         " < \"" <> promptFile <>
         "\" > \"" <> outFile <> "\" 2> \"" <> logFile <> "\"" <>
         "\r\n";
    strm = OpenWrite[batFile, BinaryFormat -> True];
    BinaryWrite[strm, ExportString[bc, "Text", CharacterEncoding -> "ASCII"]];
    Close[strm];
