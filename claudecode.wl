iDefaultToolDefinitions[accessLevel_:0.5] := {
  <|
    "Name"        -> "mathematica_eval",
    "Description" -> "Evaluate a Mathematica expression in the local kernel. " <>
                     "Use this for computation, data processing, and analysis. " <>
                     "The expression runs locally where confidential data resides.",
    "InputSchema" -> <|
      "type" -> "object",
      "properties" -> <|
        "code" -> <|
          "type" -> "string",
          "description" -> "Mathematica expression to evaluate (InputForm)"|>|>,
      "required" -> {"code"}|>
  |>,
  <|
    "Name"        -> "web_search",
    "Description" -> "Search the web and return a comprehensive Japanese-language " <>
                     "summary that itself already synthesizes multiple search results. " <>
                     "This is a HIGH-LEVEL tool: one call typically produces a complete, " <>
                     "ready-to-use answer covering the topic from several angles. " <>
                     "Do NOT chain multiple web_search calls with minor query variations; " <>
                     "the first result is already an LLM-synthesized summary and is " <>
                     "normally sufficient to answer the user's question. " <>
                     "Only call a second time if the user explicitly asks for more depth, " <>
                     "or if the first result clearly missed a different meaning of an " <>
                     "ambiguous term.",
    "InputSchema" -> <|
      "type" -> "object",
      "properties" -> <|
        "query" -> <|
          "type" -> "string",
          "description" -> "Search query"|>,
        "maxResults" -> <|
          "type" -> "integer",
          "description" -> "Desired upper bound on the number of results to cover " <>
            "in the summary (default 5; hint only, not strictly enforced)"|>|>,
      "required" -> {"query"}|>
  |>,
  <|
    "Name"        -> "web_fetch",
    "Description" -> "Fetch the content of a web page at a given URL. " <>
                     "Returns the text content of the page.",
    "InputSchema" -> <|
      "type" -> "object",
      "properties" -> <|
        "url" -> <|
          "type" -> "string",
          "description" -> "URL to fetch"|>,
        "maxLength" -> <|
          "type" -> "integer",
          "description" -> "Maximum content length in characters (default 5000)"|>|>,
      "required" -> {"url"}|>
  |>,
  <|
    "Name"        -> "file_read",
    "Description" -> "Read the content of a local file. " <>
                     "Respects access level restrictions.",
    "InputSchema" -> <|
      "type" -> "object",
      "properties" -> <|
        "path" -> <|
          "type" -> "string",
          "description" -> "File path (relative to NotebookDirectory or absolute)"|>,
        "maxLines" -> <|
          "type" -> "integer",
          "description" -> "Maximum number of lines to read (default 200)"|>|>,
      "required" -> {"path"}|>
  |>,
  <|
    "Name"        -> "notebook_info",
    "Description" -> "Get information about the current notebook's cells. " <>
                     "Returns cell styles, content snippets, and count.",
    "InputSchema" -> <|
      "type" -> "object",
      "properties" -> <|
        "cellRange" -> <|
          "type" -> "string",
          "description" -> "Cell range to query, e.g. '1-10' or 'all' (default 'all')"|>|>,
      "required" -> {}|>
  |>
};

(* \[HorizontalLine]\[HorizontalLine] \:30c4\:30fc\:30eb\:5b9a\:7fa9\:3092 prompt \:7528\:30c6\:30ad\:30b9\:30c8\:306b\:5909\:63db \[HorizontalLine]\[HorizontalLine] *)
iToolDefinitionsToPromptText[tools_List] :=
  Module[{parts = {"=== AVAILABLE TOOLS ===\n",
    "You can call tools using <tool_call> XML blocks. Format:\n\n",
    "<tool_call name=\"tool_name\" id=\"unique_id\">\n",
    "{\"param\": \"value\"}\n",
    "</tool_call>\n\n",
    "Multiple tool calls can be made in a single response.\n",
    "When your task is complete and no more tools are needed, ",
    "respond with text only (no tool_call blocks) and include [DONE].\n\n"}},
    Do[
      Module[{t = tools[[i]], schema, props, reqd},
        schema = Lookup[t, "InputSchema", <||>];
        props  = Lookup[schema, "properties", <||>];
        reqd   = Lookup[schema, "required", {}];
        AppendTo[parts, "--- " <> t["Name"] <> " ---\n"];
        AppendTo[parts, t["Description"] <> "\n"];
        AppendTo[parts, "Parameters:\n"];
        KeyValueMap[
          Function[{k, v},
            AppendTo[parts, "  " <> k <>
              If[MemberQ[reqd, k], " (required)", ""] <>
              ": " <> Lookup[v, "description", ""] <> "\n"]],
          props];
        AppendTo[parts, "\n"]],
      {i, Length[tools]}];
    StringJoin[parts]
  ];

(* \[HorizontalLine]\[HorizontalLine] \:30c4\:30fc\:30eb\:7d50\:679c\:3092 prompt \:7528\:30c6\:30ad\:30b9\:30c8\:306b\:5909\:63db \[HorizontalLine]\[HorizontalLine] *)
iToolResultsToPromptText[toolCalls_List, toolResults_List] :=
  Module[{parts = {"=== TOOL RESULTS ===\n"}},
    Do[
      Module[{call = toolCalls[[i]],
              result = If[i <= Length[toolResults],
                toolResults[[i]], <|"Success" -> False,
                  "Error" -> "No result"|>],
              name, resultText},
        name = Lookup[call, "Name", "?"];
        (* Phase 30.8 fix (2026-04-22): \:4ee5\:524d\:306f Summary \:3092\:6700\:512a\:5148\:3067\:62fe\:3063\:3066\:3044\:305f\:305f\:3081\:3001
           web_search \:306a\:3069\:306e Summary ("Web search completed (1532 chars, pre-summarized)")
           \:304c\:62fe\:308f\:308c\:3001\:672c\:6587 1500-2800 \:6587\:5b57\:306e\:5b9f\:30c7\:30fc\:30bf\:304c LLM \:306b\:898b\:3048\:305a\:3001
           LLM \:304c\:300c\:904e\:53bb\:306e\:691c\:7d22\:7d50\:679c\:304c\:898b\:3048\:306a\:3044\:300d\:3068\:56f0\:60d1\:3057\:3066\:540c\:3058\:30af\:30a8\:30ea\:3092
           \:4f55\:5ea6\:3082\:7e70\:308a\:8fd4\:3057\:547c\:3076\:4e8b\:6545\:304c\:767a\:751f\:3057\:305f (websearch-result8.nb)\:3002
           
           \:5bfe\:7b56: Result (\:5b9f\:30c7\:30fc\:30bf) \:3092\:6700\:512a\:5148\:306b\:305b\:3001Summary \:306f
           \:304d\:8981\:7d04\:7528\:306e\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:306b\:5f15\:304d\:4e0b\:3052\:308b\:3002 *)
        resultText = If[TrueQ[Lookup[result, "Success", False]],
          Which[
            StringQ[Lookup[result, "Result", None]],
              result["Result"],
            StringQ[Lookup[result, "RedactedResult", None]],
              result["RedactedResult"],
            StringQ[Lookup[result, "Summary", None]],
              result["Summary"],
            True,
              ToString[Short[
                Lookup[result, "RawResult",
                  Lookup[result, "Result", "(no output)"]], 5]]],
          "ERROR: " <> Lookup[result, "Error", "unknown error"]];
        AppendTo[parts,
          "<tool_result name=\"" <> name <> "\" id=\"" <>
          Lookup[call, "Id", ""] <> "\">\n" <>
          StringTake[resultText, UpTo[3000]] <>
          "\n</tool_result>\n\n"]],
      {i, Length[toolCalls]}];
    StringJoin[parts]
  ];

(* \[HorizontalLine]\[HorizontalLine] \:5358\:4e00\:30c4\:30fc\:30eb\:5b9f\:884c\:30c7\:30a3\:30b9\:30d1\:30c3\:30c1\:30e3 \[HorizontalLine]\[HorizontalLine]
   adapter \:304b\:3089\:547c\:3070\:308c\:308b\:3002\:5b89\:5168\:30c1\:30a7\:30c3\:30af + \:5b9f\:884c + redact\:3002 *)
iExecuteSingleTool[call_Association, accessSpec_Association,
    nb_, adapter_] :=
  Module[{name, input, tid, result},
    name  = Lookup[call, "Name", "unknown"];
    input = Lookup[call, "Input", <||>];
    tid   = Lookup[call, "Id", ""];
    
    result = Switch[name,
      
      "mathematica_eval",
        iToolExecMathematica[input, accessSpec, adapter],
      
      "web_search",
        iToolExecWebSearch[input],
      
      "web_fetch",
        iToolExecWebFetch[input],
      
      "file_read",
        iToolExecFileRead[input, accessSpec],
      
      "notebook_info",
        iToolExecNotebookInfo[input, nb],
      
      _,
        <|"Success" -> False,
          "Error" -> "Unknown tool: " <> name|>
    ];
    
    Append[result, "ToolName" -> name]
  ];

(* \[HorizontalLine]\[HorizontalLine] mathematica_eval \[HorizontalLine]\[HorizontalLine] *)
iToolExecMathematica[input_Association, accessSpec_Association,
    adapter_] :=
  Module[{code, heldExpr, execResult, redacted, valResult, timeout,
          expectedSeconds, defaultTimeout},
    code = Lookup[input, "code", ""];
    If[!StringQ[code] || code === "",
      Return[<|"Success" -> False, "Error" -> "No code provided"|>]];
    
    (* AutoEval \:7981\:6b62\:30c1\:30a7\:30c3\:30af *)
    If[iIsAutoEvalProhibited[code],
      Return[<|"Success" -> False,
        "Error" -> "Code modifies protected constants (prohibited)"|>]];
    
    heldExpr = Quiet @ Check[
      ToExpression[code, InputForm, HoldComplete], None];
    If[heldExpr === None,
      Return[<|"Success" -> False,
        "Error" -> "Failed to parse Mathematica expression"|>]];
    
    (* NBAccess \:691c\:8a3c: forbidden head / access level \:30c1\:30a7\:30c3\:30af *)
    valResult = Quiet @ Check[
      NBAccess`NBValidateHeldExpr[heldExpr, accessSpec], $Failed];
    If[AssociationQ[valResult] &&
       !TrueQ[Lookup[valResult, "Valid",
         Lookup[valResult, "Success", True]]],
      Return[<|"Success" -> False,
        "Error" -> "Validation denied: " <>
          Lookup[valResult, "Reason",
            Lookup[valResult, "VisibleExplanation", "forbidden"]]|>]];
    
    (* Phase 29 (2026-05-13): \:30bf\:30a4\:30e0\:30a2\:30a6\:30c8\:5224\:5b9a
       \:512a\:5148\:5ea6: input[expectedSeconds] > adapter[DefaultTimeoutSeconds] > 30 (\:5f93\:6765\:30c7\:30d5\:30a9\:30eb\:30c8) *)
    defaultTimeout = If[AssociationQ[adapter],
      Lookup[adapter, "DefaultTimeoutSeconds", 30], 30];
    expectedSeconds = Lookup[input, "expectedSeconds", None];
    (* Phase 30 (2026-05-13) fix: Infinity \:306f NBExecuteHeldExpr/TimeConstrained \:306b
       \:305d\:306e\:307e\:307e\:6e21\:305b\:306a\:3044\:3053\:3068\:304c\:3042\:308b\:305f\:3081\:3001\:5b9f\:8cea\:7121\:9650\:5927 (10^10 \:79d2 \:ff5e 317 \:5e74) \:306b\:5909\:63db\:3059\:308b\:3002 *)
    timeout = Which[
      expectedSeconds === Infinity, 10^10,
      IntegerQ[expectedSeconds] && expectedSeconds > 0, expectedSeconds,
      NumericQ[expectedSeconds] && expectedSeconds > 0, Round[expectedSeconds],
      defaultTimeout === Infinity, 10^10,
      IntegerQ[defaultTimeout] && defaultTimeout > 0, defaultTimeout,
      NumericQ[defaultTimeout] && defaultTimeout > 0, Round[defaultTimeout],
      True, 30
    ];
    
    execResult = NBAccess`NBExecuteHeldExpr[heldExpr, accessSpec,
      "TimeConstraint" -> timeout];
    redacted   = NBAccess`NBRedactExecutionResult[execResult, accessSpec];
    
    <|"Success"        -> TrueQ[Lookup[execResult, "Success", False]],
      "RawResult"      -> Lookup[execResult, "RawResult", None],
      "RedactedResult" -> Lookup[redacted, "RedactedResult", ""],
      "Summary"        -> Lookup[redacted, "Summary", ""],
      "Error"          -> Lookup[execResult, "Error", None],
      "TimeoutUsed"    -> timeout|>
  ];

(* \[HorizontalLine]\[HorizontalLine] web_search \[HorizontalLine]\[HorizontalLine]
   Phase 30.1 fix (2026-04-22): ClaudeWebSearch \:306e\:5b9f\:30b7\:30b0\:30cd\:30c1\:30e3\:306b\:6574\:5408\:3002
   
   \:65e7\:5b9f\:88c5\:306f ClaudeWebSearch[query, MaxItems -> n] \:3068\:3044\:3046\:5b58\:5728\:3057\:306a\:3044
   2 \:5f15\:6570\:7248\:3092\:547c\:3073\:3001\:304b\:3064\:8fd4\:308a\:5024\:3092 {<|title, url, snippet|>, ...} \:306e
   List \:3068\:3057\:3066\:671f\:5f85\:3057\:3066\:3044\:305f\:305f\:3081\:3001\:5e38\:306b !ListQ \:30d1\:30b9\:306b\:843d\:3061
   \"Web search failed\" \:3092\:56fa\:5b9a\:3067\:8fd4\:3057\:3066\:3044\:305f\:3002
   
   ClaudeWebSearch \:306e\:5b9f\:5b9a\:7fa9 (L5227):
     ClaudeWebSearch[query_String] \[RightArrow] iDoWebSearch[prompt] \[RightArrow] LLM \:8981\:7d04 String
   
   \:305d\:3053\:3067\:4ee5\:4e0b\:306b\:4fee\:6b63:
     - 1 \:5f15\:6570\:547c\:3073\:51fa\:3057\:306b\:7d71\:4e00\:3002maxResults \:5f15\:6570\:306f\:8ffd\:52a0\:60c5\:5831\:3068\:3057\:3066
       query \:672b\:5c3e\:306b\:4ed8\:4e0e (LLM \:306b\:5e0c\:671b\:4ef6\:6570\:3092\:4f1d\:3048\:308b)\:3002
     - String \:8fd4\:5374\:3092 Result \:3068\:3057\:3066\:305d\:306e\:307e\:307e\:4f7f\:3046\:3002\"Error:\" \:3067\:59cb\:307e\:308b
       \:6587\:5b57\:5217\:3068\:3001\:660e\:3089\:304b\:306b\:77ed\:3059\:304e\:308b \:5fdc\:7b54 (20 \:6587\:5b57\:672a\:6e80) \:306e\:307f\:3092 Error \:6271\:3044\:3068\:3059\:308b\:3002
     - \:7531\:306a $Failed \:307e\:305f\:306f\:7a7a\:6587\:5b57\:5217\:306a\:3089\:5f53\:7136 Error\:3002 *)
iToolExecWebSearch[input_Association] :=
  Module[{query, maxResults, augmentedQuery, result},
    query      = Lookup[input, "query", ""];
    maxResults = Lookup[input, "maxResults", 5];
    If[!StringQ[query] || query === "",
      Return[<|"Success" -> False, "Error" -> "No query provided"|>]];
    
    (* maxResults \:304c\:6307\:5b9a\:3055\:308c\:305f\:5834\:5408\:306f query \:306b\:6dfb\:3048\:3066 LLM \:306b\:4f1d\:3048\:308b\:3002
       ClaudeWebSearch \:306f\:5185\:90e8\:3067 LLM \:306b\:8981\:7d04\:3092\:4f9d\:983c\:3059\:308b\:5b9f\:88c5\:306a\:306e\:3067\:3001
       query \:6587\:5185\:306b\:542b\:3081\:3066\:304a\:3051\:3070 LLM \:304c\:9069\:5f53\:306b\:53cd\:6620\:3059\:308b\:3002 *)
    augmentedQuery = If[IntegerQ[maxResults] && maxResults > 0 && maxResults =!= 5,
      query <> " (\:4e0a\:4f4d " <> ToString[maxResults] <> " \:4ef6\:307e\:3067\:3092\:5bfe\:8c61\:3068\:3059\:308b)",
      query];
    
    result = Quiet @ Check[
      ClaudeWebSearch[augmentedQuery],
      $Failed];
    
    Which[
      result === $Failed,
        <|"Success" -> False,
          "Error" -> "Web search failed (ClaudeWebSearch returned $Failed)"|>,
      
      !StringQ[result],
        <|"Success" -> False,
          "Error" -> "Web search returned unexpected type: " <>
            ToString[Head[result]]|>,
      
      StringLength[StringTrim[result]] === 0,
        <|"Success" -> False,
          "Error" -> "Web search returned empty result"|>,
      
      (* \"Error:\" \:3067\:59cb\:307e\:308b\:6587\:5b57\:5217\:306f ClaudeWebSearch \:5185\:90e8\:304b\:3089\:306e\:30a8\:30e9\:30fc\:4f1d\:64ad *)
      StringStartsQ[StringTrim[result], "Error:" | "error:" | "ERROR:"],
        <|"Success" -> False,
          "Error" -> StringTake[StringTrim[result], UpTo[300]]|>,
      
      True,
        <|"Success" -> True,
          (* Phase 30.6 (2026-04-22): Phase 30.4 \:3067 [NOTE: ...] \:30d7\:30ec\:30d5\:30a3\:30c3\:30af\:30b9\:3092
             \:672c\:6587\:5148\:982d\:306b\:7f6e\:3044\:305f\:305f\:3081 LLM \:304c\:300c\:7d50\:679c\:3092\:4fe1\:7528\:3057\:306a\:3044
             \:30e2\:30fc\:30c9\:300d\:3067\:672c\:6587\:3092\:8aad\:307f\:3001\:5185\:5bb9\:304c\:8c4a\:5bcc\:306a\:306e\:306b
             \:300c\:4e0d\:5341\:5206\:300d\:3068\:8a8d\:8b58\:3057\:3066\:518d\:691c\:7d22\:3084\:30cf\:30eb\:30b7\:30cd\:30fc\:30b7\:30e7\:30f3\:306b
             \:9665\:308b\:4e8b\:6545\:304c\:8d77\:304d\:305f (result6b.nb: Asian Symposium \:3092
             Automata Studies \:3068\:6368\:3066\:5149\:82b1\:7fc1\:3057\:305f)\:3002
             
             \:5bfe\:5fdc:
             - \:672c\:6587\:3092\:5148\:306b\:898b\:305b\:308b\:3002\:672b\:5c3e\:306b\:63a7\:3048\:3081\:306a HINT \:3092\:7f6e\:304f\:3002
             - \:300cdo NOT\:300d\:5f37\:5236\:3092\:7dd2\:3081\:3001\:4ee3\:308f\:308a\:306b\:300c\:4e0a\:8a18\:306e\:4e8b\:5b9f\:3092\:5f15\:7528\:3057\:3066
               \:6700\:7d42\:5fdc\:7b54\:3092\:66f8\:3051\:300d\:3068\:80af\:5b9a\:7684\:306b\:8a3c\:4e8b\:3059\:308b\:3002 *)
          "Result"  -> result <> "\n\n" <>
            "[TOOL-HINT: The passage above is an LLM-prepared summary of " <>
            "multiple web results. Treat the facts in it (names, dates, " <>
            "acronyms, affiliations, locations) as the authoritative source " <>
            "for your final answer, and incorporate them faithfully. " <>
            "Typically a second web_search call is not needed.]",
          "Summary" -> "Web search completed (" <>
            ToString[StringLength[result]] <> " chars, pre-summarized)"|>
    ]
  ];

(* \[HorizontalLine]\[HorizontalLine] web_fetch \[HorizontalLine]\[HorizontalLine] *)
iToolExecWebFetch[input_Association] :=
  Module[{url, maxLen, result},
    url    = Lookup[input, "url", ""];
    maxLen = Lookup[input, "maxLength", 5000];
    If[!StringQ[url] || url === "",
      Return[<|"Success" -> False, "Error" -> "No URL provided"|>]];
    
    result = Quiet @ Check[
      ClaudeWebFetch[url],
      $Failed];
    
    If[result === $Failed || !StringQ[result],
      <|"Success" -> False,
        "Error" -> "Failed to fetch URL"|>,
      <|"Success" -> True,
        (* Phase 30.6 (2026-04-22): web_fetch \:3082\:540c\:69d8\:306b\:672b\:5c3e HINT \:5316\:3002 *)
        "Result"  -> StringTake[result, UpTo[maxLen]] <> "\n\n" <>
          "[TOOL-HINT: The passage above is an LLM-prepared summary of " <>
          "<" <> url <> ">. Use its contents as authoritative source for " <>
          "your final answer. Re-fetching the same URL or chasing related " <>
          "URLs is normally not needed.]",
        "Summary" -> "Fetched " <> ToString[StringLength[result]] <>
          " chars from " <> url <> " (pre-summarized)"|>]
  ];

(* \[HorizontalLine]\[HorizontalLine] iIsAccessiblePath: \:30d5\:30a1\:30a4\:30eb\:30d1\:30b9\:306e\:30a2\:30af\:30bb\:30b9\:53ef\:80fd\:6027\:30c1\:30a7\:30c3\:30af \[HorizontalLine]\[HorizontalLine]
   $ClaudeAccessibleDirs, $ClaudeWorkingDirectory, $packageDirectory
   \:306e\:3044\:305a\:308c\:304b\:306e\:914d\:4e0b\:306b\:3042\:308b\:304b\:3092\:5224\:5b9a\:3059\:308b\:3002 *)
iIsAccessiblePath[path_String] :=
  Module[{resolved, allowedDirs, pathParts},
    resolved = ExpandFileName[path];
    pathParts = FileNameSplit[resolved];
    allowedDirs = DeleteDuplicates @ Select[
      Join[
        If[ListQ[$ClaudeAccessibleDirs], $ClaudeAccessibleDirs, {}],
        Select[{
          If[StringQ[$ClaudeWorkingDirectory], $ClaudeWorkingDirectory, Nothing],
          If[StringQ[Global`$packageDirectory], Global`$packageDirectory, Nothing]
        }, StringQ]],
      StringQ];
    AnyTrue[allowedDirs,
      Function[{dir},
        Module[{dirParts = FileNameSplit[ExpandFileName[dir]]},
          Length[pathParts] >= Length[dirParts] &&
          pathParts[[1 ;; Length[dirParts]]] === dirParts]]]
  ];

(* \[HorizontalLine]\[HorizontalLine] file_read \[HorizontalLine]\[HorizontalLine] *)
iToolExecFileRead[input_Association, accessSpec_Association] :=
  Module[{path, maxLines, fullPath, content, lines},
    path     = Lookup[input, "path", ""];
    maxLines = Lookup[input, "maxLines", 200];
    If[!StringQ[path] || path === "",
      Return[<|"Success" -> False, "Error" -> "No path provided"|>]];
    
    (* \:30d1\:30b9\:89e3\:6c7a: \:76f8\:5bfe\:30d1\:30b9\:306f NotebookDirectory \:57fa\:6e96 *)
    fullPath = If[FileNameDepth[path] > 1 || StringStartsQ[path, "/" | "\\"],
      path,
      FileNameJoin[{
        Quiet @ Check[NotebookDirectory[], $packageDirectory],
        path}]];
    
    (* \:30a2\:30af\:30bb\:30b9\:53ef\:80fd\:30c7\:30a3\:30ec\:30af\:30c8\:30ea\:306e\:78ba\:8a8d *)
    If[!iIsAccessiblePath[fullPath],
      Return[<|"Success" -> False,
        "Error" -> "Path not in accessible directories"|>]];
    
    If[!FileExistsQ[fullPath],
      Return[<|"Success" -> False,
        "Error" -> "File not found: " <> fullPath|>]];
    
    content = Quiet @ Check[
      ReadString[fullPath, CharacterEncoding -> "UTF-8"],
      $Failed];
    If[content === $Failed,
      Return[<|"Success" -> False,
        "Error" -> "Failed to read file"|>]];
    
    lines = StringSplit[content, "\n"];
    If[Length[lines] > maxLines,
      content = StringJoin[
        Riffle[lines[[1 ;; maxLines]], "\n"]] <>
        "\n... (" <> ToString[Length[lines] - maxLines] <>
        " more lines truncated)"];
    
    <|"Success" -> True,
      "Result"  -> content,
      "Summary" -> "Read " <> ToString[Min[Length[lines], maxLines]] <>
        " of " <> ToString[Length[lines]] <> " lines"|>
  ];

(* \[HorizontalLine]\[HorizontalLine] notebook_info \[HorizontalLine]\[HorizontalLine] *)
iToolExecNotebookInfo[input_Association, nb_] :=
  Module[{cells, result},
    cells = Quiet @ Check[
      NBAccess`NBFileReadAllCells[nb],
      Quiet @ Check[
        NBAccess`NBMakeContextPacket[nb,
          <|"AccessLevel" -> 0.5|>]["Cells"],
        {}]];
    
    If[!ListQ[cells],
      Return[<|"Success" -> False,
        "Error" -> "Failed to read notebook cells"|>]];
    
    result = StringJoin[
      "Total cells: " <> ToString[Length[cells]] <> "\n\n",
      StringJoin @ MapIndexed[
        Function[{c, idx},
          "Cell " <> ToString[idx[[1]]] <> " [" <>
          Lookup[c, "CellStyle",
            Lookup[c, "Style", "?"]] <> "]: " <>
          StringTake[
            Lookup[c, "InputText",
              Lookup[c, "CellText", "(binary)"]], UpTo[120]] <>
          "\n"],
        Take[cells, UpTo[50]]]];
    
    <|"Success" -> True,
      "Result"  -> result,
      "Summary" -> ToString[Length[cells]] <> " cells"|>
  ];

