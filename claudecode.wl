                        nbPrint[nb2,
                          iL["\:2705 \:691c\:8a3c\:30c6\:30b9\:30c8\:5168\:30d1\:30b9 (",
                             "\:2705 All verification tests passed ("] <>
                          ToString[Length[testResults["passed"]]] <>
                          iL[" \:4ef6)", " tests)"]]]
