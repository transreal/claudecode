      (* 2026-05-07 fix: detect natural-language captions / titles inside
         a code block at the string level (covers cases the Pattern-based
         check misses, e.g. captions without ':' or with full-width
         parens). Strips comments and string literals first, splits at ';',
         and inspects the last non-empty statement. If it contains 4+
         CJK characters and at most 1 ASCII operator/bracket, it is
         deemed natural-language leakage. *)
      iCodeHasTrailingNaturalLanguage[code_String] :=
        Module[{stripped, statements, lastStmt, japCount, opCount, codes,
                cjkRanges, opChars},
          stripped = StringReplace[code, {
            RegularExpression["\\(\\*[\\s\\S]*?\\*\\)"] -> "",
            RegularExpression["\"(?:[^\"\\\\]|\\\\.)*\""] -> "\"\""}];
          statements = Select[StringTrim /@ StringSplit[stripped, ";"],
            # =!= "" &];
          If[Length[statements] === 0, Return[False]];
          lastStmt = Last[statements];
          codes = Quiet @ Check[ToCharacterCode[lastStmt], {}];
          (* CJK ranges:
             Hiragana       U+3040-U+309F  (12352-12447)
             Katakana       U+30A0-U+30FF  (12448-12543)
             CJK Unified    U+4E00-U+9FFF  (19968-40959)
             Halfwidth/Full U+FF00-U+FFEF  (65280-65519) *)
          japCount = Length @ Select[codes,
            (12352 <= # <= 12543) ||
            (19968 <= # <= 40959) ||
            (65280 <= # <= 65519) &];
          opChars = ToCharacterCode["=:[]{}<>+-*/^&|"];
          opCount = Length @ Select[codes, MemberQ[opChars, #] &];
          japCount >= 4 && opCount <= 1
        ];

      (* \[HorizontalLine]\[HorizontalLine] ParseProposal \[HorizontalLine]\[HorizontalLine]
         \:691c\:51fa\:512a\:5148\:9806\:4f4d:
         1. <tool_call> XML \:30d6\:30ed\:30c3\:30af \[RightArrow] ToolUse
         2. ```mathematica \:30b3\:30fc\:30c9\:30d6\:30ed\:30c3\:30af \[RightArrow] HeldExpr
         3. \:3069\:3061\:3089\:3082\:306a\:3057 \[RightArrow] TextOnly
      *)
      "ParseProposal" -> Function[{rawResponseArg},
        Module[{code, heldExpr, rawResponse = rawResponseArg, codeBlocks,
                toolCallMatches, toolCalls},
          (* \:9632\:5fa1: rawResponse \:304c Association \:306e\:5834\:5408\:306f "response" \:3092\:62bd\:51fa *)
          If[AssociationQ[rawResponse],
            rawResponse = Lookup[rawResponse, "response", ToString[rawResponse]]];
          If[!StringQ[rawResponse], rawResponse = ToString[rawResponse]];
          
          (* \[HorizontalLine]\[HorizontalLine] 1. \:30c4\:30fc\:30eb\:30b3\:30fc\:30eb\:691c\:51fa \[HorizontalLine]\[HorizontalLine] *)
          toolCallMatches = StringCases[rawResponse,
            RegularExpression[
              "(?s)<tool_call\\s+name=\"([^\"]+)\"(?:\\s+id=\"([^\"]*)\")?\\s*>\\s*([\\s\\S]*?)\\s*</tool_call>"
            ] :> {"$1", "$2", "$3"}];
          
          If[Length[toolCallMatches] > 0,
            toolCalls = Map[
              Function[{m},
                Module[{name = m[[1]], tid = m[[2]], body = m[[3]],
                        input},
                  input = Quiet @ Check[
                    Developer`ReadRawJSONString[body],
                    <|"raw" -> body|>];
                  <|"Name" -> name,
                    "Id" -> If[tid === "", CreateUUID[], tid],
                    "Input" -> input|>
                ]],
              toolCallMatches];
            Return[<|
              "HasToolUse"   -> True,
              "HasProposal"  -> False,
              "ToolCalls"    -> toolCalls,
              "TextResponse" -> rawResponse,
              "HeldExpr"     -> None|>, Module]];
          
          (* \[HorizontalLine]\[HorizontalLine] 2. Mathematica \:30b3\:30fc\:30c9\:30d6\:30ed\:30c3\:30af\:691c\:51fa (\:5f93\:6765\:52d5\:4f5c) \[HorizontalLine]\[HorizontalLine] *)
          (* Phase B-fix9: (?s) \:30d5\:30e9\:30b0\:3092\:4ed8\:3051\:3066\:8907\:6570\:884c\:30b3\:30fc\:30c9\:3092\:6b63\:3057\:304f\:6355\:7372\:3002
             \:4ee5\:524d\:306f \"```(?:mathematica)\\s*\
(.*?)\
\\s*```\" \:3060\:3063\:305f\:304c\:3001
             \. \:306f\:30c7\:30d5\:30a9\:30eb\:30c8\:3067\:6539\:884c\:30de\:30c3\:30c1\:3057\:306a\:3044\:305f\:3081
             \:8907\:6570\:884c\:30b3\:30fc\:30c9\:30d6\:30ed\:30c3\:30af\:306e\:4e2d\:8eab\:304c\:6355\:7372\:3067\:304d\:305a\:3001
             code \:304c\:7a7a\:6587\:5b57\:5217 (CodeLength=0) \:306b\:306a\:308b\:30d0\:30b0\:304c\:3042\:3063\:305f\:3002 *)
          code = None;
          codeBlocks = StringCases[rawResponse,
            RegularExpression[
              "(?s)```(?:mathematica|Mathematica|wl|wolfram|mma)\\s*\\n(.*?)\\n\\s*```"
            ] :> "$1"];
          (* Phase 30 (2026-05-13) fix: LLM \:304c\:8907\:6570\:306e ```mathematica \:30d6\:30ed\:30c3\:30af\:3092
             \:8fd4\:3057\:305f\:5834\:5408\:3001\:3059\:3079\:3066\:3092 ; \:3067\:9023\:7d50\:3057\:3066 1 \:3064\:306e\:5f0f\:3068\:3057\:3066\:51e6\:7406\:3059\:308b\:3002
             \:305d\:3046\:3057\:306a\:3044\:3068 First[codeBlocks] \:3060\:3051\:3068\:308a\:51fa\:305b\:3066\:3001
             \:30bb\:30c3\:30c8\:30a2\:30c3\:30d7\:30b3\:30fc\:30c9\:3060\:3051\:3067\:30e1\:30a4\:30f3\:51e6\:7406\:304c\:6368\:3066\:3089\:308c\:308b\:3002 *)
          If[Length[codeBlocks] > 0,
            code = StringTrim[StringRiffle[
              StringTrim /@ codeBlocks, ";\n"]]];
          (* \:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af: ``` \:306e\:307f\:ff08\:8a00\:8a9e\:6307\:5b9a\:306a\:3057\:ff09\:3067\:3082 Mathematica \:5f0f\:3092\:8a66\:884c *)
          If[code === None && StringContainsQ[rawResponse, "```\n"],
            codeBlocks = StringCases[rawResponse,
              RegularExpression["(?s)```\\s*\\n(.*?)\\n\\s*```"] :> "$1"];
            If[Length[codeBlocks] > 0,
              code = StringTrim[StringRiffle[
                StringTrim /@ codeBlocks, ";\n"]]]];
          If[StringQ[code],
            code = StringTrim[code];
            (* 2026-05-07 fix: string-level natural-language detection.
               This catches captions like "fib \:95a2\:6570\:3092\:5b9a\:7fa9\:3057\:307e\:3057\:305f\:ff08\:518d\:5e30\:ff09"
               at the trailing position of a code block. Such text passes
               ToExpression as a symbolic Times[...] expression but is a
               clear sign of LLM leakage. Detected here BEFORE ToExpression
               so the fallback path triggers a format-retry. *)
            If[iCodeHasTrailingNaturalLanguage[code],
              Return[<|"HeldExpr" -> None,
                "TextResponse" -> rawResponse,
                "HasProposal" -> False,
                "HasToolUse"  -> False|>, Module]];
            heldExpr = Quiet @ Check[
              ToExpression[code, InputForm, HoldComplete], None];
            (* 2026-05-07 fix: \:8907\:6570\:5f15\:6570 HoldComplete \:306e\:6b63\:898f\:5316\:3002
               LLM \:304c \"fib[1] = 1; fib[2] = 1; fib[(n_Integer)?Positive] := ...; \"
               \:306e\:3088\:3046\:306b ; \:533a\:5207\:308a\:8907\:6570 statement \:3092\:8fd4\:3059\:3068\:3001
               ToExpression[code, InputForm, HoldComplete] \:306f
               HoldComplete[e1, e2, e3, ...] (\:8907\:6570\:5f15\:6570\:5f62) \:3092\:8fd4\:3059\:3002
               NBExecuteHeldExpr \:306f MatchQ[heldExpr, HoldComplete[_]] \:3067
               1 \:5f15\:6570 HoldComplete \:306e\:307f\:53d7\:3051\:5165\:308c\:308b\:305f\:3081\:3001\:8907\:6570\:5f15\:6570\:306f
               Invalid HoldComplete \:30a8\:30e9\:30fc\:306b\:306a\:308b\:3002
               \:5bfe\:7b56: HoldComplete[a, b, c] \[RightArrow] HoldComplete[CompoundExpression[a, b, c]]
               \:306b\:30e9\:30c3\:30d7\:3057\:30661 \:5f15\:6570\:5f62\:306b\:6b63\:898f\:5316\:3002
               HoldComplete \:306f HoldAllComplete \:5c5e\:6027\:306a\:306e\:3067\:3001Replace \:306e RHS \:3067
               args__ \:3092 CompoundExpression \:306b\:6e21\:3057\:3066\:3082\:5185\:90e8\:8a55\:4fa1\:3055\:308c\:306a\:3044\:3002
               NBAccess.wl \:306f\:89e6\:3089\:305a claudecode.wl \:5074\:306e\:307f\:3067\:5bfe\:51e6\:3002 *)
            If[heldExpr =!= None &&
               MatchQ[heldExpr, HoldComplete[__]] &&
               !MatchQ[heldExpr, HoldComplete[_]],
              heldExpr = Replace[heldExpr,
                HoldPattern[HoldComplete[args__]] :>
                  HoldComplete[CompoundExpression[args]]]];
            (* 2026-05-07 fix: detect natural-language text leaking into a
               code block via the Pattern operator. When the LLM writes
               "Step 1: description" inside a code block, the ":" parses
               as the Pattern operator and produces Pattern[Times[...], _]
               or Pattern[Plus[...], _]. A Times/Plus headed LHS in
               Pattern is never a legitimate user expression. The fallback
               path HasProposal=False triggers a format-retry in
               iStepParseProposal. *)
            Module[{invalidPatterns},
              invalidPatterns = If[heldExpr =!= None,
                Quiet @ Check[
                  Cases[heldExpr,
                    HoldPattern[Pattern[lhs_, _]] /;
                      MatchQ[Head[Unevaluated[lhs]], Times | Plus],
                    Infinity],
                  {}],
                {}];
              If[Length[invalidPatterns] > 0,
                heldExpr = None]];
            If[heldExpr =!= None,
              Return[<|"HeldExpr" -> heldExpr,
                "TextResponse" -> rawResponse,
                "HasProposal" -> True,
                "RawCode" -> code,
                (* Phase 29 (2026-05-13): rawResponse \:304b\:3089 expectedSeconds \:3092\:62bd\:51fa\:3002
                   LLM \:306f\:300cexpectedSeconds: 180\:300d / \:300cexpected duration: 180s\:300d /
                   \:300c\:4e88\:60f3\:6240\:8981\:79d2\:6570: 180\:300d \:3092\:30b3\:30fc\:30c9\:30d6\:30ed\:30c3\:30af\:306e\:524d\:5f8c\:3067\:8a18\:8ff0\:3059\:308b\:3002 *)
                "ExpectedSeconds" -> Module[{m, jpPat},
                  m = StringCases[rawResponse,
                    RegularExpression[
                      "(?i)expectedSeconds[:\\s]+([0-9]+)"] :> "$1", 1];
                  If[Length[m] === 0,
                    m = StringCases[rawResponse,
                      RegularExpression[
                        "(?i)expected\\s*duration[:\\s]+([0-9]+)\\s*s"] :> "$1", 1]];
                  If[Length[m] === 0,
                    jpPat = FromCharacterCode[{16^^4e88, 16^^60f3, 16^^6240, 16^^8981, 16^^79d2, 16^^6570}] <>
                      "[:\\s]+([0-9]+)";
                    m = StringCases[rawResponse,
                      RegularExpression[jpPat] :> "$1", 1]];
                  If[Length[m] >= 1 && StringMatchQ[m[[1]], NumberString],
                    ToExpression[m[[1]]], None]]
              |>, Module]]];
          
          (* \[HorizontalLine]\[HorizontalLine] 3. \:30c6\:30ad\:30b9\:30c8\:306e\:307f \[HorizontalLine]\[HorizontalLine] *)
          <|"HeldExpr" -> None,
            "TextResponse" -> rawResponse,
            "HasProposal" -> False,
            "HasToolUse"  -> False|>
        ]
      ],
      
      (* \[HorizontalLine]\[HorizontalLine] ValidateProposal \[HorizontalLine]\[HorizontalLine]
         Phase C-lite (2026-06-03 \:5b9f\:88c5 / 2026-06-05 \:6587\:8a00\:6574\:5408):
         head \:5224\:5b9a\:306f NBValidateHeldExpr \:306b\:59d4\:8b72\:3057\:3001\:5b9f\:884c\:30b2\:30fc\:30c8
         (NBExecuteHeldExpr \:306e\:518d\:691c\:8a3c) \:3068\:5b8c\:5168\:4e00\:81f4\:3055\:305b\:308b\:3002\:65e7\:6765\:306e
         \:30d6\:30e9\:30c3\:30af\:30ea\:30b9\:30c8\:65b9\:5f0f ($NBDenyHeads / $NBApprovalHeads \:306e\:307f) \:3067\:306f
         unknown head \:304c Permit \:306b\:7d20\:901a\:308a\:3057\:3001\:5b9f\:884c\:6bb5\:968e\:3067\:521d\:3081\:3066
         NeedsApproval \:62d2\:5426 (\:627f\:8a8d UI \:306a\:3057) \:306b\:306a\:308b\:98df\:3044\:9055\:3044\:304c\:3042\:3063\:305f\:3002
         NBValidateHeldExpr \:7d4c\:7531\:306b\:3059\:308b\:3053\:3068\:3067\:3001unknown head \:304c
         NeedsApproval \:306a\:3089 validation \:6bb5\:968e\:3067\:627f\:8a8d UI \:304c\:51fa\:308b\:3002
         \:30c4\:30fc\:30eb\:30eb\:30fc\:30d7\:306e mathematica_eval \:3082 iToolExecMathematica \:5185\:3067
         \:540c\:69d8\:306b NBValidateHeldExpr \:3092\:5b9f\:884c\:3059\:308b\:3002 *)
      "ValidateProposal" -> Function[{proposal, contextPacket},
        Module[{heldExpr, code, heads, denied, needsApproval},
          heldExpr = proposal["HeldExpr"];
          code = Lookup[proposal, "RawCode", ""];
          (* \:518d\:5b9f\:884c\:7528: \:63d0\:6848\:5f0f\:3092\:5171\:6709\:5909\:6570\:306b\:683c\:7d0d\:3002ValidateProposal \:306f
             \:5b9f\:884c\:30fb\:30b3\:30fc\:30c9\:63d0\:793a\:306e\:3069\:3061\:3089\:306e\:7d4c\:8def\:3067\:3082\:5fc5\:305a\:901a\:308b\:691c\:8a3c\:30d5\:30a7\:30fc\:30ba\:306a\:306e\:3067\:78ba\:5b9f\:3002
             RawCode (\:751f\:30b3\:30fc\:30c9\:6587\:5b57\:5217) \:3092\:512a\:5148\:3001\:7121\:3051\:308c\:3070 heldExpr \:3092 InputForm \:5316\:3002
             SaveLastPrompt \:304c\:3053\:308c\:3092\:62fe\:3063\:3066 TargetExprString \:306b\:4fdd\:5b58\:3059\:308b\:3002 *)
          Quiet @ Check[
            ClaudeCode`$ClaudeEvalLastProposedExprString =
              Which[
                StringQ[code] && StringTrim[code] =!= "", StringTrim[code],
                heldExpr =!= None,
                  iClaudeRuntimeHeldToInputString[heldExpr],
                True, Missing["NotCaptured"]],
            ClaudeCode`$ClaudeEvalLastProposedExprString =
              Missing["NotCaptured"]];
          Which[
            (* HeldExpr \:306a\:3057 \[RightArrow] TextOnly *)
            heldExpr === None,
              <|"Decision" -> "TextOnly"|>,
            
            (* AutoEvaluate \:7981\:6b62\:64cd\:4f5c \[RightArrow] \:627f\:8a8d\:5fc5\:8981 *)
            StringQ[code] && iIsAutoEvalProhibited[code],
              <|"Decision" -> "NeedsApproval",
                "ReasonClass" -> "AccessEscalationRequired",
                "VisibleExplanation" ->
                  "Code modifies access scope. Review required."|>,
            
            (* NBAccess の head チェック。Phase C-lite (2026-06-03):
               旧来はここで独自の簡易判定 (Deny/Approval 以外は全て Permit) を
               していたため、NBExecuteHeldExpr の C-lite 再検証と食い違い、
               unknown head が「承認 UI なしで実行段階で拒否」されていた。
               NBValidateHeldExpr に委譲して判定を完全一致させる。これにより
               unknown head が NeedsApproval なら validation 段階で承認 UI が出る。 *)
            True,
              Module[{vr},
                vr = Quiet @ Check[
                  NBAccess`NBValidateHeldExpr[heldExpr, accessSpec],
                  <|"Decision" -> "RepairNeeded",
                    "ReasonClass" -> "ValidationError",
                    "VisibleExplanation" -> "Validation failed",
                    "SanitizedExpr" -> heldExpr|>];
                (* Permit のときは RouteAdvice を付与 (既存挙動互換) *)
                If[Lookup[vr, "Decision", "Deny"] === "Permit",
                  Append[vr, "RouteAdvice" -> Quiet @ Check[
                    NBAccess`NBRouteDecision[accessSpec], None]],
                  vr]
              ]
          ]
        ]
      ],
      
      (* \[HorizontalLine]\[HorizontalLine] ExecuteProposal \[HorizontalLine]\[HorizontalLine]
         Phase 32 (2026-05-13): \:30b3\:30fc\:30c9\:5b9f\:884c\:306e\:975e\:540c\:671f\:5316\:3002
         iShouldExecuteAsync \:304c True \:3092\:8fd4\:3057\:3001iSubmitParallelExecution \:304c
         \:522f\:30ab\:30fc\:30cd\:30eb\:8d77\:52d5\:306b\:6210\:529f\:3057\:305f\:5834\:5408\:306f deferred async \:7d50\:679c\:3092\:8fd4\:3059\:3002
         \:305d\:308c\:4ee5\:5916\:306f\:5f93\:6765\:306e NBExecuteHeldExpr \:3067\:540c\:671f\:5b9f\:884c\:3059\:308b\:3002 *)
      "ExecuteProposal" -> Function[{proposal, validationResult},
        Module[{heldExpr, propExpectedSec, effectiveTimeout,
                confVarNames, asyncResult, userApprovalMode},
          heldExpr = proposal["HeldExpr"];
          (* Phase C-lite (2026-06-03): ユーザーが承認 UI で明示承認した proposal は
             "UserApproved" -> True が刻まれている (ClaudeApproveProposal が付与)。
             その場合 NBExecuteHeldExpr に ApprovalMode -> "UserApproved" を渡し、
             NeedsApproval を Permit 昇格させる。Deny は昇格しない (NBAccess 側で保証)。 *)
          userApprovalMode = If[TrueQ[Lookup[proposal, "UserApproved", False]],
            "UserApproved", "None"];
          (* \:518d\:5b9f\:884c\:7528: LLM \:751f\:6210\:30b3\:30fc\:30c9\:3082\:542b\:3081\:3001\:5b9f\:884c\:3059\:308b\:5f0f\:3092 InputForm \:6587\:5b57\:5217\:5316\:3057\:3066
             \:5171\:6709\:5909\:6570\:306b\:683c\:7d0d\:3002SaveLastPrompt \:304c\:62fe\:3063\:3066 TargetExprString \:306b\:4fdd\:5b58\:3057\:3001
             ToInput / Replayable \:5224\:5b9a\:306b\:4f7f\:3046\:3002\:5168\:5b9f\:884c\:7d4c\:8def (async/sync/NBExecuteHeldExpr) \:306e
             \:624b\:524d\:306a\:306e\:3067\:3053\:3053\:304c\:78ba\:5b9f\:306a\:6355\:6349\:70b9\:3002 *)
          Quiet @ Check[
            ClaudeCode`$ClaudeEvalLastProposedExprString =
              iClaudeRuntimeHeldToInputString[heldExpr],
            ClaudeCode`$ClaudeEvalLastProposedExprString =
              Missing["NotCaptured"]];
          (* Order 9: accumulate THIS executed proposal into the turn's
             saved workflow route (weak call). Each execution (including
             post-approval ones that run after the turn-complete callback)
             appends, so a multi-step workflow is saved in full. Does not
             clear the turn -> later executions keep accumulating. *)
          Quiet @ Check[
            Module[{atask = ClaudeCode`$iClaudeEvalAutoSaveTask,
                    aturn = ClaudeCode`$iClaudeEvalAutoSaveTurn},
              If[StringQ[atask] && StringQ[aturn] &&
                 Length[Names["SourceVault`SourceVaultAutoSaveLastPrompt"]] > 0,
                Symbol["SourceVault`SourceVaultAutoSaveLastPrompt"][atask,
                  "TurnId" -> aturn,
                  "ExprString" ->
                    ClaudeCode`$ClaudeEvalLastProposedExprString]]],
            Null];
          (* Phase 29 (2026-05-13): proposal \:306e ExpectedSeconds \:3092\:512a\:5148\:3001
             \:306a\:3051\:308c\:3070 adapter \:306e DefaultTimeoutSeconds \:3092\:4f7f\:3046\:3002
             Phase 30 (2026-05-13): Infinity \:3092\:660e\:793a\:7684\:306b\:8a31\:53ef\:3002 *)
          propExpectedSec = Lookup[proposal, "ExpectedSeconds",
            Lookup[proposal, "expectedSeconds", None]];
          effectiveTimeout = Which[
            propExpectedSec === Infinity, Infinity,
            IntegerQ[propExpectedSec] && propExpectedSec > 0, propExpectedSec,
            NumericQ[propExpectedSec] && propExpectedSec > 0, Round[propExpectedSec],
            execTimeout === Infinity, Infinity,
            IntegerQ[execTimeout] && execTimeout > 0, execTimeout,
            True, 30
          ];
          (* 2026-06-12 (freeze fix 2): tick 内同期実行のハードキャップ。
             Infinity / LLM 申告の巨大 expectedSeconds をそのまま採用すると、
             提案コードのハングや長大ループで共有 tick が回復不能にブロックし
             FE が完全フリーズする (Infinity 時 NBExecuteHeldExpr は
             TimeConstrained 無しの生 ReleaseHold)。上限超過はキャップする。
             無効化: ClaudeCode`$ClaudeRuntimeMaxSyncExecutionSeconds = Infinity *)
          If[ClaudeCode`$ClaudeRuntimeMaxSyncExecutionSeconds =!= Infinity &&
             NumericQ[ClaudeCode`$ClaudeRuntimeMaxSyncExecutionSeconds],
            If[effectiveTimeout === Infinity ||
               (NumericQ[effectiveTimeout] && effectiveTimeout >
                  ClaudeCode`$ClaudeRuntimeMaxSyncExecutionSeconds),
              iClaudeFreezeLog["exec-timeout-capped",
                ToString[effectiveTimeout] <> " -> " <>
                ToString[ClaudeCode`$ClaudeRuntimeMaxSyncExecutionSeconds]];
              effectiveTimeout =
                ClaudeCode`$ClaudeRuntimeMaxSyncExecutionSeconds]];
          (* 2026-06-24: メール要約系の小バッチを sync 実行するとき、LLM 申告の
             ExpectedSeconds が小さい (既定 30s) と 1 件目 (~47s) で打ち切られる。
             Limit に応じた下限を与え、sync 上限 (既定 600s) までは許可する。
             CheckpointEvery により途中保存されるので打ち切られても進捗は残る。 *)
          With[{matchedHd = iClaudeExternalizableMatchedHead[heldExpr]},
            If[StringQ[matchedHd] && iClaudeSmallBatchSyncQ[matchedHd, heldExpr],
              Module[{lim = iClaudeExtractLimitOption[heldExpr], floor, syncCap},
                syncCap = If[NumericQ[ClaudeCode`$ClaudeRuntimeMaxSyncExecutionSeconds],
                  ClaudeCode`$ClaudeRuntimeMaxSyncExecutionSeconds, 600];
                floor = If[IntegerQ[lim], Min[syncCap, lim*90 + 60], syncCap];
                If[! NumericQ[effectiveTimeout] || effectiveTimeout < floor,
                  iClaudeFreezeLog["exec-mail-sync-timeout",
                    ToString[effectiveTimeout] <> " -> " <> ToString[floor]];
                  effectiveTimeout = floor]]]];

          (* \:6a5f\:5bc6\:30b7\:30f3\:30dc\:30eb\:30ea\:30b9\:30c8 (Secrets + ConfidentialSymbols) *)
          confVarNames = DeleteDuplicates @ Join[
            If[ListQ[Lookup[accessSpec, "ConfidentialSymbols", None]],
              Lookup[accessSpec, "ConfidentialSymbols"], {}],
            If[ListQ[secrets], secrets, {}]];
          
          (* 2026-06-12: 長時間バッチ提案の External executor 振り分け。
             $ClaudeExternalizableHeads に登録された head (例:
             SourceVaultEagleSummarizeBatch) は tick 内同期実行せず
             WolframScript 外部ジョブへ投入し、即時「投入済み」を返す。
             結果は完了時に FinalActionQueue 経由で notebook に summary が
             書かれる。投入失敗時は従来の同期実行へフォールバック。
             設計: ドキュメント/ClaudeEval_external_dispatch_design.md *)
          With[{extR = iClaudeTryExternalizeProposal[heldExpr, accessSpec, nb]},
            If[AssociationQ[extR] && TrueQ[extR["Submitted"]],
              Return[<|
                "Success"  -> True,
                "Decision" -> "Permit",
                "RawResult" -> <|
                  "ExternalJobSubmitted" -> True,
                  "Head"  -> Lookup[extR, "Head", "?"],
                  "JobID" -> Lookup[extR, "JobID",
                               Lookup[Lookup[extR, "Submission", <||>],
                                 "JobID", "?"]],
                  "Note"  -> Lookup[extR, "Note",
                    "長時間バッチを外部 WolframScript ジョブへ投入しました。完了時に summary が notebook へ書き込まれます。このタスクへの追加操作は不要です。"]|>,
                "HeldExpr" -> heldExpr,
                "Error"    -> None,
                "AuditID"  -> None|>, Module]]];

          (* \:975e\:540c\:671f\:5b9f\:884c\:5224\:5b9a \[RightArrow] \:522f\:30ab\:30fc\:30cd\:30eb\:3078\:9001\:4fe1\:8a66\:884c *)
          (* Phase D-1: ProposalEval ロールの accessSpec を作り、
             NBSubkernelExecutableQ 経由で async 可否を判定する。
             iSubmitParallelExecution は D-2 で SubkernelRaw 経由に変更予定。 *)
          With[{asyncSpec = NBAccess`NBMakeRuntimeAccessSpec[
              <|"ConfidentialSymbols" -> confVarNames, "Secrets" -> secrets,
                "Caller" -> "ClaudeEvalProposal"|>, "ProposalEval"]},
          If[iShouldExecuteAsync[heldExpr, asyncSpec, effectiveTimeout],
            asyncResult = iSubmitParallelExecution[heldExpr, asyncSpec, effectiveTimeout];
            If[AssociationQ[asyncResult] &&
               TrueQ[Lookup[asyncResult, "Async", False]],
              Return[asyncResult, Module]]]];
          
          (* 同期フォールバック。Phase D-3 (2026-06-03):
             旧来は effectiveTimeout === Infinity のとき NBExecuteHeldExpr 内の
             TimeConstrained[..., Infinity, ...] が timc メッセージで未評価を
             返す問題を避けるため、直接 ReleaseHold していた (A 分類)。
             Phase C-1 で NBExecuteHeldExpr に Infinity 分岐
             (TimeConstrained を使わず Quiet[ReleaseHold]) が実装されたため、
             この回避は不要になった。Infinity も含め NBExecuteHeldExpr に一本化し、
             すべての同期実行を NBAccess の再検証 (Permit のみ実行) 経由にする (I1)。
             これにより Infinity のときだけ検証を素通りしていた抜け穴が塞がる。
             検証ポリシーは非 Infinity 時と同一 (同じ accessSpec、snapshot なし=
             current/global mode)。
             Phase C-lite: ユーザー明示承認時は ApprovalMode -> "UserApproved" を
             渡し、NeedsApproval (Approval head / unknown head) を Permit 昇格。 *)
          (* 2026-06-12 (freeze fix 3): 同期実行中であることをステータスバーに
             明示する。長いバッチ提案 (例: SourceVault*Batch) の承認後は
             この間カーネルが占有される。中断は 評価メニュー → 評価中止。 *)
          iSafeSetWindowStatus[nb,
            iL["ClaudeRuntime: 提案コード実行中 (最大 " <>
                 ToString[effectiveTimeout] <> " 秒)...",
               "ClaudeRuntime: Executing proposal (up to " <>
                 ToString[effectiveTimeout] <> "s)..."]];
          iClaudeFreezeLog["exec-start",
            "timeout=" <> ToString[effectiveTimeout]];
          Module[{iExecR},
            iExecR = NBAccess`NBExecuteHeldExpr[heldExpr, accessSpec,
              "TimeConstraint" -> effectiveTimeout,
              "ApprovalMode" -> userApprovalMode];
            iClaudeFreezeLog["exec-end", ""];
            iExecR]
        ]
      ],
      
      (* \[HorizontalLine]\[HorizontalLine] RedactResult \[HorizontalLine]\[HorizontalLine] *)
      "RedactResult" -> Function[{executionResult, contextPacket},
        Module[{ctxAccessSpec},
          ctxAccessSpec = Lookup[contextPacket, "AccessSpec",
            <|"AccessLevel" -> accessLevel|>];
          ctxAccessSpec["Secrets"] = Join[
            Lookup[ctxAccessSpec, "Secrets", {}], secrets];
          (* 2026-06-06 \:6f0f\:6d29\:4fee\:6b63: LLM \:304c Out[13] / In[13] / InString[13] / %13 / %
             \:3067\:6a5f\:5bc6\:30bb\:30eb\:306e\:5165\:529b\:30fb\:51fa\:529b\:3092\:76f4\:63a5\:8aad\:3093\:3060\:5834\:5408\:3082 redact \:3067\:304d\:308b\:3088\:3046\:3001
             \:6a5f\:5bc6\:884c\:756a\:53f7\:3092 notebook \:304b\:3089\:7b97\:51fa\:3057\:3066 accessSpec \:306b\:6e21\:3059\:3002 *)
          ctxAccessSpec["ConfidentialLineNumbers"] = Quiet @ Check[
            NBAccess`NBConfidentialLineNumbers[nb, ctxAccessSpec], {}];
          NBAccess`NBRedactExecutionResult[executionResult, ctxAccessSpec]
        ]
      ],
      
      (* \[HorizontalLine]\[HorizontalLine] ShouldContinue: [DONE] \:30de\:30fc\:30ab\:30fc\:691c\:51fa + \:30ab\:30a6\:30f3\:30bf\:5b89\:5168\:5f01 \[HorizontalLine]\[HorizontalLine] *)
      "ShouldContinue" -> Function[{redactedResult, convState, turnCount},
        Module[{msgs, lastMsg, lastText = "", hasDoneMarker = False, sig},
          contCount++;
          (* \:4e88\:7b97\:30c1\:30a7\:30c3\:30af *)
          If[contCount > maxCont, Return[False, Module]];
          (* \:6700\:65b0 Messages \:306e TextResponse \:3092\:78ba\:8a8d *)
          msgs = Lookup[convState, "Messages", {}];
          If[Length[msgs] > 0,
            lastMsg = Last[msgs];
            lastText = Lookup[lastMsg, "TextResponse", ""];
            If[StringQ[lastText],
              hasDoneMarker = StringContainsQ[lastText,
                "[DONE]" | "[done]" | "[Done]"]]];
          (* [DONE] \:30de\:30fc\:30ab\:30fc\:304c\:3042\:308c\:3070\:5b8c\:4e86 *)
          If[hasDoneMarker, Return[False, Module]];
          (* 2026-06-18 (c) loop guard: two consecutive responses that are
             effectively identical (same URL set, etc.) mean the model is going
             in circles -> stop instead of burning more multi-minute rounds. *)
          If[StringQ[lastText] && StringLength[lastText] > 0,
            sig = iResponseSignature[lastText];
            If[StringLength[sig] >= 40 && sig === prevSig,
              iClaudeFreezeLog["loop-guard",
                "no-progress repeat detected; ending continuation"];
              Return[False, Module]];
            prevSig = sig];
          (* \:305d\:308c\:4ee5\:5916\:306f\:4e88\:7b97\:5185\:306a\:306e\:3067\:7d99\:7d9a *)
          True
        ]
      ],
      
      (* \[HorizontalLine]\[HorizontalLine] AvailableTools: \:30a8\:30fc\:30b8\:30a7\:30f3\:30c8\:304c\:4f7f\:3048\:308b\:30c4\:30fc\:30eb\:5b9a\:7fa9 \[HorizontalLine]\[HorizontalLine] *)
      "AvailableTools" -> Function[{},
        iDefaultToolDefinitions[accessLevel]
      ],
      
      (* \[HorizontalLine]\[HorizontalLine] ExecuteTools: \:30c4\:30fc\:30eb\:547c\:3073\:51fa\:3057\:306e\:4e00\:62ec\:5b9f\:884c \[HorizontalLine]\[HorizontalLine]
         \:5404\:30c4\:30fc\:30eb\:3092\:540d\:524d\:3067\:5206\:5c90\:3057\:3001accessSpec \:306b\:57fa\:3065\:304f\:5b89\:5168\:30c1\:30a7\:30c3\:30af\:3092\:9069\:7528\:3002
         \:7d50\:679c\:306f redact \:6e08\:307f\:3067\:8fd4\:3059\:3002 *)
      "ExecuteTools" -> Function[{toolCallsList, contextPacket},
        Module[{ctxAccessSpec},
          ctxAccessSpec = Lookup[contextPacket, "AccessSpec",
            <|"AccessLevel" -> accessLevel|>];
          ctxAccessSpec["Secrets"] = Join[
            Lookup[ctxAccessSpec, "Secrets", {}], secrets];
          Map[
            Function[{call},
              iExecuteSingleTool[call, ctxAccessSpec, nb, adapter]],
            toolCallsList]
        ]
      ],

      (* \[HorizontalLine]\[HorizontalLine] Phase 32k Step 3 Phase B (2026-05-14): \[HorizontalLine]\[HorizontalLine]
         async tool API \(adapter \:5074\:306e\:6a5b\:80fd\:8ffd\:52a0\:306e\:307f\:3001\:3053\:306e\:6642\:70b9\:3067\:306f
         ClaudeRuntime \:304b\:3089\:547c\:3070\:308c\:306a\:3044\)\:3002Phase C/D \:3067\:5229\:7528\:3055\:308c\:308b\:3002

         AsyncToolNames     : \:3053\:308c\:3089\:306e\:30c4\:30fc\:30eb\:540d\:306f\:5225 OS \:30d7\:30ed\:30bb\:30b9\:5316\:53ef\:80fd\:3068\:8a8d\:8b58\:3055\:308c\:308b\:3002
         SubmitToolAsync    : call \[Rule] entry \(ProcessObject \:5165\:308a\)\:3002\:5373\:6642 return\:3002
         CollectToolAsync   : entry \(\:5b8c\:4e86\:6e08\:307f\)\[Rule] toolResult Association\:3002
         CancelToolAsync    : entry \[Rule] kill + cleanup + error result\:3002
         MaxConcurrentTools : \:540c\:6642\:8d77\:52d5\:6700\:5927\:6570\(\:30ec\:30d3\:30e5\:30fc \[Section]4.1 \:63a8\:5968\:5024\)\:3002 *)

      "AsyncToolNames" -> {"web_search"},

      "MaxConcurrentTools" -> 4,

      (* call \:3092\:5225 OS \:30d7\:30ed\:30bb\:30b9\:306b\:6295\:3052\:3001ProcessObject \:5165\:308a entry \:3092\:8fd4\:3059\:3002
         \:30b5\:30dd\:30fc\:30c8 tool: web_search (Phase B \:521d\:671f)\:3002\:305d\:308c\:4ee5\:5916\:306f Status = \"Failed\" \:3092\:8fd4\:3059\:3002

         \:8fd4\:308a\:5024 (\:6210\:529f\:6642):
           <|"ToolCall"   -> call,
             "ToolName"   -> _String,
             "ToolId"     -> _String,
             "Process"    -> _ProcessObject,
             "TmpDir"     -> _String,
             "PrepData"   -> _Association,
             "StartTime"  -> _,
             "Timeout"    -> _,
             "Input"      -> _,
             "Query"      -> _String,
             "Status"     -> "Running"|>
         \:8fd4\:308a\:5024 (\:5931\:6557\:6642):
           <|"ToolName" -> _, "ToolId" -> _, "Status" -> "Failed", "Error" -> _String|> *)
      "SubmitToolAsync" -> Function[{call, contextPacket},
        Module[{toolName, input, query, maxResults, augmentedQuery, prompt,
                apiKey, model, tmpDir, prep, proc, psExe, startT,
                errorEntry},
          toolName = Lookup[call, "Name", ""];
          input    = Lookup[call, "Input", <||>];

          errorEntry = Function[{msg},
            <|"ToolName" -> toolName,
              "ToolId"   -> Lookup[call, "Id", ""],
              "Status"   -> "Failed",
              "Error"    -> msg|>];

          Which[
            toolName === "web_search",
              query      = Lookup[input, "query", ""];
              maxResults = Lookup[input, "maxResults", 5];
              If[!StringQ[query] || query === "",
                Return[errorEntry["No query provided"], Module]];

              augmentedQuery = If[IntegerQ[maxResults] && maxResults > 0 &&
                                  maxResults =!= 5,
                query <> " (\:4e0a\:4f4d " <> ToString[maxResults] <>
                  " \:4ef6\:307e\:3067\:3092\:5bfe\:8c61\:3068\:3059\:308b)",
                query];

              prompt = "Web\:3067\:4ee5\:4e0b\:306e\:30af\:30a8\:30ea\:3092\:691c\:7d22\:3057\:3001\:7d50\:679c\:3092\:65e5\:672c\:8a9e\:3067\:307e\:3068\:3081\:3066\:304f\:3060\:3055\:3044\:3002\n\n"
                <> augmentedQuery;

              apiKey = Quiet @ Check[
                NBAccess`NBGetAPIKey["anthropic",
                  PrivacySpec -> <|"AccessLevel" -> 1.0|>],
                $Failed];
              If[!StringQ[apiKey],
                Return[errorEntry[
                  "Could not retrieve Anthropic API key"], Module]];

              model = iNormalizeModelForAPI[$iModelSonnet];

              psExe = iResolvePowerShellExe[];
              If[!StringQ[psExe] || StringTrim[psExe] === "",
                Return[errorEntry["PowerShell not available"], Module]];

              tmpDir = iMakeTempDir[];
              If[!StringQ[tmpDir] || !DirectoryQ[tmpDir],
                Return[errorEntry["Could not create tmpDir"], Module]];

              prep = iPrepareWebSearchPS1[tmpDir, apiKey, model, prompt];
              If[!AssociationQ[prep],
                Quiet @ DeleteDirectory[tmpDir, DeleteContents -> True];
                Return[errorEntry["iPrepareWebSearchPS1 failed"], Module]];

              startT = AbsoluteTime[];
              proc = Quiet @ Check[
                StartProcess[{psExe, "-NoProfile", "-ExecutionPolicy", "Bypass",
                  "-File", Lookup[prep, "Ps1File"],
                  Lookup[prep, "PromptFile"],
                  Lookup[prep, "OutFile"],
                  Lookup[prep, "ErrFile"],
                  Lookup[prep, "KeyFile"],
                  Lookup[prep, "Url"],
                  Lookup[prep, "Model"]}],
                $Failed];

              If[proc === $Failed || Head[proc] =!= ProcessObject,
                Quiet @ DeleteDirectory[tmpDir, DeleteContents -> True];
                Return[errorEntry["StartProcess failed"], Module]];

              <|"ToolCall"  -> call,
                "ToolName"  -> toolName,
                "ToolId"    -> Lookup[call, "Id", ""],
                "Process"   -> proc,
                "TmpDir"    -> tmpDir,
                "PrepData"  -> prep,
                "StartTime" -> startT,
                "Timeout"   -> 300,
                "Input"     -> input,
                "Query"     -> augmentedQuery,
                "Status"    -> "Running"|>,

            True,
              errorEntry["Unsupported tool for async: " <> toolName]
          ]
        ]
      ],

      (* entry (\:5b8c\:4e86\:6e08\:307f ProcessObject \:3092\:6301\:3064) \[Rule] toolResult Association\:3002
         iToolExecWebSearch \:4e92\:63db\:5f62\:5f0f\:3092\:8fd4\:3059\:306e\:3067\:3001
         \:65e2\:5b58\:306e iToolUseAndContinue / LLM \:306f\:540c\:3058\:3088\:3046\:306b\:6271\:3048\:308b\:3002

         tmpDir \:306f iCollectWebSearchResult \:5185\:90e8\:3067 cleanup \:3055\:308c\:308b\:3002 *)
      "CollectToolAsync" -> Function[{entry},
        Module[{toolName, toolId, proc, prep, exitCode, stderr,
                runProcResult, resultText},
          toolName = Lookup[entry, "ToolName", ""];
          toolId   = Lookup[entry, "ToolId", ""];
          proc     = Lookup[entry, "Process", None];
          prep     = Lookup[entry, "PrepData", <||>];

          If[Head[proc] =!= ProcessObject,
            Return[<|"ToolName" -> toolName,
                     "ToolId"   -> toolId,
                     "Success"  -> False,
                     "Error"    -> "Invalid process object"|>, Module]];

          (* RunProcess \:4e92\:63db\:306e Association \:3092\:7d44\:307f\:7acb\:3066\:3066 iCollectWebSearchResult \:3078 *)
          exitCode = Quiet @ Check[
            ProcessInformation[proc, "ExitCode"], 1];
          If[!IntegerQ[exitCode], exitCode = 1];

          stderr = Quiet @ Check[
            ReadString[ProcessConnection[proc, "StandardError"]], ""];
          If[!StringQ[stderr], stderr = ""];

          runProcResult = <|"ExitCode"      -> exitCode,
                            "StandardError" -> stderr|>;

          resultText = iCollectWebSearchResult[prep, runProcResult];

          Which[
            !StringQ[resultText],
              <|"ToolName" -> toolName,
                "ToolId"   -> toolId,
                "Success"  -> False,
                "Error"    -> "Unexpected non-string result"|>,

            StringStartsQ[StringTrim[resultText],
              "Error:" | "error:" | "ERROR:"],
              <|"ToolName" -> toolName,
                "ToolId"   -> toolId,
                "Success"  -> False,
                "Error"    -> StringTake[
                  StringTrim[resultText], UpTo[300]]|>,

            StringLength[StringTrim[resultText]] === 0,
              <|"ToolName" -> toolName,
                "ToolId"   -> toolId,
                "Success"  -> False,
                "Error"    -> "Empty result"|>,

            True,
              <|"ToolName" -> toolName,
                "ToolId"   -> toolId,
                "Success"  -> True,
                "Result"   -> resultText <> "\n\n" <>
                  "[TOOL-HINT: The passage above is an LLM-prepared summary of " <>
                  "multiple web results. Treat the facts in it (names, dates, " <>
                  "acronyms, affiliations, locations) as the authoritative source " <>
                  "for your final answer, and incorporate them faithfully. " <>
                  "Typically a second web_search call is not needed.]",
                "Summary"  -> "Web search completed (" <>
                  ToString[StringLength[resultText]] <>
                  " chars, pre-summarized)"|>]
        ]
      ],

      (* runtime cancel \:6642\:306b\:547c\:3070\:308c\:308b\:3002Process \:3092 kill\:3001tmpDir \:3092 cleanup\:3001
         iToolExecWebSearch \:4e92\:63db\:306e error result \:3092\:8fd4\:3059\:3002 *)
      "CancelToolAsync" -> Function[{entry},
        Module[{proc, tmpDir, toolName, toolId},
          proc     = Lookup[entry, "Process", None];
          tmpDir   = Lookup[entry, "TmpDir", ""];
          toolName = Lookup[entry, "ToolName", ""];
          toolId   = Lookup[entry, "ToolId", ""];

          If[Head[proc] === ProcessObject,
            Quiet @ Check[KillProcess[proc], Null]];

          If[StringQ[tmpDir] && DirectoryQ[tmpDir],
            Quiet @ DeleteDirectory[tmpDir, DeleteContents -> True]];

          <|"ToolName" -> toolName,
            "ToolId"   -> toolId,
            "Success"  -> False,
            "Error"    -> "Tool execution cancelled"|>
        ]
      ]
    |>
  ];

(* \:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550
