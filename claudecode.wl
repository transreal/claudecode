    (* \[HorizontalLine]\[HorizontalLine] \:30ab\:30b9\:30b1\:30fc\:30c9\:3067\:5168\:30ce\:30fc\:30c9 terminal \:306b\:306a\:3063\:305f\:5834\:5408\:306e\:518d\:30c1\:30a7\:30c3\:30af \[HorizontalLine]\[HorizontalLine] *)
    If[hasFailedDeps && doneCount >= totalCount,
