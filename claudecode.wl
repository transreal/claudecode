       \:305d\:308c\:4ee5\:5916\:306f\:5f93\:6765\:306e\:6c4e\:7528\:8868\:793a\:3092\:7dad\:6301\:3002
       \:30b9\:30ed\:30c3\:30c8\:30ea\:30f3\:30b0: Dynamic \:66f4\:65b0\:306e\:8ca0\:8377\:8efd\:6e1b\:306e\:305f\:3081 5\:79d2\:9593\:9694\:306b\:5236\:9650\:3002
       \:9ad8\:983b\:5ea6\:66f4\:65b0\:306f WindowStatusArea \[RightArrow] Dynamic \:8a55\:4fa1 \[RightArrow] \:30d5\:30ed\:30f3\:30c8\:30a8\:30f3\:30c9\:30d6\:30ed\:30c3\:30af\:306e\:539f\:56e0\:3002 *)
    If[nb =!= $Failed &&
