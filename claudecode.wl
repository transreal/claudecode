          If[jid =!= None, NBAccess`NBEndJob[jid]];
          (* \:30ed\:30c3\:30af\:89e3\:653e\:3092\:6700\:512a\:5148 \[LongDash] \:5f8c\:7d9a\:306e\:51e6\:7406\:304c\:5931\:6557\:3057\:3066\:3082\:30ed\:30c3\:30af\:306f\:5fc5\:305a\:89e3\:653e *)
