iStripContinueEvalGuidance[text_String] :=
  Module[{t = text},
    t = StringReplace[t, {
      RegularExpression["(?ms)^.*完了。コードを実行して確認し、必要なら.*ContinueEval.*$"] -> "",
      RegularExpression["(?m)^\\s*ContinueEval\\[\\]\\s*$"] -> "",
      RegularExpression["(?m)^\\s*【ステップ\\s*[0-9]+】[^\\n]*$"] -> ""
    }];
    StringTrim[t]
  ];

iWriteContinueEvalButton[nb_NotebookObject, autoEvaluate_:True, callerOpts_Association:<||>] :=
  Module[{optsStr, defaultCEOpts, allOpts, nonDefaults},
    (* ContinueEval のデフォルト: AutoEvaluate->True, WebSearch->True 等。
       autoEvaluate が False の場合（ClaudeQuery経路等）、
       ContinueEval にも AutoEvaluate->False を渡す必要がある。 *)
    defaultCEOpts = <|"Fallback" -> False, "WebSearch" -> True,
      "Model" -> Automatic, "AutoEvaluate" -> True, "Timeout" -> Automatic|>;
    (* callerOpts に AutoEvaluate が未指定なら autoEvaluate 引数から補完 *)
    allOpts = Join[
      If[!TrueQ[autoEvaluate] && !KeyExistsQ[callerOpts, "AutoEvaluate"],
        <|"AutoEvaluate" -> False|>, <||>],
      callerOpts];
    nonDefaults = KeyValueMap[
      Function[{k, v},
        If[KeyExistsQ[defaultCEOpts, k] && v === defaultCEOpts[k], Nothing,
          k <> " -> " <> ToString[v, InputForm]]],
      allOpts];
    optsStr = If[Length[nonDefaults] > 0,
      ", " <> StringRiffle[nonDefaults, ", "],
      ""];
    With[{auto = TrueQ[autoEvaluate], os = optsStr},
      NBAccess`NBWriteCell[nb,
        Cell[
          TextData[{
            iL["\:5b8c\:4e86\:3002\:30b3\:30fc\:30c9\:3092\:5b9f\:884c\:3057\:3066\:78ba\:8a8d\:3057\:3001\:5fc5\:8981\:306a\:3089 ",
               "Done. Check the code output, then use "],
            ButtonBox[
              "ContinueEval",
              BaseStyle -> "Hyperlink",
              ButtonFunction :> Module[{target = InputNotebook[]},
                NBAccess`NBWriteInputCellAndMaybeEvaluate[
                  target,
                  RowBox[{"ContinueEval", "[", "\"\"" <> os, "]"}],
                  auto
                ]
              ],
              Evaluator -> Automatic,
              Method -> "Queued"
            ],
            iL[" \:3067\:7d99\:7d9a\:3067\:304d\:307e\:3059\:3002",
               " to continue."]
          }],
          "Print", FontWeight -> Bold, FontColor -> GrayLevel[0.4], FontSize -> 11,
          CellTags -> {"claudecode-notice"}
        ]
      ]
    ]
  ];

(* ClaudeUpdatePackage 完了メッセージ:
   ContinueUpdate[] ハイパーリンク + api.md 更新リンク (自動更新オフ時) *)
iWriteUpdateCompletionMessage[nb_NotebookObject, packageName_String,
    apiMdAlreadyUpdated_:False] :=
  Module[{textParts},
    textParts = {
      iL["\:5b8c\:4e86\:3002\:30b3\:30fc\:30c9\:3092\:5b9f\:884c\:3057\:3066\:78ba\:8a8d\:3057\:3001\:5fc5\:8981\:306a\:3089 ",
         "Done. Run code to verify, then use "],
      ButtonBox["ContinueUpdate",
        BaseStyle -> "Hyperlink",
        ButtonFunction :> Module[{target = InputNotebook[], btnCell},
          (* ボタンを含むセル（現在のセル）を特定し、その直後に Input セルを挿入 *)
          btnCell = EvaluationCell[];
          If[Head[btnCell] === CellObject,
            SelectionMove[btnCell, After, Cell],
            SelectionMove[target, After, Notebook]];
          NBAccess`NBWriteCell[target,
            Cell[BoxData[RowBox[{"ContinueUpdate", "[", "]"}]], "Input"]];
          SelectionMove[target, Previous, Cell];
          SelectionMove[target, All, CellContents]],
        Evaluator -> Automatic, Method -> "Queued"],
      iL["[] \:3067\:7d99\:7d9a\:3067\:304d\:307e\:3059\:3002", "[] to continue."]
    };
    (* api.md 自動更新がオフの場合: 更新リンクを追加 *)
    If[!TrueQ[apiMdAlreadyUpdated],
      AppendTo[textParts, "  "];
      AppendTo[textParts,
        ButtonBox["api.md を更新",
          BaseStyle -> "Hyperlink",
          ButtonFunction :> Module[{target = InputNotebook[]},
            iAutoUpdateApiMd[target, packageName]],
          Evaluator -> Automatic, Method -> "Queued"]]];
    NBAccess`NBWriteCell[nb,
      Cell[TextData[textParts], "Print",
        FontWeight -> Bold, FontColor -> GrayLevel[0.4], FontSize -> 11,
        CellTags -> {"claudecode-notice"}]]
  ];

