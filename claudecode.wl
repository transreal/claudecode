          iL[" | \:30c4\:30fc\:30eb\:4f7f\:7528: ", " | Tools: "], toolU];
        Print[iL["  \:51fa\:529b\:30d5\:30a1\:30a4\:30eb: ", "  Output: "], Round[fileSize / 1024., 1], " KB (",
          Lookup[info, "lineCount", 0], iL[" \:884c)", " lines)"]];
