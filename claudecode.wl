   \:4e8b\:614b\:304c\:767a\:751f\:3057\:305f\:3002\:72ec\:7acb\:3057\:305f Suppressible \:30d5\:30e9\:30b0\:3092\:8a2d\:3051\:308b\:3053\:3068\:3067\:3001
