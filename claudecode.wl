  RegularExpression["\\$(" <> $iProtectedVarNamesAlt <> ")\\s*=(?!=)"],
  (* 2. \:4fdd\:8b77\:5bfe\:8c61\:5b9a\:6570\:3078\:306e AppendTo / PrependTo *)
  RegularExpression["(?:AppendTo|PrependTo)\\s*\\[\\s*\\$(" <> $iProtectedVarNamesAlt <> ")"],
