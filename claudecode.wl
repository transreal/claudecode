              If[!StringQ[shortErr2], shortErr2 = errStr2];
              shortErr2 = StringTake[shortErr2, UpTo[200]];
              Print["  [LLMGraph] ", nextId, " \[Rule] failed (",
                shortErr2, ")"]]];
          launched++],
        {nextId, eligibleIds}];
    ]]; (* End sync chain While *)

    If[launched > 0,
      job["nodes"] = nodes;
      $iLLMGraphDAGJobs[jobId] = job];

    (* \[HorizontalLine]\[HorizontalLine] Phase 25: Runtime-aware WindowStatusArea \[HorizontalLine]\[HorizontalLine]
