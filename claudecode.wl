   \:305d\:308c\:4ee5\:5916 (legacy \:7b49 \:8ab2\:91d1 API \:306e\:751f\:30a8\:30e9\:30fc) \:306f\:73fe\:5728\:306e provider \:3092\:4f7f\:3046\:3002 *)
iRateLimitInfoProviderKey[info_Association] :=
