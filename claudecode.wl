(* \[HorizontalLine]\[HorizontalLine] RouteAdvice \:306b\:57fa\:3065\:304f provider \:547c\:3073\:51fa\:3057 \[HorizontalLine]\[HorizontalLine] *)
iAdapterSelectProvider[prompt_String, routeAdvice_Association, useFallback_] :=
  Module[{route, providerSpec, modelSpec},
    route = Lookup[routeAdvice, "Route", "CloudLLM"];
    providerSpec = Lookup[$ClaudeRoutingProviders, route, Automatic];
    
    Which[
      (* Automatic: \:901a\:5e38\:306e ClaudeQueryBg *)
      providerSpec === Automatic,
        ClaudeQueryBg[prompt, Fallback -> useFallback],
      
      (* \:660e\:793a\:7684 model spec: {vendor, model, endpoint} *)
      ListQ[providerSpec],
        modelSpec = providerSpec;
        ClaudeQueryBg[prompt, Model -> modelSpec, Fallback -> useFallback],
      
      (* Function: \:30ab\:30b9\:30bf\:30e0 provider *)
      MatchQ[providerSpec, _Function],
        providerSpec[prompt],
      
      (* \:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af *)
      True,
        ClaudeQueryBg[prompt, Fallback -> useFallback]
    ]
  ];

(* \[HorizontalLine]\[HorizontalLine] Prompt \:69cb\:7bc9 (adapter \:7528) \[HorizontalLine]\[HorizontalLine]
   \:65e7 ClaudeEval \:4e92\:63db: iClaudeSysPrompt[] \:3092\:30d9\:30fc\:30b9\:306b\:3001
   expression-proposal \:30eb\:30fc\:30d7\:56fa\:6709\:306e\:30eb\:30fc\:30eb\:3092\:8ffd\:52a0\:30bb\:30af\:30b7\:30e7\:30f3\:3068\:3057\:3066\:7d71\:5408\:3002 *)
iAdapterBuildPrompt[contextPacket_Association, convState_Association] :=
  Module[{parts = {}, input, cells, prevResult, selectedIdx, turnHistory,
          totalCellCount, maxTurnHistoryDetail = 3,
          nbCtxMode = "Tail", histCtxMode = "Recent"},
    input          = Lookup[contextPacket, "Input", ""];
    cells          = Lookup[contextPacket, "Cells", {}];
    prevResult     = Lookup[contextPacket, "PreviousResult", None];
    selectedIdx    = Lookup[contextPacket, "SelectedCells", {}];
    turnHistory    = Lookup[convState, "Messages", {}];
    totalCellCount = Lookup[contextPacket, "TotalCellCount", Length[cells]];

    (* X0b-2: consult the same ContextPlan planner the legacy path uses, so a
       registered SourceVault planner can scope the Runtime-bridge prompt too.
       Only "None" drops a dimension here (conservative); "Tail"/"Recent" keep
       the existing X0a-bounded behaviour. "LegacyFull"/False disables it. *)
    If[ClaudeCode`$ClaudeEvalContextPlanning =!= "LegacyFull" &&
       ClaudeCode`$ClaudeEvalContextPlanning =!= False,
      Module[{planPrompt, planNb, plan},
        planPrompt = If[AssociationQ[input],
          ToString[Lookup[input, "OriginalTask",
            Lookup[input, "Hint", ToString[input]]]],
          ToString[input]];
        planNb = Lookup[contextPacket, "Notebook", None];
        plan = iResolveContextPlanForCall[
          ClaudeCode`$ClaudeEvalDefaultContextPlan, planPrompt, planNb, 0,
          Lookup[contextPacket, "AccessLevel", Automatic]];
        If[AssociationQ[plan],
          nbCtxMode   = Lookup[Lookup[plan, "Notebook", <||>], "Mode", "Tail"];
          histCtxMode = Lookup[Lookup[plan, "History", <||>], "Mode", "Recent"]]]];

    (* \:65e7 ClaudeEval \:3068\:540c\:3058\:30b7\:30b9\:30c6\:30e0\:30d7\:30ed\:30f3\:30d7\:30c8\:3092\:30d9\:30fc\:30b9\:306b\:4f7f\:7528 *)
    AppendTo[parts, iClaudeSysPrompt[]];
    
    (* \:30bf\:30b9\:30af\:30aa\:30fc\:30d0\:30fc\:30d3\:30e5\:30fc\:ff08\:65e7 ClaudeEval \:4e92\:63db\:ff09:
       \:30d7\:30ed\:30f3\:30d7\:30c8\:5192\:982d\:306b\:30bf\:30b9\:30af\:306e\:6982\:8981\:3092\:914d\:7f6e\:3057\:3001
       \:30b3\:30f3\:30c6\:30ad\:30b9\:30c8\:8aad\:89e3\:306e\:65b9\:5411\:4ed8\:3051\:3092\:884c\:3046 *)
    Module[{taskStr, origTask},
      taskStr = If[AssociationQ[input],
        ToString[Lookup[input, "OriginalTask",
          Lookup[input, "Hint", ToString[input]]]],
        ToString[input]];
      (* RepairRequest \:6642: OriginalTask \:3092\:30aa\:30fc\:30d0\:30fc\:30d3\:30e5\:30fc\:306b\:8868\:793a\:3057\:3001
         repair \:30d2\:30f3\:30c8\:3067\:306f\:306a\:304f\:5143\:30bf\:30b9\:30af\:3092 LLM \:306b\:898b\:305b\:308b *)
      If[AssociationQ[input] && Lookup[input, "Type", ""] === "RepairRequest",
        origTask = Lookup[contextPacket, "OriginalTask",
          Lookup[convState, "OriginalTask", None]];
        If[StringQ[origTask] && origTask =!= "",
          taskStr = origTask]];
      AppendTo[parts, iTaskOverviewBlock[taskStr]]];
    
    (* \[HorizontalLine]\[HorizontalLine] Phase 30 (2026-04-22): \:30d1\:30c3\:30b1\:30fc\:30b8 docs / file access \:6ce8\:5165 \[HorizontalLine]\[HorizontalLine]
       \:65e7 iClaudeEvalImpl \:3068\:540c\:69d8\:306b\:3001task \:306b\:95a2\:9023\:3059\:308b api.md / \:30d5\:30a1\:30a4\:30eb\:30a2\:30af\:30bb\:30b9\:30b3\:30f3\:30c6\:30ad\:30b9\:30c8 /
       \:30d1\:30c3\:30b1\:30fc\:30b8\:4f7f\:7528\:30ac\:30fc\:30c9\:3092\:30d7\:30ed\:30f3\:30d7\:30c8\:306b\:6ce8\:5165\:3059\:308b\:3002
       
       \:3053\:308c\:304c\:306a\:3044\:3068 LLM \:306f github.wl / claudecode.wl / documentation.wl \:7b49\:306e
       api.md \:3092\:53c2\:7167\:3067\:304d\:305a\:3001GitHubListCommits \:306a\:3069\:30d1\:30c3\:30b1\:30fc\:30b8\:5c02\:6709\:306e\:95a2\:6570\:540d\:3092
       \:8a8d\:8b58\:3067\:304d\:306a\:3044\:305f\:3081\:3001\:30bf\:30b9\:30af\:304c\:534a\:6b20\:843d\:3057\:305f\:307e\:307e\:5b8c\:4e86\:3059\:308b\:3002
       
       iPackageDocsContext \:306f task \:6587\:5b57\:5217\:306b\:542b\:307e\:308c\:308b\:30d1\:30c3\:30b1\:30fc\:30b8\:540d\:30fb\:30ad\:30fc\:30ef\:30fc\:30c9\:3092
       \:691c\:51fa\:3057\:3066\:5bfe\:5fdc\:3059\:308b api.md \:3092\:5b8c\:5168\:6ce8\:5165\:3059\:308b\:3002\:65e7 Single \:30d1\:30b9\:3067\:6a5f\:80fd\:3057\:3066\:3044\:305f
       \:300capi.md \:30d5\:30a1\:30fc\:30b9\:30c8\:539f\:5247\:300d\:3092 adapter \:7d4c\:8def\:3067\:3082\:6709\:52b9\:306b\:3059\:308b\:3002 *)
    Module[{taskStr2, origTask2, fileCtx, pkgDocs, pkgGuard, symCtx, nbObj,
            mcpCtx},
      taskStr2 = If[AssociationQ[input],
        ToString[Lookup[input, "OriginalTask",
          Lookup[input, "Hint", ToString[input]]]],
        ToString[input]];
      If[AssociationQ[input] && Lookup[input, "Type", ""] === "RepairRequest",
        origTask2 = Lookup[contextPacket, "OriginalTask",
          Lookup[convState, "OriginalTask", None]];
        If[StringQ[origTask2] && origTask2 =!= "",
          taskStr2 = origTask2]];
      
      nbObj = Lookup[contextPacket, "Notebook", None];
      
      (* Quiet \@ Check \:3067\:4fdd\:8b77 \[LongDash] \:5404\:30b3\:30f3\:30c6\:30ad\:30b9\:30c8\:95a2\:6570\:306e\:5931\:6557\:3067 prompt \:69cb\:7bc9\:304c\:5d29\:308c\:306a\:3044\:3088\:3046\:306b *)
      fileCtx  = Quiet @ Check[iFileAccessContext[taskStr2], ""];
      mcpCtx   = Quiet @ Check[iCLIMCPPromptContext[], ""];
      pkgDocs  = Quiet @ Check[iPackageDocsContext[taskStr2], ""];
      pkgGuard = Quiet @ Check[iPackageUseGuard[taskStr2], ""];
      symCtx   = If[Head[nbObj] === NotebookObject && nbCtxMode =!= "None",
        Quiet @ Check[iNotebookDefinedSymbolsContext[nbObj], ""], ""];
      (* X0a: bound the notebook-defined-symbols dump (symCtx) under context
         planning; for symbol-heavy notebooks it can dominate the prompt.
         pkgDocs is now capped inside iPackageDocsContext itself ((B) fix).
         "LegacyFull"/False disables the bound. *)
      If[ClaudeCode`$ClaudeEvalContextPlanning =!= "LegacyFull" &&
         ClaudeCode`$ClaudeEvalContextPlanning =!= False,
        Module[{bdg = ClaudeCode`$ClaudeEvalContextNotebookCharBudget},
          If[IntegerQ[bdg] && bdg > 0 &&
             StringQ[symCtx] && StringLength[symCtx] > bdg,
            symCtx = StringTake[symCtx, UpTo[bdg]] <>
              "\n...[notebook-defined symbols truncated to fit the model context]\n"]]];

      If[StringQ[symCtx]   && symCtx   =!= "", AppendTo[parts, symCtx]];
      If[StringQ[fileCtx]  && fileCtx  =!= "", AppendTo[parts, fileCtx]];
      If[StringQ[mcpCtx]   && mcpCtx   =!= "", AppendTo[parts, mcpCtx]];
      If[StringQ[pkgDocs]  && pkgDocs  =!= "", AppendTo[parts, pkgDocs]];
      If[StringQ[pkgGuard] && pkgGuard =!= "", AppendTo[parts, pkgGuard]]];
    
    (* \:30de\:30eb\:30c1\:30bf\:30fc\:30f3\:62e1\:5f35 \[LongDash] \:30a2\:30eb\:30b4\:30ea\:30ba\:30e0\:3068\:30c7\:30fc\:30bf\:306e\:5206\:96e2\:539f\:5247
       
       \:8a2d\:8a08\:539f\:5247:
       - LLM = \:30b3\:30fc\:30c9\:751f\:6210\:5668\:ff08\:30a2\:30eb\:30b4\:30ea\:30ba\:30e0\:3092\:7d44\:307f\:7acb\:3066\:308b\:ff09
       - \:30ed\:30fc\:30ab\:30eb Mathematica = \:30b3\:30fc\:30c9\:8a55\:4fa1\:5668\:ff08\:30c7\:30fc\:30bf\:3092\:51e6\:7406\:3059\:308b\:ff09
       - \:3053\:306e\:5206\:96e2\:306b\:3088\:308a\:3001Confidential \:30c7\:30fc\:30bf\:3092 cloud LLM \:306b\:898b\:305b\:305a\:306b\:8a08\:7b97\:53ef\:80fd
