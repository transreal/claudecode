    (* \[HorizontalLine]\[HorizontalLine] \:30ab\:30b9\:30b1\:30fc\:30c9\:5931\:6557: failed \:30ce\:30fc\:30c9\:304c\:3042\:308b\:3068\:304d\:3060\:3051\:5b9f\:884c \[HorizontalLine]\[HorizontalLine]
       \:65e7\:5b9f\:88c5\:306f Auto-stop \:524d\:5f8c\:3067 2 \:56de\:540c\:3058\:30ab\:30b9\:30b1\:30fc\:30c9\:3092\:8d70\:3089\:305b\:3066\:3044\:305f\:304c\:3001
       Auto-stop \:5f8c\:306b 1 \:56de\:3060\:3051\:8d70\:3089\:305b\:308c\:3070\:5341\:5206\:3002
       failed \:30ce\:30fc\:30c9\:304c\:306a\:3051\:308c\:3070\:3053\:306e\:30d6\:30ed\:30c3\:30af\:5168\:4f53\:3092\:30b9\:30ad\:30c3\:30d7\:3059\:308b
       (\:5927\:898f\:6a21 DAG \:3067 tick \:6642\:9593\:3092\:5927\:5e45\:524a\:6e1b)\:3002 *)
    If[Length[failedIds] > 0,
      Module[{cascadeCount = 0, changed = True, newlyFailed},
        While[changed,
          changed = False;
          newlyFailed = {};
          Scan[With[{k = #, n = nodes[#]},
            Module[{deps, depStatuses, allTerminal, anyFailed},
              (* status === "pending" \:30c1\:30a7\:30c3\:30af: \:540c\:4e00 Scan \:5185\:3067\:65e2\:306b
                 cascade \:3067 failed \:306b\:9077\:79fb\:3057\:305f\:30ce\:30fc\:30c9\:3092\:518d\:51e6\:7406\:3057\:306a\:3044\:305f\:3081\:3002 *)
              If[Lookup[n, "status", ""] === "pending" &&
                 !TrueQ[Lookup[n, "tolerateFailure", False]],
                deps = Lookup[n, "dependsOn", {}];
                If[Length[deps] > 0,
                  depStatuses = Lookup[
                    Lookup[nodes, #, <||>], "status", ""] & /@ deps;
                  allTerminal = AllTrue[depStatuses,
                    MemberQ[{"done", "failed"}, #] &];
                  anyFailed = AnyTrue[depStatuses, # === "failed" &];
                  If[allTerminal && anyFailed,
                    n["status"] = "failed";
                    n["error"]  = "Dependency failed";
                    n["result"] = None;
                    nodes[k] = n;
                    AppendTo[newlyFailed, k];
                    cascadeCount++;
                    changed = True]]]]] &,
            pendingIds];
          If[Length[newlyFailed] > 0,
            pendingIds = Complement[pendingIds, newlyFailed];
            failedIds  = Join[failedIds, newlyFailed]]];
        If[cascadeCount > 0,
          job["nodes"] = nodes;
          $iLLMGraphDAGJobs[jobId] = job;
          doneCount += cascadeCount;
          (* v2026-04-20 T12: rate-limit active \:4e2d\:306f\:30e1\:30c3\:30bb\:30fc\:30b8\:3092\:6291\:6b62 (\:4e8c\:91cd\:9632\:5fa1) *)
          Module[{rliForPrint = Quiet @ Check[ClaudeRateLimitStatus[], None],
                  suppressMsg = False, resetsDateForPrint},
            If[AssociationQ[rliForPrint],
              resetsDateForPrint = Lookup[rliForPrint, "ResetsAt", None];
              If[Head[resetsDateForPrint] === DateObject &&
                 Quiet[Check[resetsDateForPrint > Now, False]],
                suppressMsg = True]];
            If[!suppressMsg,
              Print["  [LLMGraph] ", iL[
                "\:30ab\:30b9\:30b1\:30fc\:30c9\:5931\:6557: " <> ToString[cascadeCount] <> " \:30ce\:30fc\:30c9",
