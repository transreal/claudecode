(* ============================================================
   \:81ea\:52d5\:79d8\:5bc6\:30de\:30fc\:30af: AccessLevel \:304c cloudcode \:306e MaxAccessLevel \:3092\:8d85\:3048\:308b
   \:5834\:5408\:3001LLM \:304c\:66f8\:304d\:8fbc\:3093\:3060\:30bb\:30eb\:3092\:81ea\:52d5\:7684\:306b\:79d8\:5bc6\:30de\:30fc\:30af\:3059\:308b\:3002
   \:30ed\:30fc\:30ab\:30eb\:30e2\:30c7\:30eb\:304c Confidential[] \:3092\:4f7f\:3044\:5fd8\:308c\:3066\:3082\:5b89\:5168\:3002
   cellCountBefore: \:66f8\:304d\:8fbc\:307f\:524d\:306e\:30bb\:30eb\:6570
   nb: \:30ce\:30fc\:30c8\:30d6\:30c3\:30af
   ============================================================ *)

iAutoMarkNewCellsConfidential[nb_NotebookObject, cellCountBefore_Integer] :=
  Module[{nAfter, newIndices, style},
    nAfter = NBAccess`NBCellCount[nb];
    If[nAfter <= cellCountBefore, Return[]];
    newIndices = Range[cellCountBefore + 1, nAfter];
    Do[
      style = NBAccess`NBCellStyle[nb, idx];
      (* Input/Output/Code \:30bb\:30eb\:306e\:307f\:30de\:30fc\:30af\:3002Text/Print/Subsection \:7b49\:306f\:30b9\:30ad\:30c3\:30d7 *)
      If[MemberQ[{"Input", "Output", "Code", "ExternalLanguage"}, style] &&
         !TrueQ[NBAccess`NBGetConfidentialTag[nb, idx]],
        NBAccess`NBMarkCellConfidential[nb, idx]],
      {idx, newIndices}]
  ];

(* Identity-based variant for the async runtime path. The count-range version
   above assumes new cells are appended at the end and that no other cells were
   added since the count was taken. In the async runtime that is false: the user
   keeps evaluating cells while the model works, and result cells may be inserted
   at the job anchor, so a positional [before+1 .. after] range marks UNRELATED
   cells confidential. Here we diff the actual CellObject set captured right
   before the result is written, so only the cells THIS turn added are marked.
   NBAccess cell indices follow Cells[nb] order (NBCellCount = Length[Cells[nb]]),
   so the position in allCells is the NBAccess cellIdx. *)
iAutoMarkCellsAddedSince[nb_NotebookObject, beforeCells_List] :=
  Module[{allCells, style},
    allCells = Quiet @ Cells[nb];
    If[!ListQ[allCells], Return[]];
    (* refresh the NBAccess cell cache so NBCellStyle/index align with allCells *)
    Quiet[NBAccess`NBCellCount[nb]];
    Do[
      If[!MemberQ[beforeCells, allCells[[idx]]],
        style = Quiet @ NBAccess`NBCellStyle[nb, idx];
        If[MemberQ[{"Input", "Output", "Code", "ExternalLanguage"}, style] &&
           !TrueQ[NBAccess`NBGetConfidentialTag[nb, idx]],
          NBAccess`NBMarkCellConfidential[nb, idx]]],
      {idx, Length[allCells]}]
  ];
iAutoMarkCellsAddedSince[_, _] := Null;

(* accessLevel \:304c cloudcode \:306e\:4e0a\:9650\:3092\:8d85\:3048\:308b\:304b\:306e\:5224\:5b9a *)
iShouldAutoMarkConfidential[accessLevel_?NumericQ] :=
  accessLevel > NBAccess`NBGetProviderMaxAccessLevel["claudecode"];

(* True when the session already has confidential data to protect. *)
iSessionHasConfidentialContent[] :=
  Length[$confidentialSymbols] > 0 || Length[$allConfidentialVars] > 0;

(* Gate the local-model "blanket" auto-mark on ACTUAL confidentiality. A routine
   local-model eval on a clean, public notebook must NOT mark its result
   confidential: that taints benign variables (e.g. an echoed `m = {...}`), which
   then cascade through iPrecisionConfidentialCheck's dependency scan and mark
   unrelated cells (result16b). Mark only when the session already has
   confidential content, OR the eval is explicitly high-privacy (privSpec
   AccessLevel > 0.5). iResponseTaintedQ (response references a known confidential
   variable) still marks independently of this gate. *)
iShouldBlanketMarkConfidential[accessLevel_, privSpec_] :=
  TrueQ[iShouldAutoMarkConfidential[accessLevel]] &&
  (iSessionHasConfidentialContent[] ||
   (AssociationQ[privSpec] && TrueQ[Lookup[privSpec, "AccessLevel", 0] > 0.5]));
iShouldBlanketMarkConfidential[___] := False;

(* LLM 応答/生成コードが機密ソースを参照しているかの判定。
   機密ソース = NBAccess の機密生成ヘッド表 (SourceVault 等がロード時登録) と
   秘密変数表。クラウドセッション (autoMark=False) でも、これが True なら
   書き込んだ新規セルを iAutoMarkNewCellsConfidential で自動機密マークする
   (生成コードの実行結果やインライン化された値の漏えい防止)。
   引数: 文字列/文字列リストを任意個 (非文字列は無視)。 *)
iResponseTaintedQ[args___] :=
  Quiet @ Check[
    Module[{txt, ks},
      txt = StringRiffle[Select[Flatten[{args}], StringQ], "\n"];
      If[txt === "", Return[False, Module]];
      If[TrueQ[NBAccess`NBTextUsesConfidentialHead[txt]],
        Return[True, Module]];
      ks = Keys[NBAccess`NBGetConfidentialVars[]];
      ks =!= {} && AnyTrue[ks,
        StringContainsQ[txt,
          RegularExpression[
            "(?<![\\p{L}\\p{N}$])" <> # <> "(?![\\p{L}\\p{N}$])"]] &]],
    False];

Options[ClaudeQuerySync] = {
  Fallback -> False,
  Model -> Automatic,
  PrivacySpec -> Automatic,
  PrivacyLevel -> Automatic,
  Timeout -> Automatic,
  "TaskClass" -> Automatic,  (* hardening 04 Inc2b: ティア表経由の backend 選択 *)
  "Validator" -> None        (* hardening 04 Inc3: 応答検証の純関数
                                validator[response_String] -> True | Failure[tag, ...]
                                失敗時、AllowEscalation な class は tier 次候補へ 1 回昇格 *)
};

(* \:540c\:671f LLM \:30af\:30a8\:30ea\:ff08WindowStatusArea \:7d4c\:904e\:6642\:9593\:8868\:793a\:4ed8\:304d\:ff09\:3002
   \:4ed6\:30d1\:30c3\:30b1\:30fc\:30b8 (documentation.wl \:7b49) \:304b\:3089\:306e\:8efd\:91cf LLM \:547c\:3073\:51fa\:3057\:7528\:3002
   \:30bb\:30c3\:30b7\:30e7\:30f3\:5c65\:6b74\:3084\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:66f8\:304d\:8fbc\:307f\:306f\:884c\:308f\:306a\:3044\:3002
   
   \:30e2\:30c7\:30eb\:30eb\:30fc\:30c6\:30a3\:30f3\:30b0\:ff08\:552f\:4e00\:306e\:30b3\:30a2\:ff09:
     Model \:304c\:660e\:793a\:6307\:5b9a \[RightArrow] \:305d\:306e\:30e2\:30c7\:30eb\:3092 API \:7d4c\:7531\:3067\:4f7f\:7528
     Model === Automatic:
       PrivacyLevel < 0.5 \[RightArrow] Claude Code CLI (+ Fallback \:3067 API)
       PrivacyLevel >  0.5 \[RightArrow] $ClaudePrivateModel \:3092\:81ea\:52d5\:4f7f\:7528
   \:623b\:308a\:5024: \:5fdc\:7b54\:6587\:5b57\:5217\:3002 *)
ClaudeQuerySync[prompt_String, opts:OptionsPattern[]] :=
  Module[{modelSpec, response, nb, startTime, progressTask, label, elapsed,
          privLevel, useFallback},
    (* hardening 04 Inc2b: TaskClass 申告があればティア解決を経由 *)
    $iClaudeCurrentTaskClass =
      iClaudeEffectiveTaskClass[OptionValue["TaskClass"]];  (* 04 Inc4: 会計帰属 *)
    modelSpec = iClaudeApplyTaskClassToModel[
      OptionValue["TaskClass"], OptionValue[Model]];
    If[FailureQ[modelSpec], Return[modelSpec, Module]];
    modelSpec = iResolveDefaultModelSpec[modelSpec];
    privLevel = Replace[OptionValue[PrivacyLevel], Automatic -> 0.0];
    useFallback = TrueQ[OptionValue[Fallback]];

    (* === \:30e2\:30c7\:30eb\:30eb\:30fc\:30c6\:30a3\:30f3\:30b0\:ff08\:30b3\:30a2\:30fb\:552f\:4e00\:306e\:5834\:6240\:ff09 === *)
    If[modelSpec === Automatic,
      Which[
        (* \:30af\:30e9\:30a6\:30c9\:53ef\:80fd *)
        privLevel <= 0.5,
          Null,  (* modelSpec \:306f Automatic \:306e\:307e\:307e \[RightArrow] iQueryWithFallback \:304c\:51e6\:7406 *)
        (* \:79d8\:5bc6\:30bb\:30eb: $ClaudePrivateModel \:3092\:81ea\:52d5\:4f7f\:7528 *)
        ListQ[$ClaudePrivateModel] && Length[$ClaudePrivateModel] >= 2,
          modelSpec = $ClaudePrivateModel,
        (* $ClaudePrivateModel \:672a\:8a2d\:5b9a: \:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:30e2\:30c7\:30eb\:3092\:691c\:7d22 *)
        useFallback,
          Module[{avail = NBAccess`NBGetAvailableFallbackModels[privLevel]},
            If[Length[avail] > 0,
              modelSpec = First[avail],
              Return[iL["Error: PrivacyLevel " <> ToString[privLevel] <>
                " \:306b\:5bfe\:5fdc\:3059\:308b\:30e2\:30c7\:30eb\:304c\:3042\:308a\:307e\:305b\:3093\:3002",
                "Error: No model available for PrivacyLevel " <> ToString[privLevel] <> "."]]]],
        (* \:3069\:308c\:306b\:3082\:8a72\:5f53\:3057\:306a\:3044 *)
        True,
          Return[iL["Error: \:79d8\:5bc6\:30bb\:30eb\:306e\:51e6\:7406\:306b\:306f $ClaudePrivateModel \:307e\:305f\:306f Fallback \:304c\:5fc5\:8981\:3067\:3059\:3002",
            "Error: $ClaudePrivateModel or Fallback required for confidential cells."]]
      ]];

    (* \:9032\:6357\:8868\:793a\:7528\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:3092\:53d6\:5f97 *)
    nb = Quiet[InputNotebook[]];
    If[Head[nb] =!= NotebookObject, nb = Quiet[EvaluationNotebook[]]];
    startTime = AbsoluteTime[];

    (* \:8868\:793a\:30e9\:30d9\:30eb *)
    label = Which[
      ListQ[modelSpec] && Length[modelSpec] >= 2,
        modelSpec[[1]] <> "/" <> modelSpec[[2]],
      True,
        "Claude"
    ];

    (* WindowStatusArea \:7d4c\:904e\:6642\:9593\:8868\:793a\:30bf\:30b9\:30af\:3092\:958b\:59cb *)
    If[Head[nb] === NotebookObject,
      Quiet[CurrentValue[nb, WindowStatusArea] =
        label <> " " <> iL["\:306b\:554f\:3044\:5408\:308f\:305b\:4e2d... 0s", "querying... 0s"]];
      progressTask = CreateScheduledTask[
        With[{pNb = nb, t0 = startTime, lbl = label},
          Module[{e = Round[AbsoluteTime[] - t0, 1]},
            Quiet[CurrentValue[pNb, WindowStatusArea] =
              lbl <> " " <> iL["\:306b\:554f\:3044\:5408\:308f\:305b\:4e2d... ", "querying... "] <> ToString[e] <> "s"]]],
        1];
      Quiet[StartScheduledTask[progressTask]],
      progressTask = None];

    (* LLM \:547c\:3073\:51fa\:3057\:672c\:4f53 *)
    response = Which[
      (* Phase 28 fix (2026-05-12): provider=="claudecode" \:306f CLI \:540c\:671f\:7d4c\:8def\:3078 (iQueryViaAPI \:4ee5\:5916) *)
      ListQ[modelSpec] && Length[modelSpec] >= 2 &&
        StringQ[modelSpec[[1]]] && ToLowerCase[modelSpec[[1]]] === "claudecode",
        Block[{$ClaudeModel = modelSpec[[2]]},
          iClaudeQueryRaw[prompt]],
      modelSpec =!= Automatic && ListQ[modelSpec] && Length[modelSpec] >= 2,
        (* \:660e\:793a\:30e2\:30c7\:30eb\:6307\:5b9a (or \:81ea\:52d5\:89e3\:6c7a\:6e08\:307f $ClaudePrivateModel): API \:7d4c\:7531 *)
        iQueryViaAPI[
          modelSpec[[1]], modelSpec[[2]], prompt,
          If[Length[modelSpec] >= 3, modelSpec[[3]], ""]],
      True,
        (* Automatic: Claude Code CLI + \:30aa\:30d7\:30b7\:30e7\:30ca\:30eb\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af *)
        iQueryWithFallback[prompt, useFallback]
    ];

    (* hardening 04 Inc3: validator + escalate (1 回だけ)。
       条件: TaskClass 明示 + Model 未指定 (=tier 解決経路) + AllowEscalation。
       securityjudge は属性で昇格禁止 (隔離判定の経路を変えない)。
       validator 明示の呼び出し元には最終不合格を Failure で構造化して返す。 *)
    Module[{tc = OptionValue["TaskClass"], validator = OptionValue["Validator"],
            tcEff, attrs, vres, nextCand, reason, next2},
      If[tc =!= Automatic && tc =!= None && OptionValue[Model] === Automatic,
        tcEff = iClaudeEffectiveTaskClass[tc];
        attrs = ClaudeTaskClassAttributes[tcEff];
        If[TrueQ[attrs["RequiresValidator"]] && validator === None,
          iClaudeDiagEmit["ValidatorMissing", <|"TaskClass" -> tcEff|>]];
        vres = If[iClaudeErrorResponseQ[response],
          Failure["ErrorResponse", <|"Response" ->
            If[StringQ[response], StringTake[response, UpTo[200]],
              ToString[response]]|>],
          iClaudeValidateResponse[response, validator]];
        If[vres =!= True && TrueQ[attrs["AllowEscalation"]],
          reason = If[FailureQ[vres] && vres[[1]] === "ErrorResponse",
            "ErrorResponse", "ValidationFailed"];
          nextCand = iClaudeTierNextCandidate[tcEff, modelSpec];
          If[ListQ[nextCand],
            iClaudeDiagEmit["LLMEscalated",
              <|"From" -> ToString[modelSpec, InputForm],
                "To" -> ToString[nextCand, InputForm],
                "Reason" -> reason, "TaskClass" -> tcEff|>, "info"];
            next2 = iResolveDefaultModelSpec[nextCand];
            response = Which[
              ListQ[next2] && Length[next2] >= 2 &&
                StringQ[next2[[1]]] && ToLowerCase[next2[[1]]] === "claudecode",
                Block[{$ClaudeModel = next2[[2]]}, iClaudeQueryRaw[prompt]],
              ListQ[next2] && Length[next2] >= 2,
                iQueryViaAPI[next2[[1]], next2[[2]], prompt,
                  If[Length[next2] >= 3, next2[[3]], ""]],
              True, response];
            vres = If[iClaudeErrorResponseQ[response],
              Failure["ErrorResponse", <|"Response" ->
                If[StringQ[response], StringTake[response, UpTo[200]],
                  ToString[response]]|>],
              iClaudeValidateResponse[response, validator]]]];
        If[vres =!= True && validator =!= None,
          response = Failure["ValidationFailed",
            <|"TaskClass" -> tcEff, "Detail" -> vres,
              "Response" -> If[StringQ[response], response,
                ToString[response]]|>]]]];

    (* \:9032\:6357\:8868\:793a\:3092\:505c\:6b62\:30fb\:30af\:30ea\:30a2 *)
    If[progressTask =!= None,
      Quiet[StopScheduledTask[progressTask]];
      Quiet[RemoveScheduledTask[progressTask]]];
    If[Head[nb] === NotebookObject,
      elapsed = Round[AbsoluteTime[] - startTime, 1];
      Quiet[CurrentValue[nb, WindowStatusArea] =
        label <> " " <> iL["\:5b8c\:4e86 ", "done "] <> ToString[elapsed] <> "s"];
      RunScheduledTask[
        With[{pNb = nb},
          Quiet[CurrentValue[pNb, WindowStatusArea] = ""]],
        {2}]];

    response
  ];


(* ============================================================
   ClaudeQueryBg: FrontEnd \:64cd\:4f5c\:306a\:3057\:30fb\:540c\:671f\:30af\:30a8\:30ea
   \[HorizontalLine]\[HorizontalLine] Fallback \:306b\:5fdc\:3058\:305f\:30eb\:30fc\:30c6\:30a3\:30f3\:30b0 \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   Fallback -> False (\:30c7\:30d5\:30a9\:30eb\:30c8):
     - Claude Code CLI \:3092 RunProcess \:3067\:540c\:671f\:547c\:3073\:51fa\:3057 (iClaudeQueryRaw)
     - \:8ab2\:91d1API\:4e0d\:4f7f\:7528\:3002Claude Code \:306e\:30b5\:30d6\:30b9\:30af\:30ea\:30d7\:30b7\:30e7\:30f3\:7bc4\:56f2\:5185\:3002
     - ScheduledTask/SocketListen \:5185\:3067\:3082 RunProcess \:306f\:5b89\:5168\:3002
   Fallback -> True:
     - URLRead \:3067 Anthropic API \:3092\:76f4\:63a5\:547c\:3076 (\:8ab2\:91d1\:3042\:308a)
     - Claude Code CLI \:304c\:5229\:7528\:4e0d\:53ef\:306a\:5834\:5408\:306e\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af
   \:7528\:9014:
     - SocketListen \:30cf\:30f3\:30c9\:30e9\:5185\:304b\:3089\:306e LLM \:547c\:3073\:51fa\:3057
     - ScheduledTask \:30b3\:30fc\:30eb\:30d0\:30c3\:30af\:5185\:304b\:3089\:306e LLM \:547c\:3073\:51fa\:3057
     - FrontEnd \:306a\:3057\:74b0\:5883 (WolframScript \:7b49) \:3067\:306e LLM \:547c\:3073\:51fa\:3057
   ============================================================ *)
Options[ClaudeQueryBg] = {
  Fallback -> False,
  Model    -> Automatic,
  Timeout  -> Automatic,
  NonBlocking -> False,
  "TaskClass" -> Automatic   (* hardening 04 Inc2b *)
};

ClaudeQueryBg[prompt_String, opts:OptionsPattern[]] :=
  Module[{useFallback, nonBlock, modelSpec, hasExplicitModel, providerLower, modelName},
    (* hardening 04 Inc2b: TaskClass 申告があればティア解決を経由 *)
    $iClaudeCurrentTaskClass =
      iClaudeEffectiveTaskClass[OptionValue["TaskClass"]];  (* 04 Inc4: 会計帰属 *)
    modelSpec = iClaudeApplyTaskClassToModel[
      OptionValue["TaskClass"], OptionValue[Model]];
    If[FailureQ[modelSpec], Return[modelSpec, Module]];
    modelSpec = iResolveDefaultModelSpec[modelSpec];
    useFallback = TrueQ[OptionValue[Fallback]];
    nonBlock = TrueQ[OptionValue[NonBlocking]];
    (* Model \:304c {provider, model, ...} \:5f62\:5f0f\:3067\:660e\:793a\:6307\:5b9a\:3055\:308c\:3066\:3044\:308b\:304b *)
    hasExplicitModel = ListQ[modelSpec] && Length[modelSpec] >= 2 &&
      StringQ[modelSpec[[1]]] && StringQ[modelSpec[[2]]];
    providerLower = If[hasExplicitModel, ToLowerCase[modelSpec[[1]]], ""];
    modelName     = If[hasExplicitModel, modelSpec[[2]], ""];

    (* \:30eb\:30fc\:30c6\:30a3\:30f3\:30b0 \:8a2d\:8a08 (Phase 28, 2026-05-12):
       Imai \:5148\:751f\:306e\:30dd\:30ea\:30b7\:30fc:
       - Claude Code CLI \:7d4c\:7531 (provider="claudecode") \:306f Pro/Max \:30b5\:30d6\:30b9\:30af\:30ea\:30d7\:30b7\:30e7\:30f3\:5185\:306e\:305f\:3081\:8ab2\:91d1\:306a\:3057\:3002
         CLI \:306e --model \:30d5\:30e9\:30b0\:3067 modelSpec[[2]] \:3092\:6e21\:3057\:3066\:5b9f\:884c\:3059\:308b\:3002
       - LM Studio (provider="lmstudio") \:306f\:30ed\:30fc\:30ab\:30eb LLM \:306e\:305f\:3081\:8ab2\:91d1\:306a\:3057\:3002
         OpenAI \:4e92\:63db API \:3067\:30b5\:30fc\:30d0\:30fc\:306b\:9001\:3063\:3066\:5b9f\:884c\:3059\:308b\:3002
       - Anthropic API (provider="anthropic") / OpenAI API (provider="openai") \:306f\:8ab2\:91d1\:3042\:308a\:3002
         iClaudeQueryBgAPI \:5185\:90e8\:306e NBAccess \:30c1\:30a7\:30c3\:30af\:3092\:7d4c\:7531\:3057\:3001
         \:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:304c\:8ab2\:91d1 API \:7981\:6b62\:306a\:3089\:660e\:793a\:30a8\:30e9\:30fc\:3067\:505c\:6b62\:3059\:308b\:3002
       - Model \:6307\:5b9a\:306a\:3057 + Fallback->True \:306f Anthropic API \:7d4c\:7531 (\:65e7\:6319\:52d5)\:3002 *)
    Which[
      hasExplicitModel && providerLower === "claudecode",
        (* === Anthropic CLI \:7d4c\:7531\:3001\:8ab2\:91d1\:306a\:3057 === *)
        Block[{$ClaudeModel = modelName},
          If[nonBlock,
            iClaudeQueryRawNonBlocking[prompt, OptionValue[Timeout]],
            iClaudeQueryRaw[prompt]]],
      hasExplicitModel && providerLower === "lmstudio",
        (* === LM Studio (\:30ed\:30fc\:30ab\:30eb)\:3001\:8ab2\:91d1\:306a\:3057 === *)
        (* iClaudeQueryBgAPI \:306f provider-aware \:3067 lmstudio \:30eb\:30fc\:30c8\:3092\:6301\:3064\:304c\:3001
           NBAccess \:30c1\:30a7\:30c3\:30af\:306f Paid=False \:30e2\:30c7\:30eb\:306a\:3089\:30b9\:30ad\:30c3\:30d7\:3055\:308c\:308b\:3002 *)
        iClaudeQueryBgAPI[prompt, modelSpec, OptionValue[Timeout]],
      hasExplicitModel,
        (* === \:305d\:306e\:4ed6\:306e\:30d7\:30ed\:30d0\:30a4\:30c0 (anthropic / openai \:7b49\:8ab2\:91d1): \:5fc5\:305a API \:7d4c\:8def === *)
        iClaudeQueryBgAPI[prompt, modelSpec, OptionValue[Timeout]],
      useFallback,
        (* === Model \:6307\:5b9a\:306a\:3057 + Fallback->True: API \:7d4c\:8def (\:30c7\:30d5\:30a9\:30eb\:30c8 Anthropic) === *)
        iClaudeQueryBgAPI[prompt, modelSpec, OptionValue[Timeout]],
      nonBlock,
        (* === CLI \:7d4c\:8def NonBlocking === *)
        iClaudeQueryRawNonBlocking[prompt, OptionValue[Timeout]],
      True,
        (* === CLI \:7d4c\:8def \:540c\:671f === *)
        iClaudeQueryRaw[prompt]
    ]
  ];

(* API \:76f4\:63a5\:547c\:3073\:51fa\:3057: Fallback -> True \:6642\:306e\:307f\:4f7f\:7528\:3002
   v2026-05-12 (Phase 27): provider-aware \:5316\:3002
     - \:65e7\:7248\:306f modelSpec[[1]] (provider) \:3092\:7121\:8996\:3057\:5e38\:306b Anthropic API \:306b\:6295\:3052\:3066\:3044\:305f\:305f\:3081
       Model -> {"openai", "gpt-5.5"} \:3068\:6307\:5b9a\:3057\:3066\:3082 Anthropic \:306b\:8a72\:5f53\:30e2\:30c7\:30eb\:3092\:8a55\:4fa1\:3055\:305b\:3088\:3046\:3068\:3057\:3066
       "Error: model: gpt-5.5" \:304c\:8fd4\:3063\:3066\:304a\:308a\:3001LLM \:9078\:629e\:306e\:610f\:5473\:304c\:7834\:308c\:3066\:3044\:305f\:3002
     - \:4fee\:6b63\:5f8c: provider \:3054\:3068\:306b\:6b63\:3057\:3044 API \:30ad\:30fc\:30fbURL\:30fbBody \:5f62\:5f0f\:30fbHeader\:30fb\:5fdc\:7b54\:30d1\:30fc\:30b5\:3092\:9078\:3076\:3002
     - \:8ab2\:91d1 API \:7981\:6b62\:74b0\:5883 (NBProviderCanAccess False) \:306e\:5834\:5408\:306f\:660e\:793a\:30a8\:30e9\:30fc\:3092\:8fd4\:3057\:3066\:8a72\:5f53 API \:306b\:4e00\:5207\:8a73\:3093\:306a\:3044
       (Imai \:5148\:751f\:306e privacy boundary \:30dd\:30ea\:30b7\:30fc\:9075\:62e0)\:3002 *)
iClaudeQueryBgAPI[prompt_String, modelSpec_, timeoutSpec_] :=
  Module[{provider, model, apiKey, url, bodyBytes, req, timeout,
          accessLevel, canAccess, providerLower, targetNb, nbAllowed,
          preflight, preflightURL},
    timeout = timeoutSpec;
    If[timeout === Automatic || !NumericQ[timeout], timeout = $ClaudeTimeout];
    If[!NumericQ[timeout], timeout = 1200];

    (* \[HorizontalLine]\[HorizontalLine] provider / model \:89e3\:6c7a (Paid \:5224\:5b9a\:306e\:305f\:3081\:5148\:884c) \[HorizontalLine]\[HorizontalLine] *)
    provider = Which[
      (* \:660e\:793a\:6307\:5b9a: {"openai","gpt-5.5"} \:7b49 *)
      ListQ[modelSpec] && Length[modelSpec] >= 2 && StringQ[modelSpec[[1]]],
        modelSpec[[1]],
      (* $ClaudeModel \:304c\:30ea\:30b9\:30c8\:5f62\:5f0f *)
      ListQ[$ClaudeModel] && Length[$ClaudeModel] >= 2 && StringQ[$ClaudeModel[[1]]],
        $ClaudeModel[[1]],
      (* \:30c7\:30d5\:30a9\:30eb\:30c8: anthropic *)
      True,
        "anthropic"
    ];
    providerLower = ToLowerCase[provider];
    model = Which[
      ListQ[modelSpec] && Length[modelSpec] >= 2 && StringQ[modelSpec[[2]]],
        modelSpec[[2]],
      ListQ[$ClaudeModel] && Length[$ClaudeModel] >= 2 && StringQ[$ClaudeModel[[2]]],
        $ClaudeModel[[2]],
      StringQ[$ClaudeModel] && StringTrim[$ClaudeModel] =!= "",
        $ClaudeModel,
      (* Phase 28: $iModelSonnet \:306f tuple {provider, model} \:3068\:306a\:3063\:305f\:306e\:3067 [[2]] \:3092\:53d6\:308b *)
      ListQ[$iModelSonnet] && Length[$iModelSonnet] >= 2 && StringQ[$iModelSonnet[[2]]],
        $iModelSonnet[[2]],
      True,
        "claude-sonnet-4-6"
    ];

    (* Phase 4.7: external cloud API preflight before key lookup / network send. *)
    preflightURL = Which[
      ListQ[modelSpec] && Length[modelSpec] >= 3 && StringQ[modelSpec[[3]]],
        modelSpec[[3]],
      providerLower === "openai",
        "https://api.openai.com/v1/chat/completions",
      providerLower === "zai",
        $iZAIChatCompletionsURL,
      providerLower === "anthropic",
        "https://api.anthropic.com/v1/messages",
      True,
        Automatic];
    preflight = iCloudSendPreflightDecision[providerLower, prompt, preflightURL];
    If[Lookup[preflight, "Decision", "Deny"] =!= "Permit",
      Return[iCloudSendPreflightFailure[preflight]]];

    (* \[HorizontalLine]\[HorizontalLine] NBAccess \:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:8ab2\:91d1 API \:8a31\:53ef\:30c1\:30a7\:30c3\:30af (Phase 28 Paid \:30d5\:30e9\:30b0\:30d9\:30fc\:30b9) \[HorizontalLine]\[HorizontalLine]
       \:8a2d\:8a08\:610f\:56f3:
         - $ClaudeModelCapabilities[{provider,model}]["Paid"] === True \:306a\:3089
           NBAccess \:306e\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:8a31\:53ef\:3092\:78ba\:8a8d\:3057\:3001\:7981\:6b62\:306a\:3089\:660e\:793a\:30a8\:30e9\:30fc\:3067\:505c\:6b62\:3002
         - Paid === False (\:307e\:305f\:306f\:672a\:767b\:9332) \:306a\:3089\:30c1\:30a7\:30c3\:30af\:3092\:30b9\:30ad\:30c3\:30d7\:3002
           (LM Studio \:7b49\:306e\:30ed\:30fc\:30ab\:30eb LLM \:306f\:8ab2\:91d1\:306a\:3057\:306e\:305f\:3081\:7121\:6761\:4ef6\:8a31\:53ef)\:3002
         - \:672a\:767b\:9332\:30e2\:30c7\:30eb\:306e\:5834\:5408\:306f provider \:540d\:3067 fallback \:5224\:5b9a:
           anthropic / openai \:306f Paid\:3001\:305d\:308c\:4ee5\:5916\:306f Free \:3068\:307f\:306a\:3059\:3002 *)
    Module[{caps, capEntry, isPaid},
      caps = If[ValueQ[ClaudeDirectives`$ClaudeModelCapabilities] &&
                AssociationQ[ClaudeDirectives`$ClaudeModelCapabilities],
        ClaudeDirectives`$ClaudeModelCapabilities, <||>];
      capEntry = Lookup[caps, Key[{providerLower, model}], <||>];
      isPaid = Which[
        AssociationQ[capEntry] && KeyExistsQ[capEntry, "Paid"],
          TrueQ[capEntry["Paid"]],
        True,
          (* \:672a\:767b\:9332: provider \:540d\:3067 fallback (zai=z.ai \:3082\:8ab2\:91d1 API) *)
          MemberQ[{"anthropic", "openai", "zai"}, providerLower]
      ];
      If[isPaid,
        Module[{targetNb, nbAllowed},
          targetNb = Quiet[EvaluationNotebook[]];
          If[Head[targetNb] =!= NotebookObject,
            targetNb = Quiet[InputNotebook[]]];
          nbAllowed = TrueQ @ Quiet @ NBAccess`NBGetNotebookPaidAPIAllowed[targetNb];
          If[!nbAllowed,
            Return[
              "Error: \:3053\:306e\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:3067\:306f\:8ab2\:91d1 API \:547c\:3073\:51fa\:3057\:304c\:7981\:6b62\:3055\:308c\:3066\:3044\:307e\:3059 (NBAccess)\:3002\n" <>
              "\:8981\:6c42\:3055\:308c\:305f\:30e2\:30c7\:30eb: {" <> provider <> ", " <> model <> "} (Paid=True)\:3002\n" <>
              "\:30d1\:30ec\:30c3\:30c8\:306e\:300c\:8ab2\:91d1API\:300d\:30dc\:30bf\:30f3\:3067\:300c\:8a31\:53ef\:300d\:306b\:5207\:308a\:66ff\:3048\:308b\:304b\:3001\n" <>
              "NBAccess`NBSetNotebookPaidAPIAllowed[nb, True] \:3067\:8a31\:53ef\:3057\:3066\:304f\:3060\:3055\:3044\:3002\n" <>
              "\:307e\:305f\:306f\:540c\:7b49\:306e\:30e2\:30c7\:30eb\:3092 Anthropic CLI (provider=\"claudecode\") \:7d4c\:7531\:3067\:547c\:3073\:51fa\:3059\:3053\:3068\:3082\:691c\:8a0e\:3057\:3066\:304f\:3060\:3055\:3044\:3002\n" <>
              "(Phase 28: $ClaudeModelCapabilities \:306e Paid \:30d5\:30e9\:30b0\:3067\:5224\:5b9a)"
            ]]]
      ]
      (* else: Paid=False \:306a\:30e2\:30c7\:30eb\:306f NBAccess \:30c1\:30a7\:30c3\:30af\:30b9\:30ad\:30c3\:30d7 (\:7121\:6761\:4ef6\:8a31\:53ef) *)
    ];

    (* \[HorizontalLine]\[HorizontalLine] \:6a29\:9650\:30c1\:30a7\:30c3\:30af (\:8ab2\:91d1 API \:7981\:6b62\:74b0\:5883\:3067\:306e\:8aa4\:6295\:3052\:9632\:6b62) \[HorizontalLine]\[HorizontalLine]
       Imai \:5148\:751f\:306e $iProviderMaxAccessLevel \:8a2d\:5b9a (NBAccess.wl L869-875) \:3092\:5c0a\:91cd\:3059\:308b\:3002
       \:8ab2\:91d1 API \:5168\:9762\:7981\:6b62\:306e\:74b0\:5883\:3067\:306f anthropic / openai \:306e level \:304c 0 \:307e\:305f\:306f
       Missing[] \:306b\:8a2d\:5b9a\:3055\:308c\:3001NBProviderCanAccess \:304c False \:3092\:8fd4\:3059\:3002
       \:305d\:306e\:6642\:306f Anthropic \:3078\:306e\:8aa4\:6295\:3052\:3082\:5305\:3081\:3066\:6c7a\:3057\:3066\:884c\:308f\:306a\:3044\:3002 *)
    accessLevel = Quiet @ NBAccess`NBGetProviderMaxAccessLevel[providerLower];
    If[!NumericQ[accessLevel], accessLevel = 0.5];
    canAccess = TrueQ @ Quiet @ NBAccess`NBProviderCanAccess[providerLower, accessLevel];
    If[!canAccess,
      Return[
        "Error: \:30d7\:30ed\:30d0\:30a4\:30c0 '" <> provider <> "' \:306f\:5916\:90e8 API \:547c\:3073\:51fa\:3057\:6a29\:9650\:304c\:3042\:308a\:307e\:305b\:3093\:3002\n" <>
        "Provider MaxAccessLevel = " <> ToString[accessLevel] <> "\n" <>
        "\:8ab2\:91d1 API \:3092\:8a31\:53ef\:3059\:308b\:306b\:306f NBAccess`NBSetProviderMaxAccessLevel[\"" <> providerLower <>
        "\", 0.5] \:7b49\:3067\:8a2d\:5b9a\:3092\:5909\:66f4\:3057\:3001\n" <>
        "\:304b\:3064\:8a72\:5f53 SystemCredential \:304c\:8a2d\:5b9a\:3055\:308c\:3066\:3044\:308b\:5fc5\:8981\:304c\:3042\:308a\:307e\:3059\:3002"
      ]];

    (* \[HorizontalLine]\[HorizontalLine] API \:30ad\:30fc\:53d6\:5f97 (provider \:5225) \[HorizontalLine]\[HorizontalLine] *)
    apiKey = Which[
      providerLower === "lmstudio",
        iResolveLMStudioAPIKey[
          If[ListQ[modelSpec] && Length[modelSpec] >= 3 && StringQ[modelSpec[[3]]], modelSpec[[3]], ""]],
      True,
        Quiet[NBAccess`NBGetAPIKey[providerLower,
          PrivacySpec -> <|"AccessLevel" -> 1.0|>]]
    ];
    If[!StringQ[apiKey] || StringLength[apiKey] === 0,
      Return["Error: " <> provider <> " API \:30ad\:30fc\:3092\:53d6\:5f97\:3067\:304d\:307e\:305b\:3093\:3067\:3057\:305f\:3002\n" <>
             "SystemCredential \:306b API \:30ad\:30fc\:3092\:8a2d\:5b9a\:3057\:3066\:304f\:3060\:3055\:3044\:3002"]];

    (* \[HorizontalLine]\[HorizontalLine] \:30a8\:30f3\:30c9\:30dd\:30a4\:30f3\:30c8 URL (provider \:5225) \[HorizontalLine]\[HorizontalLine] *)
    url = Which[
      ListQ[modelSpec] && Length[modelSpec] >= 3 && StringQ[modelSpec[[3]]] && modelSpec[[3]] =!= "",
        If[providerLower === "openai" || providerLower === "zai" || providerLower === "lmstudio",
          iEnsureChatCompletionsPath[modelSpec[[3]]],
          modelSpec[[3]]],
      providerLower === "anthropic",
        "https://api.anthropic.com/v1/messages",
      providerLower === "openai",
        "https://api.openai.com/v1/chat/completions",
      providerLower === "zai",
        $iZAIChatCompletionsURL,
      providerLower === "lmstudio",
        "http://localhost:1234/v1/chat/completions",
      True,
        Return["Error: \:672a\:5bfe\:5fdc\:30d7\:30ed\:30d0\:30a4\:30c0: " <> provider]
    ];

    (* \[HorizontalLine]\[HorizontalLine] provider \:5225\:306b API \:547c\:3073\:51fa\:3057\:30c7\:30a3\:30b9\:30d1\:30c3\:30c1 \[HorizontalLine]\[HorizontalLine]
       OpenAI / LM Studio \:306f iQueryOpenAIAPI \:3092\:6d41\:7528\:3067\:304d\:308b (\:65e2\:5b58\:3001\:540c\:671f\:578b)\:3002
       Anthropic \:306f\:4ee5\:524d\:901a\:308a URLRead \:7d4c\:7531\:3067 ByteArray \:9001\:53d7\:4fe1\:3002 *)
    Which[
      providerLower === "openai" || providerLower === "zai" || providerLower === "lmstudio",
        Return @ iQueryOpenAIAPI[apiKey, model, prompt, url],
      providerLower === "anthropic",
        Null,  (* \:4ee5\:4e0b\:306e Anthropic \:8def\:7d50\:3092\:7d9a\:884c *)
      True,
        Return["Error: \:672a\:5bfe\:5fdc\:30d7\:30ed\:30d0\:30a4\:30c0: " <> provider]
    ];

    (* \[HorizontalLine]\[HorizontalLine] Anthropic \:7d4c\:8def: \:30ea\:30af\:30a8\:30b9\:30c8\:30dc\:30c7\:30a3 (SKILL \:6e96\:62e0: ByteArray \:3067\:9001\:4fe1) \[HorizontalLine]\[HorizontalLine] *)
    bodyBytes = Quiet @ Check[
      ExportByteArray[<|
        "model"      -> model,
        "max_tokens" -> 4096,
        "messages"   -> {<|"role" -> "user", "content" -> prompt|>}
      |>, "JSON", "Compact" -> True],
      $Failed];
    (* ExportByteArray \:304c\:4f7f\:3048\:306a\:3044 WL \:30d0\:30fc\:30b8\:30e7\:30f3\:7528\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af *)
    If[!ByteArrayQ[bodyBytes],
      bodyBytes = StringToByteArray[
        StringReplace[
          ExportString[<|
            "model"      -> model,
            "max_tokens" -> 4096,
            "messages"   -> {<|"role" -> "user", "content" -> prompt|>}
          |>, "JSON", "Compact" -> True],
          c : RegularExpression["[\\x80-\\x{FFFF}]"] :>
            "\\u" <> IntegerString[First[ToCharacterCode[c]], 16, 4]],
        "UTF-8"]];

    req = HTTPRequest[url,
      <|Method -> "POST",
        "Headers" -> {
          "x-api-key"         -> apiKey,
          "anthropic-version" -> "2023-06-01",
          "content-type"      -> "application/json"
        },
        "Body" -> bodyBytes|>];

    Module[{rb},
      rb = Quiet[TimeConstrained[URLRead[req, "BodyByteArray"], timeout, $Failed]];
      If[!ByteArrayQ[rb],
        Return["Error: API \:547c\:3073\:51fa\:3057\:306b\:5931\:6557\:3057\:307e\:3057\:305f (URLRead \:30bf\:30a4\:30e0\:30a2\:30a6\:30c8\:307e\:305f\:306f\:30cd\:30c3\:30c8\:30ef\:30fc\:30af\:30a8\:30e9\:30fc)\:3002"]];
      iParseAnthropicBgResponse[rb]]
  ];
(* \:30ea\:30b9\:30c8\:5165\:529b\:7248: {"\:8cea\:554f", Image[...], File["path"], ...}
   CLI \:30d1\:30b9: iClaudeQueryRaw \:304c iNormalizePrompt \:7d4c\:7531\:3067 Image/File \:3092\:51e6\:7406\:3002
   API \:30d1\:30b9: \:30de\:30eb\:30c1\:30e2\:30fc\:30c0\:30eb content \:914d\:5217\:3092\:69cb\:7bc9\:3057\:3066\:9001\:4fe1\:3002 *)
ClaudeQueryBg[items_List, opts:OptionsPattern[]] :=
  Module[{useFallback, nonBlock, hasMedia, modelSpec, hasExplicitModel},
    (* hardening 04 Inc2b: TaskClass 申告があればティア解決を経由 *)
    $iClaudeCurrentTaskClass =
      iClaudeEffectiveTaskClass[OptionValue["TaskClass"]];  (* 04 Inc4: 会計帰属 *)
    modelSpec = iClaudeApplyTaskClassToModel[
      OptionValue["TaskClass"], OptionValue[Model]];
    If[FailureQ[modelSpec], Return[modelSpec, Module]];
    modelSpec = iResolveDefaultModelSpec[modelSpec];
    useFallback = TrueQ[OptionValue[Fallback]];
    nonBlock = TrueQ[OptionValue[NonBlocking]];
    hasExplicitModel = ListQ[modelSpec] && Length[modelSpec] >= 2 &&
      StringQ[modelSpec[[1]]] && StringQ[modelSpec[[2]]];
    hasMedia = AnyTrue[items,
      (ImageQ[#] || MatchQ[#, File[_String]] ||
       (StringQ[#] && FileExistsQ[#] && iIsMediaFile[#])) &];
    If[!hasMedia,
      (* \:30e1\:30c7\:30a3\:30a2\:306a\:3057: \:5f93\:6765\:3069\:304a\:308a\:30c6\:30ad\:30b9\:30c8\:7d50\:5408 *)
      ClaudeQueryBg[StringJoin[Riffle[Select[items, StringQ], "\n"]], opts],
      (* \:30e1\:30c7\:30a3\:30a2\:3042\:308a: \:5358\:9805\:7248\:3068\:540c\:69d8\:306e\:30eb\:30fc\:30c6\:30a3\:30f3\:30b0 (Phase 27 v2) *)
      Which[
        hasExplicitModel,
          (* Model \:660e\:793a\:6307\:5b9a: \:5fc5\:305a multimodal API \:7d4c\:8def *)
          iClaudeQueryBgAPIMultimodal[items, modelSpec, OptionValue[Timeout]],
        useFallback,
          (* Fallback->True: multimodal API \:7d4c\:8def *)
          iClaudeQueryBgAPIMultimodal[items, modelSpec, OptionValue[Timeout]],
        nonBlock,
          iClaudeQueryRawNonBlocking[items, OptionValue[Timeout]],
        True,
          iClaudeQueryRaw[items]
      ]
    ]
  ];

(* Anthropic API \:30de\:30eb\:30c1\:30e2\:30fc\:30c0\:30eb\:547c\:3073\:51fa\:3057\:3002
   v2026-05-12 (Phase 27): provider-aware \:5316\:3002
     - \:8ab2\:91d1 API \:6a29\:9650\:30c1\:30a7\:30c3\:30af\:3092\:8ffd\:52a0\:3002
     - provider \:304c "anthropic" \:4ee5\:5916 (openai \:7b49) \:306e\:5834\:5408\:306f\:660e\:793a\:30a8\:30e9\:30fc\:3092\:8fd4\:3059
       (OpenAI \:306e multimodal API \:306f\:5f62\:5f0f\:304c\:5927\:304d\:304f\:7570\:306a\:308a image_url \:65b9\:5f0f\:306e\:305f\:3081\:5225\:9014\:5b9f\:88c5\:304c\:5fc5\:8981)\:3002 *)
iClaudeQueryBgAPIMultimodal[items_List, modelSpec_, timeoutSpec_] :=
  Module[{provider, providerLower, model, apiKey, url,
          contentBlocks = {}, bodyBytes, req, timeout,
          tmpDir, imgIdx = 0, accessLevel, canAccess, targetNb, nbAllowed,
          preflight},
    timeout = timeoutSpec;
    If[timeout === Automatic || !NumericQ[timeout], timeout = $ClaudeTimeout];
    If[!NumericQ[timeout], timeout = 1200];

    (* \[HorizontalLine]\[HorizontalLine] provider / model \:89e3\:6c7a (Phase 28: Paid \:5224\:5b9a\:306e\:305f\:3081\:5148\:884c) \[HorizontalLine]\[HorizontalLine] *)
    provider = Which[
      ListQ[modelSpec] && Length[modelSpec] >= 2 && StringQ[modelSpec[[1]]], modelSpec[[1]],
      ListQ[$ClaudeModel] && Length[$ClaudeModel] >= 2 && StringQ[$ClaudeModel[[1]]], $ClaudeModel[[1]],
      True, "anthropic"
    ];
    providerLower = ToLowerCase[provider];

    (* \[HorizontalLine]\[HorizontalLine] Phase 35 fix (2026-05-18): provider == "claudecode" \:306f CLI \:7d4c\:8def\:3078\:30ea\:30c0\:30a4\:30ec\:30af\:30c8 \[HorizontalLine]\[HorizontalLine]
       claudecode CLI (Anthropic Pro/Max \:30b5\:30d6\:30b9\:30af\:30ea\:30d7\:30b7\:30e7\:30f3) \:306f Claude Code \:30b7\:30b9\:30c6\:30e0\:7d4c\:7531\:3067
       \:30d7\:30ed\:30f3\:30d7\:30c8\:5185\:306e\:753b\:50cf\:30d5\:30a1\:30a4\:30eb\:53c2\:7167\:3092\:81ea\:52d5\:8a8d\:8b58\:3057 vision \:51e6\:7406\:3059\:308b\:3002
       iNormalizePrompt[items_List] \:304c\:65e2\:306b\:6b21\:306e\:51e6\:7406\:3092\:884c\:3046:
         1. Mathematica Image \:30aa\:30d6\:30b8\:30a7\:30af\:30c8\:3092 tmp dir \:306b PNG \:3068\:3057\:3066\:66f8\:304d\:51fa\:3057
         2. prompt text \:306b\:300c\:6dfb\:4ed8\:30d5\:30a1\:30a4\:30eb: <path>\:300d\:3068\:3057\:3066\:57cb\:3081\:8fbc\:307f
         3. imageDirs \:3092 --add-dir \:7d4c\:7531\:3067 CLI \:306b\:6e21\:3059
       \:3088\:3063\:3066\:3001API \:30ad\:30fc\:6709\:7121\:306b\:95a2\:308f\:3089\:305a Claude Code \:306e Pro/Max \:7531\:6765\:306e API \:30af\:30ec\:30b8\:30c3\:30c8\:3067
       OCR / image \:8cea\:554f\:5fdc\:7b54\:304c\:53ef\:80fd\:3002 *)
    If[providerLower === "claudecode",
      Return[iClaudeQueryRawNonBlocking[items, timeoutSpec]]];

    (* Phase 4.7: external cloud API preflight for multimodal payloads. *)
    preflight = iCloudSendPreflightDecision[
      providerLower, items,
      If[providerLower === "anthropic",
        "https://api.anthropic.com/v1/messages", Automatic]];
    If[Lookup[preflight, "Decision", "Deny"] =!= "Permit",
      Return[iCloudSendPreflightFailure[preflight]]];

    (* multimodal \:306f\:73fe\:6642\:70b9 Anthropic \:306e\:307f\:5bfe\:5fdc *)
    If[providerLower =!= "anthropic",
      Return[
        "Error: multimodal API \:306f\:73fe\:5728 Anthropic \:307e\:305f\:306f Claude Code CLI (provider 'claudecode') \:306e\:307f\:5bfe\:5fdc\:3057\:3066\:3044\:307e\:3059\:3002\n" <>
        "\:8a73\:7d30: provider '" <> provider <> "' \:306e multimodal API \:5f62\:5f0f (\:4f8b: OpenAI \:306f image_url \:65b9\:5f0f) \:306f\n" <>
        "iClaudeQueryBgAPIMultimodal \:3067\:306f\:30b5\:30dd\:30fc\:30c8\:3055\:308c\:3066\:3044\:307e\:305b\:3093\:3002"
      ]];

    model = Which[
      ListQ[modelSpec] && Length[modelSpec] >= 2 && StringQ[modelSpec[[2]]], modelSpec[[2]],
      ListQ[$ClaudeModel] && Length[$ClaudeModel] >= 2 && StringQ[$ClaudeModel[[2]]], $ClaudeModel[[2]],
      StringQ[$ClaudeModel] && StringTrim[$ClaudeModel] =!= "", $ClaudeModel,
      (* Phase 28: $iModelSonnet \:306f tuple {provider, model} \:306a\:306e\:3067 [[2]] \:3092\:53d6\:308b *)
      ListQ[$iModelSonnet] && Length[$iModelSonnet] >= 2 && StringQ[$iModelSonnet[[2]]], $iModelSonnet[[2]],
      True, "claude-sonnet-4-6"];

    (* \[HorizontalLine]\[HorizontalLine] NBAccess \:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:8ab2\:91d1 API \:30c1\:30a7\:30c3\:30af (Phase 28 Paid \:30d5\:30e9\:30b0\:30d9\:30fc\:30b9) \[HorizontalLine]\[HorizontalLine]
       multimodal \:306f anthropic only \:306a\:306e\:3067 \:5b9f\:8cea\:5e38\:306b Paid=True\:3002 *)
    Module[{caps, capEntry, isPaid},
      caps = If[ValueQ[ClaudeDirectives`$ClaudeModelCapabilities] &&
                AssociationQ[ClaudeDirectives`$ClaudeModelCapabilities],
        ClaudeDirectives`$ClaudeModelCapabilities, <||>];
      capEntry = Lookup[caps, Key[{providerLower, model}], <||>];
      isPaid = Which[
        AssociationQ[capEntry] && KeyExistsQ[capEntry, "Paid"],
          TrueQ[capEntry["Paid"]],
        True,
          MemberQ[{"anthropic", "openai"}, providerLower]
      ];
      If[isPaid,
        Module[{targetNb, nbAllowed},
          targetNb = Quiet[EvaluationNotebook[]];
          If[Head[targetNb] =!= NotebookObject,
            targetNb = Quiet[InputNotebook[]]];
          nbAllowed = TrueQ @ Quiet @ NBAccess`NBGetNotebookPaidAPIAllowed[targetNb];
          If[!nbAllowed,
            Return[
              "Error: \:3053\:306e\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:3067\:306f\:8ab2\:91d1 API \:547c\:3073\:51fa\:3057\:304c\:7981\:6b62\:3055\:308c\:3066\:3044\:307e\:3059 (NBAccess)\:3002\n" <>
              "\:8981\:6c42\:3055\:308c\:305f\:30e2\:30c7\:30eb: {" <> provider <> ", " <> model <> "} (multimodal, Paid=True)\:3002\n" <>
              "\:30d1\:30ec\:30c3\:30c8\:306e\:300c\:8ab2\:91d1API\:300d\:30dc\:30bf\:30f3\:3067\:300c\:8a31\:53ef\:300d\:306b\:5207\:308a\:66ff\:3048\:308b\:304b\:3001\n" <>
              "NBAccess`NBSetNotebookPaidAPIAllowed[nb, True] \:3067\:8a31\:53ef\:3057\:3066\:304f\:3060\:3055\:3044\:3002"
            ]]]
      ]
    ];

    (* \[HorizontalLine]\[HorizontalLine] \:6a29\:9650\:30c1\:30a7\:30c3\:30af (\:65e7\:6765\:306e provider-level access check\, \:65e2\:5b58) \[HorizontalLine]\[HorizontalLine] *)
    accessLevel = Quiet @ NBAccess`NBGetProviderMaxAccessLevel[providerLower];
    If[!NumericQ[accessLevel], accessLevel = 0.5];
    canAccess = TrueQ @ Quiet @ NBAccess`NBProviderCanAccess[providerLower, accessLevel];
    If[!canAccess,
      Return[
        "Error: \:30d7\:30ed\:30d0\:30a4\:30c0 '" <> provider <> "' \:306f\:5916\:90e8 API \:547c\:3073\:51fa\:3057\:6a29\:9650\:304c\:3042\:308a\:307e\:305b\:3093\:3002"]];

    apiKey = Quiet[NBAccess`NBGetAPIKey["anthropic",
      PrivacySpec -> <|"AccessLevel" -> 1.0|>]];
    If[!StringQ[apiKey] || StringLength[apiKey] === 0,
      Return["Error: Anthropic API \:30ad\:30fc\:3092\:53d6\:5f97\:3067\:304d\:307e\:305b\:3093\:3067\:3057\:305f\:3002"]];
    url = If[ListQ[modelSpec] && Length[modelSpec] >= 3 && StringQ[modelSpec[[3]]],
      modelSpec[[3]], "https://api.anthropic.com/v1/messages"];
    tmpDir = FileNameJoin[{$ClaudeWorkingDirectory,
      "claude_mm_" <> ToString[UnixTime[]]}];
    (* content \:914d\:5217\:3092\:69cb\:7bc9 *)
    Scan[Function[item, Which[
      StringQ[item] && (!FileExistsQ[item] || !iIsMediaFile[item]),
        AppendTo[contentBlocks,
          <|"type" -> "text", "text" -> item|>],
      ImageQ[item],
        imgIdx++;
        If[!DirectoryQ[tmpDir], CreateDirectory[tmpDir]];
        With[{f = FileNameJoin[{tmpDir, "img_" <> ToString[imgIdx] <> ".png"}]},
          Export[f, ImageResize[item, {Min[ImageDimensions[item][[1]], 1568]}], "PNG"];
          With[{b64 = BaseEncode[ReadByteArray[f]]},
            AppendTo[contentBlocks,
              <|"type" -> "image",
                "source" -> <|"type" -> "base64",
                  "media_type" -> "image/png", "data" -> b64|>|>]]],
      MatchQ[item, File[_String]] && FileExistsQ[item[[1]]] &&
        iIsImageMediaType[iMediaTypeForExt[FileExtension[item[[1]]]]],
        With[{b64 = BaseEncode[ReadByteArray[item[[1]]]],
              mt = iMediaTypeForExt[FileExtension[item[[1]]]]},
          AppendTo[contentBlocks,
            <|"type" -> "image",
              "source" -> <|"type" -> "base64",
                "media_type" -> mt, "data" -> b64|>|>]],
      StringQ[item] && FileExistsQ[item] && iIsMediaFile[item] &&
        iIsImageMediaType[iMediaTypeForExt[FileExtension[item]]],
        With[{b64 = BaseEncode[ReadByteArray[item]],
              mt = iMediaTypeForExt[FileExtension[item]]},
          AppendTo[contentBlocks,
            <|"type" -> "image",
              "source" -> <|"type" -> "base64",
                "media_type" -> mt, "data" -> b64|>|>]],
      True,
        AppendTo[contentBlocks,
          <|"type" -> "text", "text" -> ToString[item]|>]
    ]], items];
    If[DirectoryQ[tmpDir], Quiet[DeleteDirectory[tmpDir, DeleteContents -> True]]];
    bodyBytes = Quiet @ Check[
      ExportByteArray[<|
        "model" -> model, "max_tokens" -> 4096,
        "messages" -> {<|"role" -> "user", "content" -> contentBlocks|>}
      |>, "JSON", "Compact" -> True], $Failed];
    If[!ByteArrayQ[bodyBytes], Return["Error: JSON \:69cb\:7bc9\:5931\:6557"]];
    req = HTTPRequest[url,
      <|Method -> "POST",
        "Headers" -> {
          "x-api-key" -> apiKey,
          "anthropic-version" -> "2023-06-01",
          "content-type" -> "application/json"},
        "Body" -> bodyBytes|>];
    Module[{rb},
      rb = Quiet[TimeConstrained[URLRead[req, "BodyByteArray"], timeout, $Failed]];
      If[!ByteArrayQ[rb],
        Return["Error: API \:547c\:3073\:51fa\:3057\:5931\:6557"]];
      iParseAnthropicBgResponse[rb]]
  ];
(* Anthropic \:30ec\:30b9\:30dd\:30f3\:30b9 JSON \[RightArrow] \:30c6\:30ad\:30b9\:30c8\:6587\:5b57\:5217 *)

(* ByteArray \:76f4\:63a5\:7248 (SKILL \:6e96\:62e0: ImportByteArray["RawJSON"] \:3067\:5909\:63db\:306a\:3057\:30d1\:30fc\:30b9) *)
iParseAnthropicBgResponse[rb_ByteArray] :=
  Module[{parsed, str},
    (* ImportByteArray["RawJSON"] \:3067 ByteArray \:3092\:76f4\:63a5 JSON \:30d1\:30fc\:30b9\:3002
       ByteArrayToString \:3092\:7d4c\:7531\:3057\:306a\:3044\:305f\:3081 Windows \:306e\:6697\:9ed9\:5909\:63db\:304c\:5165\:3089\:306a\:3044\:3002 *)
    parsed = Quiet @ Check[ImportByteArray[rb, "RawJSON"], $Failed];
    If[parsed === $Failed,
      (* \:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af: \:660e\:793a\:7684 UTF-8 \:30c7\:30b3\:30fc\:30c9\:5f8c\:306b\:6587\:5b57\:5217\:7248\:3092\:8a66\:307f\:308b *)
      str = Quiet @ Check[ByteArrayToString[rb, "UTF-8"], $Failed];
      If[StringQ[str], Return[iParseAnthropicBgResponse[str]]];
      Return["Error: JSON \:89e3\:6790\:5931\:6557 (ByteArray)"]];
    iParseAnthropicBgResponse[parsed]  (* Association \:3092\:6587\:5b57\:5217\:7248\:3067\:51e6\:7406 *)
  ];

(* Association \:76f4\:63a5\:7248: ImportByteArray \:306e\:7d50\:679c\:3092\:53d7\:3051\:53d6\:308a text \:3092\:62bd\:51fa *)
iParseAnthropicBgResponse[parsed_Association] :=
  Module[{content, errData},
    If[KeyExistsQ[parsed, "error"],
      errData = parsed["error"];
      If[ListQ[errData] && !AssociationQ[errData], errData = Association[errData]];
      Return["Error: " <> If[AssociationQ[errData],
        Lookup[errData, "message", ToString[errData]],
        ToString[errData]]]];
    content = Lookup[parsed, "content", {}];
    If[!ListQ[content] || Length[content] === 0,
      Return["Error: \:30ec\:30b9\:30dd\:30f3\:30b9\:306b content \:30d5\:30a3\:30fc\:30eb\:30c9\:304c\:3042\:308a\:307e\:305b\:3093\:3002"]];
    StringJoin[Map[Function[b,
      If[AssociationQ[b] && Lookup[b, "type", ""] === "text",
        Lookup[b, "text", ""], ""]],
      content]]
  ];

(* String \:7248: ByteArrayToString \:7d4c\:7531\:306e\:65e7\:30d1\:30b9 (\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:7528) *)
iParseAnthropicBgResponse[respStr_String] :=
  Module[{parsed, content, errData},
    (* Developer`ReadRawJSONString (WL 11.1+) \:306f 
, \\, \u \:7b49\:306e JSON \:30a8\:30b9\:30b1\:30fc\:30d7\:3092
       \:6b63\:3057\:304f\:51e6\:7406\:3067\:304d\:308b\:3002ImportString["JSON"] \:306f\:3053\:308c\:3089\:3067\:5931\:6557\:3059\:308b\:30b1\:30fc\:30b9\:304c\:3042\:308b\:3002 *)
    parsed = Quiet @ Check[Developer`ReadRawJSONString[respStr], $Failed];
    If[parsed === $Failed,
      parsed = Quiet @ Check[ImportString[respStr, "RawJSON"], $Failed]];
    If[parsed === $Failed,
      parsed = Quiet @ Check[ImportString[respStr, "JSON"], $Failed]];
    If[ListQ[parsed] && !AssociationQ[parsed], parsed = Association[parsed]];
    If[!AssociationQ[parsed],
      Return["Error: JSON \:89e3\:6790\:5931\:6557: " <>
             StringTake[respStr, Min[200, StringLength[respStr]]]]];
    (* \:30a8\:30e9\:30fc\:30ec\:30b9\:30dd\:30f3\:30b9 *)
    If[KeyExistsQ[parsed, "error"],
      errData = parsed["error"];
      If[ListQ[errData] && !AssociationQ[errData], errData = Association[errData]];
      Return["Error: " <> If[AssociationQ[errData],
        Lookup[errData, "message", ToString[errData]],
        ToString[errData]]]];
    (* \:6210\:529f: content[0].text \:3092\:9023\:7d50 *)
    content = Lookup[parsed, "content", {}];
    If[!ListQ[content] || Length[content] === 0,
      Return["Error: \:30ec\:30b9\:30dd\:30f3\:30b9\:306b content \:30d5\:30a3\:30fc\:30eb\:30c9\:304c\:3042\:308a\:307e\:305b\:3093\:3002"]];
    StringJoin[Map[Function[b,
      Module[{ba = If[ListQ[b] && !AssociationQ[b], Association[b], b]},
        If[AssociationQ[ba] && Lookup[ba, "type", ""] === "text",
          Lookup[ba, "text", ""], ""]]],
      content]]
  ];

Options[ClaudeWriteResponse] = {AutoEvaluate -> False};
ClaudeWriteResponse[nb_NotebookObject, text_String, opts:OptionsPattern[]] :=
  iWriteQueryResponse[nb, text, TrueQ[OptionValue[AutoEvaluate]]];

(* ============================================================
   ClaudeQueryAsync: \:975e\:540c\:671f LLM \:30af\:30a8\:30ea\:ff08\:30ab\:30fc\:30cd\:30eb\:975e\:30d6\:30ed\:30c3\:30af\:ff09
   \:5b8c\:4e86\:6642\:306b callback[\:5fdc\:7b54\:6587\:5b57\:5217] \:3092\:547c\:3076\:3002
   iClaudeQueryImpl \:3068\:5b8c\:5168\:306b\:540c\:3058\:975e\:540c\:671f\:30d1\:30b9\:3092\:4f7f\:7528:
   - Job \:30b7\:30b9\:30c6\:30e0 (NBBeginJobAtEvalCell) \:3067\:9032\:6357\:7ba1\:7406
   - iClaudeQueryAsyncWithProgress / iStartFallbackAsync \:3067\:975e\:540c\:671f\:5b9f\:884c
   nb \:5f15\:6570\:3092\:5fc5\:305a\:6307\:5b9a\:3059\:308b\:3053\:3068\:ff08\:30d1\:30ec\:30c3\:30c8\:304b\:3089\:306f iDocUserNotebook[] \:7b49\:3067\:89e3\:6c7a\:6e08\:307f\:306e nb\:ff09\:3002
   ============================================================ *)
Options[ClaudeQueryAsync] = {
  Fallback -> False,
  Model -> Automatic,
  PrivacyLevel -> Automatic,
  Timeout -> Automatic,
  Integrations -> Automatic,
  AutoCellize -> True,
  "TaskClass" -> Automatic   (* hardening 04 Inc2b *)
};

ClaudeQueryAsync[prompt_String, callback_, nb_NotebookObject, opts:OptionsPattern[]] :=
  Block[{$iLMStudioIntegrationsOverride =
      With[{ig = OptionValue[Integrations]},
        If[ListQ[ig] && Length[ig] > 0, ig, $iLMStudioIntegrationsOverride]]},
  Module[{modelSpec, privLevel, useFallback, availModels, useClaudeCode,
          jobId, wrappedCallback, accessLevel, norm, hasMedia, mediaFiles,
          autoCellize},
    (* hardening 04 Inc2b: TaskClass 申告があればティア解決を経由 *)
    $iClaudeCurrentTaskClass =
      iClaudeEffectiveTaskClass[OptionValue["TaskClass"]];  (* 04 Inc4: 会計帰属 *)
    modelSpec = iClaudeApplyTaskClassToModel[
      OptionValue["TaskClass"], OptionValue[Model]];
    If[FailureQ[modelSpec], Return[modelSpec, Module]];
    modelSpec = iResolveDefaultModelSpec[modelSpec];
    autoCellize = TrueQ[OptionValue[AutoCellize]];
    privLevel = Replace[OptionValue[PrivacyLevel], Automatic -> 0.0];
    useFallback = TrueQ[OptionValue[Fallback]];
    accessLevel = If[privLevel > 0, privLevel, 0.5];

    (* === \:30b0\:30ed\:30fc\:30d0\:30eb\:72b6\:614b\:8a2d\:5b9a: ClaudeQuery \:3068\:540c\:3058 === *)
    $currentUseFallback = useFallback;
    $iAllowReadTool = False;
    $iAllowWebSearch = False;
    (* \:30bb\:30c3\:30b7\:30e7\:30f3\:306e\:30a2\:30bf\:30c3\:30c1\:30e1\:30f3\:30c8\:3092\:30ed\:30fc\:30c9: iInjectAttachments \:304c\:4f7f\:7528\:3059\:308b *)
    $iCurrentSessionAttachments = iGetResolvedAttachments[nb, iSessionTag[]];

    (* === \:30e1\:30c7\:30a3\:30a2\:30d5\:30a1\:30a4\:30eb\:691c\:51fa ===
       PDF/\:753b\:50cf\:7b49\:304c\:30a2\:30bf\:30c3\:30c1\:3055\:308c\:3066\:3044\:308b\:5834\:5408:
       - \:8ab2\:91d1API\:8a31\:53ef (useFallback=True): Anthropic API \:3067\:30de\:30eb\:30c1\:30e2\:30fc\:30c0\:30eb\:9001\:4fe1
       - \:8ab2\:91d1API\:7981\:6b62 (useFallback=False): CLI \:30d1\:30b9\:3067\:51e6\:7406\:ff08\:30c4\:30fc\:30eb\:627f\:8a8d\:304c\:5fc5\:8981\:306b\:306a\:308b\:5834\:5408\:3042\:308a\:ff09 *)
    norm = iNormalizePrompt[iInjectAttachments[prompt]];
    mediaFiles = If[ListQ[norm["mediaFiles"]], norm["mediaFiles"], {}];
    hasMedia = Length[mediaFiles] > 0 && useFallback;

    (* === \:30e2\:30c7\:30eb\:30eb\:30fc\:30c6\:30a3\:30f3\:30b0 === *)
    If[modelSpec === Automatic,
      Which[
        (* \:30e1\:30c7\:30a3\:30a2\:30d5\:30a1\:30a4\:30eb\:3042\:308a + \:8ab2\:91d1API\:8a31\:53ef: Anthropic API \:5fc5\:9808\:ff08\:30de\:30eb\:30c1\:30e2\:30fc\:30c0\:30eb PDF \:5bfe\:5fdc\:ff09 *)
