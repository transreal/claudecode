(* \:540c\:671f LLM \:30af\:30a8\:30ea\:ff08WindowStatusArea \:7d4c\:904e\:6642\:9593\:8868\:793a\:4ed8\:304d\:ff09\:3002
   \:4ed6\:30d1\:30c3\:30b1\:30fc\:30b8 (documentation.wl \:7b49) \:304b\:3089\:306e\:8efd\:91cf LLM \:547c\:3073\:51fa\:3057\:7528\:3002
   \:30bb\:30c3\:30b7\:30e7\:30f3\:5c65\:6b74\:3084\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:66f8\:304d\:8fbc\:307f\:306f\:884c\:308f\:306a\:3044\:3002
   
   \:30e2\:30c7\:30eb\:30eb\:30fc\:30c6\:30a3\:30f3\:30b0\:ff08\:552f\:4e00\:306e\:30b3\:30a2\:ff09:
     Model \:304c\:660e\:793a\:6307\:5b9a \:2192 \:305d\:306e\:30e2\:30c7\:30eb\:3092 API \:7d4c\:7531\:3067\:4f7f\:7528
     Model === Automatic:
       PrivacyLevel <= 0.5 \:2192 Claude Code CLI (+ Fallback \:3067 API)
       PrivacyLevel >  0.5 \:2192 $ClaudePrivateModel \:3092\:81ea\:52d5\:4f7f\:7528
   \:623b\:308a\:5024: \:5fdc\:7b54\:6587\:5b57\:5217\:3002 *)
ClaudeQuerySync[prompt_String, opts:OptionsPattern[]] :=
  Module[{modelSpec, response, nb, startTime, progressTask, label, elapsed,
          privLevel, useFallback},
    modelSpec = OptionValue[Model];
    privLevel = Replace[OptionValue[PrivacyLevel], Automatic -> 0.0];
    useFallback = TrueQ[OptionValue[Fallback]];

    (* === \:30e2\:30c7\:30eb\:30eb\:30fc\:30c6\:30a3\:30f3\:30b0\:ff08\:30b3\:30a2\:30fb\:552f\:4e00\:306e\:5834\:6240\:ff09 === *)
    If[modelSpec === Automatic,
      Which[
        (* \:30af\:30e9\:30a6\:30c9\:53ef\:80fd *)
        privLevel <= 0.5,
          Null,  (* modelSpec \:306f Automatic \:306e\:307e\:307e \:2192 iQueryWithFallback \:304c\:51e6\:7406 *)
        (* \:79d8\:5bc6\:30bb\:30eb: $ClaudePrivateModel \:3092\:81ea\:52d5\:4f7f\:7528 *)
        ListQ[$ClaudePrivateModel] && Length[$ClaudePrivateModel] >= 2,
          modelSpec = $ClaudePrivateModel,
        (* $ClaudePrivateModel \:672a\:8a2d\:5b9a: \:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:30e2\:30c7\:30eb\:3092\:691c\:7d22 *)
        useFallback,
          Module[{avail = NBAccess`NBGetAvailableFallbackModels[privLevel]},
            If[Length[avail] > 0,
              modelSpec = First[avail],
              Return[iL["Error: PrivacyLevel " <> ToString[privLevel] <>
                " \:306b\:5bfe\:5fdc\:3059\:308b\:30e2\:30c7\:30eb\:304c\:3042\:308a\:307e\:305b\:3093\:3002",
                "Error: No model available for PrivacyLevel " <> ToString[privLevel] <> "."]]]],
        (* \:3069\:308c\:306b\:3082\:8a72\:5f53\:3057\:306a\:3044 *)
        True,
          Return[iL["Error: \:79d8\:5bc6\:30bb\:30eb\:306e\:51e6\:7406\:306b\:306f $ClaudePrivateModel \:307e\:305f\:306f Fallback \:304c\:5fc5\:8981\:3067\:3059\:3002",
            "Error: $ClaudePrivateModel or Fallback required for confidential cells."]]
      ]];

    (* \:9032\:6357\:8868\:793a\:7528\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:3092\:53d6\:5f97 *)
    nb = Quiet[InputNotebook[]];
    If[Head[nb] =!= NotebookObject, nb = Quiet[EvaluationNotebook[]]];
    startTime = AbsoluteTime[];

    (* \:8868\:793a\:30e9\:30d9\:30eb *)
    label = Which[
      ListQ[modelSpec] && Length[modelSpec] >= 2,
        modelSpec[[1]] <> "/" <> modelSpec[[2]],
      True,
        "Claude"
    ];

    (* WindowStatusArea \:7d4c\:904e\:6642\:9593\:8868\:793a\:30bf\:30b9\:30af\:3092\:958b\:59cb *)
    If[Head[nb] === NotebookObject,
      Quiet[CurrentValue[nb, WindowStatusArea] =
        label <> " " <> iL["\:306b\:554f\:3044\:5408\:308f\:305b\:4e2d... 0s", "querying... 0s"]];
      progressTask = CreateScheduledTask[
        With[{pNb = nb, t0 = startTime, lbl = label},
          Module[{e = Round[AbsoluteTime[] - t0, 1]},
            Quiet[CurrentValue[pNb, WindowStatusArea] =
              lbl <> " " <> iL["\:306b\:554f\:3044\:5408\:308f\:305b\:4e2d... ", "querying... "] <> ToString[e] <> "s"]]],
        1];
      Quiet[StartScheduledTask[progressTask]],
      progressTask = None];

    (* LLM \:547c\:3073\:51fa\:3057\:672c\:4f53 *)
    response = If[modelSpec =!= Automatic && ListQ[modelSpec] && Length[modelSpec] >= 2,
      (* \:660e\:793a\:30e2\:30c7\:30eb\:6307\:5b9a (or \:81ea\:52d5\:89e3\:6c7a\:6e08\:307f $ClaudePrivateModel): API \:7d4c\:7531 *)
      iQueryViaAPI[
        modelSpec[[1]], modelSpec[[2]], prompt,
        If[Length[modelSpec] >= 3, modelSpec[[3]], ""]],
      (* Automatic: Claude Code CLI + \:30aa\:30d7\:30b7\:30e7\:30ca\:30eb\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af *)
      iQueryWithFallback[prompt, useFallback]
    ];

    (* \:9032\:6357\:8868\:793a\:3092\:505c\:6b62\:30fb\:30af\:30ea\:30a2 *)
    If[progressTask =!= None,
      Quiet[StopScheduledTask[progressTask]];
      Quiet[RemoveScheduledTask[progressTask]]];
    If[Head[nb] === NotebookObject,
      elapsed = Round[AbsoluteTime[] - startTime, 1];
      Quiet[CurrentValue[nb, WindowStatusArea] =
        label <> " " <> iL["\:5b8c\:4e86 ", "done "] <> ToString[elapsed] <> "s"];
      RunScheduledTask[
        With[{pNb = nb},
          Quiet[CurrentValue[pNb, WindowStatusArea] = ""]],
        {2}]];

    response
  ];


(* ============================================================
   ClaudeQueryBg: FrontEnd 操作なし・同期クエリ
   ── Fallback に応じたルーティング ──────────────────────
   Fallback -> False (デフォルト):
     - Claude Code CLI を RunProcess で同期呼び出し (iClaudeQueryRaw)
     - 課金API不使用。Claude Code のサブスクリプション範囲内。
     - ScheduledTask/SocketListen 内でも RunProcess は安全。
   Fallback -> True:
     - URLRead で Anthropic API を直接呼ぶ (課金あり)
     - Claude Code CLI が利用不可な場合のフォールバック
   用途:
     - SocketListen ハンドラ内からの LLM 呼び出し
     - ScheduledTask コールバック内からの LLM 呼び出し
     - FrontEnd なし環境 (WolframScript 等) での LLM 呼び出し
   ============================================================ *)
Options[ClaudeQueryBg] = {
  Fallback -> False,
  Model    -> Automatic,
  Timeout  -> Automatic,
  NonBlocking -> False
};

ClaudeQueryBg[prompt_String, opts:OptionsPattern[]] :=
  Module[{useFallback = TrueQ[OptionValue[Fallback]],
          nonBlock = TrueQ[OptionValue[NonBlocking]]},
    If[!useFallback,
      (* === Fallback -> False: Claude Code CLI 経由 (課金なし) === *)
      If[nonBlock,
        (* NonBlocking: StartProcess + Pause ポーリング。
           フロントエンドをロックしない。トップレベル評価専用。 *)
        iClaudeQueryRawNonBlocking[prompt, OptionValue[Timeout]],
        (* 通常: RunProcess で同期呼び出し。
           ScheduledTask/SocketListen 内でも安全。 *)
        iClaudeQueryRaw[prompt]],
      (* === Fallback -> True: Anthropic API 直接呼び出し (課金あり) === *)
      iClaudeQueryBgAPI[prompt, OptionValue[Model], OptionValue[Timeout]]
    ]
  ];

(* Anthropic API 直接呼び出し: Fallback -> True 時のみ使用 *)
iClaudeQueryBgAPI[prompt_String, modelSpec_, timeoutSpec_] :=
  Module[{model, apiKey, url, bodyBytes, req, timeout},
    timeout = timeoutSpec;
    If[timeout === Automatic || !NumericQ[timeout], timeout = $ClaudeTimeout];
    If[!NumericQ[timeout], timeout = 1200];

    (* ── モデル解決 ── *)
    model = Which[
      (* 明示指定: {"anthropic","claude-sonnet-4-6"} *)
      ListQ[modelSpec] && Length[modelSpec] >= 2,
        modelSpec[[2]],
      (* $ClaudeModel が設定済み *)
      StringQ[$ClaudeModel] && StringTrim[$ClaudeModel] =!= "",
        $ClaudeModel,
      (* デフォルト *)
      True,
        $iModelSonnet
    ];

    (* ── APIキー取得 ──
       NBGetAPIKey は AccessLevel >= 1.0 が必要。
       この 1.0 は「認証情報ストアへのアクセス権」であり
       claudecode 内部でのみ使用する (MathWebServer 等から隠蔽)。 *)
    apiKey = Quiet[NBAccess`NBGetAPIKey["anthropic",
      PrivacySpec -> <|"AccessLevel" -> 1.0|>]];
    If[!StringQ[apiKey] || StringLength[apiKey] === 0,
      Return["Error: Anthropic API \:30ad\:30fc\:3092\:53d6\:5f97\:3067\:304d\:307e\:305b\:3093\:3067\:3057\:305f\:3002\n" <>
             "SystemCredential[\"ANTHROPIC_API_KEY\"] \:3092\:8a2d\:5b9a\:3057\:3066\:304f\:3060\:3055\:3044\:3002"]];

    (* ── エンドポイント URL ── *)
    url = If[ListQ[modelSpec] && Length[modelSpec] >= 3 && StringQ[modelSpec[[3]]] && modelSpec[[3]] =!= "",
      modelSpec[[3]],
      "https://api.anthropic.com/v1/messages"];

    (* ── リクエストボディ (SKILL 準拠: ByteArray で送信) ──
       ExportString["JSON"] を String で Body に渡すと Windows で
       暗黙エンコーディング変換が入り日本語が文字化けする。
       ExportByteArray["JSON"] で UTF-8 ByteArray として送信する。 *)
    bodyBytes = Quiet @ Check[
      ExportByteArray[<|
        "model"      -> model,
        "max_tokens" -> 4096,
        "messages"   -> {<|"role" -> "user", "content" -> prompt|>}
      |>, "JSON", "Compact" -> True],
      $Failed];
    (* ExportByteArray が使えない WL バージョン用フォールバック *)
    If[!ByteArrayQ[bodyBytes],
      bodyBytes = StringToByteArray[
        StringReplace[
          ExportString[<|
            "model"      -> model,
            "max_tokens" -> 4096,
            "messages"   -> {<|"role" -> "user", "content" -> prompt|>}
          |>, "JSON", "Compact" -> True],
          (* 非ASCII文字を \uXXXX JSON エスケープに変換 *)
          c : RegularExpression["[\\x80-\\x{FFFF}]"] :>
            "\\u" <> IntegerString[First[ToCharacterCode[c]], 16, 4]],
        "UTF-8"]];

    (* ── URLRead で Anthropic API を直接呼ぶ ──
       rule 95: URLRead は ScheduledTask/SocketListen コンテキストで ✅ 安全。
       StartProcess / $iSharedPollingTask を一切使わないため
       claudecode の非同期基盤と競合しない。 *)
    req = HTTPRequest[url,
      <|Method -> "POST",
        "Headers" -> {
          "x-api-key"         -> apiKey,
          "anthropic-version" -> "2023-06-01",
          "content-type"      -> "application/json"
        },
        (* SKILL 準拠: Body は ByteArray で渡す (文字列経由の変換を回避) *)
        "Body" -> bodyBytes|>];

    (* ── レスポンス受信 (SKILL 準拠: BodyByteArray → ImportByteArray["RawJSON"]) ──
       ByteArrayToString を経由すると Windows の暗黙エンコーディング変換が入る。
       ImportByteArray["RawJSON"] で ByteArray を直接 JSON パースする。 *)
    Module[{rb},
      rb = Quiet[TimeConstrained[URLRead[req, "BodyByteArray"], timeout, $Failed]];
      If[!ByteArrayQ[rb],
        Return["Error: API \:547c\:3073\:51fa\:3057\:306b\:5931\:6557\:3057\:307e\:3057\:305f (URLRead \:30bf\:30a4\:30e0\:30a2\:30a6\:30c8\:307e\:305f\:306f\:30cd\:30c3\:30c8\:30ef\:30fc\:30af\:30a8\:30e9\:30fc)\:3002"]];
      iParseAnthropicBgResponse[rb]]
  ];

(* リスト入力版: {"質問", Image[...], File["path"], ...}
   CLI パス: iClaudeQueryRaw が iNormalizePrompt 経由で Image/File を処理。
   API パス: マルチモーダル content 配列を構築して送信。 *)
ClaudeQueryBg[items_List, opts:OptionsPattern[]] :=
  Module[{useFallback = TrueQ[OptionValue[Fallback]],
          nonBlock = TrueQ[OptionValue[NonBlocking]],
          hasMedia},
    hasMedia = AnyTrue[items,
      (ImageQ[#] || MatchQ[#, File[_String]] ||
       (StringQ[#] && FileExistsQ[#] && iIsMediaFile[#])) &];
    If[!hasMedia,
      (* メディアなし: 従来どおりテキスト結合 *)
      ClaudeQueryBg[StringJoin[Riffle[Select[items, StringQ], "\n"]], opts],
      If[!useFallback,
        (* CLI パス: iNormalizePrompt 経由で Image → PNG 保存 *)
        If[nonBlock,
          iClaudeQueryRawNonBlocking[items, OptionValue[Timeout]],
          iClaudeQueryRaw[items]],
        (* API パス: マルチモーダル content 配列を構築 *)
        iClaudeQueryBgAPIMultimodal[items,
          OptionValue[Model], OptionValue[Timeout]]
      ]
    ]
  ];

(* Anthropic API マルチモーダル呼び出し *)
iClaudeQueryBgAPIMultimodal[items_List, modelSpec_, timeoutSpec_] :=
  Module[{model, apiKey, url, contentBlocks = {}, bodyBytes, req, timeout,
          tmpDir, imgIdx = 0},
    timeout = timeoutSpec;
    If[timeout === Automatic || !NumericQ[timeout], timeout = $ClaudeTimeout];
    If[!NumericQ[timeout], timeout = 1200];
    model = Which[
      ListQ[modelSpec] && Length[modelSpec] >= 2, modelSpec[[2]],
      StringQ[$ClaudeModel] && StringTrim[$ClaudeModel] =!= "", $ClaudeModel,
      True, $iModelSonnet];
    apiKey = Quiet[NBAccess`NBGetAPIKey["anthropic",
      PrivacySpec -> <|"AccessLevel" -> 1.0|>]];
    If[!StringQ[apiKey] || StringLength[apiKey] === 0,
      Return["Error: Anthropic API \:30ad\:30fc\:3092\:53d6\:5f97\:3067\:304d\:307e\:305b\:3093\:3067\:3057\:305f\:3002"]];
    url = If[ListQ[modelSpec] && Length[modelSpec] >= 3 && StringQ[modelSpec[[3]]],
      modelSpec[[3]], "https://api.anthropic.com/v1/messages"];
    tmpDir = FileNameJoin[{$ClaudeWorkingDirectory,
      "claude_mm_" <> ToString[UnixTime[]]}];
    (* content 配列を構築 *)
    Scan[Function[item, Which[
      StringQ[item] && (!FileExistsQ[item] || !iIsMediaFile[item]),
        AppendTo[contentBlocks,
          <|"type" -> "text", "text" -> item|>],
      ImageQ[item],
        imgIdx++;
        If[!DirectoryQ[tmpDir], CreateDirectory[tmpDir]];
        With[{f = FileNameJoin[{tmpDir, "img_" <> ToString[imgIdx] <> ".png"}]},
          Export[f, ImageResize[item, {Min[ImageDimensions[item][[1]], 1568]}], "PNG"];
          With[{b64 = BaseEncode[ReadByteArray[f]]},
            AppendTo[contentBlocks,
              <|"type" -> "image",
                "source" -> <|"type" -> "base64",
                  "media_type" -> "image/png", "data" -> b64|>|>]]],
      MatchQ[item, File[_String]] && FileExistsQ[item[[1]]] &&
        iIsImageMediaType[iMediaTypeForExt[FileExtension[item[[1]]]]],
        With[{b64 = BaseEncode[ReadByteArray[item[[1]]]],
              mt = iMediaTypeForExt[FileExtension[item[[1]]]]},
          AppendTo[contentBlocks,
            <|"type" -> "image",
              "source" -> <|"type" -> "base64",
                "media_type" -> mt, "data" -> b64|>|>]],
      StringQ[item] && FileExistsQ[item] && iIsMediaFile[item] &&
        iIsImageMediaType[iMediaTypeForExt[FileExtension[item]]],
        With[{b64 = BaseEncode[ReadByteArray[item]],
              mt = iMediaTypeForExt[FileExtension[item]]},
          AppendTo[contentBlocks,
            <|"type" -> "image",
              "source" -> <|"type" -> "base64",
                "media_type" -> mt, "data" -> b64|>|>]],
      True,
        AppendTo[contentBlocks,
          <|"type" -> "text", "text" -> ToString[item]|>]
    ]], items];
    If[DirectoryQ[tmpDir], Quiet[DeleteDirectory[tmpDir, DeleteContents -> True]]];
    bodyBytes = Quiet @ Check[
      ExportByteArray[<|
        "model" -> model, "max_tokens" -> 4096,
        "messages" -> {<|"role" -> "user", "content" -> contentBlocks|>}
      |>, "JSON", "Compact" -> True], $Failed];
    If[!ByteArrayQ[bodyBytes], Return["Error: JSON \:69cb\:7bc9\:5931\:6557"]];
    req = HTTPRequest[url,
      <|Method -> "POST",
        "Headers" -> {
          "x-api-key" -> apiKey,
          "anthropic-version" -> "2023-06-01",
          "content-type" -> "application/json"},
        "Body" -> bodyBytes|>];
    Module[{rb},
      rb = Quiet[TimeConstrained[URLRead[req, "BodyByteArray"], timeout, $Failed]];
      If[!ByteArrayQ[rb],
        Return["Error: API \:547c\:3073\:51fa\:3057\:5931\:6557"]];
      iParseAnthropicBgResponse[rb]]
  ];

(* Anthropic レスポンス JSON → テキスト文字列 *)

(* ByteArray 直接版 (SKILL 準拠: ImportByteArray["RawJSON"] で変換なしパース) *)
iParseAnthropicBgResponse[rb_ByteArray] :=
  Module[{parsed, str},
    (* ImportByteArray["RawJSON"] で ByteArray を直接 JSON パース。
       ByteArrayToString を経由しないため Windows の暗黙変換が入らない。 *)
    parsed = Quiet @ Check[ImportByteArray[rb, "RawJSON"], $Failed];
    If[parsed === $Failed,
      (* フォールバック: 明示的 UTF-8 デコード後に文字列版を試みる *)
      str = Quiet @ Check[ByteArrayToString[rb, "UTF-8"], $Failed];
      If[StringQ[str], Return[iParseAnthropicBgResponse[str]]];
      Return["Error: JSON \:89e3\:6790\:5931\:6557 (ByteArray)"]];
    iParseAnthropicBgResponse[parsed]  (* Association を文字列版で処理 *)
  ];

(* Association 直接版: ImportByteArray の結果を受け取り text を抽出 *)
iParseAnthropicBgResponse[parsed_Association] :=
  Module[{content, errData},
    If[KeyExistsQ[parsed, "error"],
      errData = parsed["error"];
      If[ListQ[errData] && !AssociationQ[errData], errData = Association[errData]];
      Return["Error: " <> If[AssociationQ[errData],
        Lookup[errData, "message", ToString[errData]],
        ToString[errData]]]];
    content = Lookup[parsed, "content", {}];
    If[!ListQ[content] || Length[content] === 0,
      Return["Error: \:30ec\:30b9\:30dd\:30f3\:30b9\:306b content \:30d5\:30a3\:30fc\:30eb\:30c9\:304c\:3042\:308a\:307e\:305b\:3093\:3002"]];
    StringJoin[Map[Function[b,
      If[AssociationQ[b] && Lookup[b, "type", ""] === "text",
        Lookup[b, "text", ""], ""]],
      content]]
  ];

(* String 版: ByteArrayToString 経由の旧パス (フォールバック用) *)
iParseAnthropicBgResponse[respStr_String] :=
  Module[{parsed, content, errData},
    (* Developer`ReadRawJSONString (WL 11.1+) は \n, \\, \u 等の JSON エスケープを
       正しく処理できる。ImportString["JSON"] はこれらで失敗するケースがある。 *)
    parsed = Quiet @ Check[Developer`ReadRawJSONString[respStr], $Failed];
    If[parsed === $Failed,
      parsed = Quiet @ Check[ImportString[respStr, "RawJSON"], $Failed]];
    If[parsed === $Failed,
      parsed = Quiet @ Check[ImportString[respStr, "JSON"], $Failed]];
    If[ListQ[parsed] && !AssociationQ[parsed], parsed = Association[parsed]];
    If[!AssociationQ[parsed],
      Return["Error: JSON \:89e3\:6790\:5931\:6557: " <>
             StringTake[respStr, Min[200, StringLength[respStr]]]]];
    (* エラーレスポンス *)
    If[KeyExistsQ[parsed, "error"],
      errData = parsed["error"];
      If[ListQ[errData] && !AssociationQ[errData], errData = Association[errData]];
      Return["Error: " <> If[AssociationQ[errData],
        Lookup[errData, "message", ToString[errData]],
        ToString[errData]]]];
    (* 成功: content[0].text を連結 *)
    content = Lookup[parsed, "content", {}];
    If[!ListQ[content] || Length[content] === 0,
      Return["Error: \:30ec\:30b9\:30dd\:30f3\:30b9\:306b content \:30d5\:30a3\:30fc\:30eb\:30c9\:304c\:3042\:308a\:307e\:305b\:3093\:3002"]];
    StringJoin[Map[Function[b,
      Module[{ba = If[ListQ[b] && !AssociationQ[b], Association[b], b]},
        If[AssociationQ[ba] && Lookup[ba, "type", ""] === "text",
          Lookup[ba, "text", ""], ""]]],
      content]]
  ];

Options[ClaudeWriteResponse] = {AutoEvaluate -> False};
ClaudeWriteResponse[nb_NotebookObject, text_String, opts:OptionsPattern[]] :=
  iWriteQueryResponse[nb, text, TrueQ[OptionValue[AutoEvaluate]]];

(* ============================================================
   ClaudeQueryAsync: 非同期 LLM クエリ（カーネル非ブロック）
   完了時に callback[応答文字列] を呼ぶ。
   iClaudeQueryImpl と完全に同じ非同期パスを使用:
   - Job システム (NBBeginJobAtEvalCell) で進捗管理
   - iClaudeQueryAsyncWithProgress / iStartFallbackAsync で非同期実行
   nb 引数を必ず指定すること（パレットからは iDocUserNotebook[] 等で解決済みの nb）。
   ============================================================ *)
Options[ClaudeQueryAsync] = {
  Fallback -> False,
  Model -> Automatic,
  PrivacyLevel -> Automatic,
  Timeout -> Automatic
};

ClaudeQueryAsync[prompt_String, callback_, nb_NotebookObject, opts:OptionsPattern[]] :=
  Module[{modelSpec, privLevel, useFallback, availModels, useClaudeCode,
          jobId, wrappedCallback, accessLevel, norm, hasMedia, mediaFiles},
    modelSpec = OptionValue[Model];
    privLevel = Replace[OptionValue[PrivacyLevel], Automatic -> 0.0];
    useFallback = TrueQ[OptionValue[Fallback]];
    accessLevel = If[privLevel > 0, privLevel, 0.5];

    (* === グローバル状態設定: ClaudeQuery と同じ === *)
    $currentUseFallback = useFallback;
    $iAllowReadTool = False;
    $iAllowWebSearch = False;
    (* セッションのアタッチメントをロード: iInjectAttachments が使用する *)
    $iCurrentSessionAttachments = iGetResolvedAttachments[nb, iSessionTag[]];

    (* === メディアファイル検出 ===
       PDF/画像等がアタッチされている場合:
       - 課金API許可 (useFallback=True): Anthropic API でマルチモーダル送信
       - 課金API禁止 (useFallback=False): CLI パスで処理（ツール承認が必要になる場合あり） *)
    norm = iNormalizePrompt[iInjectAttachments[prompt]];
    mediaFiles = If[ListQ[norm["mediaFiles"]], norm["mediaFiles"], {}];
    hasMedia = Length[mediaFiles] > 0 && useFallback;

    (* === モデルルーティング === *)
    If[modelSpec === Automatic,
      Which[
        (* メディアファイルあり + 課金API許可: Anthropic API 必須（マルチモーダル PDF 対応） *)
        hasMedia,
          Module[{allModels, anthropicModels, apiKey},
            allModels = NBAccess`NBGetAvailableFallbackModels[accessLevel];
            anthropicModels = Select[allModels,
              ToLowerCase[#[[1]]] === "anthropic" &];
            If[Length[anthropicModels] > 0,
              modelSpec = First[anthropicModels],
              apiKey = Quiet[NBAccess`NBGetAPIKey["anthropic",
                PrivacySpec -> <|"AccessLevel" -> 0.5|>]];
              If[StringQ[apiKey],
                modelSpec = {"anthropic", "claude-sonnet-4-6"},
                callback[iL[
                  "Error: PDF/画像のマルチモーダル送信には Anthropic API キーが必要です。\n" <>
                  "NBSetAPIKey[\"anthropic\", \"sk-...\"] で設定してください。",
                  "Error: Multimodal PDF/image requires an Anthropic API key.\n" <>
                  "Set it with NBSetAPIKey[\"anthropic\", \"sk-...\"]."]];
                Return[]]]],
        privLevel <= 0.5, Null,
        ListQ[$ClaudePrivateModel] && Length[$ClaudePrivateModel] >= 2,
          modelSpec = $ClaudePrivateModel,
        useFallback,
          availModels = NBAccess`NBGetAvailableFallbackModels[privLevel];
          If[Length[availModels] > 0,
            modelSpec = First[availModels],
            callback[iL["Error: PrivacyLevel " <> ToString[privLevel] <>
              " \:306b\:5bfe\:5fdc\:3059\:308b\:30e2\:30c7\:30eb\:304c\:3042\:308a\:307e\:305b\:3093\:3002",
              "Error: No model available for PrivacyLevel " <> ToString[privLevel] <> "."]];
            Return[]],
        True,
          callback[iL["Error: \:79d8\:5bc6\:30bb\:30eb\:306e\:51e6\:7406\:306b\:306f $ClaudePrivateModel \:307e\:305f\:306f Fallback \:304c\:5fc5\:8981\:3067\:3059\:3002",
            "Error: $ClaudePrivateModel or Fallback required for confidential cells."]];
          Return[]
      ]];

    (* === Job システム: iClaudeQueryImpl と完全に同じ === *)
    jobId = iBeginJobAtCapturedCell[nb];

    useClaudeCode = NBAccess`NBProviderCanAccess["claudecode", accessLevel];
    availModels = If[useFallback && !hasMedia,
      NBAccess`NBGetAvailableFallbackModels[accessLevel], {}];

    (* === コールバック: Job ライフサイクル管理付き === *)
    wrappedCallback = With[{nb2 = nb, jid = jobId, userCb = callback},
      Function[response,
        Module[{},
          NBAccess`NBJobMoveToAnchor[jid];
          $iJobActiveNb = nb2;
          userCb[response];
          NBAccess`NBJobResetSlotWritten[jid, 1];
          $iJobActiveNb = None;
          NBAccess`NBEndJob[jid]
        ]]
    ];

    (* === 非同期ディスパッチ ===
       優先順位:
       1. hasMedia (課金API許可 + メディアファイル) → Anthropic API マルチモーダル
       2. modelSpec 明示指定 → API 経由
       3. Claude Code CLI 利用可能 → CLI (課金API禁止時のデフォルト)
       4. Fallback モデルあり → API 経由
       5. どれも不可 → エラー *)
    Which[
      (* メディアファイルあり + 課金API許可: Anthropic API でマルチモーダル送信 *)
      hasMedia,
        iStartFallbackAsync[norm["text"], nb, wrappedCallback,
          {modelSpec}, 1, jobId, OptionValue[Timeout], mediaFiles],
      (* Model 明示指定: API 経由で非同期 *)
      modelSpec =!= Automatic && ListQ[modelSpec] && Length[modelSpec] >= 2,
        iStartFallbackAsync[prompt, nb, wrappedCallback,
          {modelSpec}, 1, jobId, OptionValue[Timeout], {}],
      (* Automatic: アクセスレベルに基づくルーティング *)
      useClaudeCode,
        iClaudeQueryAsyncWithProgress[
          prompt, wrappedCallback, nb, {}, jobId, availModels],
      Length[availModels] > 0,
        iStartFallbackAsync[prompt, nb, wrappedCallback,
          availModels, 1, jobId, OptionValue[Timeout], {}],
      (* どのモデルも対応不可 *)
      True,
        NBAccess`NBWriteSlot[jobId, 1,
          Cell["\[WarningSign] AccessLevel " <> ToString[accessLevel] <>
            " \:306b\:5bfe\:5fdc\:3059\:308b\:30e2\:30c7\:30eb\:304c\:3042\:308a\:307e\:305b\:3093\:3002", "Print",
            FontWeight -> Bold, FontColor -> Red, FontSize -> 11]];
        $iJobActiveNb = None;
        NBAccess`NBEndJob[jobId]
    ];
  ];

Options[ClaudeQuery] = {Fallback -> False, WebFetch -> False, WebSearch -> True, Model -> Automatic, PrivacySpec -> Automatic, AutoPrivate -> False, AutoEvaluate -> False, Timeout -> Automatic};

(* ClaudeQuery \:5185\:90e8\:5b9f\:88c5\:ff08\:975e\:540c\:671f\:ff09 *)
iClaudeQueryImpl[nb_NotebookObject, tag_String, prompt_, useFallback_, useWebFetch_,
    modelSpec_:Automatic, privSpec_:Automatic, autoPrivate_:False,
    autoEvaluate_:False, timeout_:Automatic, mediaFiles_List:{}, extraImageDirs_List:{}] :=
  Module[{history, lastEntry, cellCountAfter, notebookCtx,
          fullPrompt, step, entry, jobId, queryCallback,
          accessLevel, availModels, useClaudeCode},
    (* アクセスレベルの解決: PrivacySpec と Model の両方を考慮 *)
    accessLevel = iResolveAccessLevel[privSpec, modelSpec];
    $iCurrentSessionAttachments = iGetResolvedAttachments[nb, tag];
    history = iSessionHistoryWithInherit[nb, tag];
    lastEntry      = If[Length[history] > 0, Last[history], <||>];
    cellCountAfter = Replace[Lookup[lastEntry, "cellCountAfter",
                       Lookup[lastEntry, "cellCount", 0]], Except[_Integer] -> 0];
    (* アクセスレベルに基づいてノートブックコンテキストを構築 *)
    notebookCtx    = With[{r = Quiet[iCaptureNotebookContext[nb, cellCountAfter, accessLevel]]}, If[StringQ[r], r, ""]];
    step           = Length[iSessionHistory[nb, tag]];

    fullPrompt =
      $claudeQueryPrefix <>
      iTaskOverviewBlock[If[StringQ[prompt], prompt, ""]] <>
      If[Length[history] > 0,
        "\:4ee5\:4e0b\:306f Mathematica \:3067\:306e\:4f5c\:696d\:5c65\:6b74\:3067\:3059\:3002\n\n" <>
        iSessionToContext[history],
        ""] <>
      If[StringQ[notebookCtx] && notebookCtx =!= "",
        "=== \:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:306e\:73fe\:5728\:306e\:72b6\:614b ===\n" <> notebookCtx, ""] <>
      iNotebookDefinedSymbolsContext[nb] <>
      iFileAccessContext[If[StringQ[prompt], prompt, ""]] <>
      iPackageDocsContext[If[StringQ[prompt], prompt, ""]] <>
      iAutoPrivatePrompt[autoPrivate] <>
      iTaskDetailBlock["\:8cea\:554f", iExpandSymbolRefs[prompt]];

    entry = <|
      "step"        -> step,
      "time"        -> AbsoluteTime[],
      "type"        -> "query",
      "instruction" -> iSanitizeInstructionForHistory[prompt],
      "fullPrompt"  -> iCompressForHistory[fullPrompt],
      "cellCount"   -> NBAccess`NBCellCount[nb],
      "response"    -> "(\:51e6\:7406\:4e2d)",
      "code"        -> ""
    |>;
    iSessionAppend[nb, tag, entry];

    (* Job \:30b7\:30b9\:30c6\:30e0\:3067\:8a55\:4fa1\:30bb\:30eb\:76f4\:5f8c\:306b\:30b9\:30ed\:30c3\:30c8\:3092\:4e88\:7d04 *)
    jobId = iBeginJobAtCapturedCell[nb];

    (* アクセスレベルに基づいてフォールバック可能モデルを取得 *)
    availModels = If[TrueQ[useFallback],
      NBAccess`NBGetAvailableFallbackModels[accessLevel],
      {}];
    (* Claude Code 自体がアクセスレベルに対応可能か判定 *)
    useClaudeCode = NBAccess`NBProviderCanAccess["claudecode", accessLevel];

    If[TrueQ[useWebFetch] && TrueQ[useFallback],
      (* WebFetch \:306f\:540c\:671f\:3067\:5b9f\:884c\:3002\:8ab2\:91d1\:304c\:767a\:751f\:3059\:308b API \:7d4c\:7531\:306e\:305f\:3081 Fallback->True \:304c\:5fc5\:9808 *)
      Module[{response = iDoWebSearch[fullPrompt]},
        NBAccess`NBJobMoveToAnchor[jobId];
        $iJobActiveNb = nb;
        If[StringQ[response],
          iWriteQueryResponse[nb, response, autoEvaluate]];
        $iJobActiveNb = None;
        NBAccess`NBEndJob[jobId];
        iSessionUpdateLast[nb, tag, <|
          "response"       -> response,
          "cellCountAfter" -> NBAccess`NBCellCount[nb]
        |>]],
      (* \:901a\:5e38\:30d1\:30b9: \:975e\:540c\:671f *)
      queryCallback = With[{nb2 = nb, stag2 = tag, jid = jobId,
            autoMark = iShouldAutoMarkConfidential[accessLevel],
            ccBefore = NBAccess`NBCellCount[nb],
            ae = autoEvaluate},
        Function[response,
          Module[{cellThunks},
            (* \:30a2\:30f3\:30ab\:30fc\:306e\:76f4\:5f8c\:306b\:51fa\:529b\:3092\:914d\:7f6e *)
            NBAccess`NBJobMoveToAnchor[jid];
            $iJobActiveNb = nb2;
            (* \:30a8\:30e9\:30fc/\:5236\:9650\:30ec\:30b9\:30dd\:30f3\:30b9\:306f\:901a\:77e5\:30b9\:30bf\:30a4\:30eb\:3067\:8868\:793a\:3057\:3066\:7d42\:4e86 *)
            (* エラーチェック:
               - 500文字超の応答はエラーではない（ドキュメント等）
               - "#" で始まる応答は Markdown ドキュメントなので絶対にエラーではない
               - 非文字列は iIsAPIErrorResponse[_]:=True が捕まえる *)
            If[StringQ[response] &&
               StringLength[response] <= 500 &&
               !StringStartsQ[StringTrim[response], "#"] &&
               (iIsAPIErrorResponse[response] || StringStartsQ[response, "Error"]),
              NBAccess`NBWritePrintNotice[nb2, response, RGBColor[0.8, 0, 0]];
              NBAccess`NBJobResetSlotWritten[jid, 1];
              $iJobActiveNb = None;
              NBAccess`NBEndJob[jid];
              iSessionUpdateLast[nb2, stag2, <|
                "response" -> response,
                "cellCountAfter" -> NBAccess`NBCellCount[nb2]|>];
              Return[{}]];
            (* \:6b63\:5e38\:5fdc\:7b54: thunk \:30ea\:30b9\:30c8\:3092\:751f\:6210\:3057 writing \:30d5\:30a7\:30fc\:30ba\:306b\:59d4\:8b72 *)
            cellThunks = If[StringQ[response],
              iWriteQueryResponseQueued[nb2, response, ae],
              {Function[NBAccess`NBWriteCell[nb2,
                Cell[iL["Error: \:5fdc\:7b54\:3092\:53d6\:5f97\:3067\:304d\:307e\:305b\:3093\:3067\:3057\:305f\:3002", "Error: Could not obtain a response."], "Text"]]]}];
            (* \:6700\:5f8c\:306e thunk \:306b\:30af\:30ea\:30fc\:30f3\:30a2\:30c3\:30d7\:51e6\:7406\:3092\:8ffd\:52a0 *)
            AppendTo[cellThunks, Function[
              If[TrueQ[autoMark],
                iAutoMarkNewCellsConfidential[nb2, ccBefore]];
              NBAccess`NBJobResetSlotWritten[jid, 1];
              $iJobActiveNb = None;
              NBAccess`NBEndJob[jid];
              iSessionUpdateLast[nb2, stag2, <|
                "response"       -> response,
                "cellCountAfter" -> NBAccess`NBCellCount[nb2]
              |>]]];
            cellThunks
          ]
        ]
      ];
      If[modelSpec =!= Automatic && ListQ[modelSpec] && Length[modelSpec] >= 2,
        (* Model \:6307\:5b9a\:3042\:308a: API \:7d4c\:7531\:3067\:6307\:5b9a\:30e2\:30c7\:30eb\:3092\:76f4\:63a5\:547c\:3073\:51fa\:3057 *)
        iStartFallbackAsync[fullPrompt, nb, queryCallback,
          {modelSpec}, 1, jobId, timeout, mediaFiles],
        (* アクセスレベルに基づくルーティング *)
        If[useClaudeCode,
          (* Claude Code 使用可能: 通常パス (フォールバック時は availModels を使用) *)
          iClaudeQueryAsyncWithProgress[
            fullPrompt, queryCallback, nb, extraImageDirs, jobId, availModels],
          (* Claude Code 使用不可: フォールバックモデルへ直接 *)
          If[Length[availModels] > 0,
            iStartFallbackAsync[fullPrompt, nb, queryCallback,
              availModels, 1, jobId, timeout, mediaFiles],
            (* どのモデルもアクセスレベルに対応不可 *)
            NBAccess`NBWriteSlot[jobId, 1,
              Cell["\[WarningSign] AccessLevel " <> ToString[accessLevel] <>
                " \:306b\:5bfe\:5fdc\:3059\:308b\:30e2\:30c7\:30eb\:304c\:3042\:308a\:307e\:305b\:3093\:3002", "Print",
                FontWeight -> Bold, FontColor -> Red, FontSize -> 11]];
            $iJobActiveNb = None;
            NBAccess`NBEndJob[jobId];
            iSessionUpdateLast[nb, tag, <|
              "response" -> "Error: AccessLevel " <> ToString[accessLevel] <>
                " \:306b\:5bfe\:5fdc\:3059\:308b\:30e2\:30c7\:30eb\:304c\:3042\:308a\:307e\:305b\:3093",
              "cellCountAfter" -> NBAccess`NBCellCount[nb]|>]
          ]
        ]
      ]
    ];
  ];

ClaudeQuery[prompt_, opts:OptionsPattern[]] := (
    iCaptureEvalCell[];
    $currentUseFallback = TrueQ[OptionValue[Fallback]];
    $iAllowReadTool = True;
    $iAllowWebSearch = TrueQ[OptionValue[WebSearch]];
  With[{nb = Quiet[EvaluationNotebook[]],
        ae = OptionValue[AutoEvaluate],
        mdl = OptionValue[Model],
        ps = OptionValue[PrivacySpec],
        ap = TrueQ[OptionValue[AutoPrivate]],
        tmo = OptionValue[Timeout],
        actualPrompt = iResolveWebFetchWithFallback[
          prompt, OptionValue[WebFetch], $currentUseFallback]},
  (* ── $UseClaudeRuntime 分岐 ── *)
  If[TrueQ[$UseClaudeRuntime],
    iClaudeEvalViaRuntimeBridge[nb, iSessionTag[], actualPrompt,
      {}, ae, mdl, ps, ap, tmo],
    Module[{session, tag},
      iPrecisionConfidentialCheck[nb];
      session = iEnsureDefaultSession[nb];
      tag     = session["SessionTag"];
      iClaudeQueryImpl[nb, tag, prompt,
        TrueQ[OptionValue[Fallback]], TrueQ[OptionValue[WebFetch]],
        mdl, ps, ap, ae, tmo, {}, {}]
    ]
  ]]);

(* セッション対応版 ClaudeQuery（非同期・履歴保存付き） *)
ClaudeQuery[session_Association, prompt_, opts:OptionsPattern[]] := (
    iCaptureEvalCell[];
    $currentUseFallback = TrueQ[OptionValue[ClaudeQuery, {opts}, Fallback]];
    $iAllowReadTool = True;
    $iAllowWebSearch = TrueQ[OptionValue[ClaudeQuery, {opts}, WebSearch]];
  With[{nb = session["Notebook"],
        ae = OptionValue[ClaudeQuery, {opts}, AutoEvaluate],
        mdl = OptionValue[ClaudeQuery, {opts}, Model],
        ps = OptionValue[ClaudeQuery, {opts}, PrivacySpec],
        ap = TrueQ[OptionValue[ClaudeQuery, {opts}, AutoPrivate]],
        tmo = OptionValue[ClaudeQuery, {opts}, Timeout]},
  If[TrueQ[$UseClaudeRuntime],
    iClaudeEvalViaRuntimeBridge[nb, session["SessionTag"], prompt,
      {}, ae, mdl, ps, ap, tmo],
    Module[{tag},
      tag = session["SessionTag"];
      iPrecisionConfidentialCheck[nb];
      $iCurrentSessionAttachments = iGetResolvedAttachments[nb, tag];
      iClaudeQueryImpl[nb, tag, prompt,
        TrueQ[OptionValue[ClaudeQuery, {opts}, Fallback]],
        TrueQ[OptionValue[ClaudeQuery, {opts}, WebFetch]],
        mdl, ps, ap, ae, tmo, {}, {}]
    ]
  ]]);

(* リスト入力版 ClaudeQuery: {"質問", Image[...], File["path"], ...}
   画像・PDF・音声ファイルを API にマルチモーダルコンテンツとして直接送信する。 *)
ClaudeQuery[items_List, opts:OptionsPattern[]] := (
    iCaptureEvalCell[];
    $currentUseFallback = TrueQ[OptionValue[Fallback]];
    $iAllowReadTool = True;
    $iAllowWebSearch = TrueQ[OptionValue[WebSearch]];
  With[{nb = Quiet[EvaluationNotebook[]],
        ae = OptionValue[AutoEvaluate],
        mdl = OptionValue[Model],
        ps = OptionValue[PrivacySpec],
        ap = TrueQ[OptionValue[AutoPrivate]],
        tmo = OptionValue[Timeout]},
  Module[{session, tag, norm},
    iPrecisionConfidentialCheck[nb];
    session = iEnsureDefaultSession[nb];
    tag     = session["SessionTag"];
    norm    = iNormalizePrompt[iInjectAttachments[items]];
    If[TrueQ[$UseClaudeRuntime],
      iClaudeEvalViaRuntimeBridge[nb, tag, norm["text"],
        norm["imageDirs"], ae, mdl, ps, ap, tmo,
        norm["mediaFiles"]],
      iClaudeQueryImpl[nb, tag, norm["text"],
        TrueQ[OptionValue[Fallback]], TrueQ[OptionValue[WebFetch]],
        mdl, ps, ap, ae, tmo,
        norm["mediaFiles"], norm["imageDirs"]]
    ]
  ]]);

(* セッション指定版リスト入力 ClaudeQuery *)
ClaudeQuery[session_Association, items_List, opts:OptionsPattern[]] := (
    iCaptureEvalCell[];
    $currentUseFallback = TrueQ[OptionValue[ClaudeQuery, {opts}, Fallback]];
    $iAllowReadTool = True;
    $iAllowWebSearch = TrueQ[OptionValue[ClaudeQuery, {opts}, WebSearch]];
  With[{nb = session["Notebook"],
        ae = OptionValue[ClaudeQuery, {opts}, AutoEvaluate],
        mdl = OptionValue[ClaudeQuery, {opts}, Model],
        ps = OptionValue[ClaudeQuery, {opts}, PrivacySpec],
        ap = TrueQ[OptionValue[ClaudeQuery, {opts}, AutoPrivate]],
        tmo = OptionValue[ClaudeQuery, {opts}, Timeout]},
  Module[{tag, norm},
    tag  = session["SessionTag"];
    iPrecisionConfidentialCheck[nb];
    $iCurrentSessionAttachments = iGetResolvedAttachments[nb, tag];
    norm = iNormalizePrompt[iInjectAttachments[items]];
    If[TrueQ[$UseClaudeRuntime],
      iClaudeEvalViaRuntimeBridge[nb, tag, norm["text"],
        norm["imageDirs"], ae, mdl, ps, ap, tmo,
        norm["mediaFiles"]],
      iClaudeQueryImpl[nb, tag, norm["text"],
        TrueQ[OptionValue[ClaudeQuery, {opts}, Fallback]],
        TrueQ[OptionValue[ClaudeQuery, {opts}, WebFetch]],
        mdl, ps, ap, ae, tmo,
        norm["mediaFiles"], norm["imageDirs"]]
    ]
  ]]);

(* ============================================================
   $Language ベースの言語指示ヘルパー
   プロンプト内の言語指定を $Language に基づいて動的生成する。
   ============================================================ *)

(* 現在の言語名を返す（英語表記） *)
iLanguageName[] := If[StringQ[$Language], $Language, "English"];

(* プロンプト用の言語指示文を生成。
   style:
     "polite"  → 敬体 (日本語) / polite style (他言語)
     "plain"   → 常体 (日本語) / concise style (他言語)
     "general" → "All text must be written in ..." *)
iLanguageInstruction["polite"] :=
  If[$Language === "Japanese",
    "Write in Japanese using \:656c\:4f53 (\:3067\:3059\:30fb\:307e\:3059\:8abf) style.\n",
    "Write in " <> iLanguageName[] <> ".\n"];

iLanguageInstruction["plain"] :=
  If[$Language === "Japanese",
    "Write in Japanese using \:5e38\:4f53 (\:3060\:30fb\:3067\:3042\:308b\:8abf) style for brevity.\n",
    "Write in " <> iLanguageName[] <> " using concise style.\n"];

iLanguageInstruction["general"] :=
  "All text must be written in " <> iLanguageName[] <> ".\n";

iLanguageInstruction["summary"] :=
  "Summarize the following Mathematica package update instruction in ONE short " <>
  iLanguageName[] <> " sentence (max 40 chars). ";

iLanguageInstruction["explanation"] :=
  "All explanatory text must be written in " <> iLanguageName[] <> ".";

(* 非同期タスクスケジューリング規約: ClaudeCreatePackage / ClaudeUpdatePackage プロンプトに注入。
   claudecode/NBAccess が提供する共有ポーリングタスクを経由し、
   パッケージ側で個別に ScheduledTask を作成しないことを指示する。 *)
iAsyncSchedulingRules[] :=
  "\n=== ASYNC TASK SCHEDULING RULES ===\n" <>
  "When the package needs asynchronous or background processing with UI feedback:\n" <>
  "1. MANDATORY: Use claudecode/NBAccess public APIs for async task scheduling.\n" <>
  "   - Use iClaudeQueryAsyncWithProgress[] for LLM query tasks.\n" <>
  "   - Use NBAccess functions (NBWriteCell, NBEndJob, etc.) for notebook output.\n" <>
  "   - Do NOT create individual ScheduledTask objects for polling or progress tracking.\n" <>
  "   - The shared polling infrastructure in claudecode manages all concurrent async tasks\n" <>
  "     through a single ScheduledTask to prevent FrontEnd dynamic evaluation overload.\n" <>
  "2. EXCEPTIONS (individual ScheduledTask allowed):\n" <>
  "   a. Pure computation tasks (numerical, combinatorial) that do NOT interact with\n" <>
  "      the FrontEnd (no WindowStatusArea, NotebookWrite, Dynamic, etc.).\n" <>
  "   b. Interactive user-facing programs (e.g., PresentationListener) that have\n" <>
  "      specific real-time requirements justifying a custom scheduler.\n" <>
  "   In both cases, the documentation (api.md/user_manual.md/README.md) MUST explicitly\n" <>
  "   note that the package uses its own ScheduledTask and explain why.\n" <>
  "3. RATIONALE: Multiple concurrent ScheduledTask objects that update WindowStatusArea\n" <>
  "   or call NotebookWrite cause Mathematica's dynamic evaluation to overflow,\n" <>
  "   triggering the 'Dynamic evaluation abort' dialog and freezing all tasks.\n" <>
  "=================================\n\n";

ClaudeMath[task_String] := iClaudeQueryRaw[
  "You are an expert Wolfram Language / Mathematica programmer. \
Provide clean, working Mathematica code. \
Wrap all code in ```mathematica ... ``` blocks. \
Use idiomatic Wolfram Language style. \
For explanatory text outside code blocks: \
do NOT use markdown tables (no |---|); \
instead describe comparisons as numbered lists or plain sentences. \
Do not use markdown bold (**text**) or heading syntax (# ##). \
All explanatory text must be written in " <> iLanguageName[] <> ". \
Task: " <> task
];

ClaudeExtractCode[response_String] := Module[{matches},
  matches = StringCases[response,
    "```mathematica" ~~ Shortest[code__] ~~ "```" :> StringTrim[code]];
  If[Length[matches] > 0, First[matches], response]
];

ClaudeExtractAllCode[response_String] :=
  StringCases[response,
    "```mathematica" ~~ Shortest[code__] ~~ "```" :> StringTrim[code]];

(* 言語タグ付きコードブロック抽出: {<|"lang"->..., "code"->...|>, ...} *)
$iExternalLangMap = <|
  "python" -> "Python", "py" -> "Python",
  "r" -> "R",
  "julia" -> "Julia",
  "ruby" -> "Ruby",
  "javascript" -> "NodeJS", "js" -> "NodeJS",
  "shell" -> "Shell", "bash" -> "Shell", "sh" -> "Shell",
  "sql" -> "SQL"
|>;

iExtractAllCodeBlocks[response_String] := Module[{raw},
  raw = StringCases[response,
    RegularExpression["```(\\w+)\\n([\\s\\S]*?)```"] :> {"$1", "$2"}];
  Map[Function[pair,
    Module[{tag = ToLowerCase[First[pair]], code = StringTrim[Last[pair]]},
      <|"lang" -> If[tag === "mathematica", "mathematica",
                    Lookup[$iExternalLangMap, tag, "mathematica"]],
        "fenceTag" -> First[pair],
        "code" -> iFixUnicodeEscapes[code]|>
    ]], raw]
];

(* \uXXXX / \xNN 形式の Unicode エスケープを実文字に変換。
   Claude が日本語を \x4e00\x81f4 や \:30d1\:30c3 のように出力する問題への対策。
   Mathematica は \:XXXX 形式なので \uXXXX / \xNN はリテラルとして残ってしまう。 *)
iFixUnicodeEscapes[code_String] :=
  Module[{result},
    (* Step 1: \uXXXX → 実文字 *)
    result = StringReplace[code,
      "\\u" ~~ hex : Repeated[HexadecimalCharacter, {4}] :>
        FromCharacterCode[FromDigits[hex, 16]]];
    (* Step 2: \xNN\xNN... (UTF-8 バイト列) → 実文字
       連続する \xNN を UTF-8 バイト列として解釈 *)
    result = StringReplace[result,
      s : Repeated["\\x" ~~ Repeated[HexadecimalCharacter, {2}], {2, Infinity}] :>
        Module[{bytes},
          bytes = FromDigits[#, 16] & /@
            StringCases[s, "\\x" ~~ h : Repeated[HexadecimalCharacter, {2}] :> h];
          Quiet @ Check[
            FromCharacterCode[bytes, "UTF-8"],
            s  (* デコード失敗時は元のまま *)
          ]]];
    result
  ];

(* ExternalLanguage セルを書き込む *)
iWriteExternalLanguageCell[nb_NotebookObject, code_String,
    lang_String, autoEvaluate_:False] :=
  NBAccess`NBWriteExternalLanguageCell[nb, code, lang, autoEvaluate];

(* レスポンスからコードブロックを書き込む共通処理 *)
(* 長時間ブロッキングする可能性のある関数パターン *)
(* 外部サービスへの不可逆な書き込み操作: 自動実行をスキップして確認を求める *)
$iLongRunningPatterns = {
  "GitHubRefreshAndCommit", "GitHubPushAll", "GitHubCommit",
  "GitHubCreatePullRequest", "GitHubMergePullRequest",
  "GitHubSubmitPullRequest"
};

iIsLongRunningCode[code_String] :=
  AnyTrue[$iLongRunningPatterns, StringContainsQ[code, #] &];

