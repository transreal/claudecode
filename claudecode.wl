iSanitizeUnderscoreVarNames[code_String] :=
  Module[{matches, result = code},
    (* _\:304c2\:56de\:4ee5\:4e0a\:51fa\:73fe\:3059\:308b\:8b58\:5225\:5b50\:3092\:691c\:51fa *)
    matches = Union @ StringCases[code,
