(* ==============================================================
   \:95a2\:6570\:5358\:4f4d\:62bd\:51fa: \:30d5\:30a1\:30a4\:30eb\:5185\:306e\:5404\:95a2\:6570\:5b9a\:7fa9\:3092 Association \:306b\:5206\:89e3
   ============================================================== *)
iExtractFunctions[code_String] :=
  Module[{lines, blocks, current, nameRe, usageRe, optRe},
    lines = StringSplit[code, "\n"];
    (* 2026-06-10: Pkg`X / Pkg`Private`iX のような完全修飾定義も認識する。
       従来は backtick で名前マッチが途切れて継続行扱いになり、完全修飾
       スタイルのパッケージ (ClaudePackageManager.wl 等) では関数分解・
       マージ・対象関数推定が全く機能していなかった。 *)
    nameRe = RegularExpression[
      "^((?:[a-zA-Z\\$][a-zA-Z0-9\\$]*`)*[a-zA-Z\\$][a-zA-Z0-9\\$]*)\\s*[\\[\\(]"];
    (* FuncName::usage = "..." \[RightArrow] \:30ad\:30fc\:3092 FuncName \:306b\:3059\:308b *)
    usageRe = RegularExpression[
      "^((?:[a-zA-Z\\$][a-zA-Z0-9\\$]*`)*[a-zA-Z\\$][a-zA-Z0-9\\$]*)::usage\\s*="];
    (* Options[FuncName] = {...} \[RightArrow] \:30ad\:30fc\:3092 FuncName \:306b\:3059\:308b *)
    optRe = RegularExpression[
      "^Options\\[((?:[a-zA-Z\\$][a-zA-Z0-9\\$]*`)*[a-zA-Z\\$][a-zA-Z0-9\\$]*)\\]\\s*="];
    blocks = <||>;
    current = None;
    Scan[Function[line,
      Module[{m, mu, mo},
        Which[
          (* Options[FuncName] = {...}: FuncName \:3092\:30ad\:30fc\:306b\:3059\:308b *)
          (mo = StringCases[line, optRe :> "$1"]; Length[mo] > 0) &&
            !StringStartsQ[line, " "] && !StringStartsQ[line, "\t"],
            current = First[mo];
            If[!KeyExistsQ[blocks, current], blocks[current] = ""];
            blocks[current] = blocks[current] <> line <> "\n",
          (* FuncName::usage = "...": FuncName \:3092\:30ad\:30fc\:306b\:3059\:308b *)
          (mu = StringCases[line, usageRe :> "$1"]; Length[mu] > 0) &&
            !StringStartsQ[line, " "] && !StringStartsQ[line, "\t"],
            current = First[mu];
            If[!KeyExistsQ[blocks, current], blocks[current] = ""];
            blocks[current] = blocks[current] <> line <> "\n",
          (* \:901a\:5e38\:306e\:95a2\:6570\:5b9a\:7fa9: FuncName[...] := ... *)
          (m = StringCases[line, nameRe :> "$1"]; Length[m] > 0) &&
            !StringStartsQ[line, " "] && !StringStartsQ[line, "\t"] &&
            (StringContainsQ[line, ":="] || StringContainsQ[line, "= ("] ||
             (* 複数行ヘッダ定義: Fn[ で行が終わり引数が次行に続く形
                (ClaudePackageManager.wl 等の完全修飾スタイルで頻出) *)
             StringEndsQ[StringTrim[line], "["]),
            current = First[m];
            If[!KeyExistsQ[blocks, current], blocks[current] = ""];
            blocks[current] = blocks[current] <> line <> "\n",
          (* $Constant = ... (\:884c\:982d $ \:3067\:59cb\:307e\:308b\:5b9a\:6570\:4ee3\:5165) *)
          StringStartsQ[line, "$"] && StringContainsQ[line, "="] &&
            !StringStartsQ[line, " "] && !StringStartsQ[line, "\t"],
            Module[{cm = StringCases[line, RegularExpression["^(\\$[a-zA-Z0-9]+)"] :> "$1"]},
              If[Length[cm] > 0,
                current = First[cm];
                If[!KeyExistsQ[blocks, current], blocks[current] = ""];
                blocks[current] = blocks[current] <> line <> "\n"]],
          (* \:7d99\:7d9a\:884c *)
          True,
            If[current =!= None,
              blocks[current] = blocks[current] <> line <> "\n"]
        ]
      ]
    ], lines];
    blocks
  ];

(* ============================================================
   2026-06-10: セグメント単位の関数マージ

   iExtractFunctions は同名キーのブロックを非連続領域 (Public 領域の
   usage 宣言と Private 領域の実装) にまたがって 1 つに連結する。
   そのため:
     (a) usage と実装が離れている標準レイアウトでは、連結ブロックが
         元ファイルの連続部分文字列にならず StringReplace が常に no-op
         (従来は mergedCount++ され「マージ完了」と虚偽報告)
     (b) usage と実装が偶然連続している場合は、間に挟まる
         Begin["`Private`"] 等の構造行ごと置換されてファイルを破壊
   ここでは「連続した行のかたまり」をセグメントとして抽出し、
   {関数名, 種別 (usage/options/def)} 単位で in-place 置換する。
   構造行 (BeginPackage/Begin/End/EndPackage) はセグメントを終端させ、
   どのセグメントにも属さないため破壊されない。
   ============================================================ *)

iExtractFunctionSegments[code_String] :=
  Module[{lines, segs = {}, curKey = None, curKind = None, curLines = {},
          nameRe, usageRe, optRe, structRe, flush},
    lines = StringSplit[code, "\n"];
    nameRe = RegularExpression[
      "^((?:[a-zA-Z\\$][a-zA-Z0-9\\$]*`)*[a-zA-Z\\$][a-zA-Z0-9\\$]*)\\s*[\\[\\(]"];
    usageRe = RegularExpression[
      "^((?:[a-zA-Z\\$][a-zA-Z0-9\\$]*`)*[a-zA-Z\\$][a-zA-Z0-9\\$]*)::usage\\s*="];
    optRe = RegularExpression[
      "^Options\\[((?:[a-zA-Z\\$][a-zA-Z0-9\\$]*`)*[a-zA-Z\\$][a-zA-Z0-9\\$]*)\\]\\s*="];
    (* 列 0 の構造行のみ (インデントされた文字列連結行などは対象外) *)
    structRe = RegularExpression[
      "^(BeginPackage\\[|Begin\\[|End\\[\\]|EndPackage\\[\\])"];
    flush := (
      If[curKey =!= None && Length[curLines] > 0,
        AppendTo[segs, <|"Key" -> curKey, "Kind" -> curKind,
          "Text" -> StringJoin[(# <> "\n") & /@ curLines]|>]];
      curKey = None; curKind = None; curLines = {});
    Scan[Function[line,
      Module[{m, mu, mo},
        Which[
          (* 構造行: セグメント終端。どのセグメントにも含めない
             (structRe は ^ アンカー付きなので行頭一致のみ) *)
          StringContainsQ[line, structRe],
            flush,
          (mo = StringCases[line, optRe :> "$1"]; Length[mo] > 0) &&
            !StringStartsQ[line, " "] && !StringStartsQ[line, "\t"],
            flush; curKey = First[mo]; curKind = "options";
            AppendTo[curLines, line],
          (mu = StringCases[line, usageRe :> "$1"]; Length[mu] > 0) &&
            !StringStartsQ[line, " "] && !StringStartsQ[line, "\t"],
            flush; curKey = First[mu]; curKind = "usage";
            AppendTo[curLines, line],
          (m = StringCases[line, nameRe :> "$1"]; Length[m] > 0) &&
            !StringStartsQ[line, " "] && !StringStartsQ[line, "\t"] &&
            (StringContainsQ[line, ":="] || StringContainsQ[line, "= ("] ||
             StringEndsQ[StringTrim[line], "["]),
            flush; curKey = First[m]; curKind = "def";
            AppendTo[curLines, line],
          StringStartsQ[line, "$"] && StringContainsQ[line, "="] &&
            !StringStartsQ[line, " "] && !StringStartsQ[line, "\t"],
            Module[{cm = StringCases[line,
                RegularExpression["^(\\$[a-zA-Z0-9]+)"] :> "$1"]},
              If[Length[cm] > 0,
                flush; curKey = First[cm]; curKind = "def";
                AppendTo[curLines, line],
                If[curKey =!= None, AppendTo[curLines, line]]]],
          True,
            If[curKey =!= None, AppendTo[curLines, line]]
        ]
      ]
    ], lines];
    flush;
    segs
  ];

(* patch 内の各セグメントを orig の対応セグメント ({Key, Kind} が一致する
   もの。多重定義は出現順に消費) と in-place 置換する。
   返値:
     "Code"        -> 置換後ソース
     "Replaced"    -> 置換できた関数名リスト
     "Identical"   -> patch と orig が同一だった関数名リスト (変更なし)
     "Unmerged"    -> 対応セグメントはあるが verbatim 一致しなかった関数名
     "AddedBlocks" -> <|関数名 -> 挿入すべきテキスト|> (orig に対応無し)
   挿入位置の決定は呼び出し側のポリシーに委ねる (legacy は Private 末尾、
   ClaudePackageManager adapter は Public 領域)。 *)
iMergeFunctionSegments[orig_String, patch_String] :=
  Module[{origSegs, patchSegs, working = orig, replaced = {}, identical = {},
          unmerged = {}, addedBlocks = <||>, origIndex},
    origSegs  = iExtractFunctionSegments[orig];
    patchSegs = iExtractFunctionSegments[patch];
    origIndex = GroupBy[origSegs, ({#["Key"], #["Kind"]} &)];
    Scan[Function[seg,
      Module[{k = {seg["Key"], seg["Kind"]}, cands, cand, res},
        cands = Lookup[origIndex, Key[k], {}];
        If[Length[cands] === 0,
          (* orig に対応セグメント無し → 挿入候補 *)
          addedBlocks[seg["Key"]] =
            Lookup[addedBlocks, seg["Key"], ""] <> seg["Text"],
          cand = First[cands];
          origIndex[k] = Rest[cands];
          Which[
            (* 空白差のみは「変更なし」扱い (無意味な whitespace churn と
               偽の mergedCount を防ぐ) *)
            cand["Text"] === seg["Text"] ||
            StringTrim[cand["Text"]] === StringTrim[seg["Text"]],
              AppendTo[identical, seg["Key"]],
            True,
              res = StringReplace[working, cand["Text"] -> seg["Text"], 1];
              If[res =!= working,
                working = res; AppendTo[replaced, seg["Key"]],
                AppendTo[unmerged, seg["Key"]]]
          ]]]],
      patchSegs];
    <|"Code"        -> working,
      "Replaced"    -> DeleteDuplicates[replaced],
      "Identical"   -> DeleteDuplicates[identical],
      "Unmerged"    -> DeleteDuplicates[unmerged],
      "AddedBlocks" -> addedBlocks|>
  ];

(* \:30d7\:30ed\:30f3\:30d7\:30c8\:306b\:542b\:307e\:308c\:308b\:95a2\:6570\:540d\:3092\:30d1\:30c3\:30b1\:30fc\:30b8\:306e\:30a8\:30af\:30b9\:30dd\:30fc\:30c8\:540d\:4e00\:89a7\:3068\:7167\:5c04\:3057\:3066\:63a8\:5b9a *)

(* ============================================================
   \:88dc\:52a9 API \:30c9\:30ad\:30e5\:30e1\:30f3\:30c8 (api_*.md) \:7528\:30d8\:30eb\:30d1\:30fc\:7fa4
   \:88dc\:52a9\:30d1\:30c3\:30b1\:30fc\:30b8 <pkg>_<aux>.wl \:306b\:5bfe\:5fdc\:3059\:308b api_<aux>.md \:3092\:6271\:3046\:3002
   ============================================================ *)

(* api_<aux>.md \:5f62\:5f0f\:306e\:30d5\:30a1\:30a4\:30eb\:540d\:304b\:3092\:5224\:5b9a *)
iIsAuxApiName[s_String] :=
  StringMatchQ[s, "api_" ~~ (LetterCharacter | DigitCharacter | "_") ..];
iIsAuxApiName[___] := False;

(* api_<aux>.md \:307e\:305f\:306f api_<aux> \:304b\:3089 <aux> \:3092\:62bd\:51fa\:3002\:8a72\:5f53\:3057\:306a\:3051\:308c\:3070 None *)
iExtractAuxNameFromApiDoc[docFile_String] :=
  Module[{base = FileBaseName[docFile]},
    If[iIsAuxApiName[base],
      StringDrop[base, 4],  (* "api_" \:524a\:9664 \[RightArrow] "directives" \:7b49 *)
      None
    ]
  ];
iExtractAuxNameFromApiDoc[___] := None;

(* \:88dc\:52a9\:30d1\:30c3\:30b1\:30fc\:30b8\:30bd\:30fc\:30b9\:30d5\:30a1\:30a4\:30eb\:3092\:63a2\:7d22\:3002\:898b\:3064\:304b\:3089\:306a\:3051\:308c\:3070 $Failed *)
iFindAuxPackageSource[packageName_String, auxName_String] :=
  Module[{pkgDir = Global`$packageDirectory, candidates},
    If[!StringQ[pkgDir] || pkgDir === "", Return[$Failed]];
    candidates = {
      FileNameJoin[{pkgDir, packageName <> "_" <> auxName <> ".wl"}],
      FileNameJoin[{pkgDir, packageName, "Kernel", packageName <> "_" <> auxName <> ".wl"}]
    };
    SelectFirst[candidates, FileExistsQ, $Failed]
  ];
iFindAuxPackageSource[___] := $Failed;

(* \:30c9\:30ad\:30e5\:30e1\:30f3\:30c8\:751f\:6210\:30fb\:66f4\:65b0\:6642\:306b docFile \:306b\:5fdc\:3058\:305f sourceCode \:3092\:89e3\:6c7a\:3002
   \:8fd4\:5024 Association:
     "isAux"          -> True/False (\:88dc\:52a9 api_*.md \:304b)
     "auxName"        -> \:88dc\:52a9\:540d (None \:307e\:305f\:306f String)
     "sourceCode"     -> \:4f7f\:7528\:3059\:3079\:304d\:30bd\:30fc\:30b9\:30b3\:30fc\:30c9 (None \:306a\:3089\:88dc\:52a9\:30bd\:30fc\:30b9\:6b20\:843d)
     "effectiveName"  -> \:30c6\:30f3\:30d7\:30ec\:30fc\:30c8\:5185\:3067\:8868\:793a\:3059\:308b\:30d1\:30c3\:30b1\:30fc\:30b8\:540d
     "srcFile"        -> \:53c2\:7167\:3057\:305f\:30bd\:30fc\:30b9\:30d5\:30a1\:30a4\:30eb (Missing[] \:3082\:3042\:308a\:5f97)
   \:88dc\:52a9 api_*.md \:3060\:304c\:88dc\:52a9\:30bd\:30fc\:30b9\:304c\:898b\:3064\:304b\:3089\:306a\:3044\:5834\:5408\:306f sourceCode \:3092 None \:306b\:3057\:3066\:8fd4\:3059
   \:ff08\:547c\:3073\:51fa\:3057\:5074\:3067\:30b9\:30ad\:30c3\:30d7\:51e6\:7406\:3092\:3055\:305b\:308b\:ff09\:3002 *)
iResolveSourceForDoc[packageName_String, docFile_String, defaultSourceCode_String] :=
  Module[{aux, auxSrcFile, src},
    aux = iExtractAuxNameFromApiDoc[docFile];
    If[aux === None,
      Return[<|
        "isAux" -> False, "auxName" -> None,
        "sourceCode" -> defaultSourceCode,
        "effectiveName" -> packageName,
        "srcFile" -> Missing["Default"]|>]];
    auxSrcFile = iFindAuxPackageSource[packageName, aux];
    If[auxSrcFile === $Failed,
      Return[<|
        "isAux" -> True, "auxName" -> aux,
        "sourceCode" -> None,
        "effectiveName" -> packageName <> "_" <> aux,
        "srcFile" -> Missing["NotFound"]|>]];
    src = Quiet @ Check[Import[auxSrcFile, "Text"], None];
    If[!StringQ[src],
      Return[<|
        "isAux" -> True, "auxName" -> aux,
        "sourceCode" -> None,
        "effectiveName" -> packageName <> "_" <> aux,
        "srcFile" -> auxSrcFile|>]];
    <|
      "isAux" -> True, "auxName" -> aux,
      "sourceCode" -> src,
      "effectiveName" -> packageName <> "_" <> aux,
      "srcFile" -> auxSrcFile|>
  ];

(* \:88dc\:52a9\:30d1\:30c3\:30b1\:30fc\:30b8\:306e\:30bd\:30fc\:30b9\:30d5\:30a1\:30a4\:30eb\:540d\:3092\:5168\:3066\:30b9\:30ad\:30e3\:30f3\:3057\:3001\:88dc\:52a9\:540d\:30ea\:30b9\:30c8\:3092\:8fd4\:3059\:3002
   \:898b\:3064\:304b\:3089\:306a\:3051\:308c\:3070\:7a7a\:30ea\:30b9\:30c8\:3002 *)
iScanAuxPackages[packageName_String] :=
  Module[{pkgDir = Global`$packageDirectory, files, prefix, names},
    If[!StringQ[pkgDir] || pkgDir === "", Return[{}]];
    prefix = packageName <> "_";
    files = Join[
      FileNames[prefix <> "*.wl", pkgDir],
      FileNames[prefix <> "*.wl",
        FileNameJoin[{pkgDir, packageName, "Kernel"}]]
    ];
    names = StringDrop[FileBaseName[#], StringLength[prefix]] & /@ files;
    DeleteDuplicates[Select[names, StringLength[#] > 0 &]]
  ];
iScanAuxPackages[___] := {};

(* === 補助 api ドキュメントの内容ハッシュ基準の鮮度判定 (Dropbox の mtime 揺れ対策) ===
   mtime は Dropbox 同期 / 複数PC / git 操作で内容と無関係に変わり、未変更モジュールまで
   再生成してしまう。補助ソースの内容ハッシュを docsDir 内サイドカーに記録し、内容が実際に
   変わったときだけ再生成する。改行(CRLF/LF)差だけの揺れは \r 除去で無視する。 *)
iAuxHashPath[docsDir_String] := FileNameJoin[{docsDir, ".aux_source_hashes.json"}];

iAuxSourceHash[srcFile_String] :=
  Module[{txt = Quiet @ Check[Import[srcFile, "Text"], $Failed]},
    If[!StringQ[txt], Return[$Failed]];
    IntegerString[Hash[StringDelete[txt, "\r"]], 36]];
iAuxSourceHash[___] := $Failed;

iAuxHashRead[docsDir_String] :=
  Module[{p = iAuxHashPath[docsDir], j},
    If[!FileExistsQ[p], Return[<||>]];
    j = Quiet @ Check[Developer`ReadRawJSONString[Import[p, "Text"]], <||>];
    If[AssociationQ[j], j, <||>]];

iAuxHashSet[docsDir_String, auxName_String, hash_String] :=
  Module[{j = iAuxHashRead[docsDir]},
    j[auxName] = hash;
    Quiet @ Check[
      Export[iAuxHashPath[docsDir], Developer`WriteRawJSONString[j],
        "Text", CharacterEncoding -> "UTF-8"], Null]];

(* docFile の対応ソースの現内容ハッシュを基準として記録する。doc 生成成功時に呼び、
   以後の鮮度判定 (ClaudeUpdateDocumentation / PackageCommit DocsGate) を content 基準にする。
   api.md 本体 → 主ソース <pkg>.wl を予約キー "@main" に、api_<aux>.md → 補助ソースを auxName に記録。 *)
iRecordAuxHash[docsDir_String, packageName_String, docFile_String] :=
  Module[{base = FileBaseName[FileNameTake[docFile]], auxName, srcFile, key, h},
    If[base === "api",
      key = "@main"; srcFile = iPackageSourceFile[packageName],
      auxName = iExtractAuxNameFromApiDoc[FileNameTake[docFile]];
      If[auxName === None, Return[]];
      key = auxName; srcFile = iFindAuxPackageSource[packageName, auxName]];
    If[!StringQ[srcFile] || !FileExistsQ[srcFile], Return[]];
    h = iAuxSourceHash[srcFile];
    If[StringQ[h], iAuxHashSet[docsDir, key, h]]];

iAuxMtimeFreshQ[auxSrcFile_String, auxDocFile_String] :=
  Quiet @ Check[
    AbsoluteTime @ FileDate[auxSrcFile, "Modification"] >
    AbsoluteTime @ FileDate[auxDocFile, "Modification"],
    False];

(* 補助 api_*.md を更新対象に入れるべきか判定 (内容ハッシュ基準)。
     - 補助ソース <pkg>_<aux>.wl が見つからない → False (対象外)
     - 補助 api ファイルが存在しない → True (新規作成必要)
     - 記録済みハッシュと現ソース内容ハッシュが異なる → True (内容が実際に変わった)
     - 一致 → False (内容不変。mtime が動いていても再生成しない)
   移行措置: ハッシュ未記録なら従来の mtime 比較で判定しつつ、未変更(doc が新しい)なら
   現ハッシュを基準に記録し、以後は content 基準へ寄せる。内容ハッシュが読めない場合のみ
   mtime にフォールバックする。 *)
iIsAuxApiFresh[packageName_String, auxName_String, docsDir_String] :=
  Module[{auxSrcFile, auxDocFile, curHash, storedHash, mtimeFresh},
    auxSrcFile = iFindAuxPackageSource[packageName, auxName];
    If[auxSrcFile === $Failed, Return[False]];
    auxDocFile = FileNameJoin[{docsDir, "api_" <> auxName <> ".md"}];
    If[!FileExistsQ[auxDocFile], Return[True]];
    curHash = iAuxSourceHash[auxSrcFile];
    If[!StringQ[curHash],
      Return[iAuxMtimeFreshQ[auxSrcFile, auxDocFile]]];
    storedHash = Lookup[iAuxHashRead[docsDir], auxName, None];
    If[storedHash === None,
      mtimeFresh = iAuxMtimeFreshQ[auxSrcFile, auxDocFile];
      If[!mtimeFresh, iAuxHashSet[docsDir, auxName, curHash]];
      Return[mtimeFresh]];
    storedHash =!= curHash
  ];
iIsAuxApiFresh[___] := False;

(* TargetFiles \:30ea\:30b9\:30c8\:306e\:5c55\:958b:
   (1) "api.md" \:304c\:542b\:307e\:308c\:308b\:5834\:5408\:3001\:88dc\:52a9 api_*.md (\:30bd\:30fc\:30b9\:304c\:65b0\:9bae\:306a\:3082\:306e) \:3092\:8ffd\:52a0\:3002
   (2) "examples/*" \:30de\:30fc\:30ab\:30fc\:304c\:542b\:307e\:308c\:308b\:5834\:5408\:3001docsDir/examples \:5185\:306e\:5168 *.md \:306b\:5c55\:958b\:3002 *)
iExpandApiInTargetFiles[targetFiles_List, packageName_String, docsDir_String] :=
  Module[{result = targetFiles, auxNames, auxFile},
    If[MemberQ[result, "api.md"],
      auxNames = iScanAuxPackages[packageName];
      Do[
        auxFile = "api_" <> auxName <> ".md";
        If[!MemberQ[result, auxFile] && iIsAuxApiFresh[packageName, auxName, docsDir],
          AppendTo[result, auxFile]],
        {auxName, auxNames}]];
    (* 2026-07-09: examples/* \:30de\:30fc\:30ab\:30fc\:3092\:5b9f\:5728\:3059\:308b examples/*.md \:5168\:4ef6\:306b\:5c55\:958b *)
    If[MemberQ[result, "examples/*"],
      Module[{exDir = FileNameJoin[{docsDir, "examples"}], exFiles},
        exFiles = If[DirectoryQ[exDir],
          ("examples/" <> FileNameTake[#]) & /@ FileNames["*.md", exDir], {}];
        result = DeleteDuplicates[Join[DeleteCases[result, "examples/*"], exFiles]]]];
    result
  ];
iExpandApiInTargetFiles[targetFiles_, _, _] := targetFiles;

(* Automatic \:7d4c\:8def\:7528: \:65e2\:5b58\:30c9\:30ad\:30e5\:30e1\:30f3\:30c8\:30ea\:30b9\:30c8\:306b\:5bfe\:3057\:3066
     - \:65e2\:5b58\:306e\:88dc\:52a9 api_*.md \:306e\:3046\:3061\:30bd\:30fc\:30b9\:304c\:53e4\:3044\:3082\:306e\:3092\:9664\:5916
     - \:88dc\:52a9\:30bd\:30fc\:30b9\:306f\:5b58\:5728\:3059\:308b\:304c\:88dc\:52a9 api \:304c\:672a\:4f5c\:6210\:306a\:3082\:306e\:3092\:8ffd\:52a0 *)
iFilterAndExpandAuxApi[docs_List, packageName_String, docsDir_String] :=
  Module[{result, auxNames, auxFile},
    result = Select[docs, Function[doc,
      Module[{auxName = iExtractAuxNameFromApiDoc[FileNameTake[doc]]},
        If[auxName === None, True,
          iIsAuxApiFresh[packageName, auxName, docsDir]]]]];
    auxNames = iScanAuxPackages[packageName];
    Do[
      auxFile = "api_" <> auxName <> ".md";
      If[!MemberQ[result, auxFile] && iIsAuxApiFresh[packageName, auxName, docsDir],
        AppendTo[result, auxFile]],
      {auxName, auxNames}];
    result
  ];
iFilterAndExpandAuxApi[docs_, _, _] := docs;

(* \:4f9d\:5b58\:30d1\:30c3\:30b1\:30fc\:30b8\:306e api.md \:3092\:53ce\:96c6\:3059\:308b\:3002
   \:5bfe\:8c61\:30d1\:30c3\:30b1\:30fc\:30b8\:306e\:30bd\:30fc\:30b9\:304b\:3089 Needs["Pkg`"] \:3092\:691c\:51fa\:3057\:3001\:5404\:4f9d\:5b58\:306e api.md \:3092\:8aad\:3080\:3002
   ClaudeUpdatePackage \:306e\:30d7\:30ed\:30f3\:30d7\:30c8\:306b\:4ed8\:52a0\:3057\:3066\:30d1\:30c3\:30b1\:30fc\:30b8\:5883\:754c\:3092\:8d8a\:3048\:305f\:539f\:56e0\:8ffd\:8de1\:3092\:53ef\:80fd\:306b\:3059\:308b\:3002 *)
iCollectDependencyApis[sourceCode_String] :=
  Module[{needsPkgs, apiTexts = {}, pkgDir = Global`$packageDirectory,
          docsDir, apiFiles, content},
    If[!StringQ[pkgDir] || pkgDir === "", Return[""]];
    (* Needs["PackageName`"] \:304b\:3089\:30d1\:30c3\:30b1\:30fc\:30b8\:540d\:3092\:62bd\:51fa *)
    needsPkgs = StringCases[sourceCode,
      RegularExpression["Needs\\[\"([a-zA-Z][a-zA-Z0-9]*)`\"\\]"] :> "$1"];
    needsPkgs = DeleteDuplicates[needsPkgs];
    If[Length[needsPkgs] === 0, Return[""]];
    Do[
      docsDir = iPackageDocsDir[pkg];
      If[StringQ[docsDir] && DirectoryQ[docsDir],
        (* api.md \:3068\:88dc\:52a9 api_*.md \:3092\:5168\:4ef6\:53ce\:96c6\:3002api.md \:3092\:5148\:982d\:306b *)
        apiFiles = Join[
          Select[{FileNameJoin[{docsDir, "api.md"}]}, FileExistsQ],
          Sort @ FileNames["api_*.md", docsDir]
        ];
        Do[
          content = Quiet @ Check[Import[apiF, "Text"], ""];
          If[StringQ[content] && StringLength[content] > 0,
            AppendTo[apiTexts,
              "=== Dependency API: " <> pkg <> " (" <> FileNameTake[apiF] <> ") ===\n" <>
              "(This package is used by the target package via Needs[\"" <> pkg <> "`\"]. " <>
              "Use this API reference to understand available functions when tracing call chains.)\n\n" <>
              content <> "\n\n"]],
          {apiF, apiFiles}]
      ],
    {pkg, needsPkgs}];
    StringJoin[apiTexts]
  ];

(* \:5909\:66f4\:691c\:8a3c: LLM \:30ec\:30b9\:30dd\:30f3\:30b9\:306e VERIFY: \:30bf\:30b0\:3092\:62bd\:51fa\:3057\:3001\:30de\:30fc\:30b8\:5f8c\:306e\:30b3\:30fc\:30c9\:306b\:542b\:307e\:308c\:308b\:304b\:78ba\:8a8d\:3002
   LLM \:304c\:300c\:5909\:66f4\:3057\:305f\:300d\:3068\:4e3b\:5f35\:3059\:308b\:5185\:5bb9\:304c\:5b9f\:969b\:306b\:30b3\:30fc\:30c9\:306b\:53cd\:6620\:3055\:308c\:3066\:3044\:308b\:304b\:3092\:691c\:8a3c\:3059\:308b\:3002
   \:691c\:51fa\:3055\:308c\:306a\:304b\:3063\:305f\:9805\:76ee\:306f\:8b66\:544a\:3068\:3057\:3066\:8fd4\:3055\:308c\:308b\:3002 *)
iVerifyClaimedChanges[response_String, newCode_String] :=
  Module[{verifyLines, missing = {}},
    verifyLines = StringCases[response,
      RegularExpression["VERIFY:\\s*(.+)"] :> "$1"];
    verifyLines = StringTrim /@ verifyLines;
    Do[
      If[!StringContainsQ[newCode, item],
        AppendTo[missing, item]],
    {item, verifyLines}];
    missing
  ];

(* \:672a\:5909\:66f4\:95a2\:6570\:306e\:4fdd\:5168\:691c\:8a3c: LLM \:30ec\:30b9\:30dd\:30f3\:30b9\:306b\:542b\:307e\:308c\:306a\:3044\:95a2\:6570\:304c\:30de\:30fc\:30b8\:3067\:7834\:640d\:3057\:3066\:3044\:306a\:3044\:304b\:78ba\:8a8d\:3002
   origCode \:3068 newCode \:304b\:3089\:95a2\:6570\:30d6\:30ed\:30c3\:30af\:3092\:62bd\:51fa\:3057\:3001LLM \:304c\:5909\:66f4\:3057\:3066\:3044\:306a\:3044\:95a2\:6570\:306e\:5185\:5bb9\:304c
   \:4e00\:81f4\:3059\:308b\:304b\:691c\:8a3c\:3059\:308b\:3002StringReplace \:306e\:8aa4\:30de\:30c3\:30c1\:7b49\:306b\:3088\:308b\:610f\:56f3\:3057\:306a\:3044\:7834\:640d\:3092\:691c\:51fa\:3059\:308b\:3002
   \:623b\:308a\:5024: \:7834\:640d\:304c\:691c\:51fa\:3055\:308c\:305f\:95a2\:6570\:540d\:306e\:30ea\:30b9\:30c8\:ff08\:7a7a\:306a\:3089\:554f\:984c\:306a\:3057\:ff09\:3002 *)
iVerifyUnchangedFunctions[origCode_String, newCode_String, llmResponse_String] :=
  Module[{origBlks, newBlks, llmBlks, unchanged, corrupted = {}},
    origBlks = iExtractFunctions[origCode];
    newBlks  = iExtractFunctions[newCode];
    llmBlks  = iExtractFunctions[llmResponse];
    (* LLM \:30ec\:30b9\:30dd\:30f3\:30b9\:306b\:542b\:307e\:308c\:306a\:3044\:95a2\:6570 = \:5909\:66f4\:3055\:308c\:3066\:3044\:306a\:3044\:306f\:305a\:306e\:95a2\:6570 *)
    unchanged = Complement[Keys[origBlks], Keys[llmBlks]];
    Do[
      Module[{origDef, newDef},
        origDef = Lookup[origBlks, fn, ""];
        newDef  = Lookup[newBlks, fn, ""];
        (* \:5143\:30b3\:30fc\:30c9\:306b\:5b58\:5728\:3057\:3001\:65b0\:30b3\:30fc\:30c9\:3067\:3082\:5b58\:5728\:3059\:308b\:304c\:5185\:5bb9\:304c\:7570\:306a\:308b\:5834\:5408 \[RightArrow] \:7834\:640d *)
        If[origDef =!= "" && newDef =!= "" && origDef =!= newDef,
          AppendTo[corrupted, fn]]],
    {fn, unchanged}];
    corrupted
  ];

(* \:30c6\:30b9\:30c8\:62bd\:51fa\:30fb\:5b9f\:884c: LLM \:30ec\:30b9\:30dd\:30f3\:30b9\:304b\:3089 ===BEGIN_TESTS=== \:ff5e ===END_TESTS=== \:3092\:62bd\:51fa\:3057\:3001
   \:30bb\:30c3\:30b7\:30e7\:30f3\:30c7\:30a3\:30ec\:30af\:30c8\:30ea\:306b test.wl \:3068\:3057\:3066\:4fdd\:5b58\:3059\:308b\:3002
   \:623b\:308a\:5024: \:30c6\:30b9\:30c8\:30b3\:30fc\:30c9\:6587\:5b57\:5217\:ff08\:7a7a\:306a\:3089\:62bd\:51fa\:5931\:6557\:ff09\:3002 *)
iExtractTests[response_String, sessionDir_String] :=
  Module[{testCode, testFile},
    testCode = iExtractBetweenMarkers[response,
      "===BEGIN_TESTS===", "===END_TESTS==="];
    If[testCode === "" || !StringQ[testCode], Return[""]];
    testCode = StringTrim[testCode];
    testFile = FileNameJoin[{sessionDir, "test.wl"}];
    Quiet @ Export[testFile, testCode, "Text"];
    testCode
  ];

(* \:30c6\:30b9\:30c8\:5b9f\:884c: \:30c6\:30b9\:30c8\:30b3\:30fc\:30c9\:4e2d\:306e\:5404 Boolean \:5f0f\:3092\:8a55\:4fa1\:3057\:3001\:7d50\:679c\:3092\:8fd4\:3059\:3002
   $testSourceCode \:306b\:30de\:30fc\:30b8\:5f8c\:306e\:30bd\:30fc\:30b9\:30b3\:30fc\:30c9\:3092\:675f\:7e1b\:3057\:3066\:304b\:3089\:30c6\:30b9\:30c8\:3092\:8a55\:4fa1\:3059\:308b\:3002
   \:5404\:30c6\:30b9\:30c8\:306f (* \:30b3\:30e1\:30f3\:30c8 *) \:306e\:76f4\:5f8c\:306b Boolean \:5f0f\:304c\:6765\:308b\:5f62\:5f0f\:3092\:60f3\:5b9a\:3002
   \:623b\:308a\:5024: <|"passed" -> {\:30c6\:30b9\:30c8\:540d...}, "failed" -> {\:30c6\:30b9\:30c8\:540d...}|> *)
iRunUpdateTests[testCode_String, newCode_String, nb_NotebookObject] :=
  Module[{blocks, results = <|"passed" -> {}, "failed" -> {}|>,
          currentLabel = "", val},
    (* Global`$testSourceCode \:306b\:8a2d\:5b9a: ToExpression \:304c\:53c2\:7167\:3067\:304d\:308b\:3088\:3046\:306b\:3059\:308b\:3002
       Block \:3060\:3068 ToExpression \:5185\:3067\:5225\:30b3\:30f3\:30c6\:30ad\:30b9\:30c8\:306e\:30b7\:30f3\:30dc\:30eb\:306b\:306a\:308a $Failed \:306b\:306a\:308b\:3002 *)
    Global`$testSourceCode = newCode;
    Internal`WithLocalSettings[Null,
      (* \:30c6\:30b9\:30c8\:30b3\:30fc\:30c9\:3092\:30b3\:30e1\:30f3\:30c8\:533a\:5207\:308a\:3067\:30d6\:30ed\:30c3\:30af\:5206\:5272\:3002
         \:8907\:6570\:884c\:306b\:307e\:305f\:304c\:308b Module[...] \:7b49\:30921\:30c6\:30b9\:30c8\:3068\:3057\:3066\:6271\:3046\:3002 *)
      blocks = StringSplit[testCode,
        RegularExpression["(?m)^\\(\\*\\s*(.+?)\\s*\\*\\)\\s*$"] :>
        "$1"];
      Do[
        Module[{item = StringTrim[b]},
          Which[
            item === "", Null,
            (* \:30b3\:30e1\:30f3\:30c8\:304b\:3089\:62bd\:51fa\:3055\:308c\:305f\:30e9\:30d9\:30eb *)
            !StringContainsQ[item, "["] && !StringContainsQ[item, "="],
              currentLabel = item,
            (* \:30c6\:30b9\:30c8\:5f0f *)
            True,
              val = Quiet @ Check[ToExpression[item], $Failed];
              If[TrueQ[val],
                AppendTo[results["passed"],
                  If[currentLabel =!= "", currentLabel, StringTake[item, UpTo[60]]]],
                AppendTo[results["failed"],
                  If[currentLabel =!= "", currentLabel, StringTake[item, UpTo[60]]] <>
                  " \[RightArrow] " <> ToString[val]]];
              currentLabel = ""
          ]],
      {b, blocks}],
      (* \:30af\:30ea\:30fc\:30f3\:30a2\:30c3\:30d7: \:30b0\:30ed\:30fc\:30d0\:30eb\:5909\:6570\:3092\:9664\:53bb *)
      Quiet[Global`$testSourceCode =.]];
    results
  ];

(* \:65e5\:672c\:8a9e\:30ad\:30fc\:30ef\:30fc\:30c9 \[RightArrow] \:95a2\:9023\:95a2\:6570\:30b0\:30eb\:30fc\:30d7\:306e\:30de\:30c3\:30d4\:30f3\:30b0\:3082\:4f7f\:7528 *)
iGuessTargetFunctions[prompt_String, allFuncNames_List] :=
  iGuessTargetFunctions[prompt, allFuncNames, ""];

iGuessTargetFunctions[prompt_String, allFuncNames_List, sourceCode_String] :=
  Module[{words, hits, kwMap, kwHits, usageHits = {}},
    (* \:82f1\:8a9e\:95a2\:6570\:540d\:306e\:76f4\:63a5\:30de\:30c3\:30c1 *)
    words = StringCases[prompt, RegularExpression["[a-zA-Z\\$][a-zA-Z0-9\\$]+"]];
    hits  = Select[allFuncNames, MemberQ[words, #] &];

    (* \:65e5\:672c\:8a9e\:30ad\:30fc\:30ef\:30fc\:30c9 \[RightArrow] \:95a2\:9023\:95a2\:6570\:30b0\:30eb\:30fc\:30d7 *)
    kwMap = {
      {"\:6a5f\:5bc6", "Confidential", "confidential", "NonConfidential", "\:89e3\:9664"} ->
        {"Confidential", "NonConfidential", "MarkConfidential", "UnmarkConfidential",
         "IsConfidential", "ScanConfidentialCells",
         "iConfidentialCellEpilog", "iEnsureCellEpilog", "iInstallCellEpilog",
         "iCellUsesConfidentialSymbol", "iExtractCellVarNames",
         "iExtractCellAssignedNames", "iMarkSelectedConfidential",
         "iUnmarkSelectedConfidential", "iScanAndReport",
         "iShowConfidentialVars", "iIsConfidentialCell",
         "$confidentialSymbols"},
      {"\:30d1\:30ec\:30c3\:30c8", "Palette", "palette"} ->
        {"ShowClaudePalette", "iClaudePaletteButton",
         "iInsertClaudeQueryTemplate", "iInsertClaudeEvalTemplate",
         "iInsertContinueEvalTemplate", "iInsertChatCell",
         "iEnsureSourceVaultStyleSheet"},
      {"\:30bb\:30c3\:30b7\:30e7\:30f3", "Session", "session", "\:5c65\:6b74"} ->
        {"CreateClaudeSession", "ClaudeShowHistory", "ClaudeListSessions",
         "iSessionTag", "iSessionAppend", "iSessionHistory",
         "iSessionToContext", "iSessionHistoryWithInherit"},
      {"\:30af\:30a8\:30ea", "Query", "query", "\:8cea\:554f"} ->
        {"ClaudeQuery", "iClaudeQueryRaw",
         "iClaudeQueryAsyncWithProgress"},
      {"Eval", "\:8a55\:4fa1", "\:5b9f\:884c", "\:30bf\:30b9\:30af"} ->
        {"ClaudeEval", "ContinueEval", "iClaudeEvalImpl", "iContinueEvalImpl", "iScheduleAt"},
      {"\:30d0\:30c3\:30af\:30a2\:30c3\:30d7", "\:30ea\:30b9\:30c8\:30a2", "\:66f4\:65b0", "Update", "Restore"} ->
        {"ClaudeUpdatePackage", "ClaudeRestorePackage",
         "ClaudeUpdatePackageHistory", "ClaudeBackupDataset", "ClaudeConvertToPaclet", "ClaudeCreateDocumentation", "ClaudeUpdateDocumentation", "ClaudeCreatePackage",
         "iExtractFunctions", "iGuessTargetFunctions", "iExpandWithDeps"},
      {"\:30ce\:30fc\:30c8\:30d6\:30c3\:30af", "\:30b3\:30f3\:30c6\:30ad\:30b9\:30c8", "Notebook", "context"} ->
        {"iCaptureNotebookContext", "nbPrint", "cellToText"},
      {"\:30d7\:30ed\:30f3\:30d7\:30c8", "prompt", "Prompt"} ->
        {"iNormalizePrompt", "iExpandSymbolRefs", "iDescribeSymbol",
         "$claudeQueryPrefix", "$claudeMathPromptPrefix"},
      {"\:4ed5\:69d8", "Spec", "spec", "\:30b9\:30da\:30c3\:30af"} ->
        {"ClaudeSpec", "iClaudeSpecImpl", "$claudeSpecPrefix", "$specCellOpts",
         "iCollectCellContent", "iRunClaudeEvalFromCells", "iRunClaudeQueryFromCells", "iRunClaudeSpecFromCells"},
      {"\:30c7\:30d0\:30c3\:30b0", "\:30ec\:30d3\:30e5\:30fc", "Debug", "Review"} ->
        {"ClaudeDebug", "ClaudeReview"},
      {"Directive", "\:30c7\:30a3\:30ec\:30af\:30c6\:30a3\:30d6", "CLAUDE.md", "SKILL", "\:30b9\:30ad\:30eb"} ->
        {"ClaudeAddDirective", "ClaudeRestoreDirective", "ClaudeListDirectives",
         "ClaudeDirectiveBackupDataset",
         "iDirectivesSourceDir", "iDirectiveFilePath", "iBackupDirectiveFile",
         "iLatestDirectiveBackup", "iRunInstallClaudeDirectives"}
    };

    kwHits = Flatten[
      Cases[kwMap,
        Rule[kws_List, funcs_List] /;
          AnyTrue[kws, StringContainsQ[prompt, #] &] :> funcs
      ]
    ];

    (* \:82f1\:8a9e\:30de\:30c3\:30c1 + \:30ad\:30fc\:30ef\:30fc\:30c9\:30de\:30c3\:30c1\:3092\:7d71\:5408\:3057\:3001\:5b9f\:5728\:3059\:308b\:95a2\:6570\:540d\:306e\:307f *)
    hits = Union[hits, Select[kwHits, MemberQ[allFuncNames, #] &]];

    (* Usage + Body \:30d9\:30fc\:30b9\:30de\:30c3\:30c1: \:30bd\:30fc\:30b9\:30b3\:30fc\:30c9\:4e2d\:306e\:95a2\:6570\:3092\:691c\:51fa\:3002
       1. \:307e\:305a\:95a2\:6570\:672c\:4f53\:306b\:30d7\:30ed\:30f3\:30d7\:30c8\:306e\:8907\:5408\:8a9e\:ff083\:6587\:5b57\:4ee5\:4e0a\:306e\:6f22\:5b57/\:30ab\:30bf\:30ab\:30ca\:5217\:ff09\:304c\:542b\:307e\:308c\:308b\:95a2\:6570\:3092\:691c\:51fa\:3002
          \:30dc\:30bf\:30f3\:30e9\:30d9\:30eb\:7b49\:306e UI \:30c6\:30ad\:30b9\:30c8\:3092\:542b\:3080\:95a2\:6570\:3092\:6b63\:78ba\:306b\:7279\:5b9a\:3067\:304d\:308b\:3002
       2. \:672c\:4f53\:30de\:30c3\:30c1\:304c\:7a7a\:306a\:3089 usage \:6587\:5b57\:5217\:3078\:306e bi-gram \:30de\:30c3\:30c1\:306b\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:3002 *)
    If[StringLength[sourceCode] > 0 && Length[hits] === 0,
      Module[{promptCompounds, bodyHits = {}, usagePairs, promptKws, matchedFuncs,
              allBlks},
        (* \:8907\:5408\:8a9e\:62bd\:51fa: 4\:6587\:5b57\:4ee5\:4e0a\:306e\:6f22\:5b57\:30fb\:30ab\:30bf\:30ab\:30ca\:9023\:7d9a\:5217\:3002
           3\:6587\:5b57\:4ee5\:4e0b\:ff08\:30dc\:30bf\:30f3\:3001\:524a\:9664\:3001\:5c55\:958b\:7b49\:ff09\:306f\:6c4e\:7528\:3059\:304e\:3066\:5927\:91cf\:8aa4\:30de\:30c3\:30c1\:306e\:539f\:56e0\:306b\:306a\:308b\:3002 *)
        promptCompounds = DeleteDuplicates[
          StringCases[prompt, RegularExpression["[\\x{4E00}-\\x{9FFF}\\x{30A0}-\\x{30FF}]{4,}"]]];
        (* \:82f1\:8a9e\:30ad\:30fc\:30ef\:30fc\:30c9\:3082\:542b\:3081\:308b\:ff085\:6587\:5b57\:4ee5\:4e0a\:ff09 *)
        promptCompounds = Join[promptCompounds,
          DeleteDuplicates[StringCases[prompt, RegularExpression["[a-zA-Z]{5,}"]]]];

        (* Phase 1: \:95a2\:6570\:672c\:4f53\:30de\:30c3\:30c1\:ff08\:8907\:5408\:8a9e\:3067\:691c\:7d22 \[LongDash] \:9ad8\:7cbe\:5ea6\:ff09 *)
        If[Length[promptCompounds] > 0,
          allBlks = iExtractFunctions[sourceCode];
          Do[
            Module[{body = Lookup[allBlks, fn, ""]},
              If[body =!= "" &&
                 AnyTrue[promptCompounds, StringContainsQ[body, #] &],
                AppendTo[bodyHits, fn]]],
          {fn, allFuncNames}];
          bodyHits = DeleteDuplicates[bodyHits]];

        If[Length[bodyHits] > 0 && Length[bodyHits] <= 10,
          (* \:672c\:4f53\:30de\:30c3\:30c1\:6210\:529f: \:9069\:5207\:306a\:6570\:306a\:306e\:3067\:3053\:308c\:3092\:4f7f\:3046 *)
          hits = Union[hits, bodyHits],
          (* bodyHits > 10: \:8907\:5408\:8a9e\:304c\:6c4e\:7528\:3059\:304e\:308b \[RightArrow] \:5168\:4f53\:9001\:4fe1\:306b\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af *)
          If[Length[bodyHits] > 10, Null,
          (* bodyHits = 0: Phase 2: usage \:30d9\:30fc\:30b9 bi-gram \:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af *)
          usagePairs = StringCases[sourceCode,
            RegularExpression["([a-zA-Z\\$][a-zA-Z0-9\\$]*)::usage\\s*=\\s*\n?\\s*\"([^\"]*(?:\"\\s*<>\\s*\n?\\s*\"[^\"]*)*)\""] :>
            {"$1", "$2"}];
          If[Length[usagePairs] > 0,
            promptKws = Union[
              StringCases[prompt, RegularExpression["[\\x{4E00}-\\x{9FFF}\\x{30A0}-\\x{30FF}]+"]],
              StringCases[prompt, RegularExpression["[a-zA-Z]{3,}"]]];
            promptKws = Flatten[
              If[StringLength[#] > 3,
                Join[{#}, StringPartition[#, 2, 1]],
                {#}] & /@ promptKws];
            promptKws = DeleteDuplicates[Select[promptKws, StringLength[#] >= 2 &]];
            matchedFuncs = {};
            Do[
              Module[{fn = pair[[1]], usageText = pair[[2]]},
                If[AnyTrue[promptKws, StringContainsQ[usageText, #, IgnoreCase -> True] &],
                  AppendTo[matchedFuncs, fn]]],
            {pair, usagePairs}];
            usageHits = Select[matchedFuncs, MemberQ[allFuncNames, #] &];
            hits = Union[hits, usageHits]
          ]]
        ]
      ]
    ];
    hits
  ];


(* \:4e3b\:95a2\:6570\:304c\:547c\:3073\:51fa\:3059\:30d8\:30eb\:30d1\:30fc\:3082\:542b\:3081\:308b\:3002
   \:5c55\:958b\:4e0a\:9650: \:7d50\:679c\:304c 40 \:95a2\:6570\:3092\:8d85\:3048\:305f\:3089\:5143\:306e\:30bf\:30fc\:30b2\:30c3\:30c8\:306e\:307f\:8fd4\:3059\:3002
   \:77ed\:3044\:95a2\:6570\:540d\:ff082\:6587\:5b57\:4ee5\:4e0b\:ff09\:306e\:8aa4\:30de\:30c3\:30c1\:3082\:9664\:5916\:3059\:308b\:3002 *)
iExpandWithDeps[targets_List, blocks_Association] :=
  Module[{allNames = Keys[blocks], result = targets, scan},
    scan = targets;
    Scan[Function[fn,
      Module[{body, called},
        body  = Lookup[blocks, fn, ""];
        (* 3\:6587\:5b57\:4ee5\:4e0a\:306e\:95a2\:6570\:540d\:306e\:307f\:4f9d\:5b58\:3068\:3057\:3066\:691c\:51fa\:ff08iL \:7b49\:306e\:8aa4\:30de\:30c3\:30c1\:9632\:6b62\:ff09 *)
        called = Select[allNames,
          StringLength[#] >= 3 && fn =!= # && StringContainsQ[body, #] &];
        result = Union[result, called]
      ]
    ], scan];
    (* \:5c55\:958b\:4e0a\:9650\:30c1\:30a7\:30c3\:30af: \:904e\:5270\:5c55\:958b\:306f\:5168\:4f53\:9001\:4fe1\:3088\:308a\:54c1\:8cea\:304c\:60aa\:3044 *)
    If[Length[result] > 40, targets, result]
  ];

