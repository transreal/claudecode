      (* Instruction: LLM \:304c\:751f\:6210\:3057\:305f\:30b3\:30fc\:30c9 (\:5b89\:5168: LLM \:51fa\:529b) *)
      instruction = If[StringQ[code],
        "```\n" <> StringTake[code, UpTo[300]] <> "\n```",
        If[StringQ[textResp],
          StringTake[textResp, UpTo[120]],
          "(no code)"]];
      
      (* Summary: \:691c\:8a3c\:5224\:5b9a + \:6210\:5426\:306e\:307f\:3002\:5909\:6570\:5024\:30fb\:5b9f\:884c\:7d50\:679c\:306f\:542b\:3081\:306a\:3044 *)
      summary = Which[
        AssociationQ[execResult] && TrueQ[execResult["Success"]],
          "Executed successfully",
        AssociationQ[execResult],
          "Execution failed: " <>
            StringTake[Lookup[execResult, "Error", "unknown"], UpTo[80]],
        StringQ[textResp],
          "(text-only response)",
        True, "(no action)"];
      
      status = If[TrueQ[Lookup[msg, "Compacted", False]],
        "Completed",
        If[Lookup[st, "Status", "Done"] === "Failed" && i === Length[msgs],
          "Failed", "Completed"]];
      
      (* InEdges: \:6700\:521d\:306e\:30bf\:30fc\:30f3\:306f\:30aa\:30fc\:30b1\:30b9\:30c8\:30ec\:30fc\:30bf\:304b\:3089\:3001\:4ee5\:964d\:306f\:524d\:30bf\:30fc\:30f3\:304b\:3089 *)
      inEdges = If[i === 1,
        If[KeyExistsQ[graphNodes, orchestratorNodeID],
          {<|"From" -> orchestratorNodeID, "Type" -> "DataFlow"|>},
          {}],
        If[prevNodeID =!= None,
          {<|"From" -> prevNodeID, "Type" -> "Continuation"|>},
          {}]];
      
      (* v2026-04-20 T03: \:6700\:7d42 turn \:306e\:5834\:5408\:306f runtime state \:306e
         FailureInfo / Status \:3092\:62bd\:51fa\:3057\:3066\:30ce\:30fc\:30c9\:5c5e\:6027\:306b\:683c\:7d0d\:3002
         UserDenied / ValidationError \:306a\:3069\:306f\:3053\:3053\:3067\:8a18\:9332\:3055\:308c\:308b\:3002 *)
      Module[{failureInfo, turnDecision = None, turnReason = None,
              turnReasonClass = None, runtimeStatus},
        failureInfo  = Lookup[st, "FailureInfo", None];
        runtimeStatus = Lookup[st, "Status", "Done"];
        If[AssociationQ[failureInfo] && i === Length[msgs],
          turnReasonClass = Lookup[failureInfo, "ReasonClass", None];
          turnReason      = Lookup[failureInfo, "VisibleExplanation",
            Lookup[failureInfo, "Reason", None]];
          turnDecision    = Lookup[failureInfo, "Decision",
            If[runtimeStatus === "Failed", "Failed", None]]];
        If[!KeyExistsQ[graphNodes, turnNodeID],
          graphNodes[turnNodeID] = iNewLLMNode[turnNodeID, nodeType,
            accessLevel,
            <|"Instruction"     -> instruction,
              "ResponseSummary" -> summary,
              "Status"          -> status,
              "Time"            -> Lookup[msg, "Timestamp", None],
              "Type"            -> "runtime-turn",
              "InEdges"         -> inEdges,
              "OutEdges"        -> {},
              "Decision"        -> turnDecision,
              "ReasonClass"     -> turnReasonClass,
              "Reason"          -> turnReason|>]];
      
        (* \:524d\:30ce\:30fc\:30c9\:306e OutEdges \:3092\:66f4\:65b0 *)
        Module[{fromNodeID = If[i === 1, orchestratorNodeID, prevNodeID]},
          If[fromNodeID =!= None && KeyExistsQ[graphNodes, fromNodeID],
            graphNodes[fromNodeID]["OutEdges"] = Append[
              Lookup[graphNodes[fromNodeID], "OutEdges", {}],
              <|"To" -> turnNodeID,
                "Type" -> If[i === 1, "DataFlow", "Continuation"]|>]]];
      ];
      
      prevNodeID = turnNodeID,
    {i, Length[msgs]}];
    
    (* \[HorizontalLine]\[HorizontalLine] Phase 28: \:5b64\:7acb DAG \:30ce\:30fc\:30c9\:306e\:9061\:53ca\:63a5\:7d9a \[HorizontalLine]\[HorizontalLine]
       iLLMGraphDAGRecordHistory \:306f\:30bf\:30a4\:30df\:30f3\:30b0\:4e0a\:30bf\:30fc\:30f3\:30ce\:30fc\:30c9\:4f5c\:6210\:524d\:306b
       \:5b9f\:884c\:3055\:308c\:308b\:3053\:3068\:304c\:3042\:308a\:ff08\:4e2d\:9593\:30bf\:30fc\:30f3\:306e continuation \:6642\:ff09\:3001
       \:30aa\:30fc\:30b1\:30b9\:30c8\:30ec\:30fc\:30bf \[RightArrow] \:30eb\:30fc\:30c8 DAG \:30ce\:30fc\:30c9\:306e Produces \:8fba\:304c\:6b20\:843d\:3059\:308b\:3002
       \:3053\:3053\:3067\:30bf\:30fc\:30f3\:30ce\:30fc\:30c9\:4f5c\:6210\:5f8c\:306b\:9061\:53ca\:7684\:306b\:63a5\:7d9a\:3059\:308b\:3002
       
       \:691c\:51fa\:65b9\:6cd5: DAG \:30ce\:30fc\:30c9 (dag-* prefix) \:306e OutEdges \:306b
       \:3053\:306e\:30e9\:30f3\:30bf\:30a4\:30e0\:306e\:30bf\:30fc\:30f3\:30ce\:30fc\:30c9\:3078\:306e Produces \:8fba\:304c\:3042\:308b\:304c\:3001
       \:30aa\:30fc\:30b1\:30b9\:30c8\:30ec\:30fc\:30bf\:304b\:3089\:306e InEdges \:3092\:6301\:305f\:306a\:3044\:30eb\:30fc\:30c8 DAG \:30ce\:30fc\:30c9\:3002 *)
    If[KeyExistsQ[graphNodes, orchestratorNodeID],
      Module[{allTurnIDs, dagPrefixesToFix = <||>},
        (* \:3053\:306e\:30e9\:30f3\:30bf\:30a4\:30e0\:306e\:5168\:30bf\:30fc\:30f3\:30ce\:30fc\:30c9 ID \:3092\:53ce\:96c6 *)
        allTurnIDs = Table[
          "rt-" <> runtimeId <> "-turn" <>
            ToString[Lookup[msgs[[j]], "Turn", j]],
          {j, Length[msgs]}];
        
        (* DAG \:30ce\:30fc\:30c9\:306e OutEdges \:3092\:30b9\:30ad\:30e3\:30f3\:3057\:3001
           \:30bf\:30fc\:30f3\:30ce\:30fc\:30c9\:3078\:306e Produces \:8fba\:3092\:6301\:3064\:3082\:306e\:3092\:767a\:898b *)
        KeyValueMap[Function[{nid, node},
          If[StringQ[nid] && StringStartsQ[nid, "dag-"],
            Scan[Function[{edge},
              If[Lookup[edge, "Type", ""] === "Produces" &&
                 MemberQ[allTurnIDs, Lookup[edge, "To", ""]],
                (* DAG prefix \:3092\:62bd\:51fa: "dag-TIMESTAMP" *)
                Module[{parts = StringSplit[nid, "-"]},
                  If[Length[parts] >= 3,
                    dagPrefixesToFix[
                      StringJoin[Riffle[Take[parts, 2], "-"]]] =
                        True]]]],
              Lookup[node, "OutEdges", {}]]]],
          graphNodes];
        
        (* \:5404 DAG \:30bb\:30c3\:30c8\:306e\:30eb\:30fc\:30c8\:30ce\:30fc\:30c9\:3092\:7279\:5b9a\:3057\:63a5\:7d9a *)
        Do[
          Module[{dagNodeIDs, rootIDs},
            dagNodeIDs = Select[Keys[graphNodes],
              StringQ[#] && StringStartsQ[#, pfx <> "-"] &];
            (* \:30eb\:30fc\:30c8 DAG \:30ce\:30fc\:30c9: DAGDependency \:306e InEdge \:3092\:6301\:305f\:306a\:3044 *)
            rootIDs = Select[dagNodeIDs, Function[{did},
              !AnyTrue[Lookup[graphNodes[did], "InEdges", {}],
                Lookup[#, "Type", ""] === "DAGDependency" &]]];
            Do[
              (* \:91cd\:8907\:9632\:6b62: \:65e2\:306b\:30aa\:30fc\:30b1\:30b9\:30c8\:30ec\:30fc\:30bf\:304b\:3089\:306e\:8fba\:304c\:3042\:308b\:304b\:78ba\:8a8d *)
              If[!AnyTrue[
                   Lookup[graphNodes[rid], "InEdges", {}],
                   Lookup[#, "From", ""] === orchestratorNodeID &&
                   Lookup[#, "Type", ""] === "Produces" &],
                graphNodes[orchestratorNodeID]["OutEdges"] = Append[
                  Lookup[graphNodes[orchestratorNodeID], "OutEdges", {}],
                  <|"To" -> rid, "Type" -> "Produces"|>];
                graphNodes[rid]["InEdges"] = Append[
                  Lookup[graphNodes[rid], "InEdges", {}],
                  <|"From" -> orchestratorNodeID,
                    "Type" -> "Produces"|>]],
              {rid, rootIDs}]],
          {pfx, Keys[dagPrefixesToFix]}]]];
    
    graph["Nodes"]       = graphNodes;
    graph["LastModified"] = AbsoluteTime[];
    $iLLMGraphCache = graph;
    Quiet @ iLLMGraphFlush[nb];
  ];

(* \:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550
