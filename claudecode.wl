                    ]];
                (* CUDA \:30dd\:30b9\:30c8\:30d7\:30ed\:30bb\:30b9: .cu \:30d5\:30a1\:30a4\:30eb\:62bd\:51fa\:30fb\:30b3\:30f3\:30d1\:30a4\:30eb *)
                If[isCuda && TrueQ[$iCUDAExtensionLoaded],
