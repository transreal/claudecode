iMakeTempDir[prefix_String:"claudecode-anthropic-"] := Module[{dir},
  dir = FileNameJoin[{
    $TemporaryDirectory,
    prefix <> IntegerString[Round[AbsoluteTime[]*1000]] <> "-" <>
      IntegerString[RandomInteger[10^9]]
  }];
  CreateDirectory[dir, CreateIntermediateDirectories -> True]
