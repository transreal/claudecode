                 "ClaudeRuntime: Processing... "] <>
              ToString[elapsed] <> "s"
          ];
          iSafeSetWindowStatus[nb, statusText],

          (* \[HorizontalLine]\[HorizontalLine] \:975e runtime DAG: \:5f93\:6765\:306e\:6c4e\:7528\:8868\:793a \[HorizontalLine]\[HorizontalLine] *)
          If[Length[running] > 0,
            iSafeSetWindowStatus[nb,
