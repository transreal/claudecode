(* ClaudeShowHistory["name"]: \:540d\:524d\:6307\:5b9a\:306e\:5c65\:6b74\:8868\:793a *)
ClaudeShowHistory[name_String] := Module[{nb, tag},
  nb = EvaluationNotebook[];
