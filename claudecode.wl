    catRunning = Counts[
      Lookup[nodes[#], "category", "?"] & /@ runningIds];

    (* \[HorizontalLine]\[HorizontalLine] \:540c\:4e00\:30a8\:30e9\:30fc\:9023\:7d9a\:5931\:6557\:306b\:3088\:308b\:81ea\:52d5\:505c\:6b62 \[HorizontalLine]\[HorizontalLine]
       Auto-stop \:306f failed \:30ce\:30fc\:30c9\:304c\:5b58\:5728\:3059\:308b\:5834\:5408\:306e\:307f\:610f\:5473\:304c\:3042\:308b\:3002
       \:62bd\:8c61\:30ab\:30c6\:30b4\:30ea\:5225 (cli, cli-vision, process, sync) \:306b\:5931\:6557\:30a8\:30e9\:30fc\:3092\:96c6\:8a08\:3057\:3001
       \:540c\:4e00\:30a8\:30e9\:30fc\:304c\:95be\:5024\:3092\:8d85\:3048\:305f\:3089\:540c\:62bd\:8c61\:30ab\:30c6\:30b4\:30ea\:306e pending \:30ce\:30fc\:30c9\:3092
       \:5168\:3066 failed \:306b\:3059\:308b (rate limit \:5bfe\:7b56)\:3002
       "Dependency failed" \:3084 "Stopped by user" \:306f\:9664\:5916\:3002 *)
    If[$LLMGraphAutoStopThreshold > 0 && Length[failedIds] > 0,
      Module[{catErrors = <||>, autoStopCount = 0,
              catMap = Lookup[taskDesc, "categoryMap", <||>],
              resolveAbsCat},
        resolveAbsCat = Function[concreteCat,
          Lookup[catMap, concreteCat, concreteCat]];
        (* failed \:30ce\:30fc\:30c9\:306e\:307f\:30b9\:30ad\:30e3\:30f3 (\:4ee5\:524d\:306f\:5168\:30ce\:30fc\:30c9\:30b9\:30ad\:30e3\:30f3) *)
        Scan[With[{n = nodes[#]},
          Module[{absCat, err},
            absCat = resolveAbsCat[Lookup[n, "category", "other"]];
            err = ToString[Lookup[n, "error", ""]];
            If[!StringContainsQ[err, "Dependency failed" | "Stopped by user" | "Auto-stopped"],
              If[!KeyExistsQ[catErrors, absCat], catErrors[absCat] = <||>];
              catErrors[absCat][err] = Lookup[catErrors[absCat], err, 0] + 1]]] &,
          failedIds];
        Do[Module[{errCounts = catErrors[absCat], best, maxErr, maxCount},
          best = First[SortBy[Normal[errCounts], -Last[#] &]];
          maxErr   = First[best];
          maxCount = Last[best];
          If[maxCount >= $LLMGraphAutoStopThreshold,
            (* pending \:30ce\:30fc\:30c9\:306e\:307f\:30b9\:30ad\:30e3\:30f3 (\:4ee5\:524d\:306f\:5168\:30ce\:30fc\:30c9\:30b9\:30ad\:30e3\:30f3) *)
            Scan[With[{n = nodes[#]},
              Module[{nAbsCat},
                nAbsCat = resolveAbsCat[Lookup[n, "category", "other"]];
