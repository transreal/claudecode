      (* 5. \:73fe\:5728\:306e\:30c7\:30a3\:30ec\:30af\:30c8\:30ea *)
      FileNameJoin[{Directory[], pkgName <> ".wl"}],
      FileNameJoin[{Directory[], pkgName}]
    };
    SelectFirst[Select[candidates, StringQ], FileExistsQ, $Failed]
  ];

