   \:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550 *)


iClaudeUpdatePackageImpl[packageName_String, updatePrompt_, targetFuncsOpt_, updateApiMd_:True] :=
  With[{nb = Replace[EvaluationNotebook[],
    Except[_NotebookObject] :>
      Replace[$iRetryTargetNotebook,
        Except[_NotebookObject] :> InputNotebook[]]]},
  Module[{srcFile, currentCode, prompt,
          beginMark, endMark, timestamp, sessionDir, bdir,
          allBlocks, allNames, targets, targetCode,
          jsPlaceholder, jsBlock, updatePromptNorm, imgDirs, jobId,
          continueAnchorTag = None, preBackupFile = "", cudaRequested = False,
          histBlock, fnIndexBlock, inlineFull},

  iPrecisionConfidentialCheck[nb];
  srcFile = iPackageSourceFile[packageName];
  If[!FileExistsQ[srcFile],
    nbPrint[nb, iL["\:30d5\:30a1\:30a4\:30eb\:304c\:898b\:3064\:304b\:308a\:307e\:305b\:3093: ", "File not found: "] <> srcFile]; Return[$Failed]];

  (* \:6392\:4ed6\:30ed\:30c3\:30af: \:540c\:4e00\:30d1\:30c3\:30b1\:30fc\:30b8\:306e\:4e26\:5217\:66f4\:65b0\:3092\:9632\:6b62 *)
  If[!iAcquirePackageLock[packageName, nb], Return[$Failed]];

  (* Phase 3: \:30b5\:30d6\:30b0\:30e9\:30d5\:8a18\:9332\:958b\:59cb *)
  Quiet @ iLLMGraphBeginSubgraph[nb, iSessionTag[], packageName];

  (* references \:30d5\:30a9\:30eb\:30c0\:3092\:53c2\:7167\:53ef\:80fd\:306b\:3059\:308b *)
  iEnsureReferencesAccessible[packageName];

  (* \:30bb\:30af\:30b7\:30e7\:30f3\:30d8\:30c3\:30c0\:30fc\:3068\:30b8\:30e7\:30d6\:30a2\:30f3\:30ab\:30fc\:306e\:914d\:7f6e *)
  If[TrueQ[$iContinueUpdateFlag],
    (* ContinueUpdate: \:30dc\:30bf\:30f3\:30bb\:30eb\:306e\:76f4\:5f8c\:ff08\:73fe\:5728\:4f4d\:7f6e\:ff09\:306b\:30d8\:30c3\:30c0\:30fc\:3068\:30a2\:30f3\:30ab\:30fc\:3092\:914d\:7f6e *)
    NBAccess`NBWriteCell[nb, Cell[
      "\[FilledRightTriangle] ContinueUpdate: " <> packageName <>
      " (" <> DateString[Now, {"Year", "/", "Month", "/", "Day", " ", "Hour24", ":", "Minute"}] <> ")",
      "Subsubsection", CellGroupingRules -> {"SectionGrouping", 68}]];
    continueAnchorTag = "continue-anchor-" <> ToString[UnixTime[]] <> "-" <> ToString[RandomInteger[99999]];
    NBAccess`NBWriteCell[nb, Cell["", "Output", CellOpen -> False,
      ShowCellBracket -> False, CellTags -> {continueAnchorTag}]];
    jobId = None,
    (* \:901a\:5e38: EvaluationCell \:3092\:57fa\:6e96 *)
    iWriteSectionHeaderBeforeEvalCell[nb,
      "\[FilledRightTriangle] ClaudeUpdatePackage: " <> packageName <>
      " (" <> DateString[Now, {"Year", "/", "Month", "/", "Day", " ", "Hour24", ":", "Minute"}] <> ")"];
    jobId = iBeginJobAtCapturedCell[nb]
  ];

  updatePromptNorm = iNormalizePrompt[updatePrompt];
  imgDirs = updatePromptNorm["imageDirs"];
  currentCode = Import[srcFile, "Text"];
  Quiet @ iLLMGraphLogSubStep["read-source", "Local",
    ToString[StringLength[currentCode]] <> " chars"];
  timestamp   = DateString[Now, {"Year","Month","Day","_","Hour24","Minute","Second"}] <>
    If[TrueQ[$iContinueUpdateFlag], "_continue", ""];
  bdir        = backupDir[packageName];

  (* \[HorizontalLine]\[HorizontalLine] \:6bce\:56de\:306e\:4e8b\:524d\:30d0\:30c3\:30af\:30a2\:30c3\:30d7\:ff08\:5fc5\:305a\:5b9f\:884c\:ff09\[HorizontalLine]\[HorizontalLine] *)
  Module[{preDir},
    preDir = FileNameJoin[{bdir, "pre_" <> timestamp}];
    CreateDirectory[preDir, CreateIntermediateDirectories -> True];
    iSaveBackupWl[preDir, srcFile, packageName, True];
    (* CUDA \:30bd\:30fc\:30b9\:306e\:30d0\:30c3\:30af\:30a2\:30c3\:30d7 (cuda.wl \:30ed\:30fc\:30c9\:6e08\:307f\:306e\:5834\:5408) *)
    If[TrueQ[$iCUDAExtensionLoaded],
      Quiet @ iCUDABackupSources[preDir, packageName]];
    preBackupFile = FileNameJoin[{preDir, packageName <> ".wl"}];
    nbPrint[nb, iL["\:4e8b\:524d\:30d0\:30c3\:30af\:30a2\:30c3\:30d7: ", "Pre-backup: "] <> preDir];
    Quiet @ iLLMGraphLogSubStep["pre-backup", "Local", preDir]
  ];

  sessionDir = FileNameJoin[{bdir, timestamp}];
  CreateDirectory[sessionDir, CreateIntermediateDirectories -> True];

  (* JS\:30d7\:30ec\:30fc\:30b9\:30db\:30eb\:30c0\:30fc\:51e6\:7406 *)
  jsPlaceholder = "(* %%JS_SOURCE_DO_NOT_MODIFY%% *)";
  jsBlock = First[StringCases[currentCode,
    RegularExpression["(?s)(\\$JSSource\\s*=\\s*\".*?\"\\s*;)"] :> "$1"], ""];
  If[jsBlock =!= "",
    currentCode = StringReplace[currentCode, jsBlock -> jsPlaceholder, 1]];

  (* \:95a2\:6570\:5358\:4f4d\:306b\:5206\:89e3 *)
  allBlocks = iExtractFunctions[currentCode];
  allNames  = Keys[allBlocks];

  (* \:5bfe\:8c61\:95a2\:6570\:3092\:6c7a\:5b9a *)
  targets = targetFuncsOpt;
  If[targets === Automatic,
    targets = iGuessTargetFunctions[updatePromptNorm["userText"], allNames, currentCode]];
  (* \:4f9d\:5b58\:95a2\:6570\:3082\:5c55\:958b *)
  If[Length[targets] > 0,
    targets = iExpandWithDeps[targets, allBlocks]];

  If[Length[targets] === 0,
    nbPrint[nb, "\:5bfe\:8c61\:95a2\:6570\:3092\:81ea\:52d5\:5224\:5b9a\:3067\:304d\:307e\:305b\:3093\:3067\:3057\:305f\:3002\:30d5\:30a1\:30a4\:30eb\:5168\:4f53\:3092\:9001\:4fe1\:3057\:307e\:3059\:3002"];
    Quiet @ iLLMGraphLogSubStep["target-detection", "Local", "full file"];
    targetCode = currentCode,
    nbPrint[nb, "\:5bfe\:8c61\:95a2\:6570: " <> StringRiffle[targets, ", "]];
    Quiet @ iLLMGraphLogSubStep["target-detection", "Local",
      StringRiffle[targets, ", "]];
    targetCode = ToString[StringJoin[Lookup[allBlocks, #, ""] & /@ targets]]
  ];

  beginMark = "===BEGIN_FUNCTIONS==="; endMark = "===END_FUNCTIONS===";
  (* 2026-06-10 perf: LLM へのコンテキスト供給を改善。
     - パッケージ履歴の二重ロードを解消 (histBlock に一度だけ取得)
     - ソースファイルの絶対パスを提示し Read ツールでの参照を明示
       (CLI には Read が許可され --add-dir に $packageDirectory が含まれる
        のに従来はパスを教えていなかったため、対象関数モードでは LLM が
        断片しか見えず、Claude Code 直接依頼より品質が落ちる主因だった)
     - 全トップレベル定義名の索引を提示 (存在しない関数の捏造防止)
     - 巨大ファイル ($ClaudeUpdateInlineMaxChars 超) は全文インラインせず
       Read 参照に切替 (コンテキスト溢れ防止) *)
  histBlock = iLoadPackageHistory[bdir, packageName];
  inlineFull = Length[targets] === 0 &&
    StringLength[currentCode] <= $ClaudeUpdateInlineMaxChars;
  fnIndexBlock = If[Length[allNames] > 0,
    With[{idx = StringRiffle[allNames, ", "]},
      If[StringLength[idx] > 8000, StringTake[idx, 8000] <> " ...", idx]],
    ""];
  prompt =
    "You are an expert Wolfram Language / Mathematica programmer.\n" <>
    "CRITICAL: Do NOT write any files. Do NOT use file-writing tools. Output to stdout ONLY.\n\n" <>
    (* \:30b5\:30f3\:30c9\:30a4\:30c3\:30c1\:69cb\:9020: \:30bf\:30b9\:30af\:6982\:8981\:3092\:5192\:982d\:306b\:914d\:7f6e *)
    iTaskOverviewBlock["INSTRUCTION: " <> updatePromptNorm["userText"]] <>
    histBlock <>
    If[histBlock =!= "", "\n", ""] <>
    "SOURCE FILE (read-only): " <> srcFile <> "\n" <>
    "You MAY use the Read tool on this file to inspect any part of the package\n" <>
    "(helper functions, usage declarations, surrounding context) before deciding your changes.\n" <>
    If[fnIndexBlock =!= "",
      "ALL top-level definitions in this package: " <> fnIndexBlock <> "\n\n",
      "\n"] <>
    Which[
      Length[targets] > 0,
      (* targets判定済み: 選択した関数のみ送信 *)
      "Below are selected function definitions from the Mathematica package `" <> packageName <> ".wl`.\n" <>
      "Modify them according to the instruction. Return ONLY the modified functions.\n" <>
      "If the shown functions are not sufficient, Read the SOURCE FILE above for full context;\n" <>
      "you may also return modified versions of package functions that are not shown below.\n",
      inlineFull,
      (* targets未判定 (通常サイズ): ファイル全体を送信 *)
      "Below is the COMPLETE source of the Mathematica package `" <> packageName <> ".wl`.\n" <>
      "Modify ONLY the functions that need to change according to the instruction.\n" <>
      "Return ONLY the modified function definitions (not the entire file).\n" <>
      "IMPORTANT: Do NOT return the entire file. Return ONLY the functions you actually changed.\n" <>
      "All unchanged functions will be preserved automatically by the merge system.\n",
      True,
      (* targets未判定 (巨大ファイル): インラインせず Read 参照 *)
      "The package `" <> packageName <> ".wl` is too large to inline in this prompt (" <>
      ToString[StringLength[currentCode]] <> " chars).\n" <>
      "Use the Read tool on the SOURCE FILE above (in chunks if needed) to locate the code to change.\n" <>
      "Return ONLY the modified function definitions (not the entire file).\n" <>
      "All unchanged functions will be preserved automatically by the merge system.\n"
    ] <>
    "Your response MUST start with " <> beginMark <> " on the very first line.\n" <>
    "Do NOT write any explanation or text before " <> beginMark <> ".\n" <>
    "After " <> endMark <> " you may add optional explanation.\n" <>
    "IMPORTANT: All explanations, VERIFY tags, and test comments must be written in the SAME LANGUAGE as the user's instruction.\n\n" <>
    (* \:6dfb\:4ed8\:30d5\:30a1\:30a4\:30eb\:304c\:3042\:308c\:3070\:5225\:30bb\:30af\:30b7\:30e7\:30f3\:3067\:53c2\:7167\:6307\:793a *)
    If[Length[updatePromptNorm["filePaths"]] > 0,
      "ATTACHMENTS (use the Read tool to view each file):\n" <>
      StringJoin[MapIndexed[
        Function[{fp, idx}, "  " <> ToString[First[idx]] <> ". " <> fp <> "\n"],
        updatePromptNorm["filePaths"]]] <> "\n",
      ""] <>
    Which[
      Length[targets] > 0, "CURRENT FUNCTIONS:\n",
      inlineFull, "COMPLETE SOURCE (modify only what is needed):\n",
      True, "SOURCE NOT INLINED (too large; use the Read tool on the SOURCE FILE path above):\n"
    ] <>
    beginMark <> "\n" <>
    If[Length[targets] > 0 || inlineFull,
      ToString[targetCode],
      "(source not inlined; read " <> srcFile <> " with the Read tool)"] <>
    "\n" <> endMark <> "\n\n" <>
    (* \:30b5\:30f3\:30c9\:30a4\:30c3\:30c1\:69cb\:9020: \:30bf\:30b9\:30af\:8a73\:7d30\:3092\:672b\:5c3e\:306b\:518d\:63b2 *)
    iTaskDetailBlock["INSTRUCTION (FULL)", iExpandSymbolRefs[updatePromptNorm["userText"]]];

  (* \:975e\:540c\:671f\:30bf\:30b9\:30af\:30b9\:30b1\:30b8\:30e5\:30fc\:30ea\:30f3\:30b0\:898f\:7d04\:3092\:6ce8\:5165 *)
  prompt = prompt <> iAsyncSchedulingRules[];

  (* \:4f9d\:5b58\:30d1\:30c3\:30b1\:30fc\:30b8\:306e API \:60c5\:5831\:3092\:4ed8\:52a0: \:30d1\:30c3\:30b1\:30fc\:30b8\:5883\:754c\:3092\:8d8a\:3048\:305f\:539f\:56e0\:8ffd\:8de1\:3092\:53ef\:80fd\:306b\:3059\:308b *)
  Module[{depApis = iCollectDependencyApis[currentCode]},
    If[StringLength[depApis] > 0,
      prompt = prompt <>
        "\n\n=== DEPENDENCY PACKAGE APIs ===\n" <>
        "(These are API references for packages that the target package depends on. " <>
        "Use them to trace call chains across package boundaries when diagnosing issues.)\n\n" <>
        depApis]];

  (* CUDA \:691c\:51fa: \:30d7\:30ed\:30f3\:30d7\:30c8\:30fb\:65e2\:5b58\:30b3\:30fc\:30c9\:30fb.cuda \:30c7\:30a3\:30ec\:30af\:30c8\:30ea\:306e\:5b58\:5728\:3092\:78ba\:8a8d *)
  If[iIsCUDARequest[updatePromptNorm["userText"]] ||
     iIsCUDARequest[currentCode] ||
     DirectoryQ[FileNameJoin[{Global`$packageDirectory, packageName <> ".cuda"}]],
    cudaRequested = True;
    If[iEnsureCUDAExtension[],
      prompt = prompt <> iCUDAUpdatePromptBlock[packageName],
      prompt = prompt <> iCUDAUnavailableNote[nb]]
  ];

  (* \:5909\:66f4\:691c\:8a3c\:30d2\:30f3\:30c8: LLM \:306b\:5909\:66f4\:5185\:5bb9\:306e\:6b63\:78ba\:306a\:8a18\:8ff0\:3092\:4fc3\:3059 *)
  prompt = prompt <>
    "\n\nIMPORTANT: After " <> endMark <> ", write all explanations in the SAME LANGUAGE as the user's instruction above.\n" <>
    "Also list each change you made as:\n" <>
    "  VERIFY: <identifier that should appear in the modified code>\n" <>
    "This helps automated verification. Example: VERIFY: AutoScroll -> False\n\n" <>
    "ALSO: Generate verification tests between ===BEGIN_TESTS=== and ===END_TESTS===.\n" <>
    "The variable $testSourceCode contains the merged source code as a string.\n" <>
    "Write one Boolean expression per line, preceded by a (* comment *) describing the test.\n" <>
    "Test comments should be in the SAME LANGUAGE as the user's instruction.\n" <>
    "Include both static tests (checking source code) and runtime tests (calling functions) if possible.\n" <>
    "Example:\n" <>
    "===BEGIN_TESTS===\n" <>
    "(* AutoScroll option was added to SelectionMove *)\n" <>
    "StringContainsQ[$testSourceCode, \"AutoScroll -> False\"]\n" <>
    "(* Function returns expected result *)\n" <>
    "MatchQ[funcName[testInput], _String]\n" <>
    "===END_TESTS===\n";

  (* D. \:81ea\:52d5 think hard: \:5927\:898f\:6a21\:30d5\:30a1\:30a4\:30eb\:3084\:5168\:4f53\:9001\:4fe1\:6642\:306f thinking \:3092\:5f37\:5316 *)
  If[Length[targets] === 0 && StringLength[currentCode] > 5000,
    prompt = "think hard\n" <> prompt];

  iSaveSessionMedia[sessionDir, prompt, imgDirs];

  Quiet @ iLLMGraphLogSubStep["build-prompt", "Local",
    ToString[StringLength[prompt]] <> " chars"];
  Quiet @ iLLMGraphLogSubStepStart["llm-query", "ClaudeCode", packageName];

  iClaudeQueryAsyncWithProgress[prompt,
    With[{nb2=nb, sd=sessionDir, pn=packageName, sf=srcFile,
          blks=allBlocks, tgts=targets, jp=jsPlaceholder, jb=jsBlock,
          bm=beginMark, em=endMark, origCode=Import[srcFile, "Text"],
          doUpdateApi=updateApiMd, jid=jobId, cat=continueAnchorTag,
          pbf=preBackupFile, origInstr=updatePromptNorm["userText"],
          retryN=$iUpdateRetryCount, isCuda=cudaRequested},
      Function[response,
        Module[{newFuncs, newCode, newWlFile, validationErrors = {}},
          (* \:30a2\:30f3\:30ab\:30fc\:306e\:76f4\:5f8c\:306b\:51fa\:529b\:3092\:914d\:7f6e *)
          If[jid =!= None, NBAccess`NBJobMoveToAnchor[jid],
            (* ContinueUpdate: anchor tag \:3067\:4f4d\:7f6e\:6307\:5b9a *)
            If[StringQ[cat], Quiet[
              NotebookFind[nb2, cat, All, CellTags];
              SelectionMove[nb2, After, Cell]]]];
          $iJobActiveNb = nb2;
          (* \:30b3\:30fc\:30eb\:30d0\:30c3\:30af\:5b8c\:4e86\:6642\:306b\:5fc5\:305a\:30ed\:30c3\:30af\:89e3\:653e\:3059\:308b\:30e9\:30c3\:30d1\:30fc *)
          Internal`WithLocalSettings[Null,

          Export[FileNameJoin[{sd, "response.txt"}], response, "Text"];
          (* Phase 3: LLM\:5fdc\:7b54\:5230\:7740 *)
          Quiet @ iLLMGraphLogSubStepEnd["Completed",
            ToString[StringLength[response]] <> " chars"];
          (* ContinueUpdate \:7528: \:30ec\:30b9\:30dd\:30f3\:30b9\:3068\:30bb\:30c3\:30b7\:30e7\:30f3Dir\:3092\:8a18\:9332 *)
          If[AssociationQ[$iLastUpdateInfo] && Lookup[$iLastUpdateInfo, "packageName", ""] === pn,
            AssociateTo[$iLastUpdateInfo, {
              "response" -> response,
              "sessionDir" -> sd,
              "cellCountAfter" -> NBAccess`NBCellCount[nb2]
            }]];
          If[StringStartsQ[response, "Error (ExitCode="] || StringStartsQ[response, "Error:"],
            nbPrint[nb2, iL["Claude \:547c\:3073\:51fa\:3057\:30a8\:30e9\:30fc:\n", "Claude call error:\n"] <> response]; Return[]];
          (* API \:30a8\:30e9\:30fc/\:5236\:9650\:30e1\:30c3\:30bb\:30fc\:30b8\:306e\:65e9\:671f\:691c\:51fa \[LongDash] \:30d5\:30a1\:30a4\:30eb\:7834\:640d\:9632\:6b62 *)
          If[iIsAPIErrorResponse[response],
            nbPrint[nb2, Style["\:26d4 API \:30a8\:30e9\:30fc\:307e\:305f\:306f\:5229\:7528\:5236\:9650\:3092\:691c\:51fa\:3002\:30d1\:30c3\:30b1\:30fc\:30b8\:306f\:66f4\:65b0\:3055\:308c\:307e\:305b\:3093\:3002\n" <>
              StringTake[response, UpTo[200]], Bold, FontColor -> RGBColor[0.8, 0, 0]]];
            Return[$Failed]];
          (* \:30c7\:30ea\:30df\:30bf\:62bd\:51fa\:3092\:8a66\:884c *)
          newFuncs = {iExtractBetweenMarkers[response, bm, em]};
          newFuncs = Select[newFuncs, # =!= "" &];
          (* \:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af: \:30c7\:30ea\:30df\:30bf\:306a\:3057\:306a\:3089 ```mathematica \:30d6\:30ed\:30c3\:30af\:304b\:3089\:62bd\:51fa *)
          If[Length[newFuncs] === 0,
            Module[{codeBlocks},
              codeBlocks = StringCases[response,
                RegularExpression["```(?:mathematica|wolfram)?\n([\\s\\S]*?)```"] :> "$1"];
              If[Length[codeBlocks] > 0,
                nbPrint[nb2, "\:30c7\:30ea\:30df\:30bf\:306a\:3057 \[RightArrow] \:30b3\:30fc\:30c9\:30d6\:30ed\:30c3\:30af\:304b\:3089\:62bd\:51fa (" <>
                  ToString[Length[codeBlocks]] <> " \:30d6\:30ed\:30c3\:30af)"];
                newFuncs = {StringJoin[Riffle[codeBlocks, "\n\n"]]},
                nbPrint[nb2, "\:30a8\:30e9\:30fc: \:30c7\:30ea\:30df\:30bf\:3082\:30b3\:30fc\:30c9\:30d6\:30ed\:30c3\:30af\:3082\:898b\:3064\:304b\:308a\:307e\:305b\:3093\:3002response.txt: " <>
                  FileNameJoin[{sd, "response.txt"}]]; Return[]
              ]
            ]
          ];
          newFuncs = First[newFuncs];

          (* Phase 3: \:30b3\:30fc\:30c9\:62bd\:51fa\:5b8c\:4e86 *)
          Quiet @ iLLMGraphLogSubStep["extract-code", "Local",
            ToString[StringLength[newFuncs]] <> " chars extracted"];
          Quiet @ iLLMGraphLogSubStepStart["merge", "Local", packageName];

          (* --- \:30de\:30fc\:30b8\:30ed\:30b8\:30c3\:30af (targets \:306e\:6709\:7121\:306b\:304b\:304b\:308f\:3089\:305a\:5e38\:306b\:30de\:30fc\:30b8\:3092\:8a66\:307f\:308b) --- *)
          newCode = Module[{code = origCode, updBlks, mergedCount = 0,
                            newOnlyFuncs = {}, unmergedFuncs = {},
                            addedBlocks = <||>, mergeRes, respIsFullFile},
            If[jb =!= "", code = StringReplace[code, jb -> jp, 1]];
            updBlks = iExtractFunctions[newFuncs];

            (* \:30ec\:30b9\:30dd\:30f3\:30b9\:304c\:5168\:30d5\:30a1\:30a4\:30eb\:304b\:90e8\:5206\:304b\:5224\:5b9a: BeginPackage \:3092\:542b\:3080\:306a\:3089\:5168\:30d5\:30a1\:30a4\:30eb *)
            respIsFullFile = StringContainsQ[newFuncs, "BeginPackage["] &&
                             StringContainsQ[newFuncs, "EndPackage["] &&
                             StringLength[newFuncs] > StringLength[origCode] * 0.7;

            If[respIsFullFile && Length[tgts] === 0,
              (* Claude \:304c\:5168\:30d5\:30a1\:30a4\:30eb\:3092\:8fd4\:3057\:305f\:5834\:5408: \:305d\:306e\:307e\:307e\:63a1\:7528 *)
              nbPrint[nb2, "\:30ec\:30b9\:30dd\:30f3\:30b9\:306f\:5b8c\:5168\:306a\:30d5\:30a1\:30a4\:30eb\:3067\:3059\:3002\:305d\:306e\:307e\:307e\:63a1\:7528\:3057\:307e\:3059\:3002"];
              code = If[jb =!= "", StringReplace[newFuncs, jp -> jb, 1], newFuncs],
              (* 部分的なレスポンス: セグメント単位でマージ (2026-06-10)。
                 従来の iExtractFunctions ブロック全体置換は、usage 宣言と
                 Private 実装が同名キーに連結されるため
                 (a) 標準レイアウトでは StringReplace が no-op なのに
                     mergedCount++ される silent failure、
                 (b) 連続レイアウトでは Begin[...] 構造行ごと破壊、
                 の二重の問題があった。iMergeFunctionSegments は連続セグメント
                 単位で {関数名, 種別} を突き合わせて in-place 置換する。 *)
              mergeRes = iMergeFunctionSegments[code, newFuncs];
              code = mergeRes["Code"];
              mergedCount = Length[mergeRes["Replaced"]];
              unmergedFuncs = mergeRes["Unmerged"];
              addedBlocks = mergeRes["AddedBlocks"];
              newOnlyFuncs = Keys[addedBlocks];
              If[Length[unmergedFuncs] > 0,
                nbPrint[nb2, Style[
                  "\:26a0 \:30de\:30fc\:30b8\:4e0d\:4e00\:81f4: \:4ee5\:4e0b\:306e\:95a2\:6570\:306f\:30bb\:30b0\:30e1\:30f3\:30c8\:304c\:5143\:30b3\:30fc\:30c9\:3068\:4e00\:81f4\:305b\:305a\:3001\:7f6e\:63db\:3067\:304d\:307e\:305b\:3093\:3067\:3057\:305f:\n  " <>
                  StringRiffle[unmergedFuncs, ", "] <>
                  "\nContinueUpdate[] \:3067\:518d\:8a66\:884c\:3067\:304d\:307e\:3059\:3002",
                  FontColor -> RGBColor[0.8, 0.4, 0]]]];
              (* \:65b0\:898f\:95a2\:6570\:304c\:3042\:308c\:3070\:9069\:5207\:306a\:4f4d\:7f6e\:306b\:633f\:5165 *)
              If[Length[newOnlyFuncs] > 0,
                Module[{insertCode, codeBefore = code, inserted = False},
                  insertCode = StringJoin[Values[addedBlocks]];
                  (* \:6226\:75651: End[] + EndPackage[] \:304c\:96a3\:63a5\:3059\:308b\:6a19\:6e96\:69cb\:9020 *)
                  code = StringReplace[code,
                    RegularExpression["(\\n\\s*End\\[\\]\\s*;?\\s*\\n\\s*EndPackage\\[\\])"] :>
                    "\n" <> insertCode <> "$1", 1];
                  If[code =!= codeBefore, inserted = True];
                  (* \:6226\:75652: End[] \:304c\:5358\:72ec\:3067\:5b58\:5728\:3059\:308b\:975e\:6a19\:6e96\:69cb\:9020 (EndPackage[] \:304c\:5148\:982d\:4ed8\:8fd1\:306b\:3042\:308b\:5834\:5408)
                     \:6700\:5f8c\:306e End[] \:306e\:76f4\:524d\:306b\:633f\:5165\:3059\:308b *)
                  If[!inserted,
                    code = codeBefore;
                    code = StringReplace[code,
                      RegularExpression["(\\n\\s*End\\[\\]\\s*;?\\s*\\n)(?![\\s\\S]*End\\[\\])"] :>
                      "\n" <> insertCode <> "$1", 1];
                    If[code =!= codeBefore, inserted = True]];
                  (* \:6226\:75653: \:6700\:5f8c\:306e End[] \:3092\:6b63\:898f\:8868\:73fe\:3067\:898b\:3064\:3051\:3089\:308c\:306a\:3044\:5834\:5408\:306f
                     StringPosition \:3067\:6700\:5f8c\:306e End[] \:3092\:63a2\:3057\:3066\:76f4\:524d\:306b\:633f\:5165 *)
                  If[!inserted,
                    code = codeBefore;
                    Module[{endPositions},
                      endPositions = StringPosition[code, RegularExpression["\\nEnd\\[\\]\\s*;?"]];
                      If[Length[endPositions] > 0,
                        Module[{lastPos = Last[endPositions]},
                          code = StringInsert[code, "\n" <> insertCode, lastPos[[1]]];
                          inserted = True]]]];
                  (* \:6226\:75654: End[] \:3059\:3089\:7121\:3044\:5834\:5408\:306f\:672b\:5c3e\:306b\:8ffd\:52a0 *)
                  If[!inserted,
                    code = codeBefore <> "\n" <> insertCode;
                    inserted = True];
                  If[inserted,
                    nbPrint[nb2, "\:65b0\:898f\:95a2\:6570\:3092\:8ffd\:52a0: " <>
                      StringRiffle[newOnlyFuncs, ", "]],
                    nbPrint[nb2, Style[
                      "\:26a0 \:65b0\:898f\:95a2\:6570\:306e\:633f\:5165\:4f4d\:7f6e\:3092\:691c\:51fa\:3067\:304d\:307e\:305b\:3093\:3067\:3057\:305f: " <>
                      StringRiffle[newOnlyFuncs, ", "] <>
                      "\n\:624b\:52d5\:3067\:8ffd\:52a0\:3057\:3066\:304f\:3060\:3055\:3044\:3002",
                      FontColor -> RGBColor[0.8, 0.4, 0]]]]
                ]
              ];
              Which[
                mergedCount > 0,
                  nbPrint[nb2, "\:30de\:30fc\:30b8\:5b8c\:4e86: " <> ToString[mergedCount] <>
                    " \:500b\:306e\:95a2\:6570\:3092\:66f4\:65b0"],
                (* 無変更 (LLM が既存定義と同一のコードを返した) *)
                Length[mergeRes["Identical"]] > 0 && Length[newOnlyFuncs] === 0,
                  nbPrint[nb2, "\:30de\:30fc\:30b8: \:5909\:66f4\:306a\:3057 (\:30ec\:30b9\:30dd\:30f3\:30b9\:306e\:95a2\:6570\:5b9a\:7fa9\:306f\:65e2\:5b58\:3068\:540c\:4e00\:3067\:3059)"],
                (* \:30de\:30fc\:30b8\:3067\:304d\:306a\:304b\:3063\:305f\:5834\:5408\:306e\:8b66\:544a\:ff08\:65b0\:898f\:95a2\:6570\:8ffd\:52a0\:306e\:307f\:306e\:5834\:5408\:306f\:507d\:967d\:6027\:306a\:306e\:3067\:9664\:5916\:ff09 *)
                Length[Keys[updBlks]] > 0 && Length[newOnlyFuncs] === 0,
                  nbPrint[nb2, Style[
                    "\:26a0 \:30de\:30fc\:30b8\:5931\:6557: \:30ec\:30b9\:30dd\:30f3\:30b9\:306e\:95a2\:6570\:304c\:5143\:30b3\:30fc\:30c9\:306b\:5bfe\:5fdc\:3057\:307e\:305b\:3093\:3067\:3057\:305f\:3002\n" <>
                    "\:30ec\:30b9\:30dd\:30f3\:30b9\:95a2\:6570: " <> StringRiffle[Keys[updBlks], ", "],
                    FontColor -> RGBColor[0.8, 0.4, 0]]]
              ];
              If[jb =!= "", code = StringReplace[code, jp -> jb, 1]];
            ];
            code
          ];

          (* Phase 3: \:30de\:30fc\:30b8\:5b8c\:4e86 *)
          Quiet @ iLLMGraphLogSubStepEnd["Completed",
            ToString[StringLength[newCode]] <> " chars"];

          (* \:5b89\:5168\:6027\:691c\:8a3c *)
          Module[{newSz, oldSz, origFuncCount, newFuncCount,
                  hasBegin, hasEnd, origHasBegin},
            newSz = StringLength[newCode];
            oldSz = StringLength[origCode];
            origFuncCount = Length[iExtractFunctions[origCode]];
            newFuncCount  = Length[iExtractFunctions[newCode]];
            origHasBegin  = StringContainsQ[origCode, "BeginPackage["];
            hasBegin      = StringContainsQ[newCode, "BeginPackage["];
            hasEnd        = StringContainsQ[newCode, "EndPackage["];

            If[oldSz > 0 && newSz < oldSz * 0.5,
              AppendTo[validationErrors,
                "\:30b5\:30a4\:30ba\:6025\:6e1b: " <> ToString[oldSz] <> " \[RightArrow] " <>
                ToString[newSz] <> " chars (" <>
                ToString[Round[100. newSz / oldSz]] <> "%)"]];
            If[origFuncCount > 3 && newFuncCount < origFuncCount * 0.5,
              AppendTo[validationErrors,
                "\:95a2\:6570\:6570\:6025\:6e1b: " <> ToString[origFuncCount] <> " \[RightArrow] " <>
                ToString[newFuncCount]]];
            If[origHasBegin && !hasBegin,
              AppendTo[validationErrors, "BeginPackage[] \:304c\:6b20\:843d"]];
            If[origHasBegin && !hasEnd,
              AppendTo[validationErrors, "EndPackage[] \:304c\:6b20\:843d"]];
          ];

          (* Phase 3: \:691c\:8a3c\:5b8c\:4e86 *)
          Quiet @ iLLMGraphLogSubStep["validate", "Local",
            If[Length[validationErrors] > 0,
              "FAILED: " <> StringRiffle[validationErrors, "; "],
              "Passed"]];

          (* \:5909\:66f4\:691c\:8a3c: LLM \:304c\:4e3b\:5f35\:3057\:305f\:5909\:66f4\:304c\:5b9f\:969b\:306b\:30b3\:30fc\:30c9\:306b\:53cd\:6620\:3055\:308c\:3066\:3044\:308b\:304b\:78ba\:8a8d *)
          Module[{missingChanges},
            missingChanges = iVerifyClaimedChanges[response, newCode];
            If[Length[missingChanges] > 0,
              nbPrint[nb2, Style[
                "\:26a0 LLM \:304c\:4e3b\:5f35\:3057\:305f\:5909\:66f4\:304c\:30b3\:30fc\:30c9\:306b\:898b\:3064\:304b\:308a\:307e\:305b\:3093:\n" <>
                StringJoin[("  \:274c " <> # <> "\n") & /@ missingChanges] <>
                "\:30de\:30fc\:30b8\:306f\:5b9f\:884c\:3055\:308c\:307e\:3057\:305f\:304c\:3001\:610f\:56f3\:3057\:305f\:5909\:66f4\:304c\:6b20\:843d\:3057\:3066\:3044\:308b\:53ef\:80fd\:6027\:304c\:3042\:308a\:307e\:3059\:3002\n" <>
                "ContinueUpdate[] \:3067\:4fee\:6b63\:3092\:7d99\:7d9a\:3067\:304d\:307e\:3059\:3002",
                FontColor -> RGBColor[0.8, 0.4, 0]]]]];

          (* \:672a\:5909\:66f4\:95a2\:6570\:306e\:4fdd\:5168\:691c\:8a3c: \:30de\:30fc\:30b8\:3067\:610f\:56f3\:3057\:306a\:3044\:7834\:640d\:304c\:306a\:3044\:304b\:78ba\:8a8d\:3002
             \:8b66\:544a\:306e\:307f \[LongDash] validationErrors \:306b\:306f\:8ffd\:52a0\:3057\:306a\:3044\:3002
             \:65b0\:95a2\:6570\:633f\:5165\:6642\:306b iExtractFunctions \:306e\:30d6\:30ed\:30c3\:30af\:5883\:754c\:304c\:305a\:308c\:3066\:507d\:967d\:6027\:304c\:767a\:751f\:3059\:308b\:305f\:3081\:3001
             \:30cf\:30fc\:30c9\:30b2\:30fc\:30c8\:ff08\:81ea\:52d5\:30ea\:30c8\:30e9\:30a4\:767a\:52d5\:ff09\:3068\:3057\:3066\:306f\:4f7f\:308f\:306a\:3044\:3002 *)
          Module[{corruptedFuncs},
            corruptedFuncs = iVerifyUnchangedFunctions[origCode, newCode, newFuncs];
            If[Length[corruptedFuncs] > 0,
              nbPrint[nb2, Style[
                "\:26a0 \:30de\:30fc\:30b8\:306b\:3088\:308a\:672a\:5909\:66f4\:306e\:306f\:305a\:306e\:95a2\:6570\:304c\:5909\:5316\:3057\:3066\:3044\:307e\:3059 (\:30d6\:30ed\:30c3\:30af\:5883\:754c\:30b7\:30d5\:30c8\:306e\:53ef\:80fd\:6027\:3042\:308a):\n" <>
                StringJoin[("  \:26a0 " <> # <> "\n") & /@ corruptedFuncs] <>
