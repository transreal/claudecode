(* ClaudeShowHistory[session_Association]: \:30bb\:30c3\:30b7\:30e7\:30f3\:30aa\:30d6\:30b8\:30a7\:30af\:30c8\:306e\:5c65\:6b74\:8868\:793a *)
ClaudeShowHistory[session_Association] :=
