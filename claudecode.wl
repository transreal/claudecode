  RegularExpression["(?<![\\p{L}\\p{N}$])ClaudeAttach\\s*\\["],
  (* 4. \:8a8d\:8a3c\:60c5\:5831\:30fb\:30d5\:30a1\:30a4\:30eb\:7834\:58ca\:7684\:64cd\:4f5c *)
