(* \[HorizontalLine]\[HorizontalLine] NotebookLLMGraph \[Times] Snapshot \:30de\:30fc\:30b8 \:8a2d\:5099 \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   Snapshot \:6642\:306b LLMGraph \:306e subset (\:307e\:305f\:306f\:5168\:90e8) \:3092\:4e26\:7f6e\:4fdd\:5b58\:3057\:3001
   Restore \:6642\:306b notebook \:306e LLMGraph \:3068\:30de\:30fc\:30b8\:3059\:308b\:305f\:3081\:306e helper \:7fa4\:3002
   iLLMGraphExtractSubsetForJob: job \:306b\:7d10\:3065\:304f\:30ce\:30fc\:30c9\:3060\:3051\:3092\:62bd\:51fa
   iLLMGraphMergeTwoGraphs:      \:4e8c\:3064\:306e LLMGraph \:3092\:30de\:30fc\:30b8 (LastModified \:65b0\:3057\:3044\:65b9\:512a\:5148)
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)

(* job \:306e context \:304b\:3089 SessionTag \:3092\:5b89\:5168\:306b\:53d6\:5f97 (\:5b58\:5728\:3057\:306a\:3051\:308c\:3070 None) *)
iLLMGraphJobSessionTag[job_Association] :=
  Module[{ctx, tag},
    ctx = Lookup[job, "context", <||>];
    If[!AssociationQ[ctx], Return[None]];
    tag = Lookup[ctx, "SessionTag", None];
    If[StringQ[tag] && StringLength[tag] > 0, tag, None]];

iLLMGraphJobSessionTag[_] := None;

(* \:30ce\:30fc\:30c9\:304c\:6307\:5b9a SessionTag \:306b\:5c5e\:3059\:308b\:304b\:3092\:5224\:5b9a:
   NodeID \:304c "{tag}-" \:3067\:59cb\:307e\:308b (L2 \:30ce\:30fc\:30c9 "{tag}-{idx}_L2-{N}" \:3082\:540c\:69d8\:306b\:78ba\:5b9f\:306b\:30de\:30c3\:30c1) *)
iLLMGraphNodeBelongsToTag[nodeID_String, sessionTag_String] :=
  StringStartsQ[nodeID, sessionTag <> "-"];
iLLMGraphNodeBelongsToTag[_, _] := False;

(* \:30ce\:30fc\:30c9\:304c\:6307\:5b9a AbsoluteTime \:4ee5\:524d\:306b\:4f5c\:6210\:3055\:308c\:305f\:304b\:3092\:5224\:5b9a\:3002
   \:30ce\:30fc\:30c9\:306b CreatedAt \:304c\:7121\:3044\:5834\:5408\:306f\:5b89\:5168\:5074\:3067 True (\:542b\:3081\:308b) *)
iLLMGraphNodeCreatedBefore[node_Association, tBefore_?NumericQ] :=
  Module[{t = Lookup[node, "CreatedAt", None]},
    If[NumericQ[t], t <= tBefore, True]];
iLLMGraphNodeCreatedBefore[_, _] := True;

(* \:30b0\:30e9\:30d5\:304b\:3089 job \:306b\:95a2\:9023\:3059\:308b subset \:3092\:62bd\:51fa\:3059\:308b\:3002
   \:512a\:5148\:5ea6: (1) job \:306e SessionTag \:4e00\:81f4 \[RightArrow] NodeID \:30d5\:30a3\:30eb\:30bf
                  (2) \:306a\:3051\:308c\:3070 job \:306e snapshotTime \:4ee5\:524d\:306e\:30ce\:30fc\:30c9\:306e\:307f
                  (3) \:305d\:308c\:3082\:7121\:3051\:308c\:3070\:5168\:30ce\:30fc\:30c9 *)
iLLMGraphExtractSubsetForJob[fullGraph_Association, job_Association] :=
  Module[{sessionTag, snapT, nodes, filtered, subsetGraph},
    nodes = Lookup[fullGraph, "Nodes", <||>];
    If[!AssociationQ[nodes], Return[fullGraph]];

    sessionTag = iLLMGraphJobSessionTag[job];
    snapT = Lookup[job, "snapshotTime", None];

    filtered = Which[
      (* \:30b1\:30fc\:30b9 1: SessionTag \:304c\:3042\:308b *)
      StringQ[sessionTag],
        KeySelect[nodes, iLLMGraphNodeBelongsToTag[#, sessionTag] &],
      (* \:30b1\:30fc\:30b9 2: snapshotTime \:304c\:3042\:308b \[RightArrow] \:305d\:308c\:4ee5\:524d\:306e\:30ce\:30fc\:30c9 *)
      NumericQ[snapT],
        Select[nodes, iLLMGraphNodeCreatedBefore[#, snapT] &],
      (* \:30b1\:30fc\:30b9 3: \:5168\:30ce\:30fc\:30c9\:3092\:305d\:306e\:307e\:307e *)
      True,
        nodes];

    subsetGraph = fullGraph;
    subsetGraph["Nodes"] = filtered;
    subsetGraph
  ];
iLLMGraphExtractSubsetForJob[_, _] := <|"Nodes" -> <||>|>;

(* \:4e8c\:3064\:306e LLMGraph \:3092\:30de\:30fc\:30b8\:3002
   - Nodes: \:540c\:4e00 NodeID \:304c\:4e21\:65b9\:306b\:3042\:308c\:3070 LastModified \:65b0\:3057\:3044\:65b9\:3092\:63a1\:7528\:3002
     \:30ce\:30fc\:30c9\:306b LastModified \:304c\:7121\:3051\:308c\:3070 CreatedAt \:3092\:4ee3\:7528\:3002\:4e21\:65b9\:306a\:3051\:308c\:3070 dst \:512a\:5148\:3002
   - SessionTags: Union
   - NotebookID, NotebookPath, CreatedAt: dst \:306e\:3082\:306e\:3092\:7dad\:6301
   - LastModified: max \:3092\:63a1\:7528 *)
iLLMGraphNodeTimeForMerge[node_Association] :=
  Module[{lm = Lookup[node, "LastModified", None], ca = Lookup[node, "CreatedAt", None]},
    Which[NumericQ[lm], lm, NumericQ[ca], ca, True, 0]];
iLLMGraphNodeTimeForMerge[_] := 0;

iLLMGraphMergeTwoGraphs[dst_Association, src_Association] :=
  Module[{dstNodes, srcNodes, mergedNodes, allKeys, dstTags, srcTags,
          result, dLM, sLM},
    dstNodes = Lookup[dst, "Nodes", <||>];
    srcNodes = Lookup[src, "Nodes", <||>];
    If[!AssociationQ[dstNodes], dstNodes = <||>];
    If[!AssociationQ[srcNodes], srcNodes = <||>];

    allKeys = DeleteDuplicates @ Join[Keys[dstNodes], Keys[srcNodes]];
    mergedNodes = Association @ Map[
      Function[k,
        Which[
          (* dst \:306b\:306e\:307f *)
          KeyExistsQ[dstNodes, k] && !KeyExistsQ[srcNodes, k],
            k -> dstNodes[k],
          (* src \:306b\:306e\:307f *)
          !KeyExistsQ[dstNodes, k] && KeyExistsQ[srcNodes, k],
            k -> srcNodes[k],
          (* \:4e21\:65b9\:306b\:5b58\:5728 \[RightArrow] \:6642\:523b\:6bd4\:8f03 *)
          True,
            Module[{dn = dstNodes[k], sn = srcNodes[k],
                    dt, st},
              dt = iLLMGraphNodeTimeForMerge[dn];
              st = iLLMGraphNodeTimeForMerge[sn];
              (* \:540c\:5024\:306e\:5834\:5408\:306f dst \:3092\:7dad\:6301 (notebook \:306e\:6700\:65b0\:5024\:3092\:91cd\:8996) *)
              k -> If[st > dt, sn, dn]]]],
      allKeys];

    dstTags = Lookup[dst, "SessionTags", {}];
    srcTags = Lookup[src, "SessionTags", {}];
    If[!ListQ[dstTags], dstTags = {}];
    If[!ListQ[srcTags], srcTags = {}];

    dLM = Lookup[dst, "LastModified", 0];
    sLM = Lookup[src, "LastModified", 0];
    If[!NumericQ[dLM], dLM = 0];
    If[!NumericQ[sLM], sLM = 0];

    result = dst;
    result["Nodes"] = mergedNodes;
    result["SessionTags"] = DeleteDuplicates @ Join[dstTags, srcTags];
    result["LastModified"] = Max[dLM, sLM, AbsoluteTime[]];
    result
  ];
iLLMGraphMergeTwoGraphs[dst_Association, _] := dst;
iLLMGraphMergeTwoGraphs[_, src_Association] := src;
iLLMGraphMergeTwoGraphs[_, _] := <|"Nodes" -> <||>|>;

(* Phase 33 Task 2b: privacy filter
   \:30ce\:30fc\:30c9\:306e Instruction / ResponseSummary \:306b $NBConfidentialSymbols \:306e\:30ad\:30fc\:540d\:304c
   \:542b\:307e\:308c\:3066\:3044\:305f\:3089 subset \:304b\:3089\:9664\:5916\:3059\:308b\:3002 $NBConfidentialSymbols \:304c\:672a\:8a2d\:5b9a\:306a\:3089\:7686\:5b89\:5168\:3002 *)
iLLMGraphNodeIsPrivacySafe[node_Association] :=
  Module[{confSyms, combined},
    confSyms = Which[
      AssociationQ[NBAccess`$NBConfidentialSymbols],
        Keys[NBAccess`$NBConfidentialSymbols],
      ListQ[NBAccess`$NBConfidentialSymbols],
        NBAccess`$NBConfidentialSymbols,
      True, {}];
    If[confSyms === {}, Return[True]];
    combined = StringJoin[
      ToString[Lookup[node, "Instruction", ""]], " ",
      ToString[Lookup[node, "ResponseSummary", ""]]];
    !AnyTrue[confSyms,
      StringLength[ToString[#]] > 0 &&
        StringContainsQ[combined, ToString[#]] &]];
iLLMGraphNodeIsPrivacySafe[_] := True;

(* \:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:5185\:306e llmgraph.wl \:3092\:8aad\:307f\:8fbc\:3080 (\:7121\:3051\:308c\:3070 None) *)
iLLMGraphDAGLoadSnapshotGraph[snapDir_String] :=
  Module[{graphFile, loaded},
    graphFile = FileNameJoin[{snapDir, "llmgraph.wl"}];
    If[!FileExistsQ[graphFile], Return[None]];
    loaded = Quiet @ Check[Get[graphFile], $Failed];
    If[AssociationQ[loaded], loaded, None]];
iLLMGraphDAGLoadSnapshotGraph[_] := None;

(* \:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:5185\:306b llmgraph.wl \:3092\:4fdd\:5b58 (Snapshot \:304b\:3089\:547c\:3070\:308c\:308b) *)
iLLMGraphDAGSaveSnapshotGraph[snapDir_String, job_Association,
    includeFullGraph_:False, includePrivate_:False] :=
  Module[{nb, fullGraph, saveGraph, graphFile, filteredNodes},
    (* \:5143\:306e nb (\:307e\:3060 $Failed \:306b\:7f6e\:63db\:3055\:308c\:308b\:524d) \:3092\:4f7f\:3046 *)
    nb = Lookup[job, "nb", None];
    If[!MatchQ[nb, _NotebookObject], Return[<|"Status" -> "NoNotebook"|>]];

    fullGraph = Quiet @ Check[iLLMGraphGetCached[nb], None];
    If[!AssociationQ[fullGraph], Return[<|"Status" -> "NoGraph"|>]];

    saveGraph = If[TrueQ[includeFullGraph],
      fullGraph,
      iLLMGraphExtractSubsetForJob[fullGraph, job]];

    (* Phase 33 Task 2b: privacy filter.
       includePrivate=True \:306a\:3089\:30d5\:30a3\:30eb\:30bf\:30fc\:3092\:30b9\:30ad\:30c3\:30d7\:3059\:308b\:3002 *)
    If[!TrueQ[includePrivate],
      filteredNodes = Select[Lookup[saveGraph, "Nodes", <||>],
        iLLMGraphNodeIsPrivacySafe];
      saveGraph["Nodes"] = filteredNodes];

    graphFile = FileNameJoin[{snapDir, "llmgraph.wl"}];
    Quiet @ Check[Put[saveGraph, graphFile], Null];
    <|"Status" -> "Saved",
      "Path" -> graphFile,
      "NodeCount" -> Length[Lookup[saveGraph, "Nodes", <||>]],
      "IncludeFullGraph" -> TrueQ[includeFullGraph]|>
  ];
iLLMGraphDAGSaveSnapshotGraph[_, _, ___] := <|"Status" -> "Error"|>;

(* llmgraph.wl \:3092 nb \:306e NotebookLLMGraph \:3068\:30de\:30fc\:30b8 \[RightArrow] TaggingRules \:3078\:4fdd\:5b58 *)
iLLMGraphDAGMergeIntoNotebook[snapDir_String, nb_NotebookObject] :=
  Module[{snapGraph, currentGraph, merged, nodeCountBefore, nodeCountAfter},
    snapGraph = iLLMGraphDAGLoadSnapshotGraph[snapDir];
    If[!AssociationQ[snapGraph],
      Return[<|"Status" -> "NoGraphInSnapshot", "SnapshotDir" -> snapDir|>]];

    currentGraph = Quiet @ Check[iLLMGraphGetCached[nb], None];
    If[!AssociationQ[currentGraph],
      currentGraph = iNewNotebookLLMGraph[nb]];

    nodeCountBefore = Length[Lookup[currentGraph, "Nodes", <||>]];
    merged = iLLMGraphMergeTwoGraphs[currentGraph, snapGraph];
    nodeCountAfter = Length[Lookup[merged, "Nodes", <||>]];

    (* \:30ad\:30e3\:30c3\:30b7\:30e5 \:66f4\:65b0 + TaggingRules \:3078\:30d5\:30e9\:30c3\:30b7\:30e5 *)
    $iLLMGraphCache = merged;
    $iLLMGraphCacheNB = nb;
    Quiet @ iSaveNotebookLLMGraph[nb, merged];

    <|"Status" -> "Merged",
      "SnapshotDir" -> snapDir,
      "NodeCountBefore" -> nodeCountBefore,
      "NodeCountAfter" -> nodeCountAfter,
      "AddedNodes" -> Max[0, nodeCountAfter - nodeCountBefore]|>
  ];
iLLMGraphDAGMergeIntoNotebook[_, _] :=
  <|"Status" -> "InvalidArgs"|>;


Options[LLMGraphDAGSnapshot] = {
  "AuxiliaryState"   -> <||>,
  "IncludeFullGraph" -> False,
  "IncludePrivate"   -> False
};

LLMGraphDAGSnapshot[jobId_String, opts:OptionsPattern[]] :=
  Module[{job, nodes, snapDir, ts, saveJob, meta, auxState,
          doneCount, failedCount, pendingCount, runningCount,
          includeFull, includePriv, graphSaveResult},
    job = Quiet @ $iLLMGraphDAGJobs[jobId];
    If[!AssociationQ[job], Return[Missing["JobNotFound", jobId]]];

    (* \:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:30c7\:30a3\:30ec\:30af\:30c8\:30ea\:4f5c\:6210 *)
    If[!DirectoryQ[$ClaudeSnapshots],
      Quiet[CreateDirectory[$ClaudeSnapshots]]];
    ts = ToString[Floor[AbsoluteTime[]]];
    snapDir = FileNameJoin[{$ClaudeSnapshots, ts <> "-" <> jobId}];
    Quiet[CreateDirectory[snapDir]];

    (* \:30ce\:30fc\:30c9\:306e runState (ProcessObject) \:3092\:30af\:30ea\:30fc\:30f3\:30a2\:30c3\:30d7 *)
    nodes = job["nodes"];
    saveJob = job;
    saveJob["nodes"] = Map[
      Module[{n = #},
        n["runState"] = None;
        (* running \:30ce\:30fc\:30c9\:306f failed \:306b\:5909\:66f4 (\:518d\:958b\:6642\:306b retry \:5bfe\:8c61) *)
        If[Lookup[n, "status", ""] === "running",
          n["status"] = "failed";
          n["error"]  = "Interrupted for snapshot"];
        n] &,
      nodes];
    saveJob["snapshotTime"] = AbsoluteTime[];

    (* LLMGraph subset \:4fdd\:5b58 (nb \:3092 $Failed \:306b\:3059\:308b\:524d\:306b\:5b9f\:884c\:3059\:308b) *)
    includeFull = TrueQ[OptionValue["IncludeFullGraph"]];
    includePriv = TrueQ[OptionValue["IncludePrivate"]];
    graphSaveResult = Quiet @ Check[
      iLLMGraphDAGSaveSnapshotGraph[snapDir, saveJob, includeFull, includePriv],
      <|"Status" -> "Error"|>];

    (* nb \:306f NotebookObject \:3067\:30b7\:30ea\:30a2\:30e9\:30a4\:30ba\:4e0d\:53ef \[RightArrow] $Failed *)
    saveJob["nb"] = $Failed;

    (* \:7d71\:8a08 *)
    doneCount    = Count[Values[saveJob["nodes"]], _?(Lookup[#, "status", ""] === "done" &)];
    failedCount  = Count[Values[saveJob["nodes"]], _?(Lookup[#, "status", ""] === "failed" &)];
    pendingCount = Count[Values[saveJob["nodes"]], _?(Lookup[#, "status", ""] === "pending" &)];

    (* \:4fdd\:5b58 *)
    Put[saveJob, FileNameJoin[{snapDir, "job.wl"}]];

    (* \:30e1\:30bf\:30c7\:30fc\:30bf (\:30ea\:30b9\:30c8\:8868\:793a\:7528) *)
    meta = <|
      "jobId"     -> jobId,
      "timestamp" -> ts,
      "context"   -> Lookup[job, "context", <||>],
      "taskName"  -> Lookup[Lookup[job, "taskDescriptor", <||>], "name", "?"],
      "done"      -> doneCount,
      "failed"    -> failedCount,
      "pending"   -> pendingCount,
      "total"     -> Length[nodes]
    |>;
    Put[meta, FileNameJoin[{snapDir, "meta.wl"}]];

    (* \:88dc\:52a9\:72b6\:614b (\:547c\:3073\:51fa\:3057\:5074\:304c\:8ffd\:52a0\:30b3\:30f3\:30c6\:30ad\:30b9\:30c8\:3092\:4fdd\:5b58\:3067\:304d\:308b) *)
    auxState = OptionValue["AuxiliaryState"];
    If[AssociationQ[auxState] && Length[auxState] > 0,
      Put[auxState, FileNameJoin[{snapDir, "aux.wl"}]]];

    Print[Style["\[Checkmark] \:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:4fdd\:5b58: " <> snapDir, Darker[Green], Bold]];
    Print["  Done: ", doneCount, " / Failed: ", failedCount,
      " / Pending: ", pendingCount, " / Total: ", Length[nodes]];
    If[AssociationQ[graphSaveResult] && Lookup[graphSaveResult, "Status", ""] === "Saved",
      Print["  LLMGraph subset: ", Lookup[graphSaveResult, "NodeCount", 0], " nodes ",
        If[TrueQ[Lookup[graphSaveResult, "IncludeFullGraph", False]], "(\:5168\:4f53)", "(subset)"]]];
    Print["  \:5fa9\:5143: LLMGraphDAGRestore[\"" <> snapDir <> "\"]"];

    <|"snapshotDir" -> snapDir, "jobId" -> jobId,
      "done" -> doneCount, "failed" -> failedCount,
      "pending" -> pendingCount,
      "graphSaveStatus" -> Lookup[
        If[AssociationQ[graphSaveResult], graphSaveResult, <||>],
        "Status", "Unknown"]|>
  ];

(* \[HorizontalLine]\[HorizontalLine] LLMGraphDAGRestore \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:304b\:3089 DAG \:30b8\:30e7\:30d6\:3092\:5fa9\:5143\:3059\:308b\:3002
   \:5fa9\:5143\:5f8c LLMGraphDAGRetry[jobId] \:3067 failed \:30ce\:30fc\:30c9\:3092\:518d\:5b9f\:884c\:53ef\:80fd\:3002
   "Resume" \:30e2\:30fc\:30c9\:3067\:306f\:5fa9\:5143\:5f8c\:5373\:5ea7\:306b Retry \:3092\:5b9f\:884c\:3059\:308b\:3002
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)

Options[LLMGraphDAGRestore] = {
  "MergeGraphTo" -> None
};

LLMGraphDAGRestore[snapDir_String, opts:OptionsPattern[]] :=
  Module[{jobFile, auxFile, job, meta, auxState, jobId, nb, nodes,
          doneCount, failedCount, pendingCount,
          mergeTarget, mergeResult},
    jobFile = FileNameJoin[{snapDir, "job.wl"}];
    If[!FileExistsQ[jobFile],
      Print[Style["\[WarningSign] job.wl \:304c\:898b\:3064\:304b\:308a\:307e\:305b\:3093: " <> snapDir, Red]];
      Return[$Failed]];

    job = Quiet @ Check[Get[jobFile], $Failed];
    If[!AssociationQ[job],
      Print[Style["\[WarningSign] job.wl \:306e\:8aad\:307f\:8fbc\:307f\:306b\:5931\:6557", Red]];
      Return[$Failed]];

    jobId = None;
    (* \:30b8\:30e7\:30d6ID\:3092\:30c7\:30a3\:30ec\:30af\:30c8\:30ea\:540d\:304b\:3089\:62bd\:51fa: <timestamp>-<jobId> *)
    Module[{id = FileBaseName[snapDir]},
      id = StringReplace[id, RegularExpression["^\\d+-"] -> ""];
      If[StringLength[id] > 0, jobId = id,
        jobId = "restored-" <> ToString[Floor[AbsoluteTime[]]]]];

    (* nb \:3092\:73fe\:5728\:306e\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:306b\:8a2d\:5b9a *)
    nb = Quiet @ Check[EvaluationNotebook[], $Failed];
    job["nb"] = nb;
    job["restoredAt"] = AbsoluteTime[];

    nodes = job["nodes"];
    doneCount    = Count[Values[nodes], _?(Lookup[#, "status", ""] === "done" &)];
    failedCount  = Count[Values[nodes], _?(Lookup[#, "status", ""] === "failed" &)];
    pendingCount = Count[Values[nodes], _?(Lookup[#, "status", ""] === "pending" &)];

    (* $iLLMGraphDAGJobs \:306b\:767b\:9332 *)
    $iLLMGraphDAGJobs[jobId] = job;

    (* \:88dc\:52a9\:72b6\:614b\:306e\:5fa9\:5143 *)
    auxFile = FileNameJoin[{snapDir, "aux.wl"}];
    auxState = If[FileExistsQ[auxFile],
      Quiet @ Check[Get[auxFile], <||>], <||>];

    Print[Style["\[Checkmark] \:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:5fa9\:5143: " <> jobId, Darker[Green], Bold]];
    Print["  Done: ", doneCount, " / Failed: ", failedCount,
      " / Pending: ", pendingCount, " / Total: ", Length[nodes]];

    (* \:30aa\:30d7\:30b7\:30e7\:30f3: \"MergeGraphTo\" -> nb \:306e\:6307\:5b9a\:304c\:3042\:308c\:3070 llmgraph.wl \:3092\:30de\:30fc\:30b8 *)
    mergeTarget = OptionValue["MergeGraphTo"];
    mergeResult = None;
    If[MatchQ[mergeTarget, _NotebookObject],
      mergeResult = Quiet @ Check[
        iLLMGraphDAGMergeIntoNotebook[snapDir, mergeTarget],
        <|"Status" -> "Error"|>];
      If[AssociationQ[mergeResult],
        Switch[Lookup[mergeResult, "Status", ""],
          "Merged",
            Print["  LLMGraph merge: before=",
              Lookup[mergeResult, "NodeCountBefore", 0],
              " after=", Lookup[mergeResult, "NodeCountAfter", 0],
              " (+", Lookup[mergeResult, "AddedNodes", 0], ")"],
          "NoGraphInSnapshot",
            Print["  LLMGraph merge: \:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:306b llmgraph.wl \:7121\:3057 (\:65e7\:5f0f)"],
          _,
            Print["  LLMGraph merge: Status=", Lookup[mergeResult, "Status", "?"]]]]];

    If[failedCount + pendingCount > 0,
      Print["  \:518d\:958b: LLMGraphDAGRetry[\"" <> jobId <> "\"]"]];

    <|"jobId" -> jobId,
      "done" -> doneCount, "failed" -> failedCount,
      "pending" -> pendingCount,
      "auxiliaryState" -> auxState,
      "mergeResult" -> mergeResult|>
  ];

LLMGraphDAGRestore[snapDir_String, "Resume"] :=
  Module[{nb, result},
    (* Resume \:30e2\:30fc\:30c9: EvaluationNotebook \:3078\:81ea\:52d5\:30de\:30fc\:30b8\:3057\:3066 history continuity \:3092\:4fdd\:3064 *)
    nb = Quiet @ Check[EvaluationNotebook[], $Failed];
    result = If[MatchQ[nb, _NotebookObject],
      LLMGraphDAGRestore[snapDir, "MergeGraphTo" -> nb],
      LLMGraphDAGRestore[snapDir]];
    If[AssociationQ[result] && StringQ[result["jobId"]],
      Print["  \[RightArrow] \:81ea\:52d5\:518d\:958b\:4e2d..."];
      LLMGraphDAGRetry[result["jobId"]]];
    result];

(* \[HorizontalLine]\[HorizontalLine] LLMGraphDAGMergeHistory (\:660e\:793a API) \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:65e2\:306b\:5fa9\:5143\:6e08\:307f\:306e\:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:3084\:3001\:5225\:306e notebook \:306b post-hoc \:3067\:30de\:30fc\:30b8\:3057\:305f\:3044\:5834\:5408\:306b\:4f7f\:7528\:3002
   \:623b\:308a\:5024: <|\"Status\" -> \"Merged\"|\"NoGraphInSnapshot\"|..., ...|>
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)

LLMGraphDAGMergeHistory[snapDir_String, nb_NotebookObject] :=
  Module[{result, status},
    If[!DirectoryQ[snapDir],
      Print[Style["\[WarningSign] \:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:30c7\:30a3\:30ec\:30af\:30c8\:30ea\:304c\:898b\:3064\:304b\:308a\:307e\:305b\:3093: " <> snapDir, Red]];
      Return[<|"Status" -> "SnapDirNotFound"|>]];
    result = iLLMGraphDAGMergeIntoNotebook[snapDir, nb];
    status = If[AssociationQ[result], Lookup[result, "Status", "Unknown"], "Unknown"];
    Which[
      status === "Merged",
        Print[Style["\[Checkmark] LLMGraph merge \:5b8c\:4e86", Darker[Green], Bold]];
        Print["  before=", Lookup[result, "NodeCountBefore", 0],
          " after=", Lookup[result, "NodeCountAfter", 0],
          " (+", Lookup[result, "AddedNodes", 0], ")"],
      status === "NoGraphInSnapshot",
        Print[Style["\[WarningSign] llmgraph.wl \:7121\:3057 (\:65e7\:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8)", Orange]],
      True,
        Print[Style["\[WarningSign] merge \:5931\:6557: " <> ToString[status], Red]]];
    result];
LLMGraphDAGMergeHistory[snapDir_String] :=
  Module[{nb = Quiet @ EvaluationNotebook[]},
    If[!MatchQ[nb, _NotebookObject],
      <|"Status" -> "NoNotebook"|>,
      LLMGraphDAGMergeHistory[snapDir, nb]]];

(* \[HorizontalLine]\[HorizontalLine] LLMGraphDAGListSnapshots \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   $ClaudeSnapshots \:5185\:306e\:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:4e00\:89a7\:3092 Dataset \:3067\:8fd4\:3059\:3002
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)

LLMGraphDAGListSnapshots[] :=
  Module[{dirs, rows = {}},
    If[!DirectoryQ[$ClaudeSnapshots],
      Print["  \:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:306a\:3057 ($ClaudeSnapshots = " <>
        $ClaudeSnapshots <> ")"];
      Return[Dataset[{}]]];
    dirs = Select[FileNames["*", $ClaudeSnapshots],
      DirectoryQ[#] && FileExistsQ[FileNameJoin[{#, "meta.wl"}]] &];
    Do[Module[{meta = Quiet @ Check[Get[FileNameJoin[{d, "meta.wl"}]], <||>]},
      If[AssociationQ[meta],
        AppendTo[rows,
          <|"dir" -> d,
            "jobId"    -> Lookup[meta, "jobId", "?"],
            "taskName" -> Lookup[meta, "taskName", "?"],
            "done"     -> Lookup[meta, "done", 0],
            "failed"   -> Lookup[meta, "failed", 0],
            "pending"  -> Lookup[meta, "pending", 0],
            "total"    -> Lookup[meta, "total", 0],
            "hasGraph" -> FileExistsQ[FileNameJoin[{d, "llmgraph.wl"}]],
            "time"     -> DateString[
              FromUnixTime[ToExpression[Lookup[meta, "timestamp", "0"]]],
              {"Year","-","Month","-","Day"," ","Hour",":","Minute"}]|>]]],
      {d, SortBy[dirs, -FileDate[#, "Modification"] &]}];
    Dataset[rows]];

(* \[HorizontalLine]\[HorizontalLine] LLMGraphDAGPlot \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   DAG \:30b8\:30e7\:30d6\:306e\:30ce\:30fc\:30c9\:4f9d\:5b58\:95a2\:4fc2\:3092 Graph \:3067\:53ef\:8996\:5316\:3059\:308b\:3002
   \:30b9\:30c6\:30fc\:30bf\:30b9\:306b\:5fdc\:3058\:305f\:8272\:5206\:3051:
     done=\:7dd1, running=\:30aa\:30ec\:30f3\:30b8, failed=\:8d64, pending=\:7070
   \:5b9f\:884c\:4e2d\:30fb\:505c\:6b62\:4e2d\:30fb\:5b8c\:4e86\:5f8c\:3044\:305a\:308c\:306e DAG \:3067\:3082\:8868\:793a\:53ef\:80fd\:3002
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)

LLMGraphDAGPlot[jobId_String] :=
  Module[{job, nodes, taskDesc, catMap, dagName,
          edges = {}, vLabels = <||>, vStyle = <||>, vSize = <||>,
          statusColor, nodeKeys},
    job = Quiet @ $iLLMGraphDAGJobs[jobId];
    If[!AssociationQ[job], Return[Missing["JobNotFound", jobId]]];
    nodes    = job["nodes"];
    taskDesc = Lookup[job, "taskDescriptor", <||>];
    catMap   = Lookup[taskDesc, "categoryMap", <||>];
    dagName  = Lookup[taskDesc, "name", jobId];
    nodeKeys = Keys[nodes];

    statusColor[s_] := Switch[s,
      "done",    Darker[Green],
      "running", Orange,
      "failed",  Red,
      "pending", GrayLevel[0.6],
      _,         GrayLevel[0.4]];

    Scan[Module[{nid = #, n, st, cat, absCat, lbl, deps},
      n    = nodes[nid];
      st   = Lookup[n, "status", "?"];
      cat  = Lookup[n, "category", "?"];
      absCat = Lookup[catMap, cat, cat];
      deps = Lookup[n, "dependsOn", {}];

      (* \:30a8\:30c3\:30b8 *)
      Scan[AppendTo[edges, DirectedEdge[#, nid]] &, deps];

      (* Tooltip \:30e9\:30d9\:30eb: nodeId + \:30ab\:30c6\:30b4\:30ea + \:30b9\:30c6\:30fc\:30bf\:30b9 + \:30a8\:30e9\:30fc + \:7d50\:679c\:30d7\:30ec\:30d3\:30e5\:30fc *)
      lbl = nid <>
        "\nCategory: " <> cat <>
          If[cat =!= absCat, " \[RightArrow] " <> absCat, ""] <>
        "\nStatus: " <> st;
      If[st === "failed",
        Module[{err = ToString[Lookup[n, "error", ""]]},
          If[StringLength[err] > 0 && err =!= "None",
            lbl = lbl <> "\nError: " <> StringTake[err, UpTo[80]]]]];
      If[st === "done",
        Module[{res = ToString[Lookup[n, "result", ""]]},
          If[StringLength[res] > 0 && res =!= "None",
            lbl = lbl <> "\nResult: " <> StringTake[res, UpTo[80]]]]];
      vLabels[nid] = Placed[lbl, Tooltip];
      vStyle[nid]  = statusColor[st];
      vSize[nid]   = If[st === "running", 0.8, 0.6]] &,
      nodeKeys];

    (* \:7d71\:8a08\:884c *)
    Module[{counts = Counts[Lookup[#, "status", "?"] & /@ Values[nodes]],
            elapsed = Round[AbsoluteTime[] -
              Lookup[job, "startTime", AbsoluteTime[]], 0.1],
            nc = Length[nodeKeys],
            arrowSz, vtxSz, imgH, imgW},
      arrowSz = Min[0.04, Max[0.008, 0.6 / nc]];
      vtxSz   = Min[0.5,  Max[0.15,  8.0 / nc]];
      imgH    = Max[200, Min[1000, 45 * nc]];
      imgW    = Max[350, Min[1200, 12 * Length[edges]]];
      Graph[nodeKeys, edges,
        VertexLabels -> Normal[vLabels],
        VertexStyle -> Normal[vStyle],
        VertexSize -> vtxSz,
        EdgeStyle -> Directive[GrayLevel[0.4], Arrowheads[arrowSz]],
        GraphLayout -> "LayeredDigraph",
        ImageSize -> {imgW, imgH},
        PlotLabel -> Style[
          dagName <> "  (" <> ToString[elapsed] <> "s)\n" <>
          StringRiffle[
            KeyValueMap[#1 <> ":" <> ToString[#2] &, counts], "  "],
          Bold, 12]]]
  ];

(* \[HorizontalLine]\[HorizontalLine] NotebookLLMGraph \:7d71\:5408: DAG \:30ce\:30fc\:30c9\:3092\:5b9f\:884c\:5c65\:6b74\:306b\:8a18\:9332 \[HorizontalLine]\[HorizontalLine]
   \:5b8c\:4e86\:3057\:305f DAG \:30b8\:30e7\:30d6\:306e\:30ce\:30fc\:30c9\:3092 NotebookLLMGraph \:306b\:767b\:9332\:3057\:3001
   NotebookLLMGraphPlot \:3067\:53ef\:8996\:5316\:3067\:304d\:308b\:3088\:3046\:306b\:3059\:308b\:3002
   \:30ab\:30c6\:30b4\:30ea\:306b\:5fdc\:3058\:305f\:8272\:5206\:3051:
