   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)

(* \[HorizontalLine]\[HorizontalLine] LLMGraphDAGPlot / Inspect: \:4fdd\:5b58\:6e08\:307f\:30b8\:30e7\:30d6\:5bfe\:5fdc \[HorizontalLine]\[HorizontalLine]
   DAG \:5b8c\:4e86\:5f8c $iLLMGraphDAGJobs \:304b\:3089\:524a\:9664\:3055\:308c\:305f\:30b8\:30e7\:30d6\:3067\:3082\:3001
   ClaudeRuntime \:306e CompletedDAGJob \:7b49\:304b\:3089\:76f4\:63a5\:53ef\:8996\:5316\:3067\:304d\:308b\:3002
   \:4f8b: st = ClaudeRuntimeState[rid]; LLMGraphDAGPlot[st["CompletedDAGJob"]]
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
LLMGraphDAGPlot[job_Association /; KeyExistsQ[job, "nodes"]] :=
  Module[{tempId = "tmp-plot-" <> ToString[RandomInteger[10^8]]},
    $iLLMGraphDAGJobs[tempId] = job;
    WithCleanup[
      LLMGraphDAGPlot[tempId],
      $iLLMGraphDAGJobs = KeyDrop[$iLLMGraphDAGJobs, tempId]]
  ];

LLMGraphDAGInspect[job_Association /; KeyExistsQ[job, "nodes"]] :=
  Module[{tempId = "tmp-inspect-" <> ToString[RandomInteger[10^8]]},
    $iLLMGraphDAGJobs[tempId] = job;
    WithCleanup[
      LLMGraphDAGInspect[tempId],
      $iLLMGraphDAGJobs = KeyDrop[$iLLMGraphDAGJobs, tempId]]
  ];

LLMGraphDAGInspect[job_Association /; KeyExistsQ[job, "nodes"],
    "Summary"] :=
  Module[{tempId = "tmp-inspect-" <> ToString[RandomInteger[10^8]]},
    $iLLMGraphDAGJobs[tempId] = job;
    WithCleanup[
      LLMGraphDAGInspect[tempId, "Summary"],
      $iLLMGraphDAGJobs = KeyDrop[$iLLMGraphDAGJobs, tempId]]
  ];

iLLMGraphDAGRecordHistory[job_Association] :=
  Module[{nb, nodes, taskDesc, dagName, graph, graphNodes,
          dagPrefix, catMap, nodeList, dagNode, nlgNodeID,
          accessLevel, nodeType, statusStr, inEdges, outEdges,
          ctx, detailLevel, runtimeId, turnCount, turnNodeID,
          lastNodeID},
    nb = Lookup[job, "nb", $Failed];
    If[nb === $Failed, Return[]];
    nodes    = job["nodes"];
    taskDesc = Lookup[job, "taskDescriptor", <||>];
    dagName  = Lookup[taskDesc, "name", "LLMGraph DAG"];
    catMap   = Lookup[taskDesc, "categoryMap", <||>];
    
    (* ClaudeRuntime \:30b3\:30f3\:30c6\:30ad\:30b9\:30c8\:691c\:51fa *)
    ctx = Lookup[job, "context", <||>];
    detailLevel = Lookup[ctx, "detailLevel", None];
    runtimeId   = Lookup[ctx, "runtimeId", None];
    turnCount   = Lookup[ctx, "turnCount", None];

    graph = iLLMGraphGetCached[nb];
    If[!AssociationQ[graph], Return[]];
    graphNodes = Lookup[graph, "Nodes", <||>];

    dagPrefix = "dag-" <> ToString[Round[Lookup[job, "startTime", AbsoluteTime[]]]];

    (* DAG \:30ce\:30fc\:30c9\:3092 NotebookLLMGraph \:30ce\:30fc\:30c9\:306b\:5909\:63db *)
    nodeList = Keys[nodes];
    lastNodeID = None;
    Do[
      dagNode    = nodes[nid];
      nlgNodeID  = dagPrefix <> "-" <> nid;

      accessLevel = Module[{cat = Lookup[dagNode, "category", "sync"],
                            absCat},
        absCat = Lookup[catMap, cat, cat];
        Switch[absCat,
          "cli",        "Public",
          "cli-vision", "Public",
          "process",    "Mixed",
          "sync",       "Public",
          _,            "Public"]];

      nodeType = Module[{cat = Lookup[dagNode, "category", "sync"],
                         absCat},
        absCat = Lookup[catMap, cat, cat];
        Switch[absCat,
          "cli",        "CloudLLM",
          "cli-vision", "VisionLLM",
          "process",    "External",
          "sync",       "Compute",
          _,            "Compute"]];

      statusStr = Switch[Lookup[dagNode, "status", "pending"],
        "done",    "Completed",
        "failed",  "Failed",
        "running", "Processing",
        _,         "Pending"];

      inEdges = Function[dep,
        <|"From" -> dagPrefix <> "-" <> dep, "Type" -> "DAGDependency"|>
      ] /@ Lookup[dagNode, "dependsOn", {}];

      outEdges = Function[targetId,
        <|"To" -> dagPrefix <> "-" <> targetId, "Type" -> "DAGDependency"|>
      ] /@ Select[nodeList,
        MemberQ[Lookup[nodes[#], "dependsOn", {}], nid] &];

      (* v2026-04-20 T03: dispatchDecision / validateProposal / parseProposal
         \:306a\:3069\:306e\:30ce\:30fc\:30c9\:306f result \:306b Decision/Outcome/ReasonClass/
         VisibleExplanation \:304c\:5165\:3063\:3066\:3044\:308b\:306e\:3067\:5c02\:7528\:30d5\:30a3\:30fc\:30eb\:30c9\:306b\:62bd\:51fa\:3002
         \:65e2\:5b9a\:306f None \:3001\:63cf\:753b\:5074\:304c\:30d5\:30a3\:30fc\:30eb\:30c9\:6709\:7121\:306b\:5fdc\:3058\:3066 ToolTip \:6271\:3044\:3002 *)
      Module[{res, dec, outc, reason, detail, summaryStr},
        res = Lookup[dagNode, "result", None];
        If[AssociationQ[res],
          dec    = Lookup[res, "Decision", None];
          outc   = Lookup[res, "Outcome", None];
          reason = Lookup[res, "ReasonClass", None];
          detail = Lookup[res, "VisibleExplanation",
            Lookup[res, "Reason", None]],
          dec = None; outc = None; reason = None; detail = None];
        (* \:30b5\:30de\:30ea\:30fc\:6587\:5b57\:5217\:306e\:4e0a\:9650\:3092 80\[RightArrow]240\:306b\:62e1\:5927 *)
        summaryStr = If[statusStr === "Failed",
          "Error: " <> ToString[Lookup[dagNode, "error", ""]],
          StringTake[ToString[res], UpTo[240]]];
        graphNodes[nlgNodeID] = iNewLLMNode[nlgNodeID, nodeType, accessLevel,
          <|"Instruction" -> dagName <> ": " <> nid,
            "ResponseSummary" -> summaryStr,
            "Status" -> statusStr,
            "Time" -> Lookup[job, "startTime", None],
            "Type" -> "dag-node",
            (* ClaudeRuntime \:5185\:90e8\:30ce\:30fc\:30c9\:306b\:306f DetailLevel \:3092\:4ed8\:4e0e *)
            "DetailLevel" -> If[StringQ[detailLevel], detailLevel, "Normal"],
            "InEdges" -> inEdges,
            "OutEdges" -> outEdges,
            (* v2026-04-20 T03: \:8a3a\:65ad\:30d5\:30a3\:30fc\:30eb\:30c9 (\:30ce\:30fc\:30c9\:7a2e\:5225\:306b\:5fdc\:3058\:3066\:5b58\:5728) *)
            "Decision"    -> dec,
            "Outcome"     -> outc,
            "ReasonClass" -> reason,
            "Reason"      -> detail|>]];
      
      lastNodeID = nlgNodeID,
    {nid, nodeList}];
    
    (* ClaudeRuntime \:306e\:5834\:5408: 
       1. \:6700\:5f8c\:306e DAG \:30ce\:30fc\:30c9 \[RightArrow] \:5bfe\:5fdc\:3059\:308b turn \:30ce\:30fc\:30c9\:3078 Produces \:30a8\:30c3\:30b8
       2. \:30aa\:30fc\:30b1\:30b9\:30c8\:30ec\:30fc\:30bf \[RightArrow] \:6700\:521d\:306e DAG \:30ce\:30fc\:30c9\:3078 Produces \:30a8\:30c3\:30b8 (Detail \:8868\:793a\:7528) *)
    If[StringQ[runtimeId] && IntegerQ[turnCount],
      turnNodeID = "rt-" <> runtimeId <> "-turn" <> ToString[turnCount];
      
      (* 2a. \:6700\:5f8c\:306e DAG \:30ce\:30fc\:30c9 \[RightArrow] turn \:30ce\:30fc\:30c9\:3078 Produces *)
      If[StringQ[lastNodeID] && KeyExistsQ[graphNodes, lastNodeID],
        graphNodes[lastNodeID]["OutEdges"] = Append[
          Lookup[graphNodes[lastNodeID], "OutEdges", {}],
          <|"To" -> turnNodeID, "Type" -> "Produces"|>]];
      
      (* 2b. \:30aa\:30fc\:30b1\:30b9\:30c8\:30ec\:30fc\:30bf \[RightArrow] \:30eb\:30fc\:30c8 DAG \:30ce\:30fc\:30c9\:3078 Produces *)
      Module[{rootIds, orchestratorID = None},
        (* \:30eb\:30fc\:30c8 DAG \:30ce\:30fc\:30c9: \:4f9d\:5b58\:5148\:304c\:306a\:3044 (dependsOn \:304c\:7a7a) *)
        rootIds = Select[nodeList,
          Lookup[nodes[#], "dependsOn", {}] === {} &];
        
        (* \:30aa\:30fc\:30b1\:30b9\:30c8\:30ec\:30fc\:30bf ID: turn \:30ce\:30fc\:30c9\:3078 DataFlow \:3092\:6301\:3064\:30ce\:30fc\:30c9\:3092\:691c\:7d22 *)
        Scan[Function[{nid},
          Module[{outE = Lookup[graphNodes[nid], "OutEdges", {}]},
            If[AnyTrue[outE,
              Lookup[#, "To", ""] === turnNodeID &&
              Lookup[#, "Type", ""] === "DataFlow" &],
              orchestratorID = nid]]],
          Keys[graphNodes]];
        
        (* Phase 28 \:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af: \:30bf\:30fc\:30f3\:30ce\:30fc\:30c9\:304c\:672a\:4f5c\:6210\:306e\:5834\:5408
           (iRuntimeRecordTurnToLLMGraph \:304c\:5f8c\:304b\:3089\:5b9f\:884c\:3055\:308c\:308b\:305f\:3081)
           RuntimeState \:306e Metadata \:304b\:3089\:76f4\:63a5\:30aa\:30fc\:30b1\:30b9\:30c8\:30ec\:30fc\:30bf\:3092\:7279\:5b9a\:3059\:308b *)
        If[!StringQ[orchestratorID] && StringQ[runtimeId],
          Module[{rt, rtMeta, rtTag, rtStep, candidateID},
            rt = Quiet @ ClaudeRuntime`Private`$iClaudeRuntimes[runtimeId];
            If[AssociationQ[rt],
              rtMeta = Lookup[rt, "Metadata", <||>];
              rtTag  = Lookup[rtMeta, "Tag", None];
              rtStep = Lookup[rtMeta, "Step", None];
              If[StringQ[rtTag] && IntegerQ[rtStep],
                candidateID = rtTag <> "-" <> ToString[rtStep + 1];
                If[KeyExistsQ[graphNodes, candidateID],
                  orchestratorID = candidateID]]]]];
        
        (* \:30aa\:30fc\:30b1\:30b9\:30c8\:30ec\:30fc\:30bf \[RightArrow] \:5404\:30eb\:30fc\:30c8 DAG \:30ce\:30fc\:30c9\:3078 Produces \:30a8\:30c3\:30b8\:8ffd\:52a0 *)
        If[StringQ[orchestratorID],
          Do[Module[{rootNlgID = dagPrefix <> "-" <> rid},
            If[KeyExistsQ[graphNodes, rootNlgID],
              (* OutEdge \:3092\:30aa\:30fc\:30b1\:30b9\:30c8\:30ec\:30fc\:30bf\:306b\:8ffd\:52a0 *)
              graphNodes[orchestratorID]["OutEdges"] = Append[
                Lookup[graphNodes[orchestratorID], "OutEdges", {}],
                <|"To" -> rootNlgID, "Type" -> "Produces"|>];
              (* InEdge \:3092\:30eb\:30fc\:30c8\:30ce\:30fc\:30c9\:306b\:8ffd\:52a0 *)
              graphNodes[rootNlgID]["InEdges"] = Append[
                Lookup[graphNodes[rootNlgID], "InEdges", {}],
                <|"From" -> orchestratorID, "Type" -> "Produces"|>]]],
            {rid, rootIds}]]]
    ];

    graph["Nodes"] = graphNodes;
    graph["LastModified"] = AbsoluteTime[];
    $iLLMGraphCache = graph;
    Quiet @ iLLMGraphFlush[nb];
  ];

