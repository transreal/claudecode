   instruction \:306f\:6587\:5b57\:5217\:307e\:305f\:306f\:30c6\:30ad\:30b9\:30c8+\:753b\:50cf\:306e\:30ea\:30b9\:30c8\:ff08ClaudeUpdatePackage \:3068\:540c\:3058\:ff09\:3002 *)
