        snapDir <> "\", \"Resume\"] ",
        iL["\:3067\:81ea\:52d5\:30ea\:30c8\:30e9\:30a4", "for auto-retry"], ")"]];
    
    <|"runtimeId" -> runtimeId,
      "status"    -> Lookup[savedState, "Status", "?"],
      "turnCount" -> Lookup[savedState, "TurnCount", 0],
      "doneNodes" -> doneCount,
      "failedNodes" -> failedCount|>
  ];

ClaudeRuntimeRestore[snapDir_String, "Resume"] :=
  Module[{result = ClaudeRuntimeRestore[snapDir],
          runtimeId, rt, completedNodes, failedIds, profile, jobId},
    If[!AssociationQ[result] || !StringQ[result["runtimeId"]],
      Return[result]];
    
    runtimeId = result["runtimeId"];
    rt = Quiet @ ClaudeRuntime`Private`$iClaudeRuntimes[runtimeId];
    If[!AssociationQ[rt], Return[result]];
    
    profile = Lookup[rt, "Profile", ""];
    completedNodes = Lookup[rt, "CompletedDAGNodes", <||>];
    failedIds = Select[Keys[completedNodes],
      MemberQ[{"failed", "pending"},
        Lookup[completedNodes[#], "status", ""]] &];
    
    If[Length[failedIds] > 0,
      (* \[HorizontalLine]\[HorizontalLine] DAGJob + \:5927\:91cf failed: \:5b89\:5168\:306e\:305f\:3081\:81ea\:52d5\:30ea\:30c8\:30e9\:30a4\:3057\:306a\:3044 \[HorizontalLine]\[HorizontalLine]
         Claude CLI \:306e Rate limit \:304c\:30ea\:30bb\:30c3\:30c8\:3055\:308c\:3066\:3044\:306a\:3044\:5834\:5408\:3001
         \:5927\:91cf\:306e CLI \:30d7\:30ed\:30bb\:30b9\:304c\:9ad8\:901f\:9023\:7d9a\:5931\:6557\:3057\:3066\:30d5\:30ed\:30f3\:30c8\:30a8\:30f3\:30c9\:304c\:30af\:30e9\:30c3\:30b7\:30e5\:3059\:308b\:3002 *)
      If[profile === "DAGJob" && Length[failedIds] > 5,
        jobId = Lookup[rt, "CurrentJobId", None];
        Print["  ", iL[
          "\[DoubleRightArrow] \:5fa9\:5143\:5b8c\:4e86\:3002" <> ToString[Length[failedIds]] <>
            " \:30ce\:30fc\:30c9\:304c\:30ea\:30c8\:30e9\:30a4\:5bfe\:8c61\:3067\:3059\:3002",
          "\[DoubleRightArrow] Restored. " <> ToString[Length[failedIds]] <>
            " nodes to retry."]];
        Print["  ", iL[
          "\:6e96\:5099\:304c\:3067\:304d\:305f\:3089\:4ee5\:4e0b\:3092\:5b9f\:884c:",
          "When ready, run:"]];
        Print["    ClaudeRuntimeRetry[\"" <> runtimeId <> "\"]"];
        If[StringQ[jobId],
          Print["    ", iL["\:307e\:305f\:306f", "or"], ": LLMGraphDAGRetry[\"" <>
            jobId <> "\"]"]],
        (* Eval / \:5c11\:6570 failed: \:81ea\:52d5\:30ea\:30c8\:30e9\:30a4 *)
        Print["  \[Rule] ", iL[
          "\:81ea\:52d5\:30ea\:30c8\:30e9\:30a4\:8d77\:52d5\:4e2d...",
          "Starting auto-retry..."]];
        Quiet @ Check[
          iRuntimeRetryDispatch[runtimeId],
          Print[Style[iL[
            "\[WarningSign] \:30ea\:30c8\:30e9\:30a4\:306b\:5931\:6557\:3002\:624b\:52d5\:3067\:518d\:5b9f\:884c\:3057\:3066\:304f\:3060\:3055\:3044\:3002",
            "\[WarningSign] Retry failed. Please retry manually."], Red]]]],
      (* failed \:306a\:3057 \[RightArrow] \:7d99\:7d9a\:30bf\:30fc\:30f3 *)
      If[profile === "DAGJob",
        Print["  ", iL[
          "\[DoubleRightArrow] \:5168\:30ce\:30fc\:30c9\:6210\:529f\:6e08\:307f\:3002\:30ea\:30c8\:30e9\:30a4\:4e0d\:8981\:3002",
          "\[DoubleRightArrow] All nodes succeeded. No retry needed."]],
        Print["  \[Rule] ", iL[
          "\:7d99\:7d9a\:30bf\:30fc\:30f3\:8d77\:52d5\:4e2d...",
          "Starting continuation turn..."]];
        Quiet @ Check[
          ClaudeRuntime`ClaudeContinueTurn[runtimeId],
          Print[Style[iL[
            "\[WarningSign] \:7d99\:7d9a\:30bf\:30fc\:30f3\:306b\:5931\:6557",
            "\[WarningSign] Continuation turn failed"], Red]]]]];
    result
  ];

(* \[HorizontalLine]\[HorizontalLine] iRuntimeRetryDispatch: ClaudeRuntime / LLMGraphDAG \:81ea\:52d5\:9078\:629e \[HorizontalLine]\[HorizontalLine]
   \:5185\:90e8\:30d8\:30eb\:30d1\:30fc\:3002ClaudeRuntime.wl \:30ed\:30fc\:30c9\:6e08\:307f\:306a\:3089\:59d4\:8b72\:3001
   \:672a\:30ed\:30fc\:30c9\:306a\:3089 LLMGraphDAGRetry \:306b\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:3002
