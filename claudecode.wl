                pendingIds = DeleteCases[pendingIds, nextId];
                AppendTo[runningIds, nextId],
              (* \:901a\:5e38\:306e sync \:5931\:6557 *)
              result === $Failed || result === None,
                node["status"] = "failed";
                node["error"]  = "Sync handler returned " <> ToString[Head[result]];
                anyLaunched = True;
                pendingIds = DeleteCases[pendingIds, nextId];
                AppendTo[failedIds, nextId];
                doneCount++,
              (* \:901a\:5e38\:306e sync \:5b8c\:4e86 *)
              True,
                node["status"] = "done";
                node["result"] = result;
                anyLaunched = True;
                pendingIds = DeleteCases[pendingIds, nextId];
                doneCount++],
            (* \:975e sync (process / cli \:7b49) *)
            Module[{launchResult = Quiet[node["handler"][job]]},
              If[AssociationQ[launchResult] && KeyExistsQ[launchResult, "proc"],
                node["status"]   = "running";
                node["runState"] = launchResult;
                catRunning[cat] = Lookup[catRunning, cat, 0] + 1;
                pendingIds = DeleteCases[pendingIds, nextId];
                AppendTo[runningIds, nextId],
                node["status"] = "failed";
                node["error"]  = "Launch failed: " <>
                  ToString[Short[launchResult, 2]];
                pendingIds = DeleteCases[pendingIds, nextId];
                AppendTo[failedIds, nextId];
                doneCount++]]];
          nodes[nextId] = node;
          (* sync \:5b8c\:4e86\:6642\:306f job \:3092\:5373\:5ea7\:306b\:66f4\:65b0\:3057\:3066\:6b21\:306e eligibility \:30c1\:30a7\:30c3\:30af\:306b\:53cd\:6620 *)
          If[node["type"] === "sync" && MemberQ[{"done", "failed"}, node["status"]],
            job["nodes"] = nodes;
