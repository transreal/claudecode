     <|"Detected"       -> DateObject[],          (* \:691c\:51fa\:6642\:523b *)
       "Source"         -> "rate_limit_event" | "result" | "legacy",
       "RateLimitType"  -> "five_hour" | ...,     (* CLI \:304b\:3089 *)
       "ResetsAtUnix"   -> 1776664800,
       "ResetsAt"       -> DateObject[...],       (* Mathematica DateObject *)
       "HttpStatus"     -> 429,
       "Message"        -> "You've hit your limit...",
       "IsUsingOverage" -> False,
       "OverageStatus"  -> "rejected"|>
   rate-limit \:3067\:306a\:3051\:308c\:3070 None\:3002 *)
iExtractRateLimitInfo[text_String] :=
  Module[{lines, rateLine, resultLine, parsed, rateInfo,
          resetsAt, resetsDate, info},
    If[!StringQ[text] || StringLength[text] === 0, Return[None]];
    lines = StringSplit[text, "\n"];
    
    (* (1) rate_limit_event \:30a4\:30d9\:30f3\:30c8\:3092\:512a\:5148\:3057\:3066\:63a2\:3059 (\:6700\:3082\:8a73\:7d30) *)
    rateLine = SelectFirst[lines,
      StringContainsQ[#, "\"type\":\"rate_limit_event\""] &, None];
    If[StringQ[rateLine],
      parsed = Quiet @ Check[
        Developer`ReadRawJSONString[rateLine], None];
      If[AssociationQ[parsed],
        rateInfo = Lookup[parsed, "rate_limit_info", <||>];
        (* Phase 30.3 fix (2026-04-22): rate_limit_event \:306f\:300c\:4f7f\:7528\:91cf\:9032\:6357\:300d
           \:3092\:901a\:77e5\:3059\:308b\:5b9a\:671f\:30a4\:30d9\:30f3\:30c8\:3067\:3001status \:30d5\:30a3\:30fc\:30eb\:30c9\:3067\:5b9f\:969b\:306b
           \:5236\:9650\:304c\:304b\:304b\:3063\:3066\:3044\:308b\:304b\:3092\:5224\:5225\:3059\:308b\:3002
           
           status \:306e\:5024:
             \"allowed\"  : \:307e\:3060\:4f7f\:3048\:308b \[RightArrow] \:8a18\:9332\:3057\:306a\:3044 (None \:3092\:8fd4\:3059)
             \"limited\" / \"exceeded\" / \"rejected\" : \:5b9f\:969b\:306b\:30d2\:30c3\:30c8 \[RightArrow] \:8a18\:9332\:3059\:308b
           
           \:4ee5\:524d\:306f status \:3092\:7121\:8996\:3057\:3066\:3059\:3079\:3066\:8a18\:9332\:3057\:3066\:3044\:305f\:305f\:3081\:3001
           ResetsAt \:306b\:5c06\:6765\:306e\:30d0\:30b1\:30c3\:30c8\:5883\:754c\:304c\:5165\:3063\:3066 \"Rate limit active\"
           \:304c\:8aa4\:3063\:3066\:8868\:793a\:3055\:308c\:308b\:30d0\:30b0\:304c\:3042\:3063\:305f (limit.nb)\:3002 *)
        If[ToLowerCase[ToString[Lookup[rateInfo, "status", ""]]] === "allowed",
          Return[None]];
        resetsAt = Lookup[rateInfo, "resetsAt", None];
        resetsDate = If[IntegerQ[resetsAt],
          Quiet @ Check[FromUnixTime[resetsAt], None], None];
        info = <|
          "Detected"             -> DateObject[],
          "Source"               -> "rate_limit_event",
          "Status"               -> Lookup[rateInfo, "status", None],
          "RateLimitType"        -> Lookup[rateInfo, "rateLimitType", None],
          "ResetsAtUnix"         -> resetsAt,
          "ResetsAt"             -> resetsDate,
          "OverageStatus"        -> Lookup[rateInfo, "overageStatus", None],
          "OverageDisabledReason" -> Lookup[rateInfo, "overageDisabledReason", None],
          "IsUsingOverage"       -> Lookup[rateInfo, "isUsingOverage", None]|>;
        Return[info]]];
    
    (* (2) result \:30a4\:30d9\:30f3\:30c8\:306b api_error_status:429 \:304c\:3042\:308c\:3070\:6700\:5c0f\:9650\:306e\:60c5\:5831 *)
    resultLine = SelectFirst[Reverse[lines],
      StringContainsQ[#, "\"api_error_status\":4"] ||
      StringContainsQ[#, "\"api_error_status\":5"] &, None];
    If[StringQ[resultLine],
      parsed = Quiet @ Check[
        Developer`ReadRawJSONString[resultLine], None];
      If[AssociationQ[parsed],
        info = <|
          "Detected"   -> DateObject[],
          "Source"     -> "result",
          "HttpStatus" -> Lookup[parsed, "api_error_status", None],
          "Message"    -> Lookup[parsed, "result",
                            Lookup[parsed, "error", None]],
          "ResetsAt"   -> None|>;
        Return[info]]];
    
    (* (3) Legacy: \:975e stream-json \:3067 "hit your limit" \:306a\:3069\:304c\:898b\:3064\:304b\:3063\:305f\:5834\:5408 *)
    If[StringContainsQ[text, "hit your limit" | "rate limit",
         IgnoreCase -> True],
      Return[<|
        "Detected" -> DateObject[],
        "Source"   -> "legacy",
        "Message"  -> StringTake[text, UpTo[200]],
        "ResetsAt" -> None|>]];
    
    None];
iExtractRateLimitInfo[_] := None;

