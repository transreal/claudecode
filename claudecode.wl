     3. \:72ec\:7acb\:30c1\:30e3\:30f3\:30af\:306f\:4e26\:5217\:3001\:4f9d\:5b58\:30c1\:30e3\:30f3\:30af\:306f\:9010\:6b21\:306b\:5b9f\:884c
