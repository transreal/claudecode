   \:30c1\:30a7\:30fc\:30f3\:5168\:4f53\:3092\:4e2d\:65ad\:3057\:305f\:305f\:3081\:3001\:518d\:5b9f\:884c\:3057\:3066\:3082\:540c\:3058\:30d5\:30a1\:30a4\:30eb(\:4f8b: setup.md \:304c\:5de8\:5927\:5316\:3057
