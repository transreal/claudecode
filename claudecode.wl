      {"NBAccess`\\$NB\\w+\\s*=\\s*", "j",
       "NBAccess \:516c\:958b\:30b0\:30ed\:30fc\:30d0\:30eb\:3078\:306e\:76f4\:63a5\:4ee3\:5165 (setter API \:3092\:4f7f\:7528)"},
