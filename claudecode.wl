   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iLLMGraphInferNodeType[entry_Association] :=
  Module[{t = Lookup[entry, "type", "query"],
          inst = Lookup[entry, "instruction", ""]},
    If[t === "continue" || StringStartsQ[ToString[inst], "ContinueEval"],
      "Continuation", "Orchestrator"]
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:30ec\:30b9\:30dd\:30f3\:30b9\:30b5\:30de\:30ea\:30fc\:751f\:6210 (API \:4e0d\:8981\:3001\:30ed\:30fc\:30ab\:30eb\:306e\:307f)
   \:65e2\:5b58\:306e iMakeLocalSummary \:3092\:6d3b\:7528\:3057\:3064\:3064\:3001\:30b5\:30a4\:30ba\:3092\:53b3\:683c\:306b\:5236\:9650
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iLLMGraphMakeSummary[entry_Association] :=
  Module[{resp, code, summary},
    resp = Lookup[entry, "response", ""];
    code = Lookup[entry, "code", ""];
    (* \:65e2\:306b\:30b5\:30de\:30ea\:30fc\:304c\:3042\:308c\:3070\:305d\:308c\:3092\:4f7f\:3046 (\:30b3\:30f3\:30d1\:30af\:30b7\:30e7\:30f3\:6e08\:307f\:30a8\:30f3\:30c8\:30ea) *)
    If[KeyExistsQ[entry, "summary"] && StringQ[entry["summary"]] &&
       entry["summary"] =!= "",
      Return[StringTake[entry["summary"], UpTo[$iLLMGraphMaxSummaryChars]]]];
    (* response \:306e\:5148\:982d\:3092\:8981\:7d04\:3068\:3057\:3066\:4f7f\:7528 *)
    summary = If[StringQ[resp] && resp =!= "" &&
                 resp =!= "(\:51e6\:7406\:4e2d)" && resp =!= "\:ff08\:51e6\:7406\:4e2d\:ff09",
      StringTake[resp, UpTo[$iLLMGraphMaxSummaryChars]],
      If[StringQ[code] && code =!= "",
        "[code] " <> StringTake[code, UpTo[200]],
        ""]];
    summary
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:5916\:90e8\:30ad\:30e3\:30c3\:30b7\:30e5: \:30c7\:30a3\:30ec\:30af\:30c8\:30ea\:7ba1\:7406
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iLLMGraphCacheDir[] :=
  Module[{dir},
    (* $packageDirectory \:306f ClaudeCode \:304c\:8aad\:3081\:308b\:305f\:3081\:79d8\:533f\:30c7\:30fc\:30bf\:3092\:7f6e\:3051\:306a\:3044\:3002
       $UserBaseDirectory/ClaudeCode/ \:306f FrontEnd \:306e\:307f\:304c\:30a2\:30af\:30bb\:30b9\:3059\:308b\:9818\:57df\:3002 *)
    dir = FileNameJoin[{$UserBaseDirectory, "ClaudeCode", "llmgraph_cache"}];
    If[!DirectoryQ[dir], Quiet @ CreateDirectory[dir, CreateIntermediateDirectories -> True]];
    dir
  ];

(* \:30ad\:30e3\:30c3\:30b7\:30e5\:66f8\:304d\:8fbc\:307f: \:91cd\:3044 data \:3092\:5916\:90e8\:306b\:9000\:907f *)
iLLMGraphCacheWrite[nodeID_String, data_Association] :=
  Module[{path},
    path = FileNameJoin[{iLLMGraphCacheDir[],
      StringReplace[nodeID, "/" -> "_"] <> ".wxf"}];
    Quiet @ Export[path, data, "WXF"];
    path
  ];

(* \:30ad\:30e3\:30c3\:30b7\:30e5\:8aad\:307f\:8fbc\:307f *)
iLLMGraphCacheRead[nodeID_String] :=
  Module[{path, data},
    path = FileNameJoin[{iLLMGraphCacheDir[],
      StringReplace[nodeID, "/" -> "_"] <> ".wxf"}];
    If[!FileExistsQ[path], Return[Missing["CacheExpired"]]];
    data = Quiet @ Import[path, "WXF"];
    If[AssociationQ[data], data, Missing["CacheCorrupted"]]
  ];

(* \:30ad\:30e3\:30c3\:30b7\:30e5\:81ea\:52d5\:30af\:30ea\:30fc\:30f3\:30a2\:30c3\:30d7: \:53e4\:3044\:30d5\:30a1\:30a4\:30eb\:3092\:524a\:9664 *)
iLLMGraphCacheCleanup[] :=
  Module[{dir, files, toDelete},
    dir = iLLMGraphCacheDir[];
    files = FileNames["*.wxf", dir];
    If[Length[files] <= $iLLMGraphCacheMaxEntries, Return[]];
    (* \:66f4\:65b0\:65e5\:6642\:304c\:53e4\:3044\:9806\:306b\:30bd\:30fc\:30c8\:3057\:3001\:8d85\:904e\:5206\:3092\:524a\:9664 *)
    files = SortBy[files, FileDate[#, "Modification"] &];
    toDelete = Take[files, Length[files] - $iLLMGraphCacheMaxEntries];
    Quiet @ Scan[DeleteFile, toDelete];
  ];

(* ================================================================
   Phase 4a: L2 Computation Graph
   \:5404 L1 \:30ce\:30fc\:30c9 (ClaudeEval \:5fdc\:7b54) \:304c\:751f\:6210\:3057\:305f\:30b3\:30fc\:30c9\:30d6\:30ed\:30c3\:30af\:7fa4\:3092
   L2 \:8a08\:7b97\:30b0\:30e9\:30d5\:3068\:3057\:3066\:8ffd\:8de1\:3059\:308b\:3002

   L2 \:30ce\:30fc\:30c9\:69cb\:9020 (1 \:30ce\:30fc\:30c9\:3042\:305f\:308a ~300B):
     "NodeID"       -> "history-5_L2-1"   (* L1ID_L2-\:30d6\:30ed\:30c3\:30af\:756a\:53f7 *)
     "BlockIdx"     -> 1
     "Code"         -> "data = Import[...]"
     "Status"       -> "Pending"           (* Pending | Completed | Failed *)
     "ErrorMessage" -> None
     "Time"         -> AbsoluteTime[]
     "InEdges"      -> {}                  (* \:524d\:30d6\:30ed\:30c3\:30af\:3078\:306e Sequential \:4f9d\:5b58 *)
     "OutEdges"     -> {}

   L2 \:30b0\:30e9\:30d5\:69cb\:9020 (\:5916\:90e8\:30ad\:30e3\:30c3\:30b7\:30e5 {l1NodeID}_L2.wxf \:306b\:4fdd\:5b58):
     "L1NodeID"   -> "history-5"
     "CreatedAt"  -> AbsoluteTime[]
     "BlockCount" -> 3
     "Nodes"      -> <| "history-5_L2-1" -> node1, ... |>

   L1 \:30ce\:30fc\:30c9\:3078\:306e\:8ffd\:52a0\:30d5\:30a3\:30fc\:30eb\:30c9:
     "L2Ref"        -> "history-5_L2"  (* \:307e\:305f\:306f None *)
     "L2NodeCount"  -> 3
     "L2ErrorCount" -> 0
   ================================================================ *)

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   L2 \:5916\:90e8\:30ad\:30e3\:30c3\:30b7\:30e5: \:8aad\:307f\:66f8\:304d
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iLLMGraphCacheWriteL2[nodeID_String, l2Graph_Association] :=
  Module[{path},
    path = FileNameJoin[{iLLMGraphCacheDir[],
      StringReplace[nodeID, "/" -> "_"] <> "_L2.wxf"}];
    Quiet @ Export[path, l2Graph, "WXF"];
    path
  ];

iLLMGraphCacheReadL2[nodeID_String] :=
  Module[{path, data},
    path = FileNameJoin[{iLLMGraphCacheDir[],
      StringReplace[nodeID, "/" -> "_"] <> "_L2.wxf"}];
    If[!FileExistsQ[path], Return[Missing["CacheExpired"]]];
    data = Quiet @ Import[path, "WXF"];
    If[AssociationQ[data], data, Missing["CacheCorrupted"]]
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   L2 \:30ce\:30fc\:30c9\:30b3\:30f3\:30b9\:30c8\:30e9\:30af\:30bf
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iNewL2Node[l1NodeID_String, blockIdx_Integer, code_String] :=
  <|
    "NodeID"       -> l1NodeID <> "_L2-" <> ToString[blockIdx],
    "BlockIdx"     -> blockIdx,
    "Code"         -> code,
    "Status"       -> "Pending",
    "ErrorMessage" -> None,
    "Time"         -> AbsoluteTime[],
    "InEdges"      -> If[blockIdx > 1,
      {<|"From" -> l1NodeID <> "_L2-" <> ToString[blockIdx - 1],
         "Type" -> "Sequential"|>},
      {}],
    "OutEdges"     -> {}
  |>;

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:30ec\:30b9\:30dd\:30f3\:30b9\:6587\:5b57\:5217\:304b\:3089\:30b3\:30fc\:30c9\:30d6\:30ed\:30c3\:30af\:3092\:62bd\:51fa
   iClaudeEvalImpl \:3068\:540c\:3058\:51e6\:7406\:3092\:8e0f\:8972
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iLLMGraphExtractCodeBlocks[response_String] :=
  Module[{rawBlocks},
    rawBlocks = StringCases[response,
      RegularExpression["```(?:mathematica|wolfram)?\\n([\\s\\S]*?)```"] :> "$1"];
    rawBlocks = iFixUnicodeEscapes[StringTrim[#]] & /@ rawBlocks;
    rawBlocks = Select[rawBlocks, StringQ[#] && StringTrim[#] =!= "" &];
    If[Length[rawBlocks] === 0, Return[{}]];
    iMergeDependentBlocks[rawBlocks]
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   L2 \:30b0\:30e9\:30d5\:69cb\:7bc9: response \[RightArrow] L2 \:30b0\:30e9\:30d5
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iLLMGraphBuildL2[l1NodeID_String, response_String] :=
  Module[{blocks, nodes = <||>, i, node, prevID},
    blocks = Quiet @ iLLMGraphExtractCodeBlocks[response];
    If[!ListQ[blocks] || blocks === {}, Return[None]];

    Do[
      node = iNewL2Node[l1NodeID, i, blocks[[i]]];
      (* \:524d\:30ce\:30fc\:30c9\:306b OutEdge \:3092\:8a2d\:5b9a *)
      If[i > 1,
        prevID = l1NodeID <> "_L2-" <> ToString[i - 1];
        If[KeyExistsQ[nodes, prevID],
          nodes[prevID, "OutEdges"] = {<|
            "To"   -> node["NodeID"],
            "Type" -> "Sequential"|>}]];
      nodes[node["NodeID"]] = node,
    {i, Length[blocks]}];

    <|
      "L1NodeID"   -> l1NodeID,
      "CreatedAt"  -> AbsoluteTime[],
      "BlockCount" -> Length[blocks],
      "Nodes"      -> nodes
    |>
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   iLLMGraphBuildAndCacheL2:
   L2 \:30b0\:30e9\:30d5\:3092\:69cb\:7bc9\:3057\:3066\:30ad\:30e3\:30c3\:30b7\:30e5\:3057\:3001L1 \:30ce\:30fc\:30c9\:3092\:66f4\:65b0\:3059\:308b\:3002
   iLLMGraphOnUpdate \:306e\:5b8c\:4e86\:30d5\:30c3\:30af\:304b\:3089\:547c\:3070\:308c\:308b\:3002
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iLLMGraphBuildAndCacheL2[l1NodeID_String, response_String] :=
  Module[{l2Graph, blockCount, graph, nodes, node},
    l2Graph = Quiet @ iLLMGraphBuildL2[l1NodeID, response];
    If[!AssociationQ[l2Graph] ||
       Lookup[l2Graph, "BlockCount", 0] === 0, Return[]];
    blockCount = l2Graph["BlockCount"];
    (* L2 \:30ad\:30e3\:30c3\:30b7\:30e5\:306b\:66f8\:304d\:51fa\:3057 *)
    Quiet @ iLLMGraphCacheWriteL2[l1NodeID, l2Graph];
    (* L1 \:30ce\:30fc\:30c9\:306e L2 \:53c2\:7167\:30d5\:30a3\:30fc\:30eb\:30c9\:3092\:30a4\:30f3\:30e1\:30e2\:30ea\:30ad\:30e3\:30c3\:30b7\:30e5\:7d4c\:7531\:3067\:66f4\:65b0 *)
    graph = $iLLMGraphCache;
    If[!AssociationQ[graph], Return[]];
    nodes = Lookup[graph, "Nodes", <||>];
    node  = Lookup[nodes, l1NodeID, None];
    If[!AssociationQ[node], Return[]];
    node["L2Ref"]        = l1NodeID <> "_L2";
    node["L2NodeCount"]  = blockCount;
    node["L2ErrorCount"] = 0;
    nodes[l1NodeID] = node;
    graph["Nodes"]   = nodes;
    $iLLMGraphCache  = graph;
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   Phase 4b: L2 \:30b9\:30c6\:30fc\:30bf\:30b9\:624b\:52d5\:66f4\:65b0
   NBEvaluatePreviousCell \:306e\:5b8c\:4e86\:30b3\:30fc\:30eb\:30d0\:30c3\:30af\:304b\:3089\:5c06\:6765\:547c\:3073\:51fa\:305b\:308b\:3088\:3046
   public API \:3068\:3057\:3066\:7528\:610f\:3059\:308b\:3002
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iLLMGraphUpdateL2NodeStatus[l1NodeID_String, l2NodeID_String,
                             status_String, msg_:None] :=
  Module[{l2Graph, nodes, node},
    l2Graph = iLLMGraphCacheReadL2[l1NodeID];
    If[!AssociationQ[l2Graph], Return[]];
    nodes = Lookup[l2Graph, "Nodes", <||>];
    node  = Lookup[nodes, l2NodeID, None];
    If[!AssociationQ[node], Return[]];
    node["Status"] = status;
    If[msg =!= None, node["ErrorMessage"] = msg];
    nodes[l2NodeID] = node;
    l2Graph["Nodes"] = nodes;
    Quiet @ iLLMGraphCacheWriteL2[l1NodeID, l2Graph];
    (* L1 \:30ce\:30fc\:30c9\:306e L2ErrorCount \:3092\:66f4\:65b0 *)
    Module[{graph, l1Nodes, l1Node, errCount},
      graph = $iLLMGraphCache;
      If[!AssociationQ[graph], Return[]];
      l1Nodes = Lookup[graph, "Nodes", <||>];
      l1Node  = Lookup[l1Nodes, l1NodeID, None];
      If[!AssociationQ[l1Node], Return[]];
      errCount = Length @ Select[
        Values @ Lookup[l2Graph, "Nodes", <||>],
        Lookup[#, "Status", ""] === "Failed" &];
      l1Node["L2ErrorCount"] = errCount;
      l1Nodes[l1NodeID] = l1Node;
      graph["Nodes"] = l1Nodes;
      $iLLMGraphCache = graph];
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:8efd\:91cf\:30ce\:30fc\:30c9\:30b3\:30f3\:30b9\:30c8\:30e9\:30af\:30bf
   TaggingRules \:306b\:4fdd\:5b58\:3059\:308b\:306e\:306f\:3053\:306e\:69cb\:9020\:306e\:307f
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iNewLLMNode[nodeID_String, nodeType_String, accessLevel_String,
            fields_Association : <||>] :=
  Join[<|
    "NodeID"          -> nodeID,
    "NodeType"        -> nodeType,
    "AccessLevel"     -> accessLevel,
    "InEdges"         -> {},
    "OutEdges"        -> {},
    "Status"          -> "Completed",
    "Instruction"     -> "",
    "ResponseSummary" -> "",
    "Step"            -> 0,
    "Time"            -> None,
    "Type"            -> "query",
    "L2Ref"           -> None,
    "L2NodeCount"     -> 0,
    "L2ErrorCount"    -> 0
  |>, fields];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:30bb\:30c3\:30b7\:30e7\:30f3\:5c65\:6b74\:30a8\:30f3\:30c8\:30ea \[RightArrow] \:8efd\:91cf\:30ce\:30fc\:30c9\:5909\:63db
   \:91cd\:3044\:30c7\:30fc\:30bf (fullPrompt, response, code) \:306f\:5916\:90e8\:30ad\:30e3\:30c3\:30b7\:30e5\:3078
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iHistoryEntryToNode[entry_Association, sessionTag_String,
                    idx_Integer, cacheHeavyData_:True] :=
  Module[{nodeID, nodeType, accessLevel, inEdges, inst, summary},
    nodeID = sessionTag <> "-" <> ToString[idx];
    nodeType = iLLMGraphInferNodeType[entry];
    accessLevel = iLLMGraphInferAccessLevelFromEntry[entry];

    (* \:5148\:884c\:30ce\:30fc\:30c9\:304b\:3089\:306e\:30a8\:30c3\:30b8: parentStep \:6307\:5b9a\:304c\:3042\:308c\:3070\:305d\:308c\:3092\:4f7f\:7528 (Fork/Join \:7528) *)
    inEdges = Module[{ps = Quiet @ Lookup[entry, "parentStep", None],
                       et = Quiet @ Lookup[entry, "edgeType", "ContextInheritance"]},
      If[!StringQ[et], et = "ContextInheritance"];
      If[IntegerQ[ps] && ps >= 1,
        {<|"From" -> sessionTag <> "-" <> ToString[ps], "Type" -> et|>},
        If[idx > 1,
          {<|"From" -> sessionTag <> "-" <> ToString[idx - 1],
             "Type" -> "ContextInheritance"|>},
          {}]]];

    (* instruction \:3092\:5207\:308a\:8a70\:3081 *)
    inst = Lookup[entry, "instruction", ""];
    If[StringQ[inst],
      inst = StringTake[inst, UpTo[$iLLMGraphMaxInstructionChars]],
      inst = StringTake[ToString[inst], UpTo[$iLLMGraphMaxInstructionChars]]];

    (* \:30ec\:30b9\:30dd\:30f3\:30b9\:30b5\:30de\:30ea\:30fc\:751f\:6210 *)
    summary = iLLMGraphMakeSummary[entry];

    (* \:91cd\:3044\:30c7\:30fc\:30bf\:3092\:5916\:90e8\:30ad\:30e3\:30c3\:30b7\:30e5\:306b\:66f8\:304d\:51fa\:3057 *)
    If[TrueQ[cacheHeavyData],
      Module[{heavyData = <||>},
        If[KeyExistsQ[entry, "fullPrompt"],
          heavyData["fullPrompt"] = entry["fullPrompt"]];
        If[KeyExistsQ[entry, "response"] && StringQ[entry["response"]] &&
           entry["response"] =!= "(\:51e6\:7406\:4e2d)" &&
           entry["response"] =!= "\:ff08\:51e6\:7406\:4e2d\:ff09",
          heavyData["response"] = entry["response"]];
        If[KeyExistsQ[entry, "code"] && StringQ[entry["code"]] &&
           entry["code"] =!= "",
          heavyData["code"] = entry["code"]];
        If[Length[heavyData] > 0,
          Quiet @ iLLMGraphCacheWrite[nodeID, heavyData]]]];

    (* \:8efd\:91cf\:30ce\:30fc\:30c9\:3092\:8fd4\:3059 *)
    <|
      "NodeID"          -> nodeID,
      "NodeType"        -> nodeType,
      "AccessLevel"     -> accessLevel,
      "InEdges"         -> inEdges,
      "OutEdges"        -> {},
      "Step"            -> Lookup[entry, "step", idx],
      "Time"            -> Lookup[entry, "time", None],
      "Type"            -> Lookup[entry, "type", "query"],
      "Instruction"     -> inst,
      "ResponseSummary" -> summary,
      "Status"          -> If[
        Lookup[entry, "response", ""] === "(\:51e6\:7406\:4e2d)" ||
        Lookup[entry, "response", ""] === "\:ff08\:51e6\:7406\:4e2d\:ff09",
        "Processing", "Completed"],
      "BackupRef"       -> None,
      "L2Ref"           -> None,
      "L2NodeCount"     -> 0,
      "L2ErrorCount"    -> 0
    |>
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:30d0\:30c3\:30af\:30a2\:30c3\:30d7\:30c7\:30a3\:30ec\:30af\:30c8\:30ea\:540d \[RightArrow] AbsoluteTime \:5909\:63db
   "20260325_143022" \[RightArrow] AbsoluteTime[{2026,3,25,14,30,22}]
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iBackupDirNameToAbsoluteTime[dirName_String] :=
  Module[{ts, m},
    ts = iBackupTimestampPart[dirName];
    m = StringCases[ts,
      RegularExpression["(\\d{4})(\\d{2})(\\d{2})_(\\d{2})(\\d{2})(\\d{2})"] :>
        {ToExpression["$1"], ToExpression["$2"], ToExpression["$3"],
         ToExpression["$4"], ToExpression["$5"], ToExpression["$6"]}];
    If[Length[m] > 0,
      Quiet @ AbsoluteTime[First[m]],
      (* YYYYMMDDHHMMSS \:5f62\:5f0f (14\:6841\:30fb\:30a2\:30f3\:30c0\:30fc\:30b9\:30b3\:30a2\:306a\:3057) *)
      m = StringCases[ts,
        RegularExpression["^(\\d{4})(\\d{2})(\\d{2})(\\d{2})(\\d{2})(\\d{2})$"] :>
          {ToExpression["$1"], ToExpression["$2"], ToExpression["$3"],
           ToExpression["$4"], ToExpression["$5"], ToExpression["$6"]}];
      If[Length[m] > 0,
        Quiet @ AbsoluteTime[First[m]],
        (* YYYYMMDDHHMM \:5f62\:5f0f (12\:6841\:30fb\:65e7\:5f62\:5f0f) *)
        m = StringCases[ts,
          RegularExpression["^(\\d{4})(\\d{2})(\\d{2})(\\d{2})(\\d{2})$"] :>
            {ToExpression["$1"], ToExpression["$2"], ToExpression["$3"],
             ToExpression["$4"], ToExpression["$5"], 0}];
        If[Length[m] > 0,
          Quiet @ AbsoluteTime[First[m]],
          None]]]
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:5168\:30d1\:30c3\:30b1\:30fc\:30b8\:306e\:30d0\:30c3\:30af\:30a2\:30c3\:30d7\:30bf\:30a4\:30e0\:30b9\:30bf\:30f3\:30d7\:4e00\:89a7\:3092\:53ce\:96c6
   \:623b\:308a\:5024: {<|"DirName"->..., "AbsTime"->..., "Package"->...|>, ...}
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iCollectBackupTimestamps[] :=
  Module[{allInfoDirs, pkgNames, result = {}},
    If[!StringQ[Global`$packageDirectory] ||
       Global`$packageDirectory === "",
      Return[{}]];
    allInfoDirs = Quiet @
      Select[FileNames["*_info", Global`$packageDirectory], DirectoryQ];
    pkgNames = StringReplace[FileNameTake[#, -1],
      RegularExpression["_info$"] -> ""] & /@ allInfoDirs;
    Do[
      Module[{bdir, dirs},
        bdir = backupDir[pkg];
        If[DirectoryQ[bdir],
          dirs = Select[FileNames["*", bdir], DirectoryQ];
          Do[
            Module[{dirName = FileNameTake[d, -1], absTime},
              absTime = iBackupDirNameToAbsoluteTime[dirName];
              If[NumericQ[absTime],
                AppendTo[result, <|
                  "DirName"  -> dirName,
                  "AbsTime"  -> absTime,
                  "Package"  -> pkg,
                  "FullPath" -> d
                |>]]],
          {d, dirs}]]],
    {pkg, pkgNames}];
    result
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:30d0\:30c3\:30af\:30a2\:30c3\:30d7\:30a8\:30f3\:30c8\:30ea\:3068\:306e\:7d50\:5408 (\:30bf\:30a4\:30e0\:30b9\:30bf\:30f3\:30d7\[PlusMinus]30\:79d2\:7167\:5408)
   backupEntries: iCollectBackupTimestamps[] \:306e\:623b\:308a\:5024
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iLLMGraphEnrichWithBackup[node_Association, backupEntries_List] :=
  Module[{nodeTime, matching},
    nodeTime = Lookup[node, "Time", None];
    If[!NumericQ[nodeTime], Return[node]];
    matching = Select[backupEntries,
      (NumericQ[Lookup[#, "AbsTime", None]] &&
       Abs[#["AbsTime"] - nodeTime] < 30.0) &];
    If[matching === {},
      node,
      (* \:6700\:3082\:8fd1\:3044\:3082\:306e\:3092\:9078\:629e *)
      matching = SortBy[matching, Abs[#["AbsTime"] - nodeTime] &];
      Append[node,
        "BackupRef" -> First[matching]["DirName"]]]
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:7a7a\:306e\:30ce\:30fc\:30c8\:30d6\:30c3\:30af LLMGraph \:3092\:751f\:6210
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iNewNotebookLLMGraph[nb_] :=
  Module[{nbPath},
    nbPath = Quiet @ Replace[
      NotebookFileName[nb],
      {s_String :> s, _ -> "untitled"}];
    <|
      "NotebookID"   -> "nb-" <> DateString[Now, {"Year","Month","Day"}],
      "NotebookPath" -> nbPath,
      "CreatedAt"    -> AbsoluteTime[],
      "LastModified" -> AbsoluteTime[],
      "SessionTags"  -> {},
      "Nodes"        -> <||>
    |>
  ];
iNewNotebookLLMGraph[] := iNewNotebookLLMGraph[None];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:65e2\:5b58\:30bb\:30c3\:30b7\:30e7\:30f3\:5c65\:6b74\:304b\:3089\:30b0\:30e9\:30d5\:3092\:69cb\:7bc9
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iBuildGraphFromHistory[nb_NotebookObject, tag_String] :=
  Module[{entries, graph, nodes, i, node, prevNodeID},
    entries = Quiet @ iSessionHistory[nb, tag];
    If[!ListQ[entries] || entries === {},
      Return[iNewNotebookLLMGraph[nb]]];

    graph = iNewNotebookLLMGraph[nb];
    graph["SessionTags"] = {tag};
    nodes = <||>;

    Do[
      node = iHistoryEntryToNode[entries[[i]], tag, i];
      (* OutEdges \:3092\:524d\:306e\:30ce\:30fc\:30c9\:306b\:8a2d\:5b9a *)
      If[i > 1,
        prevNodeID = tag <> "-" <> ToString[i - 1];
        If[KeyExistsQ[nodes, prevNodeID],
          nodes[prevNodeID, "OutEdges"] = {<|
            "To"   -> node["NodeID"],
            "Type" -> "ContextInheritance"|>}]];
      nodes[node["NodeID"]] = node,
    {i, Length[entries]}];

    graph["Nodes"] = nodes;
    graph["LastModified"] = AbsoluteTime[];
    (* \:69cb\:7bc9\:5f8c\:306b\:30ad\:30e3\:30c3\:30b7\:30e5\:30af\:30ea\:30fc\:30f3\:30a2\:30c3\:30d7 *)
    Quiet @ iLLMGraphCacheCleanup[];
    graph
  ];

(* \:8907\:6570\:30bb\:30c3\:30b7\:30e7\:30f3\:30bf\:30b0\:304b\:3089\:306e\:69cb\:7bc9 *)
iBuildGraphFromAllSessions[nb_NotebookObject] :=
  Module[{tags, graph, subGraph, allNodes = <||>, backupTs},
    tags = Quiet @ Replace[
      iAllSessionTags[nb],
      Except[_List] -> {iSessionTag[]}];
    tags = DeleteDuplicates @ Prepend[tags, iSessionTag[]];

    graph = iNewNotebookLLMGraph[nb];
    graph["SessionTags"] = tags;

    Do[
      subGraph = iBuildGraphFromHistory[nb, t];
      allNodes = Join[allNodes, Lookup[subGraph, "Nodes", <||>]],
    {t, tags}];

    (* Phase 1b: \:30d0\:30c3\:30af\:30a2\:30c3\:30d7\:5c65\:6b74\:3068\:306e\:7d50\:5408 *)
    backupTs = Quiet @ iCollectBackupTimestamps[];
    If[ListQ[backupTs] && Length[backupTs] > 0,
      allNodes = Association @ KeyValueMap[
        Function[{nid, node},
          nid -> iLLMGraphEnrichWithBackup[node, backupTs]],
        allNodes]];

    graph["Nodes"] = allNodes;
    graph["LastModified"] = AbsoluteTime[];
    graph
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   TaggingRules \:3078\:306e\:4fdd\:5b58/\:8aad\:307f\:8fbc\:307f
   \:4fdd\:5b58\:3059\:308b\:306e\:306f\:8efd\:91cf\:30b0\:30e9\:30d5\:306e\:307f\:3002Compress \:3067\:3055\:3089\:306b\:5727\:7e2e\:3002
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iSaveNotebookLLMGraph[nb_NotebookObject, llmGraph_Association] := (
  Quiet[CurrentValue[nb,
    {TaggingRules, "claudecode", "LLMGraph"}] =
      Compress[llmGraph]];
  llmGraph);

iLoadNotebookLLMGraph[nb_NotebookObject] :=
  Module[{raw, graph},
    raw = Quiet @ CurrentValue[nb,
      {TaggingRules, "claudecode", "LLMGraph"}];
    graph = If[raw === Inherited || raw === {} || !StringQ[raw],
      iBuildGraphFromAllSessions[nb],
      Replace[Quiet @ Uncompress[raw],
        Except[_Association] :> iBuildGraphFromAllSessions[nb]]];
    (* \:30ad\:30e3\:30c3\:30b7\:30e5\:306b\:3082\:4fdd\:6301 *)
    $iLLMGraphCache = graph;
    $iLLMGraphCacheNB = nb;
    graph
  ];

(* ================================================================
   Phase 2b: \:30ea\:30a2\:30eb\:30bf\:30a4\:30e0\:30ce\:30fc\:30c9\:8ffd\:52a0\:30d5\:30c3\:30af
   iSessionAppend / iSessionUpdateLast \:304b\:3089\:547c\:3070\:308c\:308b\:3002
   \:30e1\:30e2\:30ea\:30ad\:30e3\:30c3\:30b7\:30e5\:3092\:4f7f\:3044\:3001\:5b8c\:4e86\:6642\:306bTaggingRules\:3078\:30d5\:30e9\:30c3\:30b7\:30e5\:3059\:308b\:3002
   ================================================================ *)

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:30e1\:30e2\:30ea\:30ad\:30e3\:30c3\:30b7\:30e5
   Compress/Uncompress \:3092\:6bce\:56de\:5b9f\:884c\:3059\:308b\:306e\:3092\:907f\:3051\:308b\:3002
   \:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:5358\:4f4d\:3067\:30ad\:30e3\:30c3\:30b7\:30e5\:3057\:3001\:5b8c\:4e86\:6642\:306b\:30d5\:30e9\:30c3\:30b7\:30e5\:3002
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
$iLLMGraphCache = None;
$iLLMGraphCacheNB = None;

iLLMGraphGetCached[nb_NotebookObject] :=
  If[$iLLMGraphCacheNB === nb && AssociationQ[$iLLMGraphCache],
    $iLLMGraphCache,
    (* \:30ad\:30e3\:30c3\:30b7\:30e5\:30df\:30b9: iLoadNotebookLLMGraph \:304c\:30ad\:30e3\:30c3\:30b7\:30e5\:3082\:8a2d\:5b9a\:3059\:308b *)
    iLoadNotebookLLMGraph[nb]];

iLLMGraphFlush[nb_NotebookObject] :=
  If[AssociationQ[$iLLMGraphCache] && $iLLMGraphCacheNB === nb,
    iSaveNotebookLLMGraph[nb, $iLLMGraphCache];
    $iLLMGraphCache];

iLLMGraphInvalidateCache[] := (
  $iLLMGraphCache = None;
  $iLLMGraphCacheNB = None);

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   iLLMGraphOnAppend: iSessionAppend \:304b\:3089\:547c\:3070\:308c\:308b\:30d5\:30c3\:30af
   \:65b0\:3057\:3044\:30a8\:30f3\:30c8\:30ea\:306e\:30ce\:30fc\:30c9\:3092\:30b0\:30e9\:30d5\:306b\:8ffd\:52a0\:3059\:308b\:3002
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iLLMGraphOnAppend[nb_NotebookObject, tag_String, entry_Association] :=
  Module[{graph, step, nodeID, node, nodes, prevNodeID, prevStep,
          parentStep, edgeType},
    graph = iLLMGraphGetCached[nb];
    If[!AssociationQ[graph], Return[]];

    step = Quiet @ Lookup[entry, "step", 0];
    If[!IntegerQ[step], step = 0];
    nodeID = tag <> "-" <> ToString[step + 1];
    nodes = Lookup[graph, "Nodes", <||>];
    If[KeyExistsQ[nodes, nodeID], Return[]];

    node = iHistoryEntryToNode[entry, tag, step + 1, False];

    (* parentStep: \:660e\:793a\:6307\:5b9a\:304c\:3042\:308c\:3070\:305d\:308c\:3092\:4f7f\:3046 (Fork/Join \:7528) *)
    parentStep = Quiet @ Lookup[entry, "parentStep", step];
    If[!IntegerQ[parentStep], parentStep = step];
    edgeType = Quiet @ Lookup[entry, "edgeType", "ContextInheritance"];
    If[!StringQ[edgeType], edgeType = "ContextInheritance"];
    prevNodeID = tag <> "-" <> ToString[parentStep];

    (* InEdges \:3092\:30aa\:30fc\:30d0\:30fc\:30e9\:30a4\:30c9 *)
    If[parentStep >= 1 && KeyExistsQ[nodes, prevNodeID],
      node["InEdges"] = {<|"From" -> prevNodeID, "Type" -> edgeType|>};
      (* \:89aa\:30ce\:30fc\:30c9\:306e OutEdges \:306b\:8ffd\:52a0 (\:65e2\:5b58\:3092\:4fdd\:6301\:3057\:3066\:8ffd\:52a0) *)
      nodes[prevNodeID, "OutEdges"] =
        DeleteDuplicatesBy[
          Append[Lookup[nodes[prevNodeID], "OutEdges", {}],
            <|"To" -> nodeID, "Type" -> edgeType|>],
          #["To"] &],
      (* parentStep=0 or \:89aa\:304c\:5b58\:5728\:3057\:306a\:3044\:5834\:5408 *)
      If[parentStep >= 1,
        node["InEdges"] = {<|"From" -> prevNodeID, "Type" -> edgeType|>}]];

    nodes[nodeID] = node;
    graph["Nodes"] = nodes;
    graph["LastModified"] = AbsoluteTime[];

    If[!MemberQ[Lookup[graph, "SessionTags", {}], tag],
      graph["SessionTags"] =
        DeleteDuplicates @ Append[Lookup[graph, "SessionTags", {}], tag]];

    $iLLMGraphCache = graph;
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   iLLMGraphOnUpdate: iSessionUpdateLast \:304b\:3089\:547c\:3070\:308c\:308b\:30d5\:30c3\:30af
   \:6700\:65b0\:30ce\:30fc\:30c9\:306e\:30b9\:30c6\:30fc\:30bf\:30b9\:30fb\:30b5\:30de\:30ea\:30fc\:3092\:66f4\:65b0\:3057\:3001
   \:5b8c\:4e86\:6642\:306bTaggingRules\:3078\:30d5\:30e9\:30c3\:30b7\:30e5 + \:5916\:90e8\:30ad\:30e3\:30c3\:30b7\:30e5\:3078\:66f8\:304d\:51fa\:3057\:3002
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iLLMGraphOnUpdate[nb_NotebookObject, tag_String, updates_Association] :=
  Module[{graph, nodes, nodeIDs, latestNodeID, node,
          resp, code, summary, isCompleted},
    graph = iLLMGraphGetCached[nb];
    If[!AssociationQ[graph], Return[]];

    nodes = Lookup[graph, "Nodes", <||>];
    (* \:3053\:306e\:30bb\:30c3\:30b7\:30e7\:30f3\:30bf\:30b0\:306b\:5c5e\:3059\:308b\:6700\:65b0\:30ce\:30fc\:30c9\:3092\:63a2\:3059 *)
    nodeIDs = Select[Keys[nodes],
      StringQ[#] && StringStartsQ[#, tag <> "-"] &];
    If[Length[nodeIDs] === 0, Return[]];
    latestNodeID = Quiet @ Last @ SortBy[nodeIDs,
      Replace[
        Quiet @ ToExpression @ Last @ StringSplit[#, "-"],
        Except[_Integer] -> 0] &];
    If[!StringQ[latestNodeID], Return[]];

    node = nodes[latestNodeID];
    If[!AssociationQ[node], Return[]];

    (* \:30ec\:30b9\:30dd\:30f3\:30b9\:304b\:3089\:30b5\:30de\:30ea\:30fc\:3092\:751f\:6210 *)
    resp = Lookup[updates, "response", None];
    code = Lookup[updates, "code", None];
    If[StringQ[resp] &&
       resp =!= "(\:51e6\:7406\:4e2d)" && resp =!= "\:ff08\:51e6\:7406\:4e2d\:ff09",
      summary = StringTake[resp, UpTo[$iLLMGraphMaxSummaryChars]];
      node["ResponseSummary"] = summary;
      node["Status"] = "Completed";
      isCompleted = True,
      isCompleted = False];

    nodes[latestNodeID] = node;
    graph["Nodes"] = nodes;
    graph["LastModified"] = AbsoluteTime[];
    $iLLMGraphCache = graph;

    (* \:5b8c\:4e86\:6642: \:5916\:90e8\:30ad\:30e3\:30c3\:30b7\:30e5\:3078\:66f8\:304d\:51fa\:3057 + L2\:30b0\:30e9\:30d5\:69cb\:7bc9 + TaggingRules \:30d5\:30e9\:30c3\:30b7\:30e5 *)
    If[TrueQ[isCompleted],
      Module[{heavyData = <||>},
        If[StringQ[resp] && StringLength[resp] > 0,
          heavyData["response"] = resp];
        If[StringQ[code] && code =!= "",
          heavyData["code"] = code];
        If[Length[heavyData] > 0,
          Quiet @ iLLMGraphCacheWrite[latestNodeID, heavyData]]];
      (* Phase 4a: L2\:30b0\:30e9\:30d5\:3092\:30ec\:30b9\:30dd\:30f3\:30b9\:304b\:3089\:69cb\:7bc9\:3057\:3066\:30ad\:30e3\:30c3\:30b7\:30e5\:306b\:66f8\:304d\:51fa\:3059\:3002
         resp \:304c\:6709\:52b9\:306a\:6587\:5b57\:5217\:3067\:3001\:304b\:3064 ```mathematica \:30d6\:30ed\:30c3\:30af\:3092\:542b\:3080\:5834\:5408\:306e\:307f\:5b9f\:884c\:3002
         iLLMGraphBuildAndCacheL2 \:306f $iLLMGraphCache \:3092\:76f4\:63a5\:66f4\:65b0\:3059\:308b\:305f\:3081
         \:5fc5\:305a iLLMGraphFlush \:3088\:308a\:524d\:306b\:547c\:3076\:3002 *)
      If[StringQ[resp] && StringLength[resp] > 0,
        Quiet @ iLLMGraphBuildAndCacheL2[latestNodeID, resp]];
      (* TaggingRules \:306b\:30d5\:30e9\:30c3\:30b7\:30e5 *)
      iLLMGraphFlush[nb]];
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:53ef\:8996\:5316\:30d8\:30eb\:30d1\:30fc
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iLLMGraphExtractEdges[llmGraph_Association] :=
  Module[{nodes, edges = {}},
    nodes = Lookup[llmGraph, "Nodes", <||>];
    KeyValueMap[
      Function[{nid, node},
        Scan[Function[edge,
          AppendTo[edges,
            DirectedEdge[nid, edge["To"], edge["Type"]]]],
          Lookup[node, "OutEdges", {}]]],
      nodes];
    edges
  ];

iLLMGraphNodeLabels[llmGraph_Association] :=
  Module[{nodes},
    nodes = Lookup[llmGraph, "Nodes", <||>];
    KeyValueMap[
      Function[{nid, node},
        nid -> Placed[
          Column[{
            Style[StringTake[
              Lookup[node, "Instruction", nid], UpTo[30]], Bold, 9],
            Style[Lookup[node, "Type", "?"] <> " | " <>
              Lookup[node, "AccessLevel", "?"], Gray, 8],
            Style["Step " <> ToString[Lookup[node, "Step", "?"]], Gray, 7]
          }, Alignment -> Center],
          Tooltip]],
      nodes]
  ];

iLLMGraphNodeStyles[llmGraph_Association] :=
  Module[{nodes},
    nodes = Lookup[llmGraph, "Nodes", <||>];
    KeyValueMap[
      Function[{nid, node},
        nid -> Directive[
          EdgeForm[{Thin, GrayLevel[0.3]}],
          iLLMGraphAccessColor[Lookup[node, "AccessLevel", ""]]]],
      nodes]
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:691c\:8a3c
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)
iValidateNotebookLLMGraph[llmGraph_Association, nb_NotebookObject] :=
  Module[{results = <||>, nodes, tags, totalHistoryEntries = 0,
          nodeCount, allNodeIDs, danglingEdges,
          graphSize = 0, avgNodeSize = 0},
    nodes = Lookup[llmGraph, "Nodes", <||>];
    nodeCount = Length[nodes];
    allNodeIDs = Keys[nodes];

    (* 1. \:30bb\:30c3\:30b7\:30e7\:30f3\:5c65\:6b74\:30a8\:30f3\:30c8\:30ea\:6570\:3068\:306e\:4e00\:81f4 *)
    tags = Lookup[llmGraph, "SessionTags", {}];
    Do[
      totalHistoryEntries += Length[
        Quiet @ Replace[iSessionHistory[nb, t],
          Except[_List] -> {}]],
    {t, tags}];
    results["NodeCountMatch"] = <|
      "Pass"     -> (nodeCount == totalHistoryEntries),
      "Expected" -> totalHistoryEntries,
      "Actual"   -> nodeCount
    |>;

    (* 2. \:30a8\:30c3\:30b8\:53c2\:7167\:6574\:5408\:6027 *)
    danglingEdges = {};
    KeyValueMap[
      Function[{nid, node},
        Scan[Function[edge,
          If[!MemberQ[allNodeIDs, edge["To"]],
            AppendTo[danglingEdges, nid -> edge["To"]]]],
          Lookup[node, "OutEdges", {}]];
        Scan[Function[edge,
          If[!MemberQ[allNodeIDs, edge["From"]],
            AppendTo[danglingEdges, edge["From"] -> nid]]],
          Lookup[node, "InEdges", {}]]],
      nodes];
    results["EdgeIntegrity"] = <|
      "Pass"          -> (danglingEdges === {}),
      "DanglingEdges" -> danglingEdges
    |>;

    (* 3. DAG \:6027 *)
    results["IsDAG"] = <|
      "Pass" -> Replace[
        Quiet @ AcyclicGraphQ[
          Graph[iLLMGraphExtractEdges[llmGraph]]],
        {True -> True, _ -> (nodeCount <= 1)}]
    |>;

    (* 4. \:30ce\:30fc\:30c9ID \:4e00\:610f\:6027 *)
    results["UniqueNodeIDs"] = <|
      "Pass"       -> (Length[allNodeIDs] == Length[DeleteDuplicates[allNodeIDs]]),
      "Duplicates" -> Select[Tally[allNodeIDs], #[[2]] > 1 &]
    |>;

    (* 5. \:30b5\:30a4\:30ba\:691c\:8a3c: Compress \:5f8c\:306e\:30b5\:30a4\:30ba (\:5b9f\:969b\:306b TaggingRules \:306b\:4fdd\:5b58\:3055\:308c\:308b\:5f62) *)
    Module[{compressed, compressedSize, avgCompressed},
      compressed = Quiet @ Compress[llmGraph];
      compressedSize = If[StringQ[compressed], StringLength[compressed], 0];
      graphSize = Quiet @ Check[ByteCount[llmGraph], 0];
      avgNodeSize = If[nodeCount > 0, N[graphSize / nodeCount], 0];
      avgCompressed = If[nodeCount > 0, N[compressedSize / nodeCount], 0];
      results["SizeCheck"] = <|
        "Pass"                -> (avgCompressed < 2000),  (* ~2KB/\:30ce\:30fc\:30c9(\:5727\:7e2e\:5f8c)\:4ee5\:4e0b *)
        "TotalBytesRaw"       -> graphSize,
        "TotalBytesCompressed"-> compressedSize,
        "AvgBytesPerNode"     -> Round[avgNodeSize],
        "AvgCompressedPerNode"-> Round[avgCompressed],
        "NodeCount"           -> nodeCount
      |>];

    (* \:5168\:4f53\:5224\:5b9a *)
    results["AllPass"] = And @@
      (Lookup[#, "Pass", False] & /@ Values[results]);
    results
  ];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:516c\:958b API \:30e9\:30c3\:30d1\:30fc
   \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] *)

NotebookLLMGraph[nb_NotebookObject] :=
  iLLMGraphGetCached[nb];
NotebookLLMGraph[] :=
  NotebookLLMGraph[EvaluationNotebook[]];

NotebookLLMGraphBuild[nb_NotebookObject] :=
  Module[{graph},
    iLLMGraphInvalidateCache[];
    graph = iBuildGraphFromAllSessions[nb];
    iSaveNotebookLLMGraph[nb, graph];
    (* \:30ad\:30e3\:30c3\:30b7\:30e5\:306b\:3082\:4fdd\:6301 *)
    $iLLMGraphCache = graph;
    $iLLMGraphCacheNB = nb;
    graph
  ];
NotebookLLMGraphBuild[] :=
  NotebookLLMGraphBuild[EvaluationNotebook[]];

NotebookLLMGraphNodes[nb_NotebookObject] :=
  Lookup[iLLMGraphGetCached[nb], "Nodes", <||>];
NotebookLLMGraphNodes[] :=
  NotebookLLMGraphNodes[EvaluationNotebook[]];

Options[NotebookLLMGraphPlot] = {
  "Detail"            -> False,
  "SplitHistoryChain" -> True,
  "OrderByTime"       -> False,
  "HiddenEdgeTypes"   -> Automatic
};

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] iResolveHiddenEdgeTypes \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:30aa\:30d7\:30b7\:30e7\:30f3\:304b\:3089 SplitHistoryChain \:3068 HiddenEdgeTypes \:3092\:53c2\:7167\:3057\:3001
   \:63cf\:753b\:6642\:306b\:9664\:5916\:3059\:308b\:30a8\:30c3\:30b8 Type \:306e\:30ea\:30b9\:30c8\:3092\:8fd4\:3059\:3002
   
   \:8a2d\:8a08\:610f\:56f3:
     - "ContextInheritance" = \:300c\:30bb\:30c3\:30b7\:30e7\:30f3\:5c65\:6b74\:306e\:6642\:9593\:524d\:5f8c\:95a2\:4fc2\:300d\:3002
       \:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:306e\:6587\:8108\:3092\:66b4\:7684\:306b\:3064\:306a\:3050\:30a8\:30c3\:30b8\:3067\:3001
       \:5b9f\:306e\:30c7\:30fc\:30bf\:4f9d\:5b58\:3067\:306f\:306a\:3044\:3002SplitHistoryChain=True \:3067\:96a0\:3059\:3002
     - \:5c06\:6765\:62e1\:5f35 "ExplicitReference" = \:6b21\:30bf\:30fc\:30f3\:304c\:524d\:30bf\:30fc\:30f3\:306e\:51fa\:529b\:3092
       \:660e\:793a\:7684\:306b\:53c2\:7167\:3057\:305f\:5834\:5408\:306e\:5b9f\:4f9d\:5b58\:3002\:3053\:308c\:306f\:96a0\:3055\:306a\:3044\:3002
     - "Produces" / "DataFlow" / "Continuation" / "DAGDependency" \:306f
       runtime DAG \:5185\:90e8\:306e\:69cb\:9020\:7684\:95a2\:4fc2\:306a\:306e\:3067\:5e38\:306b\:63cf\:753b\:3002 *)
iResolveHiddenEdgeTypes[splitChain_, hiddenOpt_] :=
  Which[
    hiddenOpt === Automatic,
      If[TrueQ[splitChain], {"ContextInheritance"}, {}],
    ListQ[hiddenOpt],
      hiddenOpt,
    StringQ[hiddenOpt],
      {hiddenOpt},
    True,
      {}];

(* \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine] iComputeTimeOrderedCoords \[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]
   \:30ce\:30fc\:30c9\:3068\:30a8\:30c3\:30b8\:304b\:3089\:3001\:5f31\:9023\:7d50\:6210\:5206 (WCC) \:3054\:3068\:306b
   \:6700\:65e9\:30ce\:30fc\:30c9\:6642\:523b\:3092\:30ad\:30fc\:3068\:3057\:3066\:6642\:7cfb\:5217\:9806\:306b\:4e26\:3079\:3001
   \:5404 WCC \:5185\:306f LayeredDigraphEmbedding \:306e\:5ea7\:6a19\:3092\:5229\:7528\:3057\:3066
   VertexCoordinateRules \:3092\:8fd4\:3059\:3002\:5931\:6557\:6642\:306f Automatic \:3092\:8fd4\:3059
   (\:65e2\:5b9a\:306e LayeredDigraphEmbedding \:306b\:4efb\:305b\:308b)\:3002 *)
iComputeTimeOrderedCoords[nodeKeys_List, nodes_Association, edges_List] :=
  Module[{und, wccs, wccTimes, sortedWccs, coordsAcc = <||>,
          xOffset = 0.0, wccGap = 1.5, subLayoutSpec},
    If[Length[nodeKeys] === 0, Return[Automatic]];
    Quiet @ Check[
      Module[{},
        (* \:65e0\:5411\:30b0\:30e9\:30d5\:3067\:5f31\:9023\:7d50\:6210\:5206\:3092\:53d6\:308b *)
        und = Graph[nodeKeys,
          UndirectedEdge @@@ (List @@@ edges),
          DirectedEdges -> False];
        wccs = Quiet @ Check[
          WeaklyConnectedComponents[
            Graph[nodeKeys, DirectedEdge @@@ (List @@@ edges)]],
          ConnectedComponents[und]];
        If[!ListQ[wccs] || Length[wccs] === 0,
          wccs = {nodeKeys}];
        
        (* \:5404 WCC \:306e\:6700\:65e9\:30ce\:30fc\:30c9\:6642\:523b\:3092\:8a08\:7b97 *)
        wccTimes = Map[
          Function[wcc,
            Min @@ Append[
              Cases[
                Map[Lookup[nodes[#], "Time", Missing[]] &, wcc],
                _?NumericQ],
              \[Infinity]]],
          wccs];
        
        (* \:5404 WCC \:3092\:6642\:523b\:306e\:6607\:9806\:3067\:4e26\:3079\:308b (\:30bf\:30a4\:3092\:7d22\:5f15\:3067\:7834\:308b) *)
        sortedWccs = wccs[[Ordering[Transpose[{wccTimes, Range[Length[wccs]]}]]]];
        
        (* \:5404 WCC \:5185\:90e8\:306f\:30b5\:30d6\:30b0\:30e9\:30d5\:306e LayeredDigraphEmbedding \:5ea7\:6a19 *)
        Do[
          Module[{wcc = sortedWccs[[k]], subEdges, subCoords, xs, ys,
                  xSpan = 0, ySpan = 1, subGraph, idx, yMax},
            subEdges = Select[edges, MemberQ[wcc, #[[1]]] && MemberQ[wcc, #[[2]]] &];
            subGraph = Graph[wcc, DirectedEdge @@@ (List @@@ subEdges),
              GraphLayout -> "LayeredDigraphEmbedding"];
            subCoords = Quiet @ Check[GraphEmbedding[subGraph], None];
            If[!ListQ[subCoords] || Length[subCoords] =!= Length[wcc],
              (* \:5358\:4e00\:30ce\:30fc\:30c9\:307e\:305f\:306f layout \:5931\:6557: \:7e26\:306b\:4e26\:3079\:308b *)
              subCoords = Table[{0.0, -N[i]}, {i, Length[wcc]}]];
            xs = subCoords[[All, 1]];
            ys = subCoords[[All, 2]];
            xSpan = If[Max[xs] > Min[xs], Max[xs] - Min[xs], 1.0];
            ySpan = If[Max[ys] > Min[ys], Max[ys] - Min[ys], 1.0];
            (* v2026-04-20 T03: \:5404 WCC \:306e\:6700\:4e0a\:90e8 (yMax) \:3092 Y=0 \:306b\:63c3\:3048\:308b\:3002
               LayeredDigraphEmbedding \:306f\:89aa (orchestrator) \:3092\:4e0a\:306b\:7f6e\:304f\:306e\:3067\:3001
               Max[ys] \:304c\:89aa (\:9752\:3044 orchestrator) \:306e Y \:5ea7\:6a19\:3002
               \:3053\:308c\:3092\:9664\:3057\:3066\:5168\:30b5\:30d6\:30b0\:30e9\:30d5\:306e\:6839\:304c Y=0 \:306b\:4e00\:81f4\:3059\:308b\:3002 *)
            yMax = Max[ys];
            (* \:5de6\:7aef\:3092 0 \:306b\:3057\:3066 xOffset \:3092\:52a0\:3048\:308b\:3002
               Y \:306f yMax \:3092\:5f15\:3044\:3066\:30eb\:30fc\:30c8\:3092 Y=0 \:306b\:63c3\:3048\:308b\:3002 *)
            Do[
              coordsAcc[wcc[[idx]]] = {
                xOffset + (subCoords[[idx, 1]] - Min[xs]),
                subCoords[[idx, 2]] - yMax},
              {idx, Length[wcc]}];
            xOffset += xSpan + wccGap],
          {k, Length[sortedWccs]}];
        
        (* VertexCoordinateRules \:5f62\:5f0f\:3067\:8fd4\:3059 *)
        Normal[coordsAcc]],
      Automatic]
  ];

NotebookLLMGraphPlot[nb_NotebookObject, opts:OptionsPattern[NotebookLLMGraphPlot]] :=
  Module[{llmGraph, allNodes, nodes, nodeCount, edges, labels, colors,
          edgeLabels = <||>, edgeStyles = <||>, showDetail,
          splitChain, orderByTime, hiddenOpt, hiddenTypes, vtxCoords},
    showDetail   = TrueQ[OptionValue["Detail"]];
    splitChain   = TrueQ[OptionValue["SplitHistoryChain"]];
    orderByTime  = OptionValue["OrderByTime"];
    hiddenOpt    = OptionValue["HiddenEdgeTypes"];
    hiddenTypes  = iResolveHiddenEdgeTypes[splitChain, hiddenOpt];
    (* v2026-04-20 T04: OrderByTime \:306e Automatic \:89e3\:6c7a\:3092 False \:306b\:5909\:66f4\:3002
       \:624b\:52d5\:5ea7\:6a19\:8a08\:7b97\:3088\:308a Mathematica \:6a19\:6e96\:306e LayeredDigraphEmbedding \:306b
       \:4efb\:305b\:308b\:65b9\:304c\:898b\:3084\:3059\:3044\:3002SplitHistoryChain=True \:306a\:3089
       \:5404 ClaudeEval \:306f\:72ec\:7acb\:9023\:7d50\:6210\:5206\:306b\:306a\:308a\:3001Mathematica \:304c\:81ea\:52d5\:7684\:306b
       \:6a2a\:4e26\:3073\:3067\:914d\:7f6e\:3059\:308b\:3002 *)
    If[orderByTime === Automatic, orderByTime = False];
    
    llmGraph = iLLMGraphGetCached[nb];
    allNodes = Lookup[llmGraph, "Nodes", <||>];
    
    (* Detail=False: DetailLevel="Internal" \:306e\:30ce\:30fc\:30c9\:3092\:9664\:5916\:3002
       \:5f8c\:65b9\:4e92\:63db: \:65e7 DAG \:30ce\:30fc\:30c9 (Type="dag-node" \:304b\:3064 DetailLevel \:672a\:8a2d\:5b9a) \:3082\:9664\:5916 *)
    nodes = If[showDetail, allNodes,
      Select[allNodes,
        Function[{node},
          Lookup[node, "DetailLevel", "Normal"] =!= "Internal" &&
          !(Lookup[node, "Type", ""] === "dag-node" &&
            !KeyExistsQ[node, "DetailLevel"])]]];
    nodeCount = Length[nodes];
    If[nodeCount == 0,
      Return @ Style["\:30ce\:30fc\:30c9\:306a\:3057 (\:30bb\:30c3\:30b7\:30e7\:30f3\:5c65\:6b74\:304c\:7a7a)", Gray, 14]];

    (* Rule \:5f62\:5f0f\:306e\:30a8\:30c3\:30b8\:30ea\:30b9\:30c8 + \:30a8\:30c3\:30b8\:30bf\:30a4\:30d7\:5225\:30e9\:30d9\:30eb\:30fb\:30b9\:30bf\:30a4\:30eb *)
    Module[{edgeData, nodeKeys = Keys[nodes]},
      edgeData = Flatten @ KeyValueMap[
        Function[{nid, node},
          Function[edge,
            <|"Edge" -> (nid -> edge["To"]),
              "Type" -> Lookup[edge, "Type", ""]|>] /@
            Lookup[node, "OutEdges", {}]],
        nodes];
      (* \:8868\:793a\:30ce\:30fc\:30c9\:306b\:542b\:307e\:308c\:306a\:3044\:30bf\:30fc\:30b2\:30c3\:30c8\:3078\:306e\:30a8\:30c3\:30b8\:3092\:9664\:5916 *)
      edgeData = Select[edgeData,
        MemberQ[nodeKeys, Last[#["Edge"]]] &];
      (* v2026-04-20 C\:6848: \:96a0\:3059\:30a8\:30c3\:30b8 Type \:3092\:63cf\:753b\:304b\:3089\:9664\:5916\:3002
         \:5c06\:6765 "ExplicitReference" \:306f hiddenTypes \:306b\:542b\:307e\:306a\:3044\:304b\:3082\:3001
         \:30e6\:30fc\:30b6\:304c\:62bc\:3057\:4ed8\:3051\:306a\:3044\:9650\:308a\:5e38\:306b\:8868\:793a\:3055\:308c\:308b\:3002 *)
      If[Length[hiddenTypes] > 0,
        edgeData = Select[edgeData,
          !MemberQ[hiddenTypes, Lookup[#, "Type", ""]] &]];
      edges = Lookup[#, "Edge"] & /@ edgeData;
      edgeLabels = Association @ Map[
        Function[{ed},
          Module[{typ = Lookup[ed, "Type", ""]},
            ed["Edge"] -> If[typ === "" || typ === "DAGDependency", None,
              Placed[Style[typ, 8, GrayLevel[0.4]], 0.5]]]],
        edgeData];
      edgeStyles = Association @ Map[
        Function[{ed},
          Module[{typ = Lookup[ed, "Type", ""]},
            ed["Edge"] -> Switch[typ,
              "DataFlow",     Directive[RGBColor[0.2, 0.5, 0.9],
                                Arrowheads[0.04], Thickness[0.003]],
              "Continuation", Directive[RGBColor[0.4, 0.7, 0.3],
                                Arrowheads[0.04], Dashing[{0.02, 0.01}]],
              "Produces",     Directive[RGBColor[0.8, 0.4, 0.1],
                                Arrowheads[0.04], Thickness[0.002]],
              "ExplicitReference",
                              Directive[RGBColor[0.7, 0.2, 0.7],
                                Arrowheads[0.045], Thickness[0.0035]],
              _,              Automatic]]],
        edgeData]];

    (* VertexLabels: Tooltip \:3067\:8868\:793a (\:30db\:30d0\:30fc\:6642\:306b instruction + \:4ed8\:52a0\:60c5\:5831) *)
    (* v2026-04-20 T03: Decision/Outcome/ReasonClass/Reason \:3092 ToolTip \:306b\:8ffd\:52a0\:3002
       \:65b0\:30d5\:30a3\:30fc\:30eb\:30c9\:304c\:306a\:3044\:65e2\:5b58\:30c7\:30fc\:30bf\:306e\:305f\:3081\:3001ResponseSummary \:3092
       StringCases \:3067\:30d1\:30fc\:30b9\:3057\:3066 Decision \:3092\:63a1\:53d6\:3059\:308b fallback \:3082\:5099\:3048\:308b\:3002
       \:307e\:305f ResponseSummary \:81ea\:4f53\:3082 240 \:5b57\:307e\:3067\:8868\:793a (\:65e7 80 \:5b57\:3067\:306f\:60c5\:5831\:5207\:308c)\:3002 *)
    Module[{iExtractDecisionFromSummary},
      iExtractDecisionFromSummary[s_String] :=
        Module[{m},
          m = StringCases[s,
            "Decision" ~~ Whitespace... ~~ "->" ~~ Whitespace... ~~
              "\"" ~~ v:Except["\""].. ~~ "\"" :> v, 1];
          If[Length[m] > 0, First[m], None]];
      iExtractDecisionFromSummary[_] := None;
      
      labels = KeyValueMap[
        Function[{nid, node},
          Module[{tip, sum, dec, outc, reasonCls, reason},
            sum       = Lookup[node, "ResponseSummary", ""];
            dec       = Lookup[node, "Decision", None];
            outc      = Lookup[node, "Outcome", None];
            reasonCls = Lookup[node, "ReasonClass", None];
            reason    = Lookup[node, "Reason", None];
            (* \:65b0\:30d5\:30a3\:30fc\:30eb\:30c9\:304c\:306a\:3044\:65e2\:5b58\:30c7\:30fc\:30bf\:7528\:306b ResponseSummary \:3092\:30d1\:30fc\:30b9 *)
            If[dec === None && StringQ[sum],
              dec = iExtractDecisionFromSummary[sum]];
            tip =
              nid <> "\n" <>
              StringTake[Lookup[node, "Instruction", ""], UpTo[80]] <>
              If[ListQ[Lookup[node, "SubSteps", None]] &&
                 Length[node["SubSteps"]] > 0,
                "\nSubSteps: " <> ToString[Length[node["SubSteps"]]], ""] <>
              If[StringQ[Lookup[node, "BackupRef", None]],
                "\nBackup: " <> node["BackupRef"], ""] <>
              Module[{l2n = Lookup[node, "L2NodeCount", 0],
                      l2e = Lookup[node, "L2ErrorCount", 0]},
                If[IntegerQ[l2n] && l2n > 0,
                  "\nL2: " <> ToString[l2n] <> " nodes" <>
                    If[l2e > 0, " (" <> ToString[l2e] <> " errors)", ""],
                  ""]] <>
              "\nStatus: " <> Lookup[node, "Status", "?"] <>
              "\nType: " <> Lookup[node, "NodeType", "?"] <>
              (* \:8a3a\:65ad\:30d5\:30a3\:30fc\:30eb\:30c9 (\:5b58\:5728\:3059\:308b\:3082\:306e\:306e\:307f) *)
              If[StringQ[dec] && dec =!= "" && dec =!= "None",
                "\nDecision: " <> dec, ""] <>
              If[StringQ[outc] && outc =!= "" && outc =!= "None",
                "\nOutcome: " <> outc, ""] <>
              If[StringQ[reasonCls] && reasonCls =!= "" && reasonCls =!= "None",
                "\nReasonClass: " <> reasonCls, ""] <>
              If[StringQ[reason] && reason =!= "" && reason =!= "None",
                "\nReason: " <> StringTake[reason, UpTo[160]], ""] <>
              (* ResponseSummary: dag-node \:306e\:5834\:5408\:306e\:307f\:8868\:793a (\:5897\:5927\:3057\:305f 240 \:5b57) *)
              If[Lookup[node, "Type", ""] === "dag-node" &&
                 StringQ[sum] && StringLength[sum] > 0 &&
                 sum =!= "None" &&
                 !StringStartsQ[sum, "Error:"],
                "\nResult: " <> StringTake[sum, UpTo[240]], ""];
            nid -> Placed[tip, Tooltip]]],
        nodes]];

    (* VertexStyle: \:30a2\:30af\:30bb\:30b9\:30ec\:30d9\:30eb\:5225\:8272\:3001L2\:30a8\:30e9\:30fc\:3042\:308a\:306f\:8d64\:7e01\:53d6\:308a *)
    colors = KeyValueMap[
      Function[{nid, node},
        nid -> If[Lookup[node, "L2ErrorCount", 0] > 0,
          Directive[
            EdgeForm[{Thickness[0.007], RGBColor[0.85, 0.1, 0.1]}],
            iLLMGraphAccessColor[Lookup[node, "AccessLevel", ""]]],
          Directive[
            EdgeForm[{Thin, GrayLevel[0.3]}],
            iLLMGraphAccessColor[Lookup[node, "AccessLevel", ""]]]]],
      nodes];

    (* v2026-04-20 C\:6848: \:6642\:7cfb\:5217\:9806\:306e VertexCoordinates \:3092\:8a08\:7b97\:3002
       \:5931\:6557\:6642\:306f Automatic \:3067\:65e2\:5b9a\:306e LayeredDigraphEmbedding \:306b\:4efb\:305b\:308b\:3002 *)
    vtxCoords = If[TrueQ[orderByTime] && Length[edges] >= 0,
      iComputeTimeOrderedCoords[Keys[nodes], nodes, edges],
      Automatic];

    If[edges === {} && !ListQ[vtxCoords],
      (* \:30a8\:30c3\:30b8\:306a\:3057 \:304b\:3064\:5ea7\:6a19\:672a\:7b97\:51fa: \:5b64\:7acb\:30ce\:30fc\:30c9\:3092\:660e\:793a *)
      Graph[Keys[nodes], {},
        VertexLabels -> labels,
        VertexStyle  -> colors,
        VertexSize   -> 0.5,
        ImageSize    -> 200,
        PlotLabel    -> "Notebook LLMGraph (" <>
          ToString[nodeCount] <> If[nodeCount === 1, " node)", " nodes)"]],
      (* \:30ce\:30fc\:30c9\:6570\:306b\:5fdc\:3058\:3066\:30b9\:30b1\:30fc\:30ea\:30f3\:30b0 *)
      Module[{arrowSz, vtxSz, imgH, imgW, commonOpts, edgeStyleOpt, plotLabel},
        arrowSz = Min[0.04, Max[0.008, 0.6 / nodeCount]];
        vtxSz   = Min[0.5,  Max[0.15,  8.0 / nodeCount]];
        imgH    = Max[300, Min[1200, 45 * nodeCount]];
        imgW    = Max[400, Min[1400, 12 * Max[1, Length[edges]]]];
        edgeStyleOpt = If[Length[edgeStyles] > 0,
          Normal[edgeStyles],
          Directive[GrayLevel[0.5], Arrowheads[arrowSz]]];
        plotLabel = "Notebook LLMGraph (" <> ToString[nodeCount] <> " nodes)";
        (* \:5ea7\:6a19\:7b97\:51fa\:306e\:6709\:7121\:3067\:4e8c\:5206\:5c90\:3057\:3001\:6b8b\:308a\:306e opts \:306f\:5171\:901a\:3002 *)
        If[ListQ[vtxCoords],
          Graph[Keys[nodes], edges,
            VertexLabels       -> labels,
            VertexStyle        -> colors,
            VertexSize         -> vtxSz,
            VertexCoordinates  -> vtxCoords,
            ImageSize          -> {imgW, imgH},
            PlotLabel          -> plotLabel,
            EdgeLabels         -> Normal[Select[edgeLabels, # =!= None &]],
            EdgeStyle          -> edgeStyleOpt],
          Graph[Keys[nodes], edges,
            VertexLabels       -> labels,
            VertexStyle        -> colors,
            VertexSize         -> vtxSz,
            GraphLayout        -> "LayeredDigraphEmbedding",
            ImageSize          -> {imgW, imgH},
            PlotLabel          -> plotLabel,
            EdgeLabels         -> Normal[Select[edgeLabels, # =!= None &]],
            EdgeStyle          -> edgeStyleOpt]]]]
  ];
NotebookLLMGraphPlot[opts:OptionsPattern[NotebookLLMGraphPlot]] :=
  NotebookLLMGraphPlot[EvaluationNotebook[], opts];
NotebookLLMGraphPlot[detail_Rule] :=
  NotebookLLMGraphPlot[EvaluationNotebook[], detail];

NotebookLLMGraphValidate[nb_NotebookObject] :=
  Module[{llmGraph, result},
    llmGraph = iLLMGraphGetCached[nb];
    result = iValidateNotebookLLMGraph[llmGraph, nb];
    If[TrueQ[result["AllPass"]],
      Print[Style["\:2705 LLMGraph \:691c\:8a3c OK (" <>
        ToString[result["SizeCheck"]["NodeCount"]] <> " nodes, " <>
        ToString[Round[result["SizeCheck"]["TotalBytesCompressed"] / 1024.0, 0.1]] <>
        " KB compressed, " <>
        ToString[result["SizeCheck"]["AvgCompressedPerNode"]] <>
        " chars/node)", Darker[Green]]],
      Print[Style["\:274c LLMGraph \:691c\:8a3c\:5931\:6557", Red]];
      Scan[
        Function[{key},
          If[!TrueQ[result[key]["Pass"]],
            Print["  ", key, ": ", result[key]]]],
        DeleteCases[Keys[result], "AllPass"]]
    ];
    result
  ];
NotebookLLMGraphValidate[] :=
  NotebookLLMGraphValidate[EvaluationNotebook[]];

(* \:5916\:90e8\:30ad\:30e3\:30c3\:30b7\:30e5\:304b\:3089\:306e response \:53d6\:5f97 *)
NotebookLLMGraphFetchResponse[nb_NotebookObject, nodeID_String] :=
  iLLMGraphCacheRead[nodeID];
NotebookLLMGraphFetchResponse[nodeID_String] :=
  NotebookLLMGraphFetchResponse[EvaluationNotebook[], nodeID];

(* \:30b5\:30d6\:30b9\:30c6\:30c3\:30d7\:5c65\:6b74\:306e\:8868\:793a *)
NotebookLLMGraphSubSteps[nb_NotebookObject, nodeID_String] :=
  Module[{graph, node, subSteps, ds},
    graph = iLLMGraphGetCached[nb];
    If[!AssociationQ[graph], Return[Missing["NoGraph"]]];
    node = Lookup[Lookup[graph, "Nodes", <||>], nodeID, None];
    If[!AssociationQ[node], Return[Missing["NodeNotFound"]]];
    subSteps = Lookup[node, "SubSteps", {}];
    If[!ListQ[subSteps] || Length[subSteps] === 0,
      Return[Missing["NoSubSteps"]]];
    (* Dataset \:5f62\:5f0f\:3067\:8868\:793a *)
    ds = Dataset[subSteps][All, <|
      "Step"    -> "Name",
      "Status"  -> "Status",
      "Access"  -> "AccessLevel",
      "Time"    -> Function[row,
        DateString[row["Time"],
          {"Hour24",":","Minute",":","Second"}]],
      "Detail"  -> "Detail"
    |>];
    Print[Style["SubSteps for " <> nodeID <> ":", Bold]];
    ds
  ];
NotebookLLMGraphSubSteps[nodeID_String] :=
  NotebookLLMGraphSubSteps[EvaluationNotebook[], nodeID];
NotebookLLMGraphSubSteps[nb_NotebookObject] :=
