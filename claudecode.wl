   CLI \:306a\:306e\:3067\:8ab2\:91d1 API \:7981\:6b62\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:3067\:3082\:5229\:7528\:53ef\:80fd\:3002 *)
$iPaletteProviderOrder = {"claudecode", "chatgptcodex", "anthropic", "openai", "zai", "lmstudio"};

(* \:5404 Provider \:306e\:5019\:88dc\:30e2\:30c7\:30eb\:4e00\:89a7 (Phase 28) \:3002
   \:30af\:30ea\:30c3\:30af\:3067\:3053\:306e\:5217\:3092\:5faa\:74b0\:9078\:629e\:3059\:308b\:3002 *)
$iPaletteModelsByProvider = <|
  "claudecode"   -> {"claude-opus-4-8", "claude-sonnet-4-6", "claude-haiku-4-5"},
  (* chatgptcodex: \:30e2\:30c7\:30eb\:5019\:88dc\:306f SourceVault \:304c\:4e00\:5143\:7ba1\:7406\:3059\:308b\:3002
     iPaletteModelsFor \:304c SourceVaultListModels \:7d4c\:7531\:3067\:53d6\:5f97\:3059\:308b\:3002
     \:3053\:306e\:9759\:7684\:30a8\:30f3\:30c8\:30ea\:306f SourceVault \:672a\:30ed\:30fc\:30c9\:6642\:306e\:6700\:5c0f\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:3002 *)
  "chatgptcodex" -> {"Automatic"},
  "anthropic"    -> {"claude-opus-4-8", "claude-sonnet-4-6", "claude-haiku-4-5"},
  "openai"       -> {"gpt-5.5", "gpt-5.5-pro", "gpt-5-mini", "gpt-5-nano"},
  (* z.ai (GLM \:30b7\:30ea\:30fc\:30ba)\:3002\:5019\:88dc\:306f\:3053\:3053\:3067\:5faa\:74b0\:3055\:308c\:308b\:3002id \:306f
     NBAccess`NBListProviderModels["zai"] \:306e\:30e9\:30a4\:30d6\:4e00\:89a7\:306b\:5408\:308f\:305b\:3066\:3042\:308b\:3002
     \:65b0\:30e2\:30c7\:30eb\:8ffd\:52a0\:6642\:306f\:3053\:306e\:30ea\:30b9\:30c8\:306b id \:3092\:8db3\:3059\:3002 *)
  "zai"          -> {"glm-5.2", "glm-5.1", "glm-5", "glm-5-turbo",
                     "glm-4.7", "glm-4.6", "glm-4.5-air", "glm-4.5"},
  "lmstudio"     -> {"qwen3.6-27b", "qwen3.5-27b", "qwen3-coder-30b", "gpt-oss-120b"}
|>;

(* SourceVault model catalog for a provider (a list of model-id strings),
   or {} when SourceVault is not loaded / returns nothing. *)
iPaletteSourceVaultModels[provider_String] :=
  Module[{sv},
    sv = If[
      TrueQ[Quiet @ Check[
        ValueQ[SourceVault`SourceVaultListModels] ||
        MemberQ[$Packages, "SourceVault`"], False]],
      Quiet @ Check[SourceVault`SourceVaultListModels[provider], {}],
      {}];
    If[ListQ[sv] && AllTrue[sv, StringQ], sv, {}]];
iPaletteSourceVaultModels[_] := {};

(* SourceVault-resolved heavy/default model id for a claude provider, or a
   Missing[] when SourceVault is unavailable / cannot resolve. This is what
   makes the palette's minor version track SourceVault's registry instead of a
   frozen hard-coded id: ClaudeResolveModel[provider, intent] returns the
   currently registered best model for the intent (e.g. claude-opus-4-8). *)
iPaletteResolveHeavyModel[provider_String] :=
  Module[{intent, res},
    intent = Lookup[$iPaletteHeavyIntent, provider, ""];
    If[intent === "" ||
       !TrueQ[Quiet @ Check[
         ValueQ[SourceVault`ClaudeResolveModel] ||
         MemberQ[$Packages, "SourceVault`"], False]],
      Return[Missing["NoSourceVault"]]];
    res = Quiet @ Check[
      SourceVault`ClaudeResolveModel[provider, intent],
      Missing["ResolveFailed"]];
    If[AssociationQ[res] && StringQ[Lookup[res, "ModelId", Missing[]]],
      Lookup[res, "ModelId"], Missing["NoModelId"]]];
iPaletteResolveHeavyModel[_] := Missing["BadProvider"];

(* resolve the candidate model list for a provider's palette picker.
   The single source of truth for provider model ids -- including the minor
   version of the Claude models -- is SourceVault. claudecode/anthropic resolve
   their default heavy model via ClaudeResolveModel (so opening the palette no
   longer pins a stale hard-coded minor version) and put it first, then list the
   rest of the registered models as cycle options. chatgptcodex always offers
   "Automatic" first; lmstudio uses the SourceVault catalog directly. Every
   branch falls back to the static $iPaletteModelsByProvider entry when
   SourceVault is not loaded, so the palette keeps working standalone. *)
iPaletteModelsFor[provider_String] :=
  Module[{sv, base, heavy, live},
    Which[
      provider === "chatgptcodex",
        sv = iPaletteSourceVaultModels[provider];
        If[sv =!= {},
          Prepend[DeleteCases[sv, "Automatic"], "Automatic"],
          {"Automatic"}],
      provider === "lmstudio",
        (* Live LM Studio catalog first (loaded-only / all per
           $ClaudeLMStudioPaletteLoadedOnly), then SourceVault, then static. *)
        live = iLMStudioPaletteModels[];
        If[live =!= {},
          live,
          sv = iPaletteSourceVaultModels[provider];
          If[sv =!= {},
            DeleteCases[sv, "Automatic"],
            Lookup[$iPaletteModelsByProvider, provider,
              {$iPaletteDefaultClaudeModel}]]],
      provider === "claudecode" || provider === "anthropic",
        sv = DeleteCases[iPaletteSourceVaultModels[provider], "Automatic"];
        base = If[sv =!= {}, sv,
          Lookup[$iPaletteModelsByProvider, provider,
            {$iPaletteDefaultClaudeModel}]];
        heavy = iPaletteResolveHeavyModel[provider];
        If[StringQ[heavy], DeleteDuplicates[Prepend[base, heavy]], base],
      True,
        Lookup[$iPaletteModelsByProvider, provider,
          {$iPaletteDefaultClaudeModel}]]];
iPaletteModelsFor[_] := {$iPaletteDefaultClaudeModel};

(* \:30e2\:30c7\:30eb\:540d\:3092\:30d1\:30ec\:30c3\:30c8\:30dc\:30bf\:30f3\:7528\:306b\:77ed\:304f\:30e9\:30d9\:30eb\:5316 *)
iPaletteShortenModelName[mn_String] :=
  Module[{caps, fam, maj, min},
    If[mn === "", Return["default"]];
    (* claude-<family>-<major>-<minor>[...] -> "Family major.minor", so the
       displayed minor version follows the model id with no code edits on a
       version bump (e.g. claude-opus-4-8 -> "Opus 4.8"). *)
    caps = StringCases[mn,
      StartOfString ~~ "claude-" ~~ f : ("opus" | "sonnet" | "haiku") ~~ "-" ~~
        a : (DigitCharacter ..) ~~ "-" ~~ b : (DigitCharacter ..) ~~ ___ :>
        {f, a, b}];
    If[caps =!= {},
      {fam, maj, min} = First[caps];
      Return[
        Switch[fam, "opus", "Opus", "sonnet", "Sonnet", "haiku", "Haiku",
          _, fam] <> " " <> maj <> "." <> min]];
    Which[
      StringStartsQ[mn, "claude-opus"],   "Opus",
      StringStartsQ[mn, "claude-sonnet"], "Sonnet",
      StringStartsQ[mn, "claude-haiku"],  "Haiku",
      True, StringTake[mn, UpTo[14]]
    ]
  ];
iPaletteShortenModelName[_] := "default";

(* Provider \:540d\:3092\:30d1\:30ec\:30c3\:30c8\:30dc\:30bf\:30f3\:7528\:306b\:8868\:793a\:540d\:306b *)
iPaletteProviderLabel[p_String] :=
  Switch[p,
    "claudecode",   "ClaudeCode",
    "chatgptcodex", "ChatGPTCodex",
    "anthropic",    "Anthropic",
    "openai",       "OpenAI",
    "zai",          "Z.AI",
    "lmstudio",     "LMStudio",
    _, p];
iPaletteProviderLabel[_] := "ClaudeCode";

(* \:73fe Provider/Model \:3092 $ClaudeModel (tuple) \:306b\:53cd\:6620\:3055\:305b\:308b\:3002
   Phase 5 (2026-05-26): provider \:304c chatgptcodex \:306e\:3068\:304d\:306f Codex \:306e
   \:5b9f\:30e2\:30c7\:30eb\:3092\:7ba1\:7406\:3059\:308b $ChatgptCodexModel \:3082\:540c\:671f\:3059\:308b\:3002
   \:30d1\:30ec\:30c3\:30c8\:306e \"Automatic\" \:306f Symbol Automatic \:306b\:5909\:63db (CLI \:65e2\:5b9a\:30e2\:30c7\:30eb)\:3002 *)
iPaletteSyncClaudeModel[] :=
  (
    $ClaudeModel = {$iPaletteProvider, $iPaletteModelName};
    If[$iPaletteProvider === "chatgptcodex",
      $ChatgptCodexModel = If[
        $iPaletteModelName === "Automatic" || $iPaletteModelName === "",
        Automatic, $iPaletteModelName]]
  );

(* \:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:304b\:3089\:8a2d\:5b9a\:3092\:8aad\:307f\:8fbc\:307f\:3001\:30b0\:30ed\:30fc\:30d0\:30eb\:5909\:6570\:3092\:540c\:671f\:3002
   TaggingRules \:306b\:8a2d\:5b9a\:304c\:4fdd\:5b58\:3055\:308c\:3066\:3044\:308b\:5834\:5408\:306f\:305d\:306e\:5024\:3092\:63a1\:7528\:3057\:3001
   \:8a2d\:5b9a\:304c\:306a\:3044\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:ff08\:65b0\:898f\:7b49\:ff09\:3067\:306f\:30c7\:30d5\:30a9\:30eb\:30c8\:5024\:306b\:30ea\:30bb\:30c3\:30c8\:3059\:308b\:3002
   \:65e7\:5b9f\:88c5\:3067\:306f\:30c7\:30d5\:30a9\:30eb\:30c8\:5024\:306b\:30ea\:30bb\:30c3\:30c8\:305b\:305a\:30e1\:30e2\:30ea\:4e0a\:306e\:524d\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:306e\:5024\:3092\:4fdd\:6301\:3057\:3066\:3044\:305f\:305f\:3081\:3001
   \:65b0\:898f\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:304c\:524d\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:306e\:8a2d\:5b9a\:3092\:7d99\:627f\:3057\:3066\:3057\:307e\:3046\:554f\:984c\:304c\:3042\:3063\:305f\:3002 *)
iLoadPaletteSettings[nb_NotebookObject] := Module[{v, vP, vM, migrated, fallbackP, fallbackM, fromCM},
  (* Phase 28 (2026-05-12): \:65b0\:898f TaggingRules \"paletteProvider\" / \"paletteModelName\" \:3092\:8aad\:3080\:3002
     \:5b58\:5728\:3057\:306a\:3044 (\:65e7\:30ce\:30fc\:30c8\:30d6\:30c3\:30af) \:5834\:5408\:306f\:65e7 \"paletteModel\" \:304b\:3089 migration \:3059\:308b\:3002
     \:305d\:308c\:3082\:306a\:3044 (\:65b0\:898f\:30ce\:30fc\:30c8\:30d6\:30c3\:30af) \:5834\:5408\:306f\:73fe\:5728\:306e $ClaudeModel \:3092\:898b\:3066\:53cd\:6620\:3055\:305b\:308b\:3002
     (Imai \:5148\:751f\:306e\:8981\:671b: \:65b0\:898f\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:3067\:3082 $ClaudeModel \:306e\:73fe\:5728\:5024\:3092\:30d1\:30ec\:30c3\:30c8\:306b\:53cd\:6620) *)
  vP = Quiet[CurrentValue[nb, {TaggingRules, "claudecode", "paletteProvider"}]];
  vM = Quiet[CurrentValue[nb, {TaggingRules, "claudecode", "paletteModelName"}]];
  migrated = False;

  (* \:73fe $ClaudeModel \:304b\:3089\:306e\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:5024\:3092\:4e8b\:524d\:8a08\:7b97 *)
  fromCM = Which[
    ListQ[$ClaudeModel] && Length[$ClaudeModel] >= 2 &&
      StringQ[$ClaudeModel[[1]]] && StringQ[$ClaudeModel[[2]]] &&
      $ClaudeModel[[1]] =!= "" && $ClaudeModel[[2]] =!= "",
      {$ClaudeModel[[1]], $ClaudeModel[[2]]},
    StringQ[$ClaudeModel] && StringTrim[$ClaudeModel] =!= "",
      (* String \:4e92\:63db: claudecode \:6271\:3044 *)
      {"claudecode", $ClaudeModel},
    True,
      (* \:4ed6\:3082\:3060\:3081\:306a\:3089\:30c7\:30d5\:30a9\:30eb\:30c8 *)
      {"claudecode", $iPaletteDefaultClaudeModel}
  ];
  fallbackP = fromCM[[1]];
  fallbackM = fromCM[[2]];

  Which[
    (* (a) \:65b0\:5f62\:5f0f\:304c\:4fdd\:5b58\:3055\:308c\:3066\:3044\:308b *)
    StringQ[vP] && MemberQ[$iPaletteProviderOrder, vP] &&
       StringQ[vM] && vM =!= "" &&
       (* lmstudio: accept the saved model without a load-time HTTP query, so the
          palette restores even when that model is not currently loaded. *)
       (vP === "lmstudio" || MemberQ[iPaletteModelsFor[vP], vM]),
      $iPaletteProvider  = vP;
      $iPaletteModelName = vM,

    (* (b) \:65e7 paletteModel ("opus"/"sonnet"/"default") \:304c\:4fdd\:5b58\:3055\:308c\:3066\:3044\:308b: migration *)
    Module[{v2 = Quiet[CurrentValue[nb, {TaggingRules, "claudecode", "paletteModel"}]]},
      MatchQ[v2, "opus" | "sonnet" | "default"]],
      v = Quiet[CurrentValue[nb, {TaggingRules, "claudecode", "paletteModel"}]];
      Which[
        v === "opus",    ($iPaletteProvider = "claudecode"; $iPaletteModelName = $iPaletteDefaultClaudeModel),
        v === "sonnet",  ($iPaletteProvider = "claudecode"; $iPaletteModelName = "claude-sonnet-4-6"),
        v === "default", ($iPaletteProvider = "claudecode"; $iPaletteModelName = $iPaletteDefaultClaudeModel),
        True,            ($iPaletteProvider = "claudecode"; $iPaletteModelName = $iPaletteDefaultClaudeModel)
      ];
      migrated = True,

    (* (c) \:4f55\:3082\:4fdd\:5b58\:3055\:308c\:3066\:3044\:306a\:3044 (\:65b0\:898f\:30ce\:30fc\:30c8\:30d6\:30c3\:30af): \:73fe $ClaudeModel \:3092\:53cd\:6620\:3055\:305b\:308b *)
    True,
      $iPaletteProvider  = fallbackP;
      $iPaletteModelName = fallbackM;
      migrated = True  (* \:3053\:306e\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:306b\:4fdd\:5b58\:3057\:3066\:6b21\:56de\:4ee5\:964d\:306f (a) \:7d4c\:8def\:3067\:9032\:3080 *)
  ];

  (* \:65e7 $iPaletteModel \:3082\:4e92\:63db\:3092\:3068\:3063\:3066\:4fdd\:6301 *)
  $iPaletteModel = Which[
    $iPaletteProvider === "claudecode" && StringContainsQ[$iPaletteModelName, "opus"],   "opus",
    $iPaletteProvider === "claudecode" && StringContainsQ[$iPaletteModelName, "sonnet"], "sonnet",
    True, "default"
  ];
  v = Quiet[CurrentValue[nb, {TaggingRules, "claudecode", "paletteEffort"}]];
  $iPaletteEffort = If[MatchQ[v, "low" | "medium" | "high" | "max"], v, "medium"];
