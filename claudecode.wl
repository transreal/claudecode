iHTTPResponseBodyUTF8[resp_HTTPResponse] := Module[{bytes, body},
  bytes = Quiet @ Check[resp["BodyByteArray"], $Failed];
  If[Head[bytes] === ByteArray,
    Return[
      Quiet @ Check[
        FromCharacterCode[Normal[bytes], "UTF-8"],
