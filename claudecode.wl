      (* --- 5. NBAccess \:516c\:958b\:30b0\:30ed\:30fc\:30d0\:30eb\:306e\:7834\:58ca\:7684\:66f4\:65b0 --- *)
      {"AppendTo\\s*\\[\\s*NBAccess`", "j",
