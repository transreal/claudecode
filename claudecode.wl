  "\:4f8b: ClaudeQueryAsyncSilent[prompt, callback]\n" <>
  "      ClaudeQueryAsyncSilent[prompt, callback, Model -> {\"anthropic\", \"claude-opus-4-7\"}]";

Options[ClaudeQueryAsyncSilent] = Options[ClaudeQueryAsync];

ClaudeQueryAsyncSilent[prompt_String, callback_,
                      opts:OptionsPattern[]] :=
  Module[{nb, safeCallback},
    (* \:307e\:305a hidden notebook \:3092\:78ba\:4fdd\:3002\:5931\:6557\:306a\:3089 callback \:306b\:30a8\:30e9\:30fc\:3092\:8fd4\:3059\:3002 *)
    nb = ClaudeEnsureSilentNotebook[];
    If[Head[nb] =!= NotebookObject,
      Quiet @ Check[callback[
        "Error: ClaudeQueryAsyncSilent failed to create hidden notebook. " <>
        "Call ClaudeEnsureSilentNotebook[] from the main kernel first."],
        Null];
      Return[$Failed]
    ];

    (* callback \:3092 Quiet \:3067\:5305\:3093\:3067\:4f8b\:5916\:306f silent \:306b\:3002 *)
    safeCallback = With[{cb = callback},
      Function[response, Quiet @ Check[cb[response], Null]]];

    (* Stage 1.7 (2026-05-17): SessionSubmit \:30e9\:30c3\:30d7\:3092\:5916\:3057\:3066\:76f4\:63a5\:547c\:3093\:3060\:3002
       ClaudeQueryAsync \:81ea\:8eab\:304c StartProcess + iEnsureSharedPollingTask \:3067
       \:975e\:540c\:671f\:5316\:3055\:308c\:308b\:306e\:3067 SessionSubmit \:30e9\:30c3\:30d7\:306f\:4e0d\:8981\:3002
       \:9006\:306b\:4f59\:5206\:306a\:30b9\:30b1\:30b8\:30e5\:30fc\:30eb\:5c64\:304c\:589e\:3048\:308b\:3068 ClaudeWaitWorkflow \:306e
       Pause \:30eb\:30fc\:30d7\:5883\:754c\:3067 1 \:5c64\:305a\:3064\:3057\:304b\:6d88\:5316\:3055\:308c\:305a\:3001
       \:5b8c\:4e86\:524d\:306b MaxWait \:3092\:8d85\:3048\:308b\:53ef\:80fd\:6027\:304c\:3042\:308b\:3002 *)
    ClaudeQueryAsync[prompt, safeCallback, nb, opts]
  ];

Options[ClaudeQuery] = {Fallback -> False, WebFetch -> False, WebSearch -> True, Model -> Automatic, PrivacySpec -> Automatic, AutoPrivate -> False, AutoEvaluate -> False, Timeout -> Automatic, Integrations -> Automatic};

(* ClaudeQuery \:5185\:90e8\:5b9f\:88c5\:ff08\:975e\:540c\:671f\:ff09 *)
iClaudeQueryImpl[nb_NotebookObject, tag_String, prompt_, useFallback_, useWebFetch_,
    modelSpec_:Automatic, privSpec_:Automatic, autoPrivate_:False,
    autoEvaluate_:False, timeout_:Automatic, mediaFiles_List:{}, extraImageDirs_List:{}] :=
  Module[{history, lastEntry, cellCountAfter, notebookCtx,
          fullPrompt, step, entry, jobId, queryCallback,
          accessLevel, availModels, useClaudeCode},
    (* \:30a2\:30af\:30bb\:30b9\:30ec\:30d9\:30eb\:306e\:89e3\:6c7a: PrivacySpec \:3068 Model \:306e\:4e21\:65b9\:3092\:8003\:616e *)
    accessLevel = iResolveAccessLevel[privSpec, modelSpec];
    $iCurrentSessionAttachments = iGetResolvedAttachments[nb, tag];
    history = iSessionHistoryWithInherit[nb, tag];
    lastEntry      = If[Length[history] > 0, Last[history], <||>];
    cellCountAfter = Replace[Lookup[lastEntry, "cellCountAfter",
                       Lookup[lastEntry, "cellCount", 0]], Except[_Integer] -> 0];
    (* \:30a2\:30af\:30bb\:30b9\:30ec\:30d9\:30eb\:306b\:57fa\:3065\:3044\:3066\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:30b3\:30f3\:30c6\:30ad\:30b9\:30c8\:3092\:69cb\:7bc9 *)
    notebookCtx    = With[{r = Quiet[iCaptureNotebookContext[nb, cellCountAfter, accessLevel]]}, If[StringQ[r], r, ""]];
    step           = Length[iSessionHistory[nb, tag]];

    fullPrompt =
      $claudeQueryPrefix <>
      iTaskOverviewBlock[If[StringQ[prompt], prompt, ""]] <>
      If[Length[history] > 0,
        "\:4ee5\:4e0b\:306f Mathematica \:3067\:306e\:4f5c\:696d\:5c65\:6b74\:3067\:3059\:3002\n\n" <>
        iSessionToContext[history],
        ""] <>
      If[StringQ[notebookCtx] && notebookCtx =!= "",
        "=== \:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:306e\:73fe\:5728\:306e\:72b6\:614b ===\n" <> notebookCtx, ""] <>
      iNotebookDefinedSymbolsContext[nb] <>
      iFileAccessContext[If[StringQ[prompt], prompt, ""]] <>
      iCLIMCPPromptContext[] <>
      iPackageDocsContext[If[StringQ[prompt], prompt, ""]] <>
      iAutoPrivatePrompt[autoPrivate] <>
      iTaskDetailBlock["\:8cea\:554f", iExpandSymbolRefs[prompt]];

    entry = <|
      "step"        -> step,
      "time"        -> AbsoluteTime[],
      "type"        -> "query",
      "instruction" -> iSanitizeInstructionForHistory[prompt],
      "fullPrompt"  -> iCompressForHistory[fullPrompt],
      "cellCount"   -> NBAccess`NBCellCount[nb],
      "response"    -> "(\:51e6\:7406\:4e2d)",
      "code"        -> ""
    |>;
    iSessionAppend[nb, tag, entry];

    (* Job \:30b7\:30b9\:30c6\:30e0\:3067\:8a55\:4fa1\:30bb\:30eb\:76f4\:5f8c\:306b\:30b9\:30ed\:30c3\:30c8\:3092\:4e88\:7d04 *)
    jobId = iBeginJobAtCapturedCell[nb];

    (* \:30a2\:30af\:30bb\:30b9\:30ec\:30d9\:30eb\:306b\:57fa\:3065\:3044\:3066\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:53ef\:80fd\:30e2\:30c7\:30eb\:3092\:53d6\:5f97 *)
    availModels = If[TrueQ[useFallback],
      NBAccess`NBGetAvailableFallbackModels[accessLevel],
      {}];
    (* Claude Code \:81ea\:4f53\:304c\:30a2\:30af\:30bb\:30b9\:30ec\:30d9\:30eb\:306b\:5bfe\:5fdc\:53ef\:80fd\:304b\:5224\:5b9a *)
    useClaudeCode = NBAccess`NBProviderCanAccess["claudecode", accessLevel];

    If[TrueQ[useWebFetch] && TrueQ[useFallback],
      (* WebFetch \:306f\:540c\:671f\:3067\:5b9f\:884c\:3002\:8ab2\:91d1\:304c\:767a\:751f\:3059\:308b API \:7d4c\:7531\:306e\:305f\:3081 Fallback->True \:304c\:5fc5\:9808 *)
      Module[{response = iDoWebSearch[fullPrompt]},
        NBAccess`NBJobMoveToAnchor[jobId];
        $iJobActiveNb = nb;
        If[StringQ[response],
          iWriteQueryResponse[nb, response, autoEvaluate]];
        $iJobActiveNb = None;
        NBAccess`NBEndJob[jobId];
        iSessionUpdateLast[nb, tag, <|
          "response"       -> response,
          "cellCountAfter" -> NBAccess`NBCellCount[nb]
        |>]],
      (* \:901a\:5e38\:30d1\:30b9: \:975e\:540c\:671f *)
      queryCallback = With[{nb2 = nb, stag2 = tag, jid = jobId,
            autoMark = iShouldAutoMarkConfidential[accessLevel],
            ccBefore = NBAccess`NBCellCount[nb],
            ae = autoEvaluate},
        Function[response,
          Module[{cellThunks},
            (* \:30a2\:30f3\:30ab\:30fc\:306e\:76f4\:5f8c\:306b\:51fa\:529b\:3092\:914d\:7f6e *)
            NBAccess`NBJobMoveToAnchor[jid];
            $iJobActiveNb = nb2;
            (* \:30a8\:30e9\:30fc/\:5236\:9650\:30ec\:30b9\:30dd\:30f3\:30b9\:306f\:901a\:77e5\:30b9\:30bf\:30a4\:30eb\:3067\:8868\:793a\:3057\:3066\:7d42\:4e86 *)
            (* \:30a8\:30e9\:30fc\:30c1\:30a7\:30c3\:30af:
               - 500\:6587\:5b57\:8d85\:306e\:5fdc\:7b54\:306f\:30a8\:30e9\:30fc\:3067\:306f\:306a\:3044\:ff08\:30c9\:30ad\:30e5\:30e1\:30f3\:30c8\:7b49\:ff09
               - "#" \:3067\:59cb\:307e\:308b\:5fdc\:7b54\:306f Markdown \:30c9\:30ad\:30e5\:30e1\:30f3\:30c8\:306a\:306e\:3067\:7d76\:5bfe\:306b\:30a8\:30e9\:30fc\:3067\:306f\:306a\:3044
               - \:975e\:6587\:5b57\:5217\:306f iIsAPIErrorResponse[_]:=True \:304c\:6355\:307e\:3048\:308b *)
            If[StringQ[response] &&
               StringLength[response] <= 500 &&
               !StringStartsQ[StringTrim[response], "#"] &&
               (iIsAPIErrorResponse[response] || StringStartsQ[response, "Error"]),
              NBAccess`NBWritePrintNotice[nb2, response, RGBColor[0.8, 0, 0]];
              NBAccess`NBJobResetSlotWritten[jid, 1];
              $iJobActiveNb = None;
              NBAccess`NBEndJob[jid];
              iSessionUpdateLast[nb2, stag2, <|
                "response" -> response,
                "cellCountAfter" -> NBAccess`NBCellCount[nb2]|>];
              Return[{}]];
            If[FailureQ[response],
              Module[{msg = iFailureDisplayText[response]},
                NBAccess`NBWritePrintNotice[nb2, msg, RGBColor[0.8, 0, 0]];
                NBAccess`NBJobResetSlotWritten[jid, 1];
                $iJobActiveNb = None;
                NBAccess`NBEndJob[jid];
                iSessionUpdateLast[nb2, stag2, <|
                  "response" -> response,
                  "responseText" -> msg,
                  "cellCountAfter" -> NBAccess`NBCellCount[nb2]|>];
                Return[{}]]];
            (* \:6b63\:5e38\:5fdc\:7b54: thunk \:30ea\:30b9\:30c8\:3092\:751f\:6210\:3057 writing \:30d5\:30a7\:30fc\:30ba\:306b\:59d4\:8b72 *)
            cellThunks = If[StringQ[response],
              iWriteQueryResponseQueued[nb2, response, ae],
              {Function[NBAccess`NBWriteCell[nb2,
                Cell[iL["Error: \:5fdc\:7b54\:3092\:53d6\:5f97\:3067\:304d\:307e\:305b\:3093\:3067\:3057\:305f\:3002", "Error: Could not obtain a response."], "Text"]]]}];
            (* \:6700\:5f8c\:306e thunk \:306b\:30af\:30ea\:30fc\:30f3\:30a2\:30c3\:30d7\:51e6\:7406\:3092\:8ffd\:52a0 *)
            AppendTo[cellThunks, Function[
              If[TrueQ[autoMark] || iResponseTaintedQ[response],
                iAutoMarkNewCellsConfidential[nb2, ccBefore]];
              NBAccess`NBJobResetSlotWritten[jid, 1];
              $iJobActiveNb = None;
              NBAccess`NBEndJob[jid];
              iSessionUpdateLast[nb2, stag2, <|
                "response"       -> response,
                "cellCountAfter" -> NBAccess`NBCellCount[nb2]
              |>]]];
            cellThunks
          ]
        ]
      ];
      (* Phase 28 (2026-05-12) fix: provider=="claudecode" \:306f Anthropic CLI \:306a\:306e\:3067
         iClaudeQueryAsyncWithProgress (\:975e\:540c\:671f CLI \:7d4c\:8def) \:306b\:6d41\:3059\:3002
         \:65e7 Phase 28 \:3067 iStartFallbackAsync \:306b\:6d41\:3057\:3066\:540c\:671f\:5b9f\:884c\:3057\:3066\:3044\:305f\:306e\:3092\:4fee\:6b63\:3002
         \:975e\:540c\:671f\:52d5\:4f5c\:306f\:7d76\:5bfe\:306e\:6388\:3066: rules/95-scheduled-task-safety.md \:6e96\:62e0\:3002
         API \:7d4c\:8def (anthropic / openai \:7b49) \:306e\:307f iStartFallbackAsync \:3078\:3002 *)
      Module[{provLower = ""},
        If[ListQ[modelSpec] && Length[modelSpec] >= 2 && StringQ[modelSpec[[1]]],
          provLower = ToLowerCase[modelSpec[[1]]]];
        If[modelSpec =!= Automatic && ListQ[modelSpec] && Length[modelSpec] >= 2 &&
           provLower =!= "claudecode",
          (* Model \:6307\:5b9a\:3042\:308a (\:8ab2\:91d1 API \:307e\:305f\:306f lmstudio): API \:7d4c\:7531\:3067\:6307\:5b9a\:30e2\:30c7\:30eb\:3092\:76f4\:63a5\:547c\:3073\:51fa\:3057 *)
          iStartFallbackAsync[fullPrompt, nb, queryCallback,
            {modelSpec}, 1, jobId, timeout, mediaFiles],
          (* \:30a2\:30af\:30bb\:30b9\:30ec\:30d9\:30eb\:306b\:57fa\:3065\:304f\:30eb\:30fc\:30c6\:30a3\:30f3\:30b0\:3002
             provider=="claudecode" \:306e Model \:6307\:5b9a\:3082\:3053\:3053\:3092\:901a\:308b (CLI \:306e --model \:3092\:898b\:308b) *)
          If[useClaudeCode,
          (* Claude Code \:4f7f\:7528\:53ef\:80fd: \:901a\:5e38\:30d1\:30b9 (\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:6642\:306f availModels \:3092\:4f7f\:7528) *)
          iClaudeQueryAsyncWithProgress[
            fullPrompt, queryCallback, nb, extraImageDirs, jobId, availModels],
          (* Claude Code \:4f7f\:7528\:4e0d\:53ef: \:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:30e2\:30c7\:30eb\:3078\:76f4\:63a5 *)
          If[Length[availModels] > 0,
            iStartFallbackAsync[fullPrompt, nb, queryCallback,
              availModels, 1, jobId, timeout, mediaFiles],
            (* \:3069\:306e\:30e2\:30c7\:30eb\:3082\:30a2\:30af\:30bb\:30b9\:30ec\:30d9\:30eb\:306b\:5bfe\:5fdc\:4e0d\:53ef *)
            NBAccess`NBWriteSlot[jobId, 1,
              Cell["\[WarningSign] AccessLevel " <> ToString[accessLevel] <>
                " \:306b\:5bfe\:5fdc\:3059\:308b\:30e2\:30c7\:30eb\:304c\:3042\:308a\:307e\:305b\:3093\:3002", "Print",
                FontWeight -> Bold, FontColor -> Red, FontSize -> 11]];
            $iJobActiveNb = None;
            NBAccess`NBEndJob[jobId];
            iSessionUpdateLast[nb, tag, <|
              "response" -> "Error: AccessLevel " <> ToString[accessLevel] <>
                " \:306b\:5bfe\:5fdc\:3059\:308b\:30e2\:30c7\:30eb\:304c\:3042\:308a\:307e\:305b\:3093",
              "cellCountAfter" -> NBAccess`NBCellCount[nb]|>]
          ]
        ]
      ]
    ]];  (* \:8ffd\:52a0 ] \:306f Phase 28 fix \:3067\:8ffd\:52a0\:3057\:305f Module \:306e\:9589\:3058 *)
  ];

ClaudeQuery[prompt_, opts:OptionsPattern[]] := Block[
  {$iLMStudioIntegrationsOverride =
     With[{ig = OptionValue[Integrations]},
       If[ListQ[ig] && Length[ig] > 0, ig, $iLMStudioIntegrationsOverride]]},
  (
    iCaptureEvalCell[];
    $currentUseFallback = TrueQ[OptionValue[Fallback]];
    $iAllowReadTool = True;
    $iAllowWebSearch = TrueQ[OptionValue[WebSearch]];
  With[{nb = Quiet[EvaluationNotebook[]],
        ae = OptionValue[AutoEvaluate],
        mdl = iResolveDefaultModelSpec[OptionValue[Model]],
        ps = OptionValue[PrivacySpec],
        ap = TrueQ[OptionValue[AutoPrivate]],
        tmo = OptionValue[Timeout],
        actualPrompt = iResolveWebFetchWithFallback[
          prompt, OptionValue[WebFetch], $currentUseFallback]},
  (* \[HorizontalLine]\[HorizontalLine] $UseClaudeRuntime \:5206\:5c90 \[HorizontalLine]\[HorizontalLine] *)
  If[TrueQ[$UseClaudeRuntime],
    iScheduleAtAsync[
      iClaudeEvalViaRuntimeBridge[nb, iSessionTag[], actualPrompt,
        {}, ae, mdl, ps, ap, tmo],
      Now],
    Module[{session, tag},
      iPrecisionConfidentialCheck[nb];
      session = iEnsureDefaultSession[nb];
      tag     = session["SessionTag"];
      iClaudeQueryImpl[nb, tag, prompt,
        TrueQ[OptionValue[Fallback]], TrueQ[OptionValue[WebFetch]],
        mdl, ps, ap, ae, tmo, {}, {}]
    ]
  ]])];

(* \:30bb\:30c3\:30b7\:30e7\:30f3\:5bfe\:5fdc\:7248 ClaudeQuery\:ff08\:975e\:540c\:671f\:30fb\:5c65\:6b74\:4fdd\:5b58\:4ed8\:304d\:ff09 *)
ClaudeQuery[session_Association, prompt_, opts:OptionsPattern[]] := (
    iCaptureEvalCell[];
    $currentUseFallback = TrueQ[OptionValue[ClaudeQuery, {opts}, Fallback]];
    $iAllowReadTool = True;
    $iAllowWebSearch = TrueQ[OptionValue[ClaudeQuery, {opts}, WebSearch]];
  With[{nb = session["Notebook"],
        ae = OptionValue[ClaudeQuery, {opts}, AutoEvaluate],
        mdl = iResolveDefaultModelSpec[OptionValue[ClaudeQuery, {opts}, Model]],
        ps = OptionValue[ClaudeQuery, {opts}, PrivacySpec],
        ap = TrueQ[OptionValue[ClaudeQuery, {opts}, AutoPrivate]],
        tmo = OptionValue[ClaudeQuery, {opts}, Timeout]},
  If[TrueQ[$UseClaudeRuntime],
    iScheduleAtAsync[
      iClaudeEvalViaRuntimeBridge[nb, session["SessionTag"], prompt,
        {}, ae, mdl, ps, ap, tmo],
      Now],
    Module[{tag},
      tag = session["SessionTag"];
      iPrecisionConfidentialCheck[nb];
      $iCurrentSessionAttachments = iGetResolvedAttachments[nb, tag];
      iClaudeQueryImpl[nb, tag, prompt,
        TrueQ[OptionValue[ClaudeQuery, {opts}, Fallback]],
        TrueQ[OptionValue[ClaudeQuery, {opts}, WebFetch]],
        mdl, ps, ap, ae, tmo, {}, {}]
    ]
  ]]);

(* \:30ea\:30b9\:30c8\:5165\:529b\:7248 ClaudeQuery: {"\:8cea\:554f", Image[...], File["path"], ...}
   \:753b\:50cf\:30fbPDF\:30fb\:97f3\:58f0\:30d5\:30a1\:30a4\:30eb\:3092 API \:306b\:30de\:30eb\:30c1\:30e2\:30fc\:30c0\:30eb\:30b3\:30f3\:30c6\:30f3\:30c4\:3068\:3057\:3066\:76f4\:63a5\:9001\:4fe1\:3059\:308b\:3002 *)
ClaudeQuery[items_List, opts:OptionsPattern[]] := (
    iCaptureEvalCell[];
    $currentUseFallback = TrueQ[OptionValue[Fallback]];
    $iAllowReadTool = True;
    $iAllowWebSearch = TrueQ[OptionValue[WebSearch]];
  With[{nb = Quiet[EvaluationNotebook[]],
        ae = OptionValue[AutoEvaluate],
        mdl = iResolveDefaultModelSpec[OptionValue[Model]],
        ps = OptionValue[PrivacySpec],
        ap = TrueQ[OptionValue[AutoPrivate]],
        tmo = OptionValue[Timeout]},
  Module[{session, tag, norm},
    iPrecisionConfidentialCheck[nb];
    session = iEnsureDefaultSession[nb];
    tag     = session["SessionTag"];
    norm    = iNormalizePrompt[iInjectAttachments[items]];
    If[TrueQ[$UseClaudeRuntime],
      iScheduleAtAsync[
        iClaudeEvalViaRuntimeBridge[nb, tag, norm["text"],
          norm["imageDirs"], ae, mdl, ps, ap, tmo,
          norm["mediaFiles"]],
        Now],
      iClaudeQueryImpl[nb, tag, norm["text"],
        TrueQ[OptionValue[Fallback]], TrueQ[OptionValue[WebFetch]],
        mdl, ps, ap, ae, tmo,
        norm["mediaFiles"], norm["imageDirs"]]
    ]
  ]]);

(* \:30bb\:30c3\:30b7\:30e7\:30f3\:6307\:5b9a\:7248\:30ea\:30b9\:30c8\:5165\:529b ClaudeQuery *)
ClaudeQuery[session_Association, items_List, opts:OptionsPattern[]] := (
    iCaptureEvalCell[];
    $currentUseFallback = TrueQ[OptionValue[ClaudeQuery, {opts}, Fallback]];
    $iAllowReadTool = True;
    $iAllowWebSearch = TrueQ[OptionValue[ClaudeQuery, {opts}, WebSearch]];
  With[{nb = session["Notebook"],
        ae = OptionValue[ClaudeQuery, {opts}, AutoEvaluate],
        mdl = iResolveDefaultModelSpec[OptionValue[ClaudeQuery, {opts}, Model]],
        ps = OptionValue[ClaudeQuery, {opts}, PrivacySpec],
        ap = TrueQ[OptionValue[ClaudeQuery, {opts}, AutoPrivate]],
        tmo = OptionValue[ClaudeQuery, {opts}, Timeout]},
  Module[{tag, norm},
    tag  = session["SessionTag"];
    iPrecisionConfidentialCheck[nb];
    $iCurrentSessionAttachments = iGetResolvedAttachments[nb, tag];
    norm = iNormalizePrompt[iInjectAttachments[items]];
    If[TrueQ[$UseClaudeRuntime],
      iScheduleAtAsync[
        iClaudeEvalViaRuntimeBridge[nb, tag, norm["text"],
          norm["imageDirs"], ae, mdl, ps, ap, tmo,
          norm["mediaFiles"]],
        Now],
      iClaudeQueryImpl[nb, tag, norm["text"],
        TrueQ[OptionValue[ClaudeQuery, {opts}, Fallback]],
        TrueQ[OptionValue[ClaudeQuery, {opts}, WebFetch]],
        mdl, ps, ap, ae, tmo,
        norm["mediaFiles"], norm["imageDirs"]]
    ]
  ]]);

(* ============================================================
   $Language \:30d9\:30fc\:30b9\:306e\:8a00\:8a9e\:6307\:793a\:30d8\:30eb\:30d1\:30fc
   \:30d7\:30ed\:30f3\:30d7\:30c8\:5185\:306e\:8a00\:8a9e\:6307\:5b9a\:3092 $Language \:306b\:57fa\:3065\:3044\:3066\:52d5\:7684\:751f\:6210\:3059\:308b\:3002
   ============================================================ *)

(* \:73fe\:5728\:306e\:8a00\:8a9e\:540d\:3092\:8fd4\:3059\:ff08\:82f1\:8a9e\:8868\:8a18\:ff09 *)
iLanguageName[] := If[StringQ[$Language], $Language, "English"];

(* \:30d7\:30ed\:30f3\:30d7\:30c8\:7528\:306e\:8a00\:8a9e\:6307\:793a\:6587\:3092\:751f\:6210\:3002
   style:
     "polite"  \[RightArrow] \:656c\:4f53 (\:65e5\:672c\:8a9e) / polite style (\:4ed6\:8a00\:8a9e)
     "plain"   \[RightArrow] \:5e38\:4f53 (\:65e5\:672c\:8a9e) / concise style (\:4ed6\:8a00\:8a9e)
     "general" \[RightArrow] "All text must be written in ..." *)
iLanguageInstruction["polite"] :=
  If[$Language === "Japanese",
    "Write in Japanese using \:656c\:4f53 (\:3067\:3059\:30fb\:307e\:3059\:8abf) style.\n",
    "Write in " <> iLanguageName[] <> ".\n"];

iLanguageInstruction["plain"] :=
  If[$Language === "Japanese",
    "Write in Japanese using \:5e38\:4f53 (\:3060\:30fb\:3067\:3042\:308b\:8abf) style for brevity.\n",
    "Write in " <> iLanguageName[] <> " using concise style.\n"];

iLanguageInstruction["general"] :=
  "All text must be written in " <> iLanguageName[] <> ".\n";

iLanguageInstruction["summary"] :=
  "Summarize the following Mathematica package update instruction in ONE short " <>
  iLanguageName[] <> " sentence (max 40 chars). ";

iLanguageInstruction["explanation"] :=
  "All explanatory text must be written in " <> iLanguageName[] <> ".";

(* \:975e\:540c\:671f\:30bf\:30b9\:30af\:30b9\:30b1\:30b8\:30e5\:30fc\:30ea\:30f3\:30b0\:898f\:7d04: ClaudeCreatePackage / ClaudeUpdatePackage \:30d7\:30ed\:30f3\:30d7\:30c8\:306b\:6ce8\:5165\:3002
   claudecode/NBAccess \:304c\:63d0\:4f9b\:3059\:308b\:5171\:6709\:30dd\:30fc\:30ea\:30f3\:30b0\:30bf\:30b9\:30af\:3092\:7d4c\:7531\:3057\:3001
   \:30d1\:30c3\:30b1\:30fc\:30b8\:5074\:3067\:500b\:5225\:306b ScheduledTask \:3092\:4f5c\:6210\:3057\:306a\:3044\:3053\:3068\:3092\:6307\:793a\:3059\:308b\:3002 *)
iAsyncSchedulingRules[] :=
  "\n=== ASYNC TASK SCHEDULING RULES ===\n" <>
  "When the package needs asynchronous or background processing with UI feedback:\n" <>
  "1. MANDATORY: Use claudecode/NBAccess public APIs for async task scheduling.\n" <>
  "   - Use iClaudeQueryAsyncWithProgress[] for LLM query tasks.\n" <>
  "   - Use NBAccess functions (NBWriteCell, NBEndJob, etc.) for notebook output.\n" <>
  "   - Do NOT create individual ScheduledTask objects for polling or progress tracking.\n" <>
  "   - The shared polling infrastructure in claudecode manages all concurrent async tasks\n" <>
  "     through a single ScheduledTask to prevent FrontEnd dynamic evaluation overload.\n" <>
  "2. EXCEPTIONS (individual ScheduledTask allowed):\n" <>
  "   a. Pure computation tasks (numerical, combinatorial) that do NOT interact with\n" <>
  "      the FrontEnd (no WindowStatusArea, NotebookWrite, Dynamic, etc.).\n" <>
  "   b. Interactive user-facing programs (e.g., PresentationListener) that have\n" <>
  "      specific real-time requirements justifying a custom scheduler.\n" <>
  "   In both cases, the documentation (api.md/user_manual.md/README.md) MUST explicitly\n" <>
  "   note that the package uses its own ScheduledTask and explain why.\n" <>
  "3. RATIONALE: Multiple concurrent ScheduledTask objects that update WindowStatusArea\n" <>
  "   or call NotebookWrite cause Mathematica's dynamic evaluation to overflow,\n" <>
  "   triggering the 'Dynamic evaluation abort' dialog and freezing all tasks.\n" <>
  "=================================\n\n";

ClaudeMath[task_String] := iClaudeQueryRaw[
  "You are an expert Wolfram Language / Mathematica programmer. \
Provide clean, working Mathematica code. \
Wrap all code in ```mathematica ... ``` blocks. \
Use idiomatic Wolfram Language style. \
For explanatory text outside code blocks: \
do NOT use markdown tables (no |---|); \
instead describe comparisons as numbered lists or plain sentences. \
Do not use markdown bold (**text**) or heading syntax (# ##). \
All explanatory text must be written in " <> iLanguageName[] <> ". \
Task: " <> task
];

ClaudeExtractCode[response_String] := Module[{matches},
  matches = StringCases[response,
    "```mathematica" ~~ Shortest[code__] ~~ "```" :> StringTrim[code]];
  If[Length[matches] > 0, First[matches], response]
];

ClaudeExtractAllCode[response_String] :=
  StringCases[response,
    "```mathematica" ~~ Shortest[code__] ~~ "```" :> StringTrim[code]];

(* \:8a00\:8a9e\:30bf\:30b0\:4ed8\:304d\:30b3\:30fc\:30c9\:30d6\:30ed\:30c3\:30af\:62bd\:51fa: {<|"lang"->..., "code"->...|>, ...} *)
$iExternalLangMap = <|
  "python" -> "Python", "py" -> "Python",
  "r" -> "R",
  "julia" -> "Julia",
  "ruby" -> "Ruby",
  "javascript" -> "NodeJS", "js" -> "NodeJS",
  "shell" -> "Shell", "bash" -> "Shell", "sh" -> "Shell",
  "sql" -> "SQL"
|>;

iExtractAllCodeBlocks[response_String] := Module[{raw},
  raw = StringCases[response,
    RegularExpression["```(\\w+)\\n([\\s\\S]*?)```"] :> {"$1", "$2"}];
  Map[Function[pair,
    Module[{tag = ToLowerCase[First[pair]], code = StringTrim[Last[pair]]},
      <|"lang" -> If[tag === "mathematica", "mathematica",
                    Lookup[$iExternalLangMap, tag, "mathematica"]],
        "fenceTag" -> First[pair],
        "code" -> iFixUnicodeEscapes[code]|>
    ]], raw]
];

(* \uXXXX / \xNN \:5f62\:5f0f\:306e Unicode \:30a8\:30b9\:30b1\:30fc\:30d7\:3092\:5b9f\:6587\:5b57\:306b\:5909\:63db\:3002
   Claude \:304c\:65e5\:672c\:8a9e\:3092 \x4e00\x81f4 \:3084 \:30d1\:30c3 \:306e\:3088\:3046\:306b\:51fa\:529b\:3059\:308b\:554f\:984c\:3078\:306e\:5bfe\:7b56\:3002
   Mathematica \:306f \:XXXX \:5f62\:5f0f\:306a\:306e\:3067 \uXXXX / \xNN \:306f\:30ea\:30c6\:30e9\:30eb\:3068\:3057\:3066\:6b8b\:3063\:3066\:3057\:307e\:3046\:3002 *)
iFixUnicodeEscapes[code_String] :=
  Module[{result},
    (* Step 1: \uXXXX \[RightArrow] \:5b9f\:6587\:5b57 *)
    result = StringReplace[code,
      "\\u" ~~ hex : Repeated[HexadecimalCharacter, {4}] :>
        FromCharacterCode[FromDigits[hex, 16]]];
    (* Step 2: \xNN\xNN... (UTF-8 \:30d0\:30a4\:30c8\:5217) \[RightArrow] \:5b9f\:6587\:5b57
       \:9023\:7d9a\:3059\:308b \xNN \:3092 UTF-8 \:30d0\:30a4\:30c8\:5217\:3068\:3057\:3066\:89e3\:91c8 *)
    result = StringReplace[result,
      s : Repeated["\\x" ~~ Repeated[HexadecimalCharacter, {2}], {2, Infinity}] :>
        Module[{bytes},
          bytes = FromDigits[#, 16] & /@
            StringCases[s, "\\x" ~~ h : Repeated[HexadecimalCharacter, {2}] :> h];
          Quiet @ Check[
            FromCharacterCode[bytes, "UTF-8"],
            s  (* \:30c7\:30b3\:30fc\:30c9\:5931\:6557\:6642\:306f\:5143\:306e\:307e\:307e *)
          ]]];
    result
  ];

