iCollectAccessibleDirs[] := Module[{nbDirs = {}, attDirs = {}, baseDirs},
  (* $packageDirectory \:3068\:4f5c\:696d\:30c7\:30a3\:30ec\:30af\:30c8\:30ea\:306f\:5e38\:306b\:4fdd\:8a3c *)
