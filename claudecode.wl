  "  /help              \[RightArrow] \:3053\:306e\:30d8\:30eb\:30d7\:3092\:8868\:793a\n" <>
  "  /version           \[RightArrow] Claude Code \:306e\:30d0\:30fc\:30b8\:30e7\:30f3 (CLI)\n" <>
