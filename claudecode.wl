   - 2 \:56de\:76ee\:4ee5\:964d\:306f\:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:3068\:6bd4\:8f03
   - \:4e0a\:66f8\:304d\:304c\:691c\:51fa\:3055\:308c\:305f\:3089 ClaudeEval \:3092\:4e2d\:6b62\:3057\:3001\:901a\:77e5\:3092\:8868\:793a
   
   \:30ea\:30bb\:30c3\:30c8:
   - $iCoreIntegritySnapshot = None \:3067\:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:3092\:30ea\:30bb\:30c3\:30c8
     \:ff08\:6b21\:56de ClaudeEval \:6642\:306b\:65b0\:3057\:3044\:30d9\:30fc\:30b9\:30e9\:30a4\:30f3\:3092\:53d6\:5f97\:ff09
   \:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550 *)

$iCoreIntegrityContexts = {"ClaudeCode`", "ClaudeRuntime`",
  "NBAccess`", "ClaudeTestKit`"};

If[!AssociationQ[$iCoreIntegritySnapshot],
  $iCoreIntegritySnapshot = None];

(* \:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:53d6\:5f97: \:5404\:30b3\:30f3\:30c6\:30ad\:30b9\:30c8\:306e\:516c\:958b\:95a2\:6570\:306e DownValues \:30cf\:30c3\:30b7\:30e5\:3092\:8a18\:9332 *)
iSnapshotCoreIntegrity[] :=
  Module[{snapshot = <||>, syms, dv},
    Do[
      syms = Quiet[Names[ctx <> "*"]];
      If[!ListQ[syms], Continue[]];
      Do[
        dv = Quiet[DownValues[ToExpression[name]]];
        If[ListQ[dv] && Length[dv] > 0,
          snapshot[name] = Hash[dv]],
        {name, syms}],
      {ctx, $iCoreIntegrityContexts}];
    $iCoreIntegritySnapshot = snapshot;
    Length[snapshot]
  ];

(* \:6574\:5408\:6027\:30c1\:30a7\:30c3\:30af: \:4e0a\:66f8\:304d\:3055\:308c\:305f\:95a2\:6570\:540d\:306e\:30ea\:30b9\:30c8\:3092\:8fd4\:3059 *)
iCheckCoreIntegrity[] :=
  Module[{violations = {}},
    (* \:521d\:56de: \:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:53d6\:5f97\:3001\:9055\:53cd\:306a\:3057 *)
    If[$iCoreIntegritySnapshot === None,
      iSnapshotCoreIntegrity[];
      Return[{}]];
    (* 2 \:56de\:76ee\:4ee5\:964d: \:6bd4\:8f03 *)
    KeyValueMap[
      Function[{name, expectedHash},
        Module[{currentHash},
          currentHash = Quiet[Hash[DownValues[ToExpression[name]]]];
          If[currentHash =!= expectedHash,
            AppendTo[violations, name]]]],
      $iCoreIntegritySnapshot];
    violations
  ];

(* \:30d6\:30ea\:30c3\:30b8\:7528: \:9055\:53cd\:304c\:3042\:308c\:3070 notebook \:306b\:901a\:77e5\:3057 $Failed \:3092\:8fd4\:3059 *)
iGuardCoreIntegrity[nb_] :=
  Module[{violations = iCheckCoreIntegrity[]},
    If[Length[violations] === 0, Return[True]];
    Quiet @ NBAccess`NBWritePrintNotice[nb,
      "\:26d4 Core \:30d1\:30c3\:30b1\:30fc\:30b8\:306e\:95a2\:6570\:304c\:4e0a\:66f8\:304d\:3055\:308c\:3066\:3044\:307e\:3059\:3002ClaudeEval \:3092\:4e2d\:6b62\:3057\:307e\:3057\:305f\:3002\n\n" <>
      "\:4e0a\:66f8\:304d\:3055\:308c\:305f\:95a2\:6570:\n  " <>
      StringRiffle[violations, "\n  "] <>
      "\n\n\:5fa9\:5143\:65b9\:6cd5:\n" <>
      "  Block[{$CharacterEncoding = \"UTF-8\"}, Get[\"ClaudeRuntime.wl\"]]\n" <>
      "  \:307e\:305f\:306f\:30d9\:30fc\:30b9\:30e9\:30a4\:30f3\:306e\:30ea\:30bb\:30c3\:30c8: $iCoreIntegritySnapshot = None",
      RGBColor[0.8, 0, 0]];
    Print[Style["\:26d4 Core integrity violation: " <>
      ToString[Length[violations]] <> " functions overwritten",
      Red, Bold]];
    Do[Print["  \[Bullet] ", v], {v, violations}];
    False
  ];

(* status label for the model actually being queried, so WindowStatusArea shows
   e.g. "lmstudio: qwen3-swallow-8b-rl-v0.2" instead of "Claude" when a local
   model is used. "" -> use the default "Claude" label (anthropic / claudecode /
   Automatic). modelSpec forms: Automatic | "model" | {provider, model[, url]}. *)
If[!ValueQ[$iActiveQueryModelLabel], $iActiveQueryModelLabel = ""];
iModelStatusLabel[Automatic] := "";
iModelStatusLabel[m_String] :=
  If[m === "" || StringContainsQ[ToLowerCase[m], "claude"], "", m];
iModelStatusLabel[m_List] :=
  Module[{prov, provLC, model},
    prov   = If[Length[m] >= 1 && StringQ[m[[1]]], m[[1]], ""];
    provLC = ToLowerCase[prov];
    model  = If[Length[m] >= 2 && StringQ[m[[2]]], m[[2]], ""];
    Which[
      MemberQ[{"anthropic", "claudecode", ""}, provLC], "",
      model =!= "" && prov =!= "", prov <> ": " <> model,
      model =!= "", model,
      True, prov]];
iModelStatusLabel[_] := "";

iClaudeEvalViaRuntimeBridge[nb_NotebookObject, tag_String, task_String,
    imageDirs_List:{}, autoEvaluate_:True, modelSpec_:Automatic,
    privSpec_:Automatic, autoPrivate_:False, timeout_:Automatic,
    mediaFiles_List:{}] :=
  Module[{accessLevel, result, runtimeId, useFallback, jobId, step,
          history, copts, meta},
    
    (* Core integrity check: \:95a2\:6570\:4e0a\:66f8\:304d\:306e\:691c\:51fa *)
    If[!TrueQ[iGuardCoreIntegrity[nb]], Return[$Failed]];

    (* 2026-06-12 (freeze fix 2): 並行 LLM ジョブ数ゲート。
       上限到達中は副作用 (履歴登録・Job slot 確保) を起こす前に
       5 秒後の再試行へ退避する (busy-wait しない)。 *)
    If[iClaudeActiveLLMJobCount[] >= ClaudeCode`$ClaudeMaxConcurrentJobs,
      iClaudeFreezeLog["job-deferred",
        "bridge active=" <> ToString[iClaudeActiveLLMJobCount[]]];
      iSafeSetWindowStatus[nb,
        iL["Claude: 他ジョブの完了待ち...", "Claude: waiting for other jobs..."]];
      With[{nb1 = nb, tag1 = tag, task1 = task, img1 = imageDirs,
            ae1 = autoEvaluate, ms1 = modelSpec, pv1 = privSpec,
            ap1 = autoPrivate, to1 = timeout, mf1 = mediaFiles},
        Quiet @ Check[
          SessionSubmit[ScheduledTask[
            iClaudeEvalViaRuntimeBridge[nb1, tag1, task1, img1, ae1,
              ms1, pv1, ap1, to1, mf1],
            {5, 1}]],
          $Failed]];
      Return[Null]];

    accessLevel = iResolveAccessLevel[privSpec, modelSpec];
    $iActiveQueryModelLabel = iModelStatusLabel[modelSpec];
    useFallback = TrueQ[$currentUseFallback];

    (* \:30bb\:30c3\:30b7\:30e7\:30f3\:5c65\:6b74\:3068\:30b9\:30c6\:30c3\:30d7\:756a\:53f7\:3092\:53d6\:5f97 *)
    history = iSessionHistoryWithInherit[nb, tag];
    step    = Length[iSessionHistory[nb, tag]];
    
    (* \:30bb\:30c3\:30b7\:30e7\:30f3\:30a8\:30f3\:30c8\:30ea\:3092\:767b\:9332\:ff08\:65e7 ClaudeEval \:4e92\:63db\:ff09 *)
    iSessionAppend[nb, tag, <|
      "step"        -> step,
      "time"        -> AbsoluteTime[],
      "instruction" -> iSanitizeInstructionForHistory[task],
      "fullPrompt"  -> iCompressForHistory["[RuntimeBridge] " <> task],
      "cellCount"   -> NBAccess`NBCellCount[nb],
      "response"    -> "\:ff08\:51e6\:7406\:4e2d\:ff09",
      "code"        -> "",
      "type"        -> "eval",
      "accessLevel" -> accessLevel
    |>];
    
    (* Job \:30b7\:30b9\:30c6\:30e0\:3067\:8a55\:4fa1\:30bb\:30eb\:76f4\:5f8c\:306b\:30b9\:30ed\:30c3\:30c8\:3092\:4e88\:7d04 *)
    jobId = iBeginJobAtCapturedCell[nb];

    (* Order 9: anchor the auto-save turn to this job so every executed
       proposal accumulates into one saved workflow route. *)
    ClaudeCode`$iClaudeEvalAutoSaveTask = task;
    ClaudeCode`$iClaudeEvalAutoSaveTurn = jobId;

    (* ContinueEval \:30dc\:30bf\:30f3\:7528\:30aa\:30d7\:30b7\:30e7\:30f3 *)
    copts = <|
      If[TrueQ[$currentUseFallback], "Fallback" -> True, Nothing],
      If[!TrueQ[$iAllowWebSearch], "WebSearch" -> False, Nothing],
      If[modelSpec =!= Automatic, "Model" -> modelSpec, Nothing],
      If[timeout =!= Automatic, "Timeout" -> timeout, Nothing]|>;
    
    (* \[HorizontalLine]\[HorizontalLine] Metadata \:3092\:4e8b\:524d\:69cb\:7bc9\:3057 ClaudeStartRuntime \:306b\:6e21\:3059 \[HorizontalLine]\[HorizontalLine]
       DAG \:8d77\:52d5\:524d\:306b Metadata \:304c RuntimeState \:306b\:30bb\:30c3\:30c8\:3055\:308c\:308b\:305f\:3081\:3001
       SyncProvider \:6642\:306e\:30ec\:30fc\:30b9\:30b3\:30f3\:30c7\:30a3\:30b7\:30e7\:30f3 (DAG \:5b8c\:4e86\:5f8c\:306b
       NotebookCallback \:304c\:672a\:8a2d\:5b9a) \:3092\:9632\:6b62\:3059\:308b\:3002 *)
    meta = <|
      "NotebookCallback" -> Function[{rid},
        iClaudeFreezeLog["display-start", rid];
        iRuntimeDisplayResult[nb, tag, rid];
        iClaudeFreezeLog["display-end", rid]],
      "Notebook"      -> nb,
      "Tag"           -> tag,
      "JobId"         -> jobId,
      "AutoEvaluate"  -> autoEvaluate,
      "AccessLevel"   -> accessLevel,
      "Step"          -> step,
      "ContinueOpts"  -> copts,
      "CellCountBefore" -> NBAccess`NBCellCount[nb],
      "AutoMark"      -> iShouldBlanketMarkConfidential[accessLevel, privSpec],
      "StartTime"     -> AbsoluteTime[]
    |>;
    
    (* \[HorizontalLine]\[HorizontalLine] WindowStatusArea \:306b\:521d\:671f\:30b9\:30c6\:30fc\:30bf\:30b9\:8868\:793a \[HorizontalLine]\[HorizontalLine] *)
    Quiet[CurrentValue[nb, WindowStatusArea] =
      iL["ClaudeRuntime: \:6e96\:5099\:4e2d...", "ClaudeRuntime: Preparing..."]];
    
    result = ClaudeStartRuntime[nb, task,
      "Profile"          -> "Eval",
      "Fallback"         -> useFallback,
      "AccessLevel"      -> accessLevel,
      "Secrets"          -> If[AssociationQ[NBAccess`$NBConfidentialSymbols],
                              Keys[NBAccess`$NBConfidentialSymbols], {}],
      (* Phase 30.2 fix (2026-04-22): MaxContinuations \:3092 1 \:304b\:3089 3 \:306b\:5fa9\:5e30\:3002
         \:65e7\:5024 1 \:3067\:306f tool \:3092\:547c\:3093\:3060\:5f8c\:306b LLM \:304c tool \:7d50\:679c\:3092\:53c2\:7167\:3057\:3066
         \:6700\:7d42\:56de\:7b54\:3092\:66f8\:304f\:4f59\:5730\:304c\:306a\:304f\:3001tool_call \:306e\:751f\:30c6\:30ad\:30b9\:30c8\:304c
         Committer \:306b\:6e21\:3063\:3066\:307e\:307e Column[{...}] \:306b\:8a70\:307e\:308c\:308b\:7834\:7dbb\:304c
         \:8d77\:304d\:3066\:3044\:305f (websearch-result1.nb)\:3002\:305d\:306e\:4ed6\:306e adapter \:4f5c\:6210\:7b87\:6240\:306f
         \:3059\:3079\:3066\:30c7\:30d5\:30a9\:30eb\:30c8 3 \:3092\:4f7f\:7528\:3057\:3066\:3044\:308b\:306e\:3067\:6574\:5408\:6027\:3082\:56de\:5fa9\:3002 *)
      "MaxContinuations" -> 3,
      "SyncProvider"     -> False,
      "Provider"         -> Automatic,
      "Model"            -> modelSpec,
      "Metadata"         -> meta];
    
    runtimeId = result["RuntimeId"];
    If[!StringQ[runtimeId],
      NBAccess`NBWritePrintNotice[nb,
        "ClaudeRuntime: \:8d77\:52d5\:5931\:6557", RGBColor[0.8, 0, 0]];
      $iJobActiveNb = None;
      NBAccess`NBEndJob[jobId];
      Return[$Failed]];
    
    (* \:30bb\:30c3\:30b7\:30e7\:30f3\:5225 runtimeId \:3092\:8a18\:9332 *)
    $iSessionRuntimeIds[tag] = runtimeId;
    $ClaudeLastRuntimeId = runtimeId;
    
    Null (* \:5373\:5ea7\:306b return \[LongDash] Out[] \:30bb\:30eb\:975e\:8868\:793a *)
  ];

(* \[HorizontalLine]\[HorizontalLine] ContinueEval \:306e runtime \:7248 \[HorizontalLine]\[HorizontalLine] *)
iContinueEvalViaRuntimeBridge[nb_NotebookObject, tag_String,
    instruction_String, autoEvaluate_:True, modelSpec_:Automatic,
    privSpec_:Automatic, autoPrivate_:False, timeout_:Automatic] :=
  Module[{runtimeId, st, contResult, jobId, accessLevel, copts, step},
    
    (* Core integrity check: \:95a2\:6570\:4e0a\:66f8\:304d\:306e\:691c\:51fa *)
    If[!TrueQ[iGuardCoreIntegrity[nb]], Return[$Failed]];
    
    runtimeId = Lookup[$iSessionRuntimeIds, tag, None];
    
    (* \:524d\:56de runtime \:304c\:306a\:3051\:308c\:3070\:65b0\:898f\:8d77\:52d5 *)
    If[!StringQ[runtimeId],
      Return[iClaudeEvalViaRuntimeBridge[nb, tag, instruction,
        {}, autoEvaluate, modelSpec, privSpec, autoPrivate, timeout]]];
    
    (* \:524d\:56de runtime \:304c continuation \:53ef\:80fd\:304b\:78ba\:8a8d *)
    st = Quiet @ Check[ClaudeRuntime`ClaudeRuntimeState[runtimeId], None];
    If[!AssociationQ[st] ||
       !MemberQ[{"Done", "AwaitingApproval"}, st["Status"]],
      (* \:4f7f\:3044\:56de\:305b\:306a\:3044\:306e\:3067\:65b0\:898f *)
      Return[iClaudeEvalViaRuntimeBridge[nb, tag, instruction,
        {}, autoEvaluate, modelSpec, privSpec, autoPrivate, timeout]]];
    
    accessLevel = iResolveAccessLevel[privSpec, modelSpec];
    $iActiveQueryModelLabel = iModelStatusLabel[modelSpec];
    step = Length[iSessionHistory[nb, tag]];

    (* \:30bb\:30c3\:30b7\:30e7\:30f3\:30a8\:30f3\:30c8\:30ea\:3092\:767b\:9332\:ff08\:65e7 ContinueEval \:4e92\:63db\:ff09 *)
    iSessionAppend[nb, tag, <|
      "step"        -> step,
      "time"        -> AbsoluteTime[],
      "instruction" -> iSanitizeInstructionForHistory[instruction],
      "fullPrompt"  -> iCompressForHistory[
        "[RuntimeContinue] " <> instruction],
      "cellCount"   -> NBAccess`NBCellCount[nb],
      "response"    -> "\:ff08\:51e6\:7406\:4e2d\:ff09",
      "code"        -> "",
      "type"        -> "eval",
      "accessLevel" -> accessLevel
    |>];
    
    (* Job \:30b7\:30b9\:30c6\:30e0\:3067\:8a55\:4fa1\:30bb\:30eb\:76f4\:5f8c\:306b\:30b9\:30ed\:30c3\:30c8\:3092\:4e88\:7d04 *)
    jobId = iBeginJobAtCapturedCell[nb];

    (* Order 9: continuation gets its own auto-save turn + prompt. *)
    ClaudeCode`$iClaudeEvalAutoSaveTask = instruction;
    ClaudeCode`$iClaudeEvalAutoSaveTurn = jobId;

    (* ContinueEval \:30dc\:30bf\:30f3\:7528\:30aa\:30d7\:30b7\:30e7\:30f3 *)
    copts = <|
      If[TrueQ[$currentUseFallback], "Fallback" -> True, Nothing],
      If[modelSpec =!= Automatic, "Model" -> modelSpec, Nothing],
      If[timeout =!= Automatic, "Timeout" -> timeout, Nothing]|>;
    
    (* ContinuationInput \:3092 instruction \:306b\:66f4\:65b0\:3057\:3066\:65b0 turn \:8d77\:52d5 *)
    Module[{cur = ClaudeRuntime`Private`$iClaudeRuntimes[runtimeId]},
      If[AssociationQ[cur],
        cur["ContinuationInput"] = instruction;
        cur["Status"] = "Done"; (* Done \:306b\:30ea\:30bb\:30c3\:30c8\:3057\:3066\:65b0 turn \:3092\:53d7\:3051\:5165\:308c\:53ef\:80fd\:306b *)
        (* Metadata \:3092\:66f4\:65b0: \:65b0 Job \:3068\:8868\:793a\:30d1\:30e9\:30e1\:30fc\:30bf *)
        cur["Metadata"] = <|
          "NotebookCallback" -> Function[{rid},
            iRuntimeDisplayResult[nb, tag, rid]],
          "Notebook"      -> nb,
          "Tag"           -> tag,
          "JobId"         -> jobId,
          "AutoEvaluate"  -> autoEvaluate,
          "AccessLevel"   -> accessLevel,
          "Step"          -> step,
          "ContinueOpts"  -> copts,
          "CellCountBefore" -> NBAccess`NBCellCount[nb],
          "AutoMark"      -> iShouldBlanketMarkConfidential[accessLevel, privSpec],
          "StartTime"     -> AbsoluteTime[]
        |>;
        ClaudeRuntime`Private`$iClaudeRuntimes[runtimeId] = cur]];
    
    (* \[HorizontalLine]\[HorizontalLine] WindowStatusArea \:306b\:7d99\:7d9a\:30b9\:30c6\:30fc\:30bf\:30b9\:8868\:793a \[HorizontalLine]\[HorizontalLine] *)
    Quiet[CurrentValue[nb, WindowStatusArea] =
      iL["ClaudeRuntime: \:7d99\:7d9a\:30bf\:30fc\:30f3\:6e96\:5099\:4e2d...",
         "ClaudeRuntime: Preparing continuation..."]];
    
    ClaudeRuntime`ClaudeRunTurn[runtimeId, instruction, "Notebook" -> nb];
    
    Null (* \:5373\:5ea7\:306b return \[LongDash] Out[] \:30bb\:30eb\:975e\:8868\:793a *)
  ];

(* \[HorizontalLine]\[HorizontalLine] \:65e7 ClaudeEval \:4e92\:63db: \:7d50\:679c\:8868\:793a \[HorizontalLine]\[HorizontalLine]
   DAG \:306e onComplete \[RightArrow] iOnTurnComplete \[RightArrow] NotebookCallback \:7d4c\:7531\:3067\:547c\:3070\:308c\:308b\:3002
   \:30d5\:30ed\:30f3\:30c8\:30a8\:30f3\:30c9\:3092\:30d6\:30ed\:30c3\:30af\:3057\:306a\:3044\:3002
   
   \:65e7 evalCallback (iClaudeEvalImpl \:5185) \:3068\:540c\:7b49\:306e\:30bb\:30eb\:66f8\:304d\:8fbc\:307f\:30ed\:30b8\:30c3\:30af:
   1. \:30c6\:30ad\:30b9\:30c8\:90e8\:5206 \[RightArrow] iTeXMathToCell \[RightArrow] Text \:30bb\:30eb
   2. \:30b3\:30fc\:30c9\:30d6\:30ed\:30c3\:30af \[RightArrow] FEParser \[RightArrow] BoxData \[RightArrow] Input \:30bb\:30eb
   3. NBEvaluatePreviousCell \[RightArrow] \:81ea\:52d5\:8a55\:4fa1
   4. iIsAutoEvalProhibited \[RightArrow] \:30bb\:30ad\:30e5\:30ea\:30c6\:30a3\:30ac\:30fc\:30c9
   5. ContinueEval \:30dc\:30bf\:30f3\:66f8\:304d\:8fbc\:307f
   6. Job \:30b7\:30b9\:30c6\:30e0\:3067\:30bb\:30eb\:914d\:7f6e\:7ba1\:7406
   7. \:30bb\:30c3\:30b7\:30e7\:30f3\:5c65\:6b74\:66f4\:65b0
*)

iRuntimeDisplayResult[nb_NotebookObject, tag_String,
    runtimeId_String] :=
  Module[{st, status, meta, jobId, ae, autoMark, ccBefore, copts, step,
          response, textOnly, blocks, queue = {}, fallbackCode, lines,
          effectiveAE, isAfterDaemon = False, lastTurnIsTextOnly = False,
          lastTurnRenderedByPhase20 = False, beforeCells = {}},
    
    (* RuntimeState \:76f4\:63a5\:53c2\:7167\:ff08KeyDrop \:7248\:3067\:306f\:306a\:304f\:5168\:4f53\:ff09 *)
    st = ClaudeRuntime`Private`$iClaudeRuntimes[runtimeId];
    If[!AssociationQ[st], Return[]];
    status = Lookup[st, "Status", "?"];
    meta   = Lookup[st, "Metadata", <||>];
    
    (* WindowStatusArea: \:7d50\:679c\:8868\:793a\:4e2d *)
    Quiet[CurrentValue[nb, WindowStatusArea] =
      iL["ClaudeRuntime: \:7d50\:679c\:8868\:793a\:4e2d...",
         "ClaudeRuntime: Displaying results..."]];
    
    (* Metadata \:304b\:3089\:8868\:793a\:30d1\:30e9\:30e1\:30fc\:30bf\:53d6\:5f97 *)
    jobId    = Lookup[meta, "JobId", ""];
    ae       = TrueQ[Lookup[meta, "AutoEvaluate", True]];
    autoMark = TrueQ[Lookup[meta, "AutoMark", False]];
    ccBefore = Lookup[meta, "CellCountBefore", 0];
    copts    = Lookup[meta, "ContinueOpts", <||>];
    step     = Lookup[meta, "Step", 0];
    
    (* AwaitingApproval \[RightArrow] \:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:5185\:306b\:627f\:8a8d UI \:3092\:66f8\:304d\:8fbc\:307f *)
    If[status === "AwaitingApproval",
      Module[{pending, valResult, isDenyOverride, reasonClass,
              explanation, heldExpr, exprStr, approvalUI, kind,
              expSec, defTimeout, rawCode, approvalTag},
        pending = Lookup[st, "PendingApproval", <||>];
        valResult = Lookup[pending, "ValidationResult", <||>];
        isDenyOverride = TrueQ[Lookup[pending, "DenyOverride", False]];
        reasonClass = Lookup[valResult, "ReasonClass", "Unknown"];
        explanation = Lookup[valResult, "VisibleExplanation", ""];
        heldExpr = Lookup[Lookup[pending, "Proposal", <||>], "HeldExpr", None];
        rawCode = Lookup[Lookup[pending, "Proposal", <||>], "RawCode", ""];
        exprStr  = If[heldExpr =!= None,
          StringTake[ToString[heldExpr, InputForm], UpTo[500]],
          If[StringQ[rawCode] && rawCode =!= "", rawCode, "(no expression)"]];
        (* Phase 30 (2026-05-13): TimeoutExtension \:6587\:8108\:3092\:8b58\:5225 *)
        kind = Lookup[pending, "Kind", None];
        expSec = Lookup[pending, "ExpectedSeconds", None];
        defTimeout = Lookup[pending, "DefaultTimeoutSeconds", 30];
        (* Phase 30 (2026-05-13): \:8a72\:5f53 runtime \:5c02\:7528\:30bf\:30b0\:3002
           \:518d AwaitingApproval \:6642\:306b\:53e4\:3044\:30bb\:30eb\:3092\:524a\:9664\:3057\:3066\:4ed8\:3051\:76f4\:3059\:3002 *)
        approvalTag = "claudecode-approval-" <> runtimeId;
        Quiet @ NBAccess`NBDeleteCellsByTag[nb, approvalTag];
        
        (* 2026-06-24 (B-fix): 承認 UI は必ず *セル境界* へ書く。
           NBJobMoveToAnchor は jobId が $NBJobTable に無い (kernel restart 等) /
           アンカーセル消失で無言の no-op になり得る。その場合に選択位置が直前の
           出力セル内容に残ったまま NBWriteCell すると、直前が編集可能 Grid
           (SourceVaultMailView 一覧) のとき承認セルが Grid のサマリー列セル内へ
           \!\(\*Cell[...]\) として埋め込まれる (result2.nb で観測)。
           アンカー移動が成功しなければノートブック末尾 (セル境界) へ退避する。 *)
        If[StringQ[jobId] && jobId =!= "",
          If[! TrueQ[NBAccess`NBJobMoveToAnchor[jobId]],
            Quiet[SelectionMove[nb, After, Notebook, AutoScroll -> False]]];
          $iJobActiveNb = nb,
          Quiet[SelectionMove[nb, After, Notebook, AutoScroll -> False]]];

        (* \:691c\:8a3c\:7d50\:679c\:306e\:60c5\:5831\:8868\:793a *)
        If[isDenyOverride,
          NBAccess`NBWriteCell[nb, Cell[
            iL["\:26a0\:fe0f \:5b89\:5168\:691c\:8a3c\:3067\:62d2\:5426: ",
               "\:26a0\:fe0f Denied by safety check: "] <> reasonClass <>
            If[explanation =!= "", " \[LongDash] " <> explanation, ""],
            "Text",
            FontColor -> RGBColor[0.8, 0, 0],
            FontSize -> 11,
            CellTags -> {"claudecode-notice", approvalTag}]],
          NBAccess`NBWriteCell[nb, Cell[
            iL["\:2753 \:627f\:8a8d\:304c\:5fc5\:8981: ",
               "\:2753 Approval required: "] <> reasonClass <>
            If[explanation =!= "", " \[LongDash] " <> explanation, ""],
            "Text",
            FontColor -> RGBColor[0.7, 0.5, 0],
            FontSize -> 11,
            CellTags -> {"claudecode-notice", approvalTag}]]];
        
        (* Phase 30 (2026-05-13): TimeoutExtension \:306e\:5834\:5408\:3001\:8a73\:7d30\:8abf\:67fb\:30b3\:30de\:30f3\:30c9 \:3068
           \:30bf\:30a4\:30e0\:30a2\:30a6\:30c8\:4e88\:6e2c\:60c5\:5831\:3092\:8868\:793a *)
        If[kind === "TimeoutExtension",
          NBAccess`NBWriteCell[nb, Cell[
            iL["\:23f1 LLM \:63d0\:6848: " <> ToString[expSec] <>
                 " \:79d2 (\:73fe\:5728\:306e\:8a2d\:5b9a: " <> ToString[defTimeout] <> " \:79d2)",
               "\:23f1 LLM proposes: " <> ToString[expSec] <>
                 "s (current default: " <> ToString[defTimeout] <> "s)"],
            "Text", FontSize -> 10, FontWeight -> Bold,
            FontColor -> RGBColor[0.5, 0.3, 0],
            CellTags -> {"claudecode-notice", approvalTag}]];
          (* \:8a73\:7d30\:8abf\:67fb\:30b3\:30de\:30f3\:30c9\:3092 Code \:30bb\:30eb\:3068\:3057\:3066\:51fa\:529b
             (\:30af\:30ea\:30c3\:30af\:3057\:3066\:8a55\:4fa1\:3057\:3066\:8abf\:67fb\:53ef\:80fd) *)
          NBAccess`NBWriteCell[nb, Cell[
            iL["\:8a73\:7d30\:8abf\:67fb (\:30b3\:30d4\:30fc/\:8a55\:4fa1):",
               "Inspection commands (copy/evaluate):"],
            "Text", FontSize -> 9, FontColor -> GrayLevel[0.4],
            CellTags -> {"claudecode-notice", approvalTag}]];
          NBAccess`NBWriteCell[nb, Cell[
            "ClaudeTurnTrace[\"" <> runtimeId <> "\"]\nshowLLMCallLog[]",
            "Code", FontSize -> 9,
            Background -> RGBColor[0.95, 0.95, 1.0],
            CellTags -> {"claudecode-notice", approvalTag}]];
          (* \:30bf\:30a4\:30e0\:30a2\:30a6\:30c8\:3057\:305f\:30b3\:30fc\:30c9\:3092 Closed \:30bb\:30eb\:30b0\:30eb\:30fc\:30d7\:3067\:51fa\:529b
             (\:30af\:30ea\:30c3\:30af\:3067\:5c55\:958b\:3067\:304d\:308b) *)
          If[StringQ[rawCode] && rawCode =!= "",
            NBAccess`NBWriteCell[nb, Cell[
              CellGroupData[{
                Cell[iL["LLM \:63d0\:6848\:30b3\:30fc\:30c9\:5168\:6587 (\:30af\:30ea\:30c3\:30af\:3067\:5c55\:958b):",
                       "Full LLM proposal code (click to expand):"],
                  "Subsection", FontSize -> 9,
                  FontColor -> GrayLevel[0.4]],
                Cell[rawCode, "Code", FontSize -> 9,
                  Background -> RGBColor[1.0, 0.97, 0.9],
                  CellTags -> {"claudecode-notice", approvalTag}]
              }, Closed],
              CellTags -> {"claudecode-notice", approvalTag}]]]
        ];
        
        (* \:5f0f\:306e\:8868\:793a (1\:884c\:8981\:7d04\:8868\:793a) *)
        NBAccess`NBWriteCell[nb, Cell[
          exprStr, "Input",
          Editable -> False,
          CellLabel -> If[isDenyOverride, "Denied", "NeedsApproval"],
          Background -> If[isDenyOverride,
            RGBColor[0.94, 0.92, 1.0],
            RGBColor[1, 0.98, 0.92]],
          CellTags -> {approvalTag}]];
        
        (* \:627f\:8a8d/\:62d2\:5426\:30dc\:30bf\:30f3 *)
        approvalUI = With[{rid = runtimeId, nbObj = nb, tg = tag,
            jd = jobId, aeVal = ae,
            isDeny = isDenyOverride,
            isTimeoutExt = (kind === "TimeoutExtension"),
            expSecVal = expSec},
          DynamicModule[{decided = False},
            If[isTimeoutExt,
              (* Phase 30: 3 \:30dc\:30bf\:30f3 (\:4e88\:60f3\:6642\:9593\:3067\:518d\:5b9f\:884c / \:30bf\:30a4\:30e0\:30a2\:30a6\:30c8\:89e3\:9664 / \:4e2d\:6b62) *)
              Row[{
                Button[
                  Column[{
                    Style[iL["\:4e88\:60f3\:6642\:9593\:3067\:518d\:5b9f\:884c",
                             "Run with expected time"], Bold, 9],
                    Style["(" <> ToString[expSecVal] <> "s)", 8,
                      FontColor -> GrayLevel[0.4]]
                  }, Alignment -> Center, Spacings -> 0.1],
                  If[!decided,
                    decided = True;
                    (* Phase 30 fix: \:975e\:540c\:671f\:5316 - ScheduledTask \:3067\:30d5\:30ed\:30f3\:30c8\:30a8\:30f3\:30c9\:3092\:30d6\:30ed\:30c3\:30af\:3057\:306a\:3044 *)
                    Quiet[CurrentValue[nbObj, WindowStatusArea] =
                      iL["ClaudeRuntime: \:518d\:5b9f\:884c\:4e2d (timeout=" <> ToString[expSecVal] <> "s)...",
                         "ClaudeRuntime: Re-executing (timeout=" <> ToString[expSecVal] <> "s)..."]];
                    SessionSubmit[ScheduledTask[
                      Module[{result, st2},
                        result = Quiet @ ClaudeRuntime`ClaudeApproveProposalWithTimeout[
                          rid, expSecVal];
                        st2 = ClaudeRuntime`Private`$iClaudeRuntimes[rid];
                        If[AssociationQ[st2],
                          iRuntimeDisplayResult[nbObj, tg, rid]];
                        Quiet[CurrentValue[nbObj, WindowStatusArea] = ""]
                      ],
                      {0.3, 1}]]],
                  Enabled -> Dynamic[!decided, SynchronousUpdating -> False],
                  ImageSize -> {130, 38},
                  Background -> Darker[Green, 0.3],
                  Method -> "Queued"],
                Spacer[8],
                Button[
                  Column[{
                    Style[iL["\:30bf\:30a4\:30e0\:30a2\:30a6\:30c8\:89e3\:9664",
                             "Disable timeout"], Bold, 9],
                    Style["(\[Infinity])", 8, FontColor -> GrayLevel[0.4]]
                  }, Alignment -> Center, Spacings -> 0.1],
                  If[!decided,
                    decided = True;
                    Quiet[CurrentValue[nbObj, WindowStatusArea] =
                      iL["ClaudeRuntime: \:518d\:5b9f\:884c\:4e2d (timeout=\[Infinity])...",
                         "ClaudeRuntime: Re-executing (timeout=\[Infinity])..."]];
                    SessionSubmit[ScheduledTask[
                      Module[{result, st2},
                        result = Quiet @ ClaudeRuntime`ClaudeApproveProposalWithTimeout[
                          rid, Infinity];
                        st2 = ClaudeRuntime`Private`$iClaudeRuntimes[rid];
                        If[AssociationQ[st2],
                          iRuntimeDisplayResult[nbObj, tg, rid]];
                        Quiet[CurrentValue[nbObj, WindowStatusArea] = ""]
                      ],
                      {0.3, 1}]]],
                  Enabled -> Dynamic[!decided, SynchronousUpdating -> False],
                  ImageSize -> {130, 38},
                  Background -> RGBColor[0.9, 0.6, 0],
                  Method -> "Queued"],
                Spacer[8],
                Button[
                  Style[iL["\:5b9f\:884c\:505c\:6b62", "Stop"], Bold, 9],
                  If[!decided,
                    decided = True;
                    Quiet @ ClaudeRuntime`ClaudeDenyProposal[rid];
                    NBAccess`NBWritePrintNotice[nbObj,
                      iL["\:26d4 \:30e6\:30fc\:30b6\:30fc\:304c\:5b9f\:884c\:3092\:62d2\:5426\:3057\:307e\:3057\:305f\:3002",
                         "\:26d4 User cancelled the execution."],
                      RGBColor[0.8, 0.5, 0]];
                    If[StringQ[jd] && jd =!= "",
                      $iJobActiveNb = None;
                      NBAccess`NBEndJob[jd]];
                    Quiet[CurrentValue[nbObj, WindowStatusArea] = ""]],
                  Enabled -> Dynamic[!decided, SynchronousUpdating -> False],
                  ImageSize -> {100, 38},
                  Method -> "Queued"]
              }, Spacer[8]],
              (* \:5f93\:6765\:306e 2 \:30dc\:30bf\:30f3 UI (NeedsApproval / DenyOverride) *)
              Row[{
                Button[
                  Style[If[isDeny,
                    iL["\:5b9f\:884c\:3059\:308b", "Execute Anyway"],
                    iL["\:627f\:8a8d", "Approve"]], Bold],
                  If[!decided,
                    decided = True;
                    (* Phase 30 fix: \:975e\:540c\:671f\:5316 *)
                    Quiet[CurrentValue[nbObj, WindowStatusArea] =
                      iL["ClaudeRuntime: \:5b9f\:884c\:4e2d...",
                         "ClaudeRuntime: Executing..."]];
                    (* 承認 wrapper context 修正 (2026-06-03): SystemOpen 等の
                       desktop action は SessionSubmit/ScheduledTask 系では効かず、
                       メインカーネルのトップレベル評価 (= このボタン本体) でのみ
                       効く。承認済みなのでここでパス検証だけ NBAccess に委ね、
                       検証 OK なら raw SystemOpen をボタン本体で直接呼ぶ。
                       重い処理は従来通り SessionSubmit へ。 *)
                    Module[{rtNow, pend, heldE, accS, deskInfo, handledHere},
                      handledHere = False;
                      rtNow = Quiet @ Check[
                        ClaudeRuntime`Private`$iClaudeRuntimes[rid], None];
                      If[AssociationQ[rtNow] &&
                         AssociationQ[Lookup[rtNow, "PendingApproval", None]],
                        pend = rtNow["PendingApproval"];
                        heldE = Lookup[Lookup[pend, "Proposal", <||>],
                          "HeldExpr", None];
                        accS = Quiet @ Check[
                          NBAccess`NBMakeRuntimeAccessSpec[
                            Lookup[pend, "ContextPacket", <||>], "Committer"],
                          <|"PermissionMode" -> "InteractiveSafe"|>];
                        If[MatchQ[heldE, HoldComplete[_]] &&
                           !TrueQ[Quiet @ Check[
                             ClaudeRuntime`ClaudeRuntimeAsyncActiveQ[], False]],
                          deskInfo = Quiet @ Check[
                            NBAccess`NBResolveDesktopActionPath[heldE, accS],
                            <|"IsDesktopAction" -> False|>];
                          If[TrueQ[Lookup[deskInfo, "IsDesktopAction", False]] &&
                             TrueQ[Lookup[deskInfo, "Validated", False]],
                            (* メインカーネル評価コンテキストで raw SystemOpen *)
                            Quiet @ Check[
                              SystemOpen[Lookup[deskInfo, "Path", ""]], Null];
                            (* runtime を Done にし承認状態を消費 *)
                            Quiet @ Check[
                              ClaudeRuntime`ClaudeMarkApprovalConsumed[rid,
                                "FinalActionExecutedInline"], Null];
                            handledHere = True;
                            Quiet[CurrentValue[nbObj, WindowStatusArea] = ""]]]];
                      If[!handledHere,
                        SessionSubmit[ScheduledTask[
                          Module[{result, st2},
                            result = Quiet @ ClaudeRuntime`ClaudeApproveProposal[rid];
                            st2 = ClaudeRuntime`Private`$iClaudeRuntimes[rid];
                            If[AssociationQ[st2],
                              iRuntimeDisplayResult[nbObj, tg, rid]];
                            Quiet[CurrentValue[nbObj, WindowStatusArea] = ""]
                          ],
                          {0.3, 1}]]]]],
                  Enabled -> Dynamic[!decided, SynchronousUpdating -> False],
                  ImageSize -> {If[isDeny, 110, 80], 28},
                  Background -> If[isDeny,
                    RGBColor[0.9, 0.6, 0],
                    Darker[Green, 0.3]],
                  Method -> "Queued"],
                Spacer[12],
                Button[
                  iL["\:4e2d\:6b62", "Cancel"],
                  If[!decided,
                    decided = True;
                    Quiet @ ClaudeRuntime`ClaudeDenyProposal[rid];
                    NBAccess`NBWritePrintNotice[nbObj,
                      iL["\:26d4 \:30e6\:30fc\:30b6\:30fc\:304c\:5f0f\:306e\:5b9f\:884c\:3092\:62d2\:5426\:3057\:307e\:3057\:305f\:3002",
                         "\:26d4 User denied the proposed expression."],
                      RGBColor[0.8, 0.5, 0]];
                    If[StringQ[jd] && jd =!= "",
                      $iJobActiveNb = None;
                      NBAccess`NBEndJob[jd]];
                    Quiet[CurrentValue[nbObj, WindowStatusArea] = ""]],
                  Enabled -> Dynamic[!decided, SynchronousUpdating -> False],
                  ImageSize -> {80, 28},
                  Method -> "Queued"]
              }, Spacer[8]]
            ]
          ]];
        
        NBAccess`NBWriteCell[nb, Cell[
          BoxData[ToBoxes[approvalUI]],
          "Output",
          CellMargins -> {{66, 0}, {4, 4}},
          Editable -> False,
          CellTags -> {approvalTag}]];
        
        If[StringQ[jobId] && jobId =!= "",
          NBAccess`NBJobResetSlotWritten[jobId, 1];
          $iJobActiveNb = None];
        Quiet[CurrentValue[nb, WindowStatusArea] =
          iL["ClaudeRuntime: \:627f\:8a8d\:5f85\:3061...",
             "ClaudeRuntime: Awaiting approval..."]];
        Return[]]];
    
    (* \[HorizontalLine]\[HorizontalLine] \:751f\:30ec\:30b9\:30dd\:30f3\:30b9\:306e\:53d6\:5f97 \[HorizontalLine]\[HorizontalLine]
       LastProposal["TextResponse"] \:306f LLM \:306e\:751f\:30ec\:30b9\:30dd\:30f3\:30b9\:5168\:4f53
       \:ff08\:30c6\:30ad\:30b9\:30c8 + \:30b3\:30fc\:30c9\:30d6\:30ed\:30c3\:30af\:3092\:542b\:3080\:ff09\:3002
       \:65e7 evalCallback \:306e response \:5f15\:6570\:3068\:540c\:7b49\:3002 *)
    response = None;
    Module[{lastProp = Lookup[st, "LastProposal", <||>]},
      If[AssociationQ[lastProp],
        response = Lookup[lastProp, "TextResponse", None]]];
    (* \:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af: ConversationState Messages \:304b\:3089 *)
    If[!StringQ[response],
      Module[{msgs = Lookup[Lookup[st, "ConversationState", <||>],
                "Messages", {}]},
        If[Length[msgs] > 0,
          response = Lookup[Last[msgs], "TextResponse", None]]]];
    
    (* \[HorizontalLine]\[HorizontalLine] \:5931\:6557\:6642\:306e\:8868\:793a \[HorizontalLine]\[HorizontalLine] *)
    If[status === "Failed",
      Module[{failDetail = Lookup[st, "LastFailure", <||>], errMsg,
              isTimeout},
        If[StringQ[jobId] && jobId =!= "",
          NBAccess`NBJobMoveToAnchor[jobId];
          $iJobActiveNb = nb];
        errMsg = Lookup[failDetail, "ReasonClass",
          Lookup[failDetail, "Error",
            iL["\:4e0d\:660e", "Unknown"]]];
        NBAccess`NBWritePrintNotice[nb,
          iL["\:26a0\:fe0f ClaudeRuntime: \:5931\:6557 - ",
             "\:26a0\:fe0f ClaudeRuntime: Failed - "] <> errMsg,
          RGBColor[0.8, 0, 0]];
        
        (* Phase C-lite (2026-06-03, spec 5A.9): Deny の場合は拒否理由
           (VisibleExplanation) を併記する。承認 UI (実行/中止ボタン) は
           出さない。これにより「Deny なのにボタンが出て押しても実行されない」
           問題を解消する。 *)
        If[AssociationQ[failDetail] &&
           Lookup[failDetail, "Decision", ""] === "Deny",
          Module[{expl = Lookup[failDetail, "VisibleExplanation", ""]},
            If[StringQ[expl] && expl =!= "",
              NBAccess`NBWriteCell[nb, Cell[
                iL["\:5b89\:5168\:691c\:8a3c\:3067\:62d2\:5426: ", "Denied by safety check: "] <> expl,
                "Text", FontColor -> RGBColor[0.8, 0, 0], FontSize -> 11,
                CellTags -> "claudecode-notice"]]]]];
        
        (* Phase 29 (2026-05-13): \:30bf\:30a4\:30e0\:30a2\:30a6\:30c8\:6642\:306f\:5b9f\:884c\:3055\:308c\:305f\:30b3\:30fc\:30c9\:3068\:8abf\:67fb\:30dc\:30bf\:30f3\:3092\:8868\:793a\:3002
           Imai \:5148\:751f\:6307\:91dd: \:300c\:77e5\:308a\:305f\:3044\:306e\:306f\:5b9f\:969b\:306b\:30bf\:30a4\:30e0\:30a2\:30a6\:30c8\:3057\:305f\:30b3\:30fc\:30c9\:300d *)
        isTimeout = StringQ[errMsg] && StringContainsQ[errMsg, "timed out"];
        If[isTimeout,
          Module[{lastProp, rawCode, rid},
            lastProp = Lookup[st, "LastProposal", <||>];
            rawCode = If[AssociationQ[lastProp],
              Lookup[lastProp, "RawCode", ""], ""];
            rid = runtimeId;
            (* \:30bf\:30a4\:30e0\:30a2\:30a6\:30c8\:3057\:305f\:30b3\:30fc\:30c9\:3092\:305d\:306e\:307e\:307e\:30bb\:30eb\:306b\:8868\:793a *)
            If[StringQ[rawCode] && rawCode =!= "",
              NBAccess`NBWriteCell[nb,
                Cell[iL["\:30bf\:30a4\:30e0\:30a2\:30a6\:30c8\:3057\:305f\:30b3\:30fc\:30c9 (LLM \:63d0\:6848):",
                       "Code that timed out (LLM proposal):"],
                  "Text", FontSize -> 10, FontWeight -> Bold,
                  FontColor -> RGBColor[0.5, 0.3, 0]]];
              NBAccess`NBWriteCell[nb,
                Cell[rawCode, "Code", FontSize -> 10,
                  Background -> RGBColor[1.0, 0.97, 0.9],
                  CellTags -> "claudecode-notice"]]];
            (* \:8abf\:67fb\:30b3\:30de\:30f3\:30c9\:3092\:30b9\:30cb\:30da\:30c3\:30c8\:3068\:3057\:3066\:8868\:793a (Button \:3067\:306f\:306a\:304f static \:30c6\:30ad\:30b9\:30c8\:3001
               \:30b3\:30d4\:30fc\:3057\:3066\:8a55\:4fa1\:53ef\:80fd) *)
            NBAccess`NBWriteCell[nb,
              Cell[iL["\:8a73\:7d30\:8abf\:67fb (\:30b3\:30d4\:30fc\:3057\:3066\:8a55\:4fa1):",
                     "Inspection commands (copy and evaluate):"],
                "Text", FontSize -> 9, FontColor -> GrayLevel[0.4]]];
            NBAccess`NBWriteCell[nb,
              Cell["ClaudeTurnTrace[\"" <> rid <> "\"]\nshowLLMCallLog[]",
                "Code", FontSize -> 9,
                Background -> RGBColor[0.95, 0.95, 1.0],
                CellTags -> "claudecode-notice"]]
          ]
        ];
        
        If[StringQ[jobId] && jobId =!= "",
          $iJobActiveNb = None;
          NBAccess`NBEndJob[jobId]];
        (* \:30bb\:30c3\:30b7\:30e7\:30f3\:5c65\:6b74\:66f4\:65b0 *)
        iSessionUpdateLast[nb, tag, <|
          "response" -> If[StringQ[response], response,
            "Error: " <> Lookup[failDetail, "ReasonClass", "?"]],
          "code" -> "",
          "cellCountAfter" -> NBAccess`NBCellCount[nb]|>]];
      (* Phase 28: \:5931\:6557\:6642\:3067\:3082\:30bf\:30fc\:30f3\:30ce\:30fc\:30c9\:3092\:30b0\:30e9\:30d5\:306b\:8a18\:9332\:3057 DAG \:63a5\:7d9a\:3092\:78ba\:4fdd *)
      Quiet @ iRuntimeRecordTurnToLLMGraph[nb, runtimeId, st, tag, step];
      Quiet[CurrentValue[nb, WindowStatusArea] = ""];
      Return[]];
    
    (* \:30ec\:30b9\:30dd\:30f3\:30b9\:304c\:306a\:3044\:5834\:5408 *)
    If[!StringQ[response] || response === "",
      If[status === "Done",
        If[StringQ[jobId] && jobId =!= "",
          NBAccess`NBJobMoveToAnchor[jobId];
          $iJobActiveNb = nb;
          NBAccess`NBWritePrintNotice[nb,
            iL["ClaudeRuntime: \:5b8c\:4e86",
               "ClaudeRuntime: Completed"],
            RGBColor[0.3, 0.6, 0.3]];
          $iJobActiveNb = None;
          NBAccess`NBEndJob[jobId]]];
      (* Phase 28: \:30ec\:30b9\:30dd\:30f3\:30b9\:306a\:3057\:6642\:3082\:30bf\:30fc\:30f3\:30ce\:30fc\:30c9\:3092\:30b0\:30e9\:30d5\:306b\:8a18\:9332 *)
      Quiet @ iRuntimeRecordTurnToLLMGraph[nb, runtimeId, st, tag, step];
