(* \:73fe\:5728\:72b6\:614b\:306e\:30ad\:30e3\:30c3\:30b7\:30e5 (\:30d1\:30ec\:30c3\:30c8\:30dc\:30bf\:30f3\:8868\:793a\:7528) *)
