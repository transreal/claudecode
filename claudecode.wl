      Do[
        Module[{c = cells[[i]],
                idx = Lookup[cells[[i]], "CellIndex", i],
                style = Lookup[cells[[i]], "CellStyle", "?"],
                text = StringTake[
                  Lookup[cells[[i]], "InputText",
                    Lookup[cells[[i]], "CellText", ""]], UpTo[200]]},
          AppendTo[parts,
            "Cell[" <> ToString[idx] <> ", " <> style <> "]: " <>
            StringReplace[text, "\n" -> " "] <> "\n"]],
        {i, Min[10, Length[cells]]}];
      If[Length[cells] > 10,
        AppendTo[parts, "... and " <> ToString[Length[cells] - 10] <> " more\n"]];
      AppendTo[parts, "\n"]];
    
    If[nbCtxMode =!= "None" && Length[selectedIdx] > 0,
      AppendTo[parts, "Selected cells: " <> ToString[selectedIdx] <> "\n\n"]];
    
    (* \[HorizontalLine]\[HorizontalLine] \:30de\:30eb\:30c1\:30bf\:30fc\:30f3\:4f1a\:8a71\:5c65\:6b74\:ff08\:30c8\:30fc\:30af\:30f3\:7ba1\:7406\:4ed8\:304d\:ff09 \[HorizontalLine]\[HorizontalLine] *)
    (* Phase 16: ClaudeRuntime \:306e\:5727\:7e2e\:6e08\:307f Messages \:306b\:5bfe\:5fdc\:3002
       Compacted=True \:306e\:30bf\:30fc\:30f3\:306f 1 \:884c\:8981\:7d04\:3067\:8868\:793a\:3002
       \:305d\:308c\:4ee5\:5916\:306f\:76f4\:8fd1 maxTurnHistoryDetail \:4ef6\:3092\:8a73\:7d30\:8868\:793a\:3002 *)
    If[histCtxMode =!= "None" && Length[turnHistory] > 0,
      AppendTo[parts, "=== Turn History (" <> ToString[Length[turnHistory]] <> " turns) ===\n"];
      Module[{compacted, detailed, nDetail, recentStart},
        (* \:5727\:7e2e\:6e08\:307f\:3068\:975e\:5727\:7e2e\:3092\:5206\:96e2 *)
        compacted = Select[turnHistory, TrueQ[Lookup[#, "Compacted", False]] &];
        detailed  = Select[turnHistory, !TrueQ[Lookup[#, "Compacted", False]] &];
        
        (* \:975e\:5727\:7e2e\:306e\:4e2d\:3067\:3082\:53e4\:3044\:3082\:306e\:306f\:8981\:7d04\:8868\:793a *)
        nDetail = Min[maxTurnHistoryDetail, Length[detailed]];
        recentStart = Max[1, Length[detailed] - nDetail + 1];
        
        (* 1. \:5727\:7e2e\:6e08\:307f\:30bf\:30fc\:30f3\:306e\:8868\:793a *)
        If[Length[compacted] > 0,
          AppendTo[parts, "[Earlier turns compacted]\n"];
          Do[
            Module[{turn = compacted[[i]], turnNum, summary},
              turnNum = Lookup[turn, "Turn", "?"];
              summary = Lookup[turn, "Summary", "(compacted)"];
              AppendTo[parts,
                "Turn " <> ToString[turnNum] <> ": " <>
                StringTake[summary, UpTo[120]] <> "\n"]],
            {i, Length[compacted]}];
          AppendTo[parts, "\n"]];
        
        (* 2. \:53e4\:3044\:975e\:5727\:7e2e\:30bf\:30fc\:30f3\:306e\:8981\:7d04 *)
        If[recentStart > 1,
          AppendTo[parts, "[Earlier detailed turns summarized]\n"];
          Do[
            Module[{turn = detailed[[i]],
                    turnNum, code, execRes, summary},
              turnNum = Lookup[turn, "Turn", i];
              code    = Lookup[turn, "ProposedCode", None];
              execRes = Lookup[turn, "ExecutionResult", None];
              summary = If[AssociationQ[execRes],
                Lookup[execRes, "Summary",
                  Lookup[execRes, "RedactedResult", ""]], ""];
              AppendTo[parts,
                "Turn " <> ToString[turnNum] <> ": " <>
                If[StringQ[code], StringTake[code, UpTo[80]], "(text)"] <>
                " \[RightArrow] " <> StringTake[ToString[summary], UpTo[100]] <> "\n"]],
            {i, recentStart - 1}];
          AppendTo[parts, "\n"]];
        
        (* 3. \:76f4\:8fd1\:30bf\:30fc\:30f3\:306e\:8a73\:7d30 *)
        Do[
          Module[{turn = detailed[[i]],
                  turnNum, code, execRes, textResp, summary,
                  turnToolCalls, turnToolResults},
            turnNum      = Lookup[turn, "Turn", i];
            code         = Lookup[turn, "ProposedCode", None];
            execRes      = Lookup[turn, "ExecutionResult", None];
            textResp     = Lookup[turn, "TextResponse", None];
            turnToolCalls   = Lookup[turn, "ToolCalls", None];
            turnToolResults = Lookup[turn, "ToolResults", None];
            
            AppendTo[parts, "--- Turn " <> ToString[turnNum] <> " ---\n"];
            If[StringQ[code],
              AppendTo[parts, "Proposed:\n```mathematica\n" <>
                StringTake[code, UpTo[500]] <> "\n```\n"]];
            (* \:30c4\:30fc\:30eb\:30bf\:30fc\:30f3\:306e\:8868\:793a *)
            If[ListQ[turnToolCalls] && Length[turnToolCalls] > 0,
              AppendTo[parts, "Tool calls: " <>
                StringRiffle[Map[Lookup[#, "Name", "?"] &, turnToolCalls], ", "] <> "\n"];
              If[ListQ[turnToolResults],
                AppendTo[parts, iToolResultsToPromptText[
                  turnToolCalls, turnToolResults]]]];
            If[StringQ[textResp],
              AppendTo[parts, "Response: " <>
                StringTake[textResp, UpTo[300]] <> "\n"]];
            If[AssociationQ[execRes],
              summary = Lookup[execRes, "Summary",
                Lookup[execRes, "RedactedResult", ""]];
              If[StringQ[summary] && StringLength[summary] > 0,
                AppendTo[parts, "Result: " <>
                  StringTake[summary, UpTo[500]] <> "\n"]]];
            AppendTo[parts, "\n"]],
          {i, Max[1, recentStart], Length[detailed]}]];
      AppendTo[parts, "\n"]];
    (* \:65e7\:4e92\:63db: PreviousResult \:304c\:3042\:308b\:304c TurnHistory \:304c\:306a\:3044\:5834\:5408 *)
    If[histCtxMode =!= "None" && Length[turnHistory] === 0 && AssociationQ[prevResult],
      AppendTo[parts,
        "=== Previous Result ===\n" <>
        Lookup[prevResult, "Summary", ""] <> "\n\n"]];
    
    (* \[HorizontalLine]\[HorizontalLine] \:30bf\:30b9\:30af / \:7d99\:7d9a\:6307\:793a \[HorizontalLine]\[HorizontalLine] *)
    Which[
      AssociationQ[input] && Lookup[input, "Type", ""] === "ToolResult",
        (* \:30c4\:30fc\:30eb\:7d50\:679c\:3092\:6ce8\:5165\:3057\:3066\:6b21\:306e\:30a2\:30af\:30b7\:30e7\:30f3\:3092\:4fc3\:3059\:3002
           Phase 30.6 (2026-04-22): Phase 30.4 \:3067\:300c\:8ffd\:52a0 tool \:3092\:547c\:3076\:306a\:300d\:3068
           \:5f37\:304f\:8a00\:3044\:3059\:304e\:305f\:7d50\:679c\:3001LLM \:304c\:7d50\:679c\:3092\:4fe1\:7528\:3057\:306a\:3044\:30e2\:30fc\:30c9\:306b
           \:9665\:308a\:3001\:8c4a\:5bcc\:306a tool \:7d50\:679c (8000+ \:6587\:5b57) \:3092\:898b\:306a\:304c\:3089
           \:300c\:4e0d\:5341\:5206\:300d\:3068\:5288\:308a\:6368\:3066\:3066\:30cf\:30eb\:30b7\:30cd\:30fc\:30b7\:30e7\:30f3\:3059\:308b\:7834\:7dbb
           (result6b.nb: Automata Studies \:306b\:6368\:3066\:5149\:82b1\:7fc1\:3057) \:304c\:8d77\:304d\:305f\:3002
           
           \:5bfe\:7b56: \:300c\:5f15\:7528\:3057\:3066\:5fdc\:7b54\:305b\:3088\:300d\:3092\:30dd\:30b8\:30c6\:30a3\:30d6\:306b\:660e\:8a18\:3002 *)
        AppendTo[parts,
          iToolResultsToPromptText[
            Lookup[input, "ToolCalls", {}],
            Lookup[input, "ToolResults", {}]]];
        AppendTo[parts,
          "=== Continue Task ===\n" <>
          "Original task: " <> ToString[Lookup[input, "OriginalTask", ""]] <> "\n\n" <>
          "CRITICAL: The tool results above are your authoritative source of " <>
          "information for this task. Your final answer MUST be based on the " <>
          "specific facts (names, dates, acronyms, affiliations, locations, " <>
          "quotes) that appear in those results. Do NOT substitute your own " <>
          "general-knowledge guesses for facts that are already present in the " <>
          "tool output.\n\n" <>
          "Specifically:\n" <>
          "  - If the tool result states an acronym expansion, use THAT expansion, " <>
          "    not one you invented.\n" <>
          "  - If the tool result gives a date, location, or organizer, quote it " <>
          "    faithfully in your final answer.\n" <>
          "  - If the tool result is in Japanese, your final answer should preserve " <>
          "    the Japanese terminology used in the summary.\n\n" <>
          "Your next response should be a COMPREHENSIVE final answer:\n" <>
          "  - A ```mathematica code block (e.g. Column[{...}]) that DISPLAYS the " <>
          "    tool-result facts to the user in an organized way, followed by " <>
          "    [DONE] in text, OR\n" <>
          "  - A detailed plain-text final answer (with [DONE]) that incorporates " <>
          "    the key facts from the tool results.\n\n" <>
          "Call another tool ONLY if:\n" <>
          "  - The user's question has a distinct second sub-question that the " <>
          "    previous tool calls did NOT address at all, or\n" <>
          "  - The previous tool result explicitly says it failed or was empty " <>
          "    (not just 'could be more detailed').\n\n" <>
          "Do NOT call web_search again with a paraphrased or translated version of " <>
          "the same query. Do NOT chain web_fetch calls hoping for 'more detail'. " <>
          "Do NOT claim that 'the search did not return enough information' when " <>
          "the tool results clearly contain the answer. " <>
          "Trust the summary you already have and produce the final answer now, " <>
          "using the facts from the tool output verbatim where appropriate.\n\n" <>
          "It is OK to return FEWER items than requested: if the user asked for N " <>
          "results but the tool output only supports fewer, present the ones you " <>
          "have and add a short note about the shortfall -- that is a COMPLETE, " <>
          "acceptable answer. Do NOT loop: do NOT keep deliberating about whether " <>
          "to search again, and do NOT re-emit a near-identical answer you have " <>
          "already produced. Output exactly ONE final answer and end with [DONE].\n"],
      
      AssociationQ[input] && Lookup[input, "Type", ""] === "Continuation",
        AppendTo[parts,
          "=== Continue Task ===\n" <>
          "Original task: " <> ToString[Lookup[input, "OriginalTask", ""]] <> "\n" <>
          "Based on the results above, write the next Mathematica expression to evaluate,\n" <>
          "or include [DONE] in your text if the task is complete.\n"],
      
      AssociationQ[input] && Lookup[input, "Type", ""] === "RepairRequest",
        (* RepairRequest: \:30d2\:30f3\:30c8\:3092\:30bf\:30b9\:30af\:3068\:3057\:3066\:8868\:793a\:3002
           repair \:8a73\:7d30\:306f\:5f8c\:7d9a\:306e REPAIR REQUEST \:30bb\:30af\:30b7\:30e7\:30f3\:3067\:8ffd\:52a0\:3055\:308c\:308b\:3002 *)
        AppendTo[parts,
          iTaskDetailBlock["Task (format retry)",
            Lookup[input, "Hint",
              "Please write Mathematica code for the task."]]],
      
      True,
        AppendTo[parts, iTaskDetailBlock["Task", ToString[input]]]
    ];
    
    (* \:30b3\:30fc\:30c9\:751f\:6210\:539f\:5247\:30ea\:30de\:30a4\:30f3\:30c0\:30fc *)
    If[AssociationQ[input] && MemberQ[{"Continuation", "ToolResult"}, Lookup[input, "Type", ""]],
      (* Continuation/ToolResult: [DONE] \:30c6\:30ad\:30b9\:30c8\:306e\:307f\:5fdc\:7b54\:3092\:8a31\:53ef *)
      AppendTo[parts,
        "\nREMINDER: If the task is complete, respond with text only and include [DONE].\n" <>
        "If more work is needed, include ```mathematica code blocks.\n" <>
        "Do NOT echo the kernel's previous result as a code block.\n"],
      (* \:521d\:56de\:30bf\:30fc\:30f3\:307e\:305f\:306f RepairRequest: \:30b3\:30fc\:30c9\:5fc5\:9808 *)
      AppendTo[parts,
        "\nREMINDER: Your response MUST include ```mathematica code blocks.\n" <>
        "Write Mathematica expressions that the local kernel evaluates.\n" <>
        "A text-only response without code blocks is NOT acceptable.\n"]
    ];
    
    (* Repair context *)
    If[AssociationQ[input] && Lookup[input, "Type", ""] === "RepairRequest",
      Module[{hint, phase, details, strategy, prevCode, fc},
        hint     = Lookup[input, "Hint", ""];
        phase    = Lookup[input, "FailedPhase", None];
        details  = Lookup[input, "ErrorDetails", None];
        strategy = Lookup[input, "RepairStrategy", "Patch"];
        fc       = Lookup[input, "FailureCount", 0];
        prevCode = If[AssociationQ[Lookup[input, "Previous", None]],
          Lookup[input["Previous"], "RawCode", None], None];
        
        AppendTo[parts, "\n\n=== REPAIR REQUEST ===\n"];
        If[StringQ[phase],
          AppendTo[parts, "Failed phase: " <> phase <> "\n"]];
        If[fc > 0,
          AppendTo[parts, "Failure count: " <> ToString[fc] <> "\n"]];
        AppendTo[parts, "Error: " <> hint <> "\n"];
        
        If[details =!= None,
          AppendTo[parts, "\nError details:\n" <>
            StringTake[ToString[details, InputForm], UpTo[500]] <> "\n"]];
        
        If[StringQ[prevCode],
          AppendTo[parts, "\nPrevious code that failed:\n```mathematica\n" <>
            StringTake[prevCode, UpTo[1000]] <> "\n```\n"]];
        
        If[strategy === "FullReplan",
          AppendTo[parts,
            "\nIMPORTANT: Previous repair attempts failed repeatedly. " <>
            "Please take a completely different approach to solve the task. " <>
            "Do NOT retry the same patch.\n"]];
      ]];
    
    StringJoin[parts]
  ];

