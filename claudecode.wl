   Cancel: \:4e2d\:65ad\:3002 *)
iShowRateLimitActionUI[nb_, rli_Association, runtimeId_, jobId_] :=
  Module[{resetsDate, waitMin, resetsStr = "", actionUI, nbJobId = "",
          moved = False},
    resetsDate = Lookup[rli, "ResetsAt", None];
    If[Head[resetsDate] === DateObject,
      resetsStr = DateString[resetsDate,
        {"Year", "-", "Month", "-", "Day", " ",
         "Hour24", ":", "Minute"}];
      waitMin = Quiet @ Check[
        Round @ QuantityMagnitude[
          UnitConvert[resetsDate - Now, "Minutes"]], None],
      waitMin = None];
    
    (* v2026-04-20 T14: Runtime \:306e Metadata \:304b\:3089 NBAccess \:30b8\:30e7\:30d6 ID \:3092\:53d6\:5f97\:3002
       DAG \:306e jobId (dag-...) \:3068\:306f\:5225\:306e\:3001NBAccess \:5185\:90e8\:306e\:30b8\:30e7\:30d6 ID (cjob...) \:3002
       \:3053\:308c\:3092\:4f7f\:308f\:306a\:3044\:3068 NBJobMoveToAnchor \:304c\:6b63\:3057\:3044\:30bb\:30eb\:4f4d\:7f6e\:306b\:6271\:3048\:305a\:3001
       UI \:304c\:898b\:3048\:306a\:3044\:4f4d\:7f6e (TextData \:30a4\:30f3\:30e9\:30a4\:30f3) \:306b\:66f8\:304b\:308c\:3066\:3057\:307e\:3046\:3002 *)
    If[StringQ[runtimeId],
      Module[{rtState = Quiet @ Check[
          ClaudeRuntime`Private`$iClaudeRuntimes[runtimeId], None]},
        If[AssociationQ[rtState],
          nbJobId = Lookup[Lookup[rtState, "Metadata", <||>],
            "JobId", ""]]]];
    
    (* \:30b8\:30e7\:30d6\:30a2\:30f3\:30ab\:30fc\:4f4d\:7f6e\:306b\:79fb\:52d5 (Approval UI \:3068\:540c\:69d8) *)
    If[StringQ[nbJobId] && nbJobId =!= "",
      Quiet @ Check[NBAccess`NBJobMoveToAnchor[nbJobId], Null];
      $iJobActiveNb = nb;
      moved = True];
    
    (* \:30d8\:30c3\:30c0\:30e1\:30c3\:30bb\:30fc\:30b8\:884c (Approval UI \:3068\:540c\:69d8\:306e\:30b9\:30bf\:30a4\:30eb) *)
    Quiet @ Check[
      NBAccess`NBWriteCell[nb, Cell[
        iL[
          "\:23f1\:fe0f Rate limit active \[LongDash] " <>
            If[resetsStr =!= "",
              "\:89e3\:9664: " <> resetsStr <>
                If[NumericQ[waitMin] && waitMin > 0,
                  " (\:3042\:3068 ~" <> ToString[waitMin] <> " \:5206)", ""],
              "\:89e3\:9664\:6642\:523b\:4e0d\:660e"] <>
            "\:3002CLI \:547c\:3073\:51fa\:3057\:3092\:505c\:6b62\:3057\:307e\:3057\:305f\:3002",
          "\:23f1\:fe0f Rate limit active \[LongDash] " <>
            If[resetsStr =!= "",
              "resets at " <> resetsStr <>
                If[NumericQ[waitMin] && waitMin > 0,
                  " (in ~" <> ToString[waitMin] <> " min)", ""],
              "reset time unknown"] <>
            ". CLI calls stopped."],
        "Text",
        FontColor -> RGBColor[0.8, 0, 0],
        FontSize -> 11]],
      Null];
    
    (* Retry / Cancel \:30dc\:30bf\:30f3 *)
    actionUI = With[{rid = runtimeId, nbObj = nb, jd = jobId,
                     resetD = resetsDate},
      DynamicModule[{decided = False},
        Row[{
          Button[
            Style["Retry", Bold],
            Module[{rliNow, stillLimited = False, resetsNow},
              rliNow = Quiet @ Check[ClaudeRateLimitStatus[], None];
              If[AssociationQ[rliNow],
                resetsNow = Lookup[rliNow, "ResetsAt", None];
                If[Head[resetsNow] === DateObject &&
                   Quiet[Check[resetsNow > Now, False]],
                  stillLimited = True]];
              If[stillLimited,
                (* \:307e\:3060 rate-limit \:4e2d: \:8a66\:884c\:3092\:62d2\:5426\:3057\:3066\:30e1\:30c3\:30bb\:30fc\:30b8 *)
                Quiet @ Check[
                  NBAccess`NBWritePrintNotice[nbObj,
                    iL["\:307e\:3060 rate-limit \:4e2d\:3067\:3059\:3002\:89e3\:9664\:5f8c\:306b\:3082\:3046\:4e00\:5ea6\:3002",
                       "Still rate-limited. Try again after the reset time."],
                    RGBColor[0.8, 0.5, 0]], Null],
                (* Retry \:53ef\:80fd *)
                decided = True;
                If[StringQ[rid],
                  Quiet @ Check[
                    ClaudeRuntime`ClaudeRuntimeRetry[rid], Null]];
                Quiet @ Check[
                  NBAccess`NBWritePrintNotice[nbObj,
                    iL["\:30ea\:30c8\:30e9\:30a4\:3057\:307e\:3057\:305f\:3002",
                       "Retry executed."],
                    Darker[Green, 0.3]], Null]]],
            Enabled -> Dynamic[!decided, SynchronousUpdating -> False],
            ImageSize -> {90, 28},
            Background -> Darker[Green, 0.3],
            Method -> "Queued"],
          Spacer[12],
          Button[
            "Cancel",
            If[!decided,
              decided = True;
              Quiet @ Check[
                NBAccess`NBWritePrintNotice[nbObj,
                  iL["\:30ad\:30e3\:30f3\:30bb\:30eb\:3055\:308c\:307e\:3057\:305f\:3002",
                     "Cancelled."],
                  RGBColor[0.8, 0.5, 0]], Null];
              If[StringQ[jd] && jd =!= "",
                Quiet[$iJobActiveNb = None];
                Quiet @ Check[NBAccess`NBEndJob[jd], Null]]],
            Enabled -> Dynamic[!decided, SynchronousUpdating -> False],
            ImageSize -> {90, 28},
            Method -> "Queued"]
        }, Spacer[8]]]];
    
    Quiet @ Check[
      NBAccess`NBWriteCell[nb, Cell[
        BoxData[ToBoxes[actionUI]],
        "Output",
        CellMargins -> {{66, 0}, {4, 4}},
        Editable -> False]], Null];
    
    (* \:30b8\:30e7\:30d6\:30b9\:30ed\:30c3\:30c8\:30ea\:30bb\:30c3\:30c8 (Approval UI \:3068\:540c\:69d8) *)
    If[moved && StringQ[nbJobId] && nbJobId =!= "",
      Quiet @ Check[
        NBAccess`NBJobResetSlotWritten[nbJobId, 1], Null];
      $iJobActiveNb = None];
    Quiet[CurrentValue[nb, WindowStatusArea] =
      iL["ClaudeRuntime: Rate limit \:7d42\:4e86\:5f85\:3061 (Retry/Cancel)",
         "ClaudeRuntime: Rate limit (Retry/Cancel)"]];
  ];
iShowRateLimitActionUI[___] := Null;

iLLMGraphDAGTick[jobId_String] :=
  Module[{job, nodes, nb, taskDesc, elapsed, doneCount, totalCount,
          pendingIds, runningIds, failedIds, collected, node,
          eligibleIds, catRunning, launched = 0,
          hasFailedDeps = False},
    job = Quiet @ $iLLMGraphDAGJobs[jobId];
    If[!AssociationQ[job],
      KeyDropFrom[$claudeProgress, jobId]; Return[]];
    nodes    = job["nodes"];
    nb       = job["nb"];
    taskDesc = Lookup[job, "taskDescriptor", <||>];
    elapsed  = Round[AbsoluteTime[] - Lookup[job, "startTime", AbsoluteTime[]]];
    totalCount = Length[nodes];

    (* \[HorizontalLine]\[HorizontalLine] v2026-04-20 T12: rate-limit active \:306a\:3089 DAG \:5373\:30ad\:30e3\:30f3\:30bb\:30eb \[HorizontalLine]\[HorizontalLine]
       T10/T11 \:306f Runtime Status \:3084 iRecordFatalFailure \:3092\:7d4c\:7531\:3057\:305f\:304c\:3001
       context \:53c2\:7167\:3084\:30d1\:30c3\:30b1\:30fc\:30b8\:9593\:53c2\:7167\:306e\:554f\:984c\:3067\:52b9\:304b\:306a\:304b\:3063\:305f\:3002
       T12 \:306f\:540c\:30d1\:30c3\:30b1\:30fc\:30b8\:306e\:516c\:958b API \:3067\:3042\:308b ClaudeRateLimitStatus[] \:3092\:76f4\:63a5
       \:547c\:3076\:3060\:3051\:3067\:3001rate-limit \:5185\:5bb9\:3092\:898b\:3066\:5373\:5ea7\:306b DAG \:3092\:30ad\:30e3\:30f3\:30bb\:30eb\:3059\:308b\:3002
       \:3053\:308c\:3067 cascade failure \:306e\:9023\:6253\:3092\:78ba\:5b9f\:306b\:6b62\:3081\:3089\:308c\:308b\:3002 *)
    Module[{rliChk, resetsDateChk, resetsAbsChk},
      rliChk = Quiet @ Check[ClaudeRateLimitStatus[], None];
      If[AssociationQ[rliChk],
        resetsDateChk = Lookup[rliChk, "ResetsAt", None];
        resetsAbsChk = If[Head[resetsDateChk] === DateObject,
          Quiet @ Check[AbsoluteTime[resetsDateChk], None], None];
        If[NumericQ[resetsAbsChk] && resetsAbsChk > AbsoluteTime[],
          (* rate-limit active: \:5168 pending/running \:30ce\:30fc\:30c9\:3092 cancelled \:306b *)
          Scan[Function[nid,
            Module[{nd = nodes[nid]},
              If[AssociationQ[nd] &&
                 MemberQ[{"pending", "running"}, Lookup[nd, "status", ""]],
                nd["status"] = "cancelled";
                nd["error"] = "Rate limit active; node execution skipped";
                nd["result"] = None;
                nodes[nid] = nd]]],
            Keys[nodes]];
          job["nodes"] = nodes;
          job["completedAt"] = AbsoluteTime[];
          (* v2026-04-20 T13: Retry/Cancel UI \:3092\:4e00\:56de\:3060\:3051\:8868\:793a *)
          If[!TrueQ[Lookup[job, "rateLimitUIShown", False]],
            If[nb =!= $Failed,
              Module[{rtCtx = Lookup[Lookup[job, "context", <||>],
                       "runtimeId", None]},
                Quiet @ Check[
                  iShowRateLimitActionUI[nb, rliChk, rtCtx, jobId],
                  Null]]];
            job["rateLimitUIShown"] = True];
          $iLLMGraphDAGJobs[jobId] = job;
          Module[{onComplete = Lookup[job, "onComplete", None]},
            If[onComplete =!= None, Quiet[onComplete[job]]]];
          Quiet @ iLLMGraphDAGRecordHistory[job];
          If[nb =!= $Failed,
            iSafeSetWindowStatus[nb, ""]];
          KeyDropFrom[$claudeProgress, jobId];
          (* v2026-04-20 T16: cancelled \:30b8\:30e7\:30d6\:3082 $iLLMGraphDAGJobs \:304b\:3089\:524a\:9664\:3057\:3066
             \:7d2f\:7a4d\:3092\:9632\:3050\:3002\:30d5\:30ea\:30fc\:30ba\:306e\:4e00\:56e0\:3060\:3063\:305f\:53ef\:80fd\:6027\:3002
             NotebookLLMGraphPlot \:7b49\:3067\:5c65\:6b74\:304c\:5fc5\:8981\:306a\:5834\:5408\:3082
             iLLMGraphDAGRecordHistory \:3067\:65e2\:306b TaggingRules \:306b\:4fdd\:5b58\:6e08\:307f\:3002 *)
          $iLLMGraphDAGJobs = KeyDrop[$iLLMGraphDAGJobs, jobId];
          Return[]]]];

    (* \[HorizontalLine]\[HorizontalLine] v2026-04-20 T10: Runtime \:5931\:6557\:6642\:306e\:65e9\:671f\:505c\:6b62\[HorizontalLine]\[HorizontalLine]
       \:3053\:306e DAG \:304c ClaudeRuntime \:7d4c\:7531\:3067\:3001\:5bfe\:5fdc\:3059\:308b Runtime \:304c
       Status=Failed \:306b\:306a\:3063\:3066\:3044\:305f\:3089\:3001\:6b8b\:308a\:306e\:30ce\:30fc\:30c9\:3092\:5168\:3066
       cancelled \:6271\:3044\:306b\:3057\:3066\:30b8\:30e7\:30d6\:3092\:5373\:4e86\:3059\:308b\:3002
       \:3053\:308c\:306b\:3088\:308a rate-limit \:7b49\:306e Fatal \:304c queryProvider \:3067\:767a\:751f\:3057\:305f\:6642\:3001
       parseProposal / validateProposal / dispatchDecision \:306e\:30ab\:30b9\:30b1\:30fc\:30c9\:5931\:6557
       \:30e1\:30c3\:30bb\:30fc\:30b8\:3092\:6291\:6b62\:3067\:304d\:308b\:3002
       cancelled \:306f failed \:3068\:7570\:306a\:308a Print \:3092\:51fa\:3055\:305a\:3001doneCount \:306b\:542b\:3081\:308b\:3002 *)
    Module[{rtCtx, rtState, rtStatus},
      rtCtx = Lookup[Lookup[job, "context", <||>], "runtimeId", None];
      If[StringQ[rtCtx],
        rtState = Quiet @ Check[
          ClaudeRuntime`Private`$iClaudeRuntimes[rtCtx], None];
        If[AssociationQ[rtState],
          rtStatus = Lookup[rtState, "Status", ""];
          If[rtStatus === "Failed" || rtStatus === "Cancelled",
            Scan[Function[nid,
              Module[{nd = nodes[nid]},
                If[MemberQ[{"pending", "running"}, Lookup[nd, "status", ""]],
                  nd["status"] = "cancelled";
                  nd["error"] = "Runtime " <> rtStatus <>
                    "; node execution skipped";
                  nd["result"] = None;
                  nodes[nid] = nd]]],
              Keys[nodes]];
            job["nodes"] = nodes;
            job["completedAt"] = AbsoluteTime[];
            $iLLMGraphDAGJobs[jobId] = job;
            Module[{onComplete = Lookup[job, "onComplete", None]},
              If[onComplete =!= None, Quiet[onComplete[job]]]];
            Quiet @ iLLMGraphDAGRecordHistory[job];
            If[nb =!= $Failed,
              iSafeSetWindowStatus[nb, ""]];
            KeyDropFrom[$claudeProgress, jobId];
            Return[]]]]];

    (* \[HorizontalLine]\[HorizontalLine] status buckets \:3092\:5358\:4e00\:30d1\:30b9\:3067\:8a08\:7b97 (O(N) \[Times] 1\:56de) \[HorizontalLine]\[HorizontalLine]
       \:65e7\:5b9f\:88c5\:3067\:306f pendingIds/runningIds/failedIds \:306e\:305f\:3073\:306b Keys[nodes] \:3092
       \:5168\:30b9\:30ad\:30e3\:30f3\:3057\:3066\:3044\:305f\:305f\:3081\:3001\:5927\:898f\:6a21 DAG \:3067 tick \:304c\:91cd\:304b\:3063\:305f\:3002 *)
    pendingIds = Internal`Bag[];
    runningIds = Internal`Bag[];
    failedIds  = Internal`Bag[];
    doneCount = 0;
    Scan[With[{k = #, st = Lookup[nodes[#], "status", ""]},
      Which[
        st === "pending", Internal`StuffBag[pendingIds, k],
        st === "running", Internal`StuffBag[runningIds, k],
        st === "failed",  Internal`StuffBag[failedIds, k]; doneCount++,
        st === "done",    doneCount++]] &,
      Keys[nodes]];
    pendingIds = Internal`BagPart[pendingIds, All];
    runningIds = Internal`BagPart[runningIds, All];
    failedIds  = Internal`BagPart[failedIds, All];

    (* \[HorizontalLine]\[HorizontalLine] running \:30ce\:30fc\:30c9\:306e\:30dd\:30fc\:30ea\:30f3\:30b0 \[HorizontalLine]\[HorizontalLine]
       Phase 31.0: \:30bf\:30a4\:30e0\:30a2\:30a6\:30c8\:4f1d\:64ad\:4fee\:6b63
       \:65e7: \:30cf\:30fc\:30c9\:30b3\:30fc\:30c9 600 \:79d2\:3067\:5fc5\:305a KillProcess
       \:65b0: runState["timeout"] \:3092\:5c0a\:91cd (\:306a\:3051\:308c\:3070 Automatic \[RightArrow] $ClaudeTimeout)
       PDFIndex \:7b49\:306e\:65e2\:5b58\:30b8\:30e7\:30d6\:306f runState \:306b "timeout" \:3092\:6301\:305f\:306a\:3044\:306e\:3067
       Automatic \:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:3067 $ClaudeTimeout (= 1200) \:304c\:52b9\:304f\:3002
       ClaudeBuildRuntimeAdapter \:304b\:3089 "Timeout" \:6307\:5b9a\:3092\:4f1d\:642c\:53ef\:80fd\:3002 *)
    Do[
      node = nodes[rid];
      (* v2026-04-20 T19: subJobId \:5f85\:6a5f\:5206\:5c90\:3002
         runState \:306b subJobId \:304c\:3042\:308c\:3070\:3001\:305d\:306e DAG \:30b8\:30e7\:30d6\:306e\:5b8c\:4e86\:3092
         LLMGraphDAGStatus \:3067\:30c1\:30a7\:30c3\:30af\:3059\:308b\:3002
         \:307e\:3060\:5b9f\:884c\:4e2d\:306a\:3089\:4f55\:3082\:3057\:306a\:3044\:3002\:5b8c\:4e86\:3057\:305f\:3089 subCompleteFn (\:3042\:308c\:3070) \:3092\:547c\:3073
         \:305d\:306e\:7d50\:679c\:3092 node \:306e result \:306b\:683c\:7d0d\:3002 *)
      If[AssociationQ[node["runState"]] &&
         StringQ[Lookup[node["runState"], "subJobId", None]],
        Module[{subJobId, subStatus, subCompleteFn, pendingOrRunning},
          subJobId = node["runState"]["subJobId"];
          subCompleteFn = Lookup[node["runState"], "subCompleteFn", None];
          subStatus = LLMGraphDAGStatus[subJobId];
          pendingOrRunning = AssociationQ[subStatus] &&
             Lookup[subStatus, "Pending", 0] + Lookup[subStatus, "Running", 0] > 0;
          If[!pendingOrRunning,
            Module[{outcome, subResult},
              outcome = Which[
                !AssociationQ[subStatus], "JobMissing",
                Lookup[subStatus, "Failed", 0] > 0, "Failed",
                True, "Done"];
              subResult = Quiet @ Check[
                If[subCompleteFn =!= None,
                  subCompleteFn[outcome, subStatus, node["runState"]],
                  <|"Outcome" -> outcome, "SubStatus" -> subStatus|>],
                <|"Outcome" -> outcome, "Error" -> $Failed|>];
              node["status"] = If[outcome === "Done" || outcome === "JobMissing",
                "done", "failed"];
              node["result"] = subResult;
              node["runState"] = None;
              nodes[rid] = node;
              runningIds = DeleteCases[runningIds, rid];
              If[node["status"] === "failed", AppendTo[failedIds, rid]];
              doneCount++
            ]
          ]
        ];
        Continue[]
      ];
      
      collected = iICollectChunkResult[node["runState"],
        Lookup[node["runState"], "timeout", Automatic]];
      If[collected["status"] =!= "Running",
        (* v2026-04-20 T18: parseFn \:30b5\:30dd\:30fc\:30c8\:3002
           runState \:306b "parseFn" \:304c\:3042\:308b\:5834\:5408\:3001Done \:6642\:306b raw \:7d50\:679c\:3092
           parseFn \:306b\:901a\:3057\:3066\:69cb\:9020\:5316\:7d50\:679c\:306b\:5909\:63db\:3059\:308b\:3002
           ClaudeOrchestrator \:306e Plan/Reduce \:30d5\:30a7\:30fc\:30ba\:3092 deferred sync \:5316\:3059\:308b
           \:305f\:3081\:306e\:57fa\:76e4\:3002JSON \:62bd\:51fa\:30fb\:30d1\:30fc\:30b9\:306a\:3069\:3092 tick \:3067\:306a\:304f
           \:4e0a\:4f4d\:30ec\:30a4\:30e4\:30fc\:3067\:884c\:3048\:308b (tick \:306f\:8ef0\:91cf\:3092\:7dad\:6301)\:3002 *)
        Module[{parseFn = Lookup[node["runState"], "parseFn", None],
                rawResult = collected["result"], parsedResult},
          parsedResult = If[collected["status"] === "Done" && parseFn =!= None,
