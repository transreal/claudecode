        byteSize > 200000, Style[iL["警告: コンパクション推奨", "Warning: Compaction recommended"], Orange, Bold],
        byteSize > 100000, Style[iL["注意: やや大きい", "Note: Somewhat large"], RGBColor[0.6, 0.5, 0]],
