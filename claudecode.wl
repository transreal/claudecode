    (* \:5404\:30de\:30c3\:30c1\:306e _ \:3092 X \:306b\:7f6e\:63db *)
    Do[result = StringReplace[result,
        m -> StringReplace[m, "_" -> "X"]],
      {m, matches}];
    result
  ];

