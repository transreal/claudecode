      "Step"    -> "Name",
      "Status"  -> "Status",
      "Access"  -> "AccessLevel",
      "Time"    -> Function[row,
        DateString[row["Time"],
          {"Hour24",":","Minute",":","Second"}]],
      "Detail"  -> "Detail"
    |>];
    Print[Style["SubSteps for " <> nodeID <> ":", Bold]];
    ds
  ];
