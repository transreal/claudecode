        StringJoin[Riffle[
          MapIndexed[Function[{row, idx},
            "Row " <> ToString[First[idx]] <> ": " <>
            StringJoin[Riffle[
              KeyValueMap[Function[{k,v}, ToString[k] <> "=" <> ToString[v]], row],
              ", "]]
          ], sample],
          "\n"]],
    True,
      txt = "Dataset:\n" <> StringTake[ToString[data, InputForm], UpTo[3000]]
