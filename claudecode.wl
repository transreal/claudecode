iRuntimeRetryDispatch[runtimeId_String] :=
  If[ValueQ[ClaudeRuntime`ClaudeRuntimeRetry],
    ClaudeRuntime`ClaudeRuntimeRetry[runtimeId],
    (* ClaudeRuntime.wl \:304c\:672a\:30ed\:30fc\:30c9 \[RightArrow] LLMGraphDAGRetry \:306b\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af *)
    Module[{rt = Quiet @ ClaudeRuntime`Private`$iClaudeRuntimes[runtimeId],
            jobId},
      If[AssociationQ[rt],
        jobId = Lookup[rt, "CurrentJobId", None];
        If[StringQ[jobId] && AssociationQ[Quiet @ $iLLMGraphDAGJobs[jobId]],
          Print[Style[iL[
            "\[WarningSign] ClaudeRuntime.wl \:304c\:672a\:30ed\:30fc\:30c9\:3002LLMGraphDAGRetry \:3067\:4ee3\:66ff\:5b9f\:884c\:3057\:307e\:3059\:3002",
            "\[WarningSign] ClaudeRuntime.wl not loaded. Falling back to LLMGraphDAGRetry."],
            Orange]];
          LLMGraphDAGRetry[jobId],
          Print[Style[iL[
            "\[WarningSign] ClaudeRuntime.wl \:304c\:672a\:30ed\:30fc\:30c9\:3067\:3059\:3002\:5148\:306b\:30ed\:30fc\:30c9\:3057\:3066\:304f\:3060\:3055\:3044\:3002",
            "\[WarningSign] ClaudeRuntime.wl is not loaded. Please load it first."], Red]];
          $Failed],
        Print[Style[iL[
          "\[WarningSign] RuntimeId \:304c\:898b\:3064\:304b\:308a\:307e\:305b\:3093: " <> runtimeId,
          "\[WarningSign] RuntimeId not found: " <> runtimeId], Red]];
        $Failed]]];

(* \[HorizontalLine]\[HorizontalLine] ClaudeRuntimeListSnapshots: Runtime/DAG \:7d71\:5408\:4e00\:89a7 \[HorizontalLine]\[HorizontalLine] *)
ClaudeRuntimeListSnapshots[] :=
  Module[{dirs, rows = {}},
    If[!DirectoryQ[$ClaudeSnapshots],
      Print["  ", iL[
        "\:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:306a\:3057",
        "No snapshots found"],
        " ($ClaudeSnapshots = " <> $ClaudeSnapshots <> ")"];
      Return[Dataset[{}]]];
    dirs = Select[FileNames["*", $ClaudeSnapshots],
      DirectoryQ[#] && FileExistsQ[FileNameJoin[{#, "meta.wl"}]] &];
    Do[Module[{meta = Quiet @ Check[
          Get[FileNameJoin[{d, "meta.wl"}]], <||>]},
      If[AssociationQ[meta],
        Module[{snapType = Lookup[meta, "type", "LLMGraphDAG"],
                ts = Lookup[meta, "timestamp", "0"]},
          AppendTo[rows, <|
            "dir"       -> d,
            "type"      -> snapType,
            "id"        -> If[snapType === "ClaudeRuntime",
                             Lookup[meta, "runtimeId", "?"],
                             Lookup[meta, "jobId", "?"]],
            "name"      -> If[snapType === "ClaudeRuntime",
                             If[Lookup[meta, "profile", ""] === "DAGJob",
                               Lookup[meta, "taskName", "DAGJob"],
                               "Runtime Turn " <>
                                 ToString[Lookup[meta, "turnCount", "?"]]],
                             Lookup[meta, "taskName", "?"]],
            "status"    -> Lookup[meta, "status", "?"],
            "done"      -> If[snapType === "ClaudeRuntime",
                             Lookup[meta, "doneNodes", 0],
                             Lookup[meta, "done", 0]],
            "failed"    -> If[snapType === "ClaudeRuntime",
                             Lookup[meta, "failedNodes", 0],
                             Lookup[meta, "failed", 0]],
            "time"      -> DateString[
              FromUnixTime[ToExpression[ts]],
              {"Year","-","Month","-","Day"," ","Hour",":","Minute"}],
            "restore"   -> If[snapType === "ClaudeRuntime",
                             "ClaudeRuntimeRestore[\"" <> d <> "\"]",
                             "LLMGraphDAGRestore[\"" <> d <> "\"]"]
          |>]]]],
      {d, SortBy[dirs, -FileDate[#, "Modification"] &]}];
    Dataset[rows]
  ];
iClaudeDirectivesAvailableQ[] :=
