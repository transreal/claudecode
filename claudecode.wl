(* \:30d1\:30c3\:30b1\:30fc\:30b8\:306e\:30bd\:30fc\:30b9\:30d5\:30a1\:30a4\:30eb\:30d1\:30b9\:3092\:8fd4\:3059 (Paclet/\:5358\:4e00\:30d5\:30a1\:30a4\:30eb\:4e21\:5bfe\:5fdc) *)
iPackageSourceFile[packageName_String] :=
  If[iPacletQ[packageName],
    FileNameJoin[{Global`$packageDirectory, packageName, "Kernel", packageName <> ".wl"}],
    FileNameJoin[{Global`$packageDirectory, packageName <> ".wl"}]
  ];

(* \:30bf\:30a4\:30e0\:30b9\:30bf\:30f3\:30d7\:6587\:5b57\:5217 "YYYYMMDD_HHMMSS", "YYYYMMDDHHMMSS", "YYYYMMDDHHMM" \:3092\:8aad\:307f\:3084\:3059\:3044\:5f62\:5f0f\:306b\:5909\:63db *)
formatTimestamp[ts_String] := Module[{m, m2, m3},
  (* YYYYMMDD_HHMMSS \:5f62\:5f0f (ClaudeUpdatePackage) \[RightArrow] \:79d2\:306f\:7701\:7565 *)
  m = StringCases[ts,
    RegularExpression["(\\d{4})(\\d{2})(\\d{2})_(\\d{2})(\\d{2})(\\d{2})"] :>
      {"$1", "$2", "$3", "$4", "$5"}];
  If[Length[m] > 0,
    With[{p = First[m]},
      p[[1]] <> "-" <> p[[2]] <> "-" <> p[[3]] <>
      " " <> p[[4]] <> ":" <> p[[5]]],
    (* YYYYMMDDHHMMSS \:5f62\:5f0f (14\:6841\:30fb\:30a2\:30f3\:30c0\:30fc\:30b9\:30b3\:30a2\:306a\:3057) *)
    m2 = StringCases[ts,
      RegularExpression["^(\\d{4})(\\d{2})(\\d{2})(\\d{2})(\\d{2})(\\d{2})$"] :>
        {"$1", "$2", "$3", "$4", "$5"}];
    If[Length[m2] > 0,
      With[{p = First[m2]},
        p[[1]] <> "-" <> p[[2]] <> "-" <> p[[3]] <>
        " " <> p[[4]] <> ":" <> p[[5]]],
      (* YYYYMMDDHHMM \:5f62\:5f0f (12\:6841\:30fb\:65e7\:5f62\:5f0f) *)
      m3 = StringCases[ts,
        RegularExpression["^(\\d{4})(\\d{2})(\\d{2})(\\d{2})(\\d{2})$"] :>
          {"$1", "$2", "$3", "$4", "$5"}];
      If[Length[m3] > 0,
        With[{p = First[m3]},
          p[[1]] <> "-" <> p[[2]] <> "-" <> p[[3]] <>
          " " <> p[[4]] <> ":" <> p[[5]]],
        ts]
    ]]
  ];

