        "Size" -> FileByteCount[claudeMD],
        "LastModified" -> DateObject[FileDate[claudeMD]],
        "LatestBackup" -> iLatestDirectiveBackup["CLAUDE.md"]|>]
    ];

    (* \:30b9\:30ad\:30eb *)
    skillDirs = FileNameJoin[{srcDir, "skills"}];
