ClaudeRegisterDAGRuntime[jobId_String, spec_Association: <||>] :=
  Module[{runtimeId, ts},
    ts = ToString[UnixTime[]] <> "-" <> ToString[RandomInteger[99999]];
    runtimeId = "rt-dag-" <> ts;
    ClaudeRuntime`Private`$iClaudeRuntimes[runtimeId] = <|
      "RuntimeId"          -> runtimeId,
      "Profile"            -> "DAGJob",
      "Status"             -> "Running",
      "CurrentJobId"       -> jobId,
      "Adapter"            -> <||>,
      "TurnCount"          -> 0,
      "BudgetsUsed"        -> <||>,
      "ConversationState"  -> <||>,
      "EventTrace"         -> {},
      "CompletedDAGNodes"  -> <||>,
      "Metadata"           -> Lookup[spec, "Metadata", <||>],
      "AuxiliaryState"     -> Lookup[spec, "AuxiliaryState", <||>]
    |>;
    $ClaudeLastRuntimeId = runtimeId;
    Print[iL["  ClaudeRuntime DAGJob \:767b\:9332: ",
             "  ClaudeRuntime DAGJob registered: "], runtimeId];
    runtimeId
  ];

ClaudeRuntimeSnapshot[runtimeId_String] :=
  Module[{rt, snapDir, ts, saveState, meta, activeJobId,
          doneCount = 0, failedCount = 0},
    rt = ClaudeRuntime`Private`$iClaudeRuntimes[runtimeId];
    If[!AssociationQ[rt],
      Return[Missing["RuntimeNotFound", runtimeId]]];
    
    If[!DirectoryQ[$ClaudeSnapshots],
      Quiet[CreateDirectory[$ClaudeSnapshots]]];
    ts = ToString[Floor[AbsoluteTime[]]];
    snapDir = FileNameJoin[{$ClaudeSnapshots, ts <> "-rt-" <> runtimeId}];
    Quiet[CreateDirectory[snapDir]];
    
    (* \[HorizontalLine]\[HorizontalLine] \:30a2\:30af\:30c6\:30a3\:30d6 DAG \:30b8\:30e7\:30d6\:306e\:51e6\:7406 \[HorizontalLine]\[HorizontalLine] *)
    activeJobId = Lookup[rt, "CurrentJobId", None];
    If[StringQ[activeJobId],
      Module[{activeJob = Quiet @ $iLLMGraphDAGJobs[activeJobId]},
        If[AssociationQ[activeJob],
          (* running \:30ce\:30fc\:30c9\:3092\:505c\:6b62 *)
          LLMGraphDAGStop[activeJobId];
          (* DAG \:306e\:6700\:65b0\:30ce\:30fc\:30c9\:72b6\:614b\:3092 CompletedDAGNodes \:306b\:53cd\:6620 *)
          Module[{nodes = Lookup[activeJob, "nodes", <||>], saved},
            saved = Association @ Map[
              KeyDrop[#, {"handler", "runState"}] &,
              nodes];
            rt["CompletedDAGNodes"] = saved;
            rt["CompletedDAGJob"] = Append[
              KeyDrop[activeJob, {"nodes", "onComplete"}],
              "nodes" -> saved];
            ClaudeRuntime`Private`$iClaudeRuntimes[runtimeId] = rt;
            Print["  ", Style[iL[
              "\:30a2\:30af\:30c6\:30a3\:30d6 DAG \:3092\:505c\:6b62\:30fb\:4fdd\:5b58\:3057\:307e\:3057\:305f: " <> activeJobId,
              "Active DAG stopped and saved: " <> activeJobId], Italic]]]]]];
    
    (* Adapter \:306f Function \:30af\:30ed\:30fc\:30b8\:30e3\:306e\:305f\:3081\:30b7\:30ea\:30a2\:30e9\:30a4\:30ba\:4e0d\:53ef \[Rule] \:9664\:5916 *)
    saveState = KeyDrop[rt, {"Adapter"}];
    saveState["snapshotTime"] = AbsoluteTime[];
    saveState["runtimeId"]    = runtimeId;
    
    (* \[HorizontalLine]\[HorizontalLine] DAGJob: runtime_state.wl \:3092\:8efd\:91cf\:5316 \[HorizontalLine]\[HorizontalLine]
       CompletedDAGJob (context \:5185\:306e chunks \:7b49\:3092\:542b\:3080\:5de8\:5927\:30c7\:30fc\:30bf) \:3068
       AuxiliaryState \:306f dag_job.wl / aux.wl \:306b\:5225\:9014\:4fdd\:5b58\:3059\:308b\:305f\:3081\:3001
       runtime_state.wl \:304b\:3089\:306f\:9664\:5916\:3059\:308b\:3002
       CompletedDAGNodes \:306f status/error \:306e\:307f\:4fdd\:6301 (result \:306f\:9664\:5916)\:3002 *)
    If[Lookup[rt, "Profile", ""] === "DAGJob",
      saveState = KeyDrop[saveState,
        {"CompletedDAGJob", "AuxiliaryState"}];
      If[AssociationQ[Lookup[saveState, "CompletedDAGNodes", None]],
        saveState["CompletedDAGNodes"] = Map[
          KeyTake[#, {"status", "error", "category",
                      "dependsOn", "tolerateFailure"}] &,
          saveState["CompletedDAGNodes"]]]];
    
    Quiet @ Check[
      Put[saveState, FileNameJoin[{snapDir, "runtime_state.wl"}]];
      Print["  ", iL["runtime_state.wl \:4fdd\:5b58\:6e08",
                     "runtime_state.wl saved"]],
      Print[Style["  \[WarningSign] " <> iL[
        "runtime_state.wl \:306e\:4fdd\:5b58\:306b\:5931\:6557",
        "Failed to save runtime_state.wl"], Red]]];
    
    (* \[HorizontalLine]\[HorizontalLine] DAGJob \:30d7\:30ed\:30d5\:30a1\:30a4\:30eb: \:30cf\:30f3\:30c9\:30e9\:30fc\:4ed8\:304d\:5b8c\:5168 DAG \:30b8\:30e7\:30d6\:4fdd\:5b58 \[HorizontalLine]\[HorizontalLine]
       PDFIndex \:7b49\:306e With \:30af\:30ed\:30fc\:30b8\:30e3\:306f\:6587\:5b57\:5217\:30fb\:6574\:6570\:306e\:307f\:30ad\:30e3\:30d7\:30c1\:30e3\:3059\:308b\:305f\:3081
       Put/Get \:3067\:76f4\:5217\:5316\:53ef\:80fd\:3002\:5fa9\:5143\:5f8c LLMGraphDAGRetry \:3067\:76f4\:63a5\:518d\:5b9f\:884c\:3067\:304d\:308b\:3002 *)
    If[Lookup[rt, "Profile", ""] === "DAGJob" && StringQ[activeJobId],
      Module[{fullJob = Quiet @ $iLLMGraphDAGJobs[activeJobId]},
        If[AssociationQ[fullJob],
          Module[{sj = fullJob},
            sj["nodes"] = Map[Module[{n = #},
              n["runState"] = None;
              If[Lookup[n, "status", ""] === "running",
                n["status"] = "failed";
                n["error"]  = "Interrupted for snapshot"];
              n] &, sj["nodes"]];
            sj["nb"] = $Failed;
            sj["snapshotTime"] = AbsoluteTime[];
            Quiet @ Check[
              Put[sj, FileNameJoin[{snapDir, "dag_job.wl"}]];
              Print["  ", iL[
                "DAG \:30b8\:30e7\:30d6\:4fdd\:5b58 (\:30cf\:30f3\:30c9\:30e9\:30fc\:4ed8\:304d): " <> activeJobId,
                "DAG job saved (with handlers): " <> activeJobId]],
              Print["  ", iL[
                "\:26a0 DAG \:30b8\:30e7\:30d6\:306e\:76f4\:5217\:5316\:306b\:5931\:6557 (\:30cf\:30f3\:30c9\:30e9\:30fc\:524a\:9664\:7248\:3067\:4fdd\:5b58)",
                "\:26a0 DAG job serialization failed (saved without handlers)"]]]
          ]]]];
    
    (* \[HorizontalLine]\[HorizontalLine] AuxiliaryState \:4fdd\:5b58 \[HorizontalLine]\[HorizontalLine] *)
    Module[{auxState = Lookup[rt, "AuxiliaryState", <||>]},
      If[AssociationQ[auxState] && Length[auxState] > 0,
        Put[auxState, FileNameJoin[{snapDir, "aux.wl"}]];
        Print["  ", iL["\:88dc\:52a9\:72b6\:614b\:4fdd\:5b58\:6e08 (", "Auxiliary state saved ("],
          StringRiffle[Keys[auxState], ", "], ")"]]];
    
    (* \:7d71\:8a08 *)
    Module[{cn = Lookup[saveState, "CompletedDAGNodes", <||>]},
      doneCount   = Count[Values[cn],
        _?(Lookup[#, "status", ""] === "done" &)];
      failedCount = Count[Values[cn],
        _?(MemberQ[{"failed", "pending"}, Lookup[#, "status", ""]] &)]];
    
    meta = <|
      "runtimeId"    -> runtimeId,
      "timestamp"    -> ts,
      "status"       -> Lookup[rt, "Status", "?"],
      "profile"      -> Lookup[rt, "Profile", "?"],
      "turnCount"    -> Lookup[rt, "TurnCount", 0],
      "messageCount" -> Length[Lookup[
        Lookup[rt, "ConversationState", <||>], "Messages", {}]],
      "doneNodes"    -> doneCount,
      "failedNodes"  -> failedCount,
      "type"         -> "ClaudeRuntime"
    |>;
    (* DAGJob: jobId \:3068\:30bf\:30b9\:30af\:540d\:3092\:30e1\:30bf\:306b\:8ffd\:52a0 *)
    If[Lookup[rt, "Profile", ""] === "DAGJob",
      meta["jobId"] = Lookup[rt, "CurrentJobId", "?"];
      Module[{md = Lookup[rt, "Metadata", <||>]},
        meta["taskName"] = Lookup[md, "title",
          Lookup[md, "docId", "DAGJob"]]]];
    Put[meta, FileNameJoin[{snapDir, "meta.wl"}]];
    
    Print[Style[iL[
      "\[Checkmark] ClaudeRuntime \:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:4fdd\:5b58: " <> snapDir,
      "\[Checkmark] ClaudeRuntime snapshot saved: " <> snapDir],
      Darker[Green], Bold]];
    Print["  Status: ", Lookup[rt, "Status", "?"],
      " / Turns: ", Lookup[rt, "TurnCount", 0],
      " / Done: ", doneCount, " / Failed: ", failedCount];
    Print["  ", iL["\:5fa9\:5143", "Restore"], ": ClaudeRuntimeRestore[\"" <>
      snapDir <> "\"]"];
    If[failedCount > 0,
      Print["  ", iL["\:5fa9\:5143+\:30ea\:30c8\:30e9\:30a4", "Restore+Retry"],
        ": ClaudeRuntimeRestore[\"" <> snapDir <> "\", \"Resume\"]"]];
    
    <|"snapshotDir" -> snapDir, "runtimeId" -> runtimeId,
      "status" -> Lookup[rt, "Status", "?"],
      "doneNodes" -> doneCount, "failedNodes" -> failedCount|>
  ];

ClaudeRuntimeRestore[snapDir_String] :=
  Module[{stateFile, savedState, runtimeId, adapter, nb,
          doneCount = 0, failedCount = 0, completedNodes},
    stateFile = FileNameJoin[{snapDir, "runtime_state.wl"}];
    If[!FileExistsQ[stateFile],
      Print[Style[iL[
        "\[WarningSign] runtime_state.wl \:304c\:898b\:3064\:304b\:308a\:307e\:305b\:3093: " <> snapDir,
        "\[WarningSign] runtime_state.wl not found: " <> snapDir], Red]];
      Return[$Failed]];
    
    savedState = Quiet @ Check[Get[stateFile], $Failed];
    If[!AssociationQ[savedState],
      Print[Style[iL[
        "\[WarningSign] runtime_state.wl \:306e\:8aad\:307f\:8fbc\:307f\:306b\:5931\:6557",
        "\[WarningSign] Failed to load runtime_state.wl"], Red]];
      Return[$Failed]];
    
    runtimeId = Lookup[savedState, "runtimeId",
      "restored-" <> ToString[Floor[AbsoluteTime[]]]];
    
    (* Adapter \:3092\:518d\:69cb\:7bc9\:ff08DAGJob \:30d7\:30ed\:30d5\:30a1\:30a4\:30eb\:306f\:7a7a adapter\:ff09 *)
    nb = Quiet @ Check[EvaluationNotebook[], $Failed];
    If[Lookup[savedState, "Profile", ""] === "DAGJob",
      adapter = <||>,
      adapter = ClaudeBuildRuntimeAdapter[nb,
        "AccessLevel" -> Lookup[savedState, "AccessLevel", 0.5],
        "Secrets"     -> {}]];
    savedState["Adapter"]    = adapter;
    savedState["restoredAt"] = AbsoluteTime[];
    
    (* \[HorizontalLine]\[HorizontalLine] DAGJob: dag_job.wl \:304b\:3089\:5b8c\:5168\:306a DAG \:30b8\:30e7\:30d6\:3092 $iLLMGraphDAGJobs \:306b\:5fa9\:5143 \[HorizontalLine]\[HorizontalLine] *)
    Module[{dagFile = FileNameJoin[{snapDir, "dag_job.wl"}]},
      If[FileExistsQ[dagFile],
        Module[{dagJob = Quiet @ Check[Get[dagFile], $Failed]},
          If[AssociationQ[dagJob],
            Module[{restoredJobId = Lookup[savedState, "CurrentJobId", None]},
              If[!StringQ[restoredJobId],
                restoredJobId = "restored-dag-" <> ToString[Floor[AbsoluteTime[]]]];
              dagJob["nb"] = nb;
              dagJob["restoredAt"] = AbsoluteTime[];
              $iLLMGraphDAGJobs[restoredJobId] = dagJob;
              savedState["CurrentJobId"] = restoredJobId;
              (* DAG \:30ce\:30fc\:30c9\:304b\:3089 CompletedDAGNodes \:3092\:518d\:69cb\:7bc9
                 (runtime_state.wl \:306f\:8efd\:91cf\:7248\:306e\:307f\:4fdd\:6301\:3059\:308b\:305f\:3081) *)
              Module[{fullNodes = Lookup[dagJob, "nodes", <||>]},
                If[AssociationQ[fullNodes] && Length[fullNodes] > 0,
                  savedState["CompletedDAGNodes"] = Association @ Map[
                    KeyDrop[#, {"handler", "runState"}] &, fullNodes]]];
              Print["  ", iL["DAG \:30b8\:30e7\:30d6\:5fa9\:5143 (\:30cf\:30f3\:30c9\:30e9\:30fc\:4ed8\:304d): ",
                             "DAG job restored (with handlers): "],
                restoredJobId]],
            Print[Style[iL[
              "\[WarningSign] dag_job.wl \:306e\:8aad\:307f\:8fbc\:307f\:306b\:5931\:6557",
              "\[WarningSign] Failed to load dag_job.wl"], Orange]]]]]];
    
    (* \[HorizontalLine]\[HorizontalLine] AuxiliaryState \:5fa9\:5143 \[HorizontalLine]\[HorizontalLine] *)
    Module[{auxFile = FileNameJoin[{snapDir, "aux.wl"}]},
      If[FileExistsQ[auxFile],
        Module[{auxState = Quiet @ Check[Get[auxFile], <||>]},
          If[AssociationQ[auxState],
            savedState["AuxiliaryState"] = auxState;
            Print["  ", iL["\:88dc\:52a9\:72b6\:614b\:5fa9\:5143\:6e08 (", "Auxiliary state restored ("],
              StringRiffle[Keys[auxState], ", "], ")"]]]]];
    
    (* \[HorizontalLine]\[HorizontalLine] \:30d1\:30c3\:30b1\:30fc\:30b8\:4f9d\:5b58\:30c1\:30a7\:30c3\:30af \[HorizontalLine]\[HorizontalLine]
       DAGJob \:306e\:30cf\:30f3\:30c9\:30e9\:30fc\:306f\:5b9f\:884c\:6642\:306b\:30d1\:30c3\:30b1\:30fc\:30b8\:5909\:6570\:3092\:53c2\:7167\:3059\:308b\:3002
       Mathematica \:518d\:8d77\:52d5\:5f8c\:306b\:30d1\:30c3\:30b1\:30fc\:30b8\:304c\:30ed\:30fc\:30c9\:3055\:308c\:3066\:3044\:306a\:3044\:3068\:30cf\:30f3\:30c9\:30e9\:30fc\:304c\:5931\:6557\:3059\:308b\:3002 *)
    If[Lookup[savedState, "Profile", ""] === "DAGJob",
      Module[{missing = {}, dagJob, sampleHandler, handlerStr},
        (* ClaudeRuntime.wl \:30c1\:30a7\:30c3\:30af *)
        If[!ValueQ[ClaudeRuntime`ClaudeRuntimeRetry],
          AppendTo[missing, "ClaudeRuntime.wl"]];
        (* DAG \:30cf\:30f3\:30c9\:30e9\:30fc\:304b\:3089\:53c2\:7167\:30d1\:30c3\:30b1\:30fc\:30b8\:3092\:63a8\:5b9a *)
        dagJob = Quiet @ $iLLMGraphDAGJobs[
          Lookup[savedState, "CurrentJobId", ""]];
        If[AssociationQ[dagJob],
          sampleHandler = Lookup[
            First[Select[Values[Lookup[dagJob, "nodes", <||>]],
              Lookup[#, "status", ""] === "failed" &], <||>],
            "handler", None];
          If[sampleHandler =!= None,
            handlerStr = ToString[InputForm[sampleHandler]];
            If[StringContainsQ[handlerStr, "PDFIndex`Private`"],
              If[!StringQ[PDFIndex`Private`$pdfChunkSummarizePrompt],
                AppendTo[missing, "PDFIndex.wl"]]]]];
        If[Length[missing] > 0,
          Print[Style["  \[WarningSign] " <> iL[
            "\:5fc5\:8981\:306a\:30d1\:30c3\:30b1\:30fc\:30b8\:304c\:672a\:30ed\:30fc\:30c9: " <>
              StringRiffle[missing, ", "],
            "Required packages not loaded: " <>
              StringRiffle[missing, ", "]], Orange, Bold]];
          Print["  ", iL[
            "  \:30ea\:30c8\:30e9\:30a4\:524d\:306b\:30d1\:30c3\:30b1\:30fc\:30b8\:3092\:30ed\:30fc\:30c9\:3057\:3066\:304f\:3060\:3055\:3044\:3002",
            "  Please load packages before retrying."]]]]];
    
    ClaudeRuntime`Private`$iClaudeRuntimes[runtimeId] = savedState;
    $ClaudeLastRuntimeId = runtimeId;
    
    (* \:7d71\:8a08 *)
    completedNodes = Lookup[savedState, "CompletedDAGNodes", <||>];
    doneCount   = Count[Values[completedNodes],
      _?(Lookup[#, "status", ""] === "done" &)];
    failedCount = Count[Values[completedNodes],
      _?(MemberQ[{"failed", "pending"}, Lookup[#, "status", ""]] &)];
    
    Print[Style[iL[
      "\[Checkmark] ClaudeRuntime \:30b9\:30ca\:30c3\:30d7\:30b7\:30e7\:30c3\:30c8\:5fa9\:5143: " <> runtimeId,
