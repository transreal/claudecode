 RowBox[{
  RowBox[{"\[ImaginaryI]", "[", "r", "]"}], "=", 
  RowBox[{
   RowBox[{"I_", 
    RowBox[{"0", " ", "\\", "left"}], 
    RowBox[{
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"\\", "frac"}], 
       RowBox[{"{", 
        RowBox[{"2", " ", "J_", "1", 
         RowBox[{"(", "x", ")"}]}], "}"}], 
       RowBox[{"{", "x", "}"}], " ", "\\r", "ight"}], ")"}], "^", "2"}]}], ",",
    " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\\", "quad"}], " ", "x"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"\\", "frac"}], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\\", "pi"}], " ", "D", " ", "r"}], "}"}], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\\", "lambda"}], " ", "f"}], 
      "}"}]}]}]}]}]], \
