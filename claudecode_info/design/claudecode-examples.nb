QCpd56xaKP7/y85/AeEQu5w=", "cellCount" -> 1, "response" -> 
       "# \:5149\:306e\:56de\:6298\:ff08Diffraction of Light\:ff09\n\n## \
\:56de\:6298\:3068\:306f\n\n\:5149\:304c\:969c\:5bb3\:7269\:3084\:30b9\:30ea\
\:30c3\:30c8\:ff08\:958b\:53e3\:90e8\:ff09\:306e\:7aef\:3092\:901a\:904e\:3059\
\:308b\:3068\:304d\:3001\:76f4\:9032\:305b\:305a\:306b**\:5f71\:306e\:9818\
\:57df\:306b\:3082\:56de\:308a\:8fbc\:3080**\:73fe\:8c61\:3092**\:56de\:6298**\
\:ff08diffraction\:ff09\:3068\:547c\:3073\:307e\:3059\:3002\:3053\:308c\:306f\
\:5149\:306e**\:6ce2\:52d5\:6027**\:3092\:793a\:3059\:4ee3\:8868\:7684\:306a\
\:73fe\:8c61\:3067\:3059\:3002\n\n\:56de\:6298\:304c\:9855\:8457\:306b\:306a\
\:308b\:6761\:4ef6\:306f\:3001\:958b\:53e3\:90e8\:306e\:5e45 $a$ \:304c\:5149\
\:306e\:6ce2\:9577 $\\lambda$ \
\:3068\:540c\:7a0b\:5ea6\:306e\:3068\:304d\:ff08$a \\sim \
\\lambda$\:ff09\:3067\:3059\:3002\n\n## 1. \:5358\:30b9\:30ea\:30c3\:30c8\
\:56de\:6298\:ff08\:30d5\:30e9\:30a6\:30f3\:30db\:30fc\:30d5\:30a1\:30fc\:56de\
\:6298\:ff09\n\n\:5e45 $a$ \:306e\:5358\:30b9\:30ea\:30c3\:30c8\:306b\:5e73\
\:9762\:6ce2\:304c\:5165\:5c04\:3059\:308b\:3068\:304d\:3001\:56de\:6298\:89d2\
 $\\theta$ \:306b\:304a\:3051\:308b\:5f37\:5ea6\:5206\:5e03\:306f\:6b21\:306e\
\:3088\:3046\:306b\:8868\:3055\:308c\:307e\:3059\:ff1a\n\n$I(\\theta) = I_0 \
\\left( \\frac{\\sin \\beta}{\\beta} \\right)^2$\n\n\:3053\:3053\:3067 \
$\\beta = \\frac{\\pi a \\sin\\theta}{\\lambda}$ \:3067\:3059\:3002\:6697\
\:7dda\:ff08\:6975\:5c0f\:ff09\:306e\:6761\:4ef6\:306f $a \\sin\\theta = \
m\\lambda$\:ff08$m = \\pm 1, \\pm 2, \\ldots$\:ff09\:3067\:3059\:3002\n\n\
```mathematica\n(* \:5358\:30b9\:30ea\:30c3\:30c8\:56de\:6298\:30d1\:30bf\
\:30fc\:30f3 *)\nManipulate[\n Module[{\[Beta], intensity},\n  \[Beta][\
\[Theta]_] := \[Pi] a Sin[\[Theta]] / \[Lambda];\n  intensity[\[Theta]_] := \
If[Abs[\[Beta][\[Theta]]] < 10^-10, 1, (Sin[\[Beta][\[Theta]]] / \[Beta][\
\[Theta]])^2];\n  Plot[intensity[\[Theta]], {\[Theta], -\[Pi]/6, \[Pi]/6},\n  \
 PlotRange -> {0, 1.05},\n   Frame -> True,\n   FrameLabel -> {\"\:56de\:6298\
\:89d2 \[Theta] (rad)\", \"\:898f\:683c\:5316\:5f37\:5ea6 I/I\:2080\"},\n   \
PlotLabel -> Style[\"\:5358\:30b9\:30ea\:30c3\:30c8 \:30d5\:30e9\:30a6\:30f3\
\:30db\:30fc\:30d5\:30a1\:30fc\:56de\:6298\", 14, Bold],\n   PlotStyle -> \
{Thick, Blue},\n   Filling -> Axis,\n   FillingStyle -> \
Directive[Opacity[0.2], Blue],\n   ImageSize -> 500\n  ]\n ],\n {{a, 5, \"\
\:30b9\:30ea\:30c3\:30c8\:5e45 a (\[Mu]m)\"}, 1, 20, 0.5, Appearance -> \
\"Labeled\"},\n {{\[Lambda], 0.55, \"\:6ce2\:9577 \[Lambda] (\[Mu]m)\"}, \
0.38, 0.75, 0.01, Appearance -> \"Labeled\"},\n TrackedSymbols :> {a, \
\[Lambda]}\n]\n```\n\n## 2. \:4e8c\:91cd\:30b9\:30ea\:30c3\:30c8\:56de\:6298\
\:ff08\:30e4\:30f3\:30b0\:306e\:5e72\:6e09\:ff0b\:56de\:6298\:ff09\n\n\:30b9\
\:30ea\:30c3\:30c8\:5e45 $a$\:3001\:30b9\:30ea\:30c3\:30c8\:9593\:9694 $d$ \
\:306e\:4e8c\:91cd\:30b9\:30ea\:30c3\:30c8\:3067\:306f\:3001**\:5e72\:6e09**\
\:3068**\:56de\:6298**\:306e\:4e21\:65b9\:306e\:52b9\:679c\:304c\:7d44\:307f\
\:5408\:308f\:3055\:308a\:307e\:3059\:ff1a\n\n$I(\\theta) = I_0 \\left( \
\\frac{\\sin \\beta}{\\beta} \\right)^2 \\cos^2 \\gamma$\n\n\
\:3053\:3053\:3067 $\\beta = \\frac{\\pi a \
\\sin\\theta}{\\lambda}$\:3001$\\gamma = \\frac{\\pi d \
\\sin\\theta}{\\lambda}$ \:3067\:3059\:3002\n\n```mathematica\n(* \
\:4e8c\:91cd\:30b9\:30ea\:30c3\:30c8\:56de\:6298\:30d1\:30bf\:30fc\:30f3 *)\n\
Manipulate[\n Module[{\[Beta], \[Gamma], envelope, interference, total},\n  \
\[Beta][\[Theta]_] := \[Pi] a Sin[\[Theta]] / \[Lambda];\n  \
\[Gamma][\[Theta]_] := \[Pi] d Sin[\[Theta]] / \[Lambda];\n  \
envelope[\[Theta]_] := If[Abs[\[Beta][\[Theta]]] < 10^-10, 1, (Sin[\[Beta][\
\[Theta]]] / \[Beta][\[Theta]])^2];\n  interference[\[Theta]_] := \
Cos[\[Gamma][\[Theta]]]^2;\n  total[\[Theta]_] := envelope[\[Theta]] * \
interference[\[Theta]];\n  Plot[{total[\[Theta]], envelope[\[Theta]]}, {\
\[Theta], -\[Pi]/12, \[Pi]/12},\n   PlotRange -> {0, 1.05},\n   Frame -> \
True,\n   FrameLabel -> {\"\:56de\:6298\:89d2 \[Theta] (rad)\", \
\"\:898f\:683c\:5316\:5f37\:5ea6 I/I\:2080\"},\n   PlotLabel -> \
Style[\"\:4e8c\:91cd\:30b9\:30ea\:30c3\:30c8 \:5e72\:6e09\:ff0b\:56de\:6298\
\:30d1\:30bf\:30fc\:30f3\", 14, Bold],\n   PlotStyle -> {{Thick, Blue}, \
{Dashed, Red}},\n   PlotLegends -> Placed[{\"\:5408\:6210\:30d1\:30bf\:30fc\
\:30f3\", \"\:56de\:6298\:5305\:7d61\:7dda\"}, {Right, Top}],\n   Filling -> \
{1 -> Axis},\n   FillingStyle -> Directive[Opacity[0.15], Blue],\n   \
ImageSize -> 550\n  ]\n ],\n {{a, 3, \"\:30b9\:30ea\:30c3\:30c8\:5e45 a \
(\[Mu]m)\"}, 1, 10, 0.5, Appearance -> \"Labeled\"},\n {{d, 15, \
\"\:30b9\:30ea\:30c3\:30c8\:9593\:9694 d (\[Mu]m)\"}, 5, 50, 1, Appearance -> \
\"Labeled\"},\n {{\[Lambda], 0.55, \"\:6ce2\:9577 \[Lambda] (\[Mu]m)\"}, \
0.38, 0.75, 0.01, Appearance -> \"Labeled\"},\n TrackedSymbols :> {a, d, \
\[Lambda]}\n]\n```\n\n## 3. \
\:56de\:6298\:30d1\:30bf\:30fc\:30f3\:306e2D\:30b7\:30df\:30e5\:30ec\:30fc\
\:30b7\:30e7\:30f3\n\n\:30b9\:30af\:30ea\:30fc\:30f3\:4e0a\:306b\:6295\:5f71\
\:3055\:308c\:308b\:56de\:6298\:30d1\:30bf\:30fc\:30f3\:30922\:6b21\:5143\
\:3067\:53ef\:8996\:5316\:3057\:307e\:3059\:3002\n\n```mathematica\n(* \:5358\
\:30b9\:30ea\:30c3\:30c8\:56de\:6298\:306e2D\:5f37\:5ea6\:5206\:5e03 *)\n\
With[{a = 5, \[Lambda] = 0.55},\n DensityPlot[\n  Module[{\[Beta]x = \[Pi] a \
x / (\[Lambda] * 200), \[Beta]y = \[Pi] a y / (\[Lambda] * 200)},\n   If[Abs[\
\[Beta]x] < 10^-10, 1, (Sin[\[Beta]x] / \[Beta]x)^2] *\n   If[Abs[\[Beta]y] < \
10^-10, 1, (Sin[\[Beta]y] / \[Beta]y)^2]\n  ],\n  {x, -50, 50}, {y, -50, 50},\
\n  PlotPoints -> 150,\n  ColorFunction -> \"SunsetColors\",\n  PlotLabel -> \
Style[\"\:6b63\:65b9\:5f62\:958b\:53e3\:306e\:56de\:6298\:30d1\:30bf\:30fc\
\:30f3\:ff082D\:ff09\", 14, Bold],\n  FrameLabel -> {\"x (\[Mu]m)\", \"y (\
\[Mu]m)\"},\n  ImageSize -> 400\n ]\n]\n```\n\n## 4. \:5186\:5f62\:958b\:53e3\
\:306e\:56de\:6298\:ff08\:30a8\:30a2\:30ea\:30fc\:30d1\:30bf\:30fc\:30f3\:ff09\
\n\n\:5186\:5f62\:958b\:53e3\:ff08\:76f4\:5f84 $D$\:ff09\:306e\:5834\:5408\
\:3001\:5f37\:5ea6\:5206\:5e03\:306f\:30d9\:30c3\:30bb\:30eb\:95a2\:6570 \
$J_1$ \:3092\:7528\:3044\:3066\:8868\:3055\:308c\:307e\:3059\:ff1a\n\n$I(r) = \
I_0 \\left( \\frac{2 J_1(x)}{x} \\right)^2, \\quad x = \\frac{\\pi D \
r}{\\lambda f}$\n\n\:3053\:3053\:3067 $f$ \
\:306f\:30ec\:30f3\:30ba\:306e\:7126\:70b9\:8ddd\:96e2\:3001$r$ \:306f\:30b9\
\:30af\:30ea\:30fc\:30f3\:4e0a\:306e\:4e2d\:5fc3\:304b\:3089\:306e\:8ddd\:96e2\
\:3067\:3059\:3002\:3053\:308c\:304c\:671b\:9060\:93e1\:3084\:9855\:5fae\:93e1\
\:306e**\:5206\:89e3\:80fd\:306e\:9650\:754c**\:ff08\:30ec\:30a4\:30ea\:30fc\
\:57fa\:6e96\:ff09\:3092\:6c7a\:5b9a\:3057\:307e\:3059\:3002\n\n\
```mathematica\n(* \:30a8\:30a2\:30ea\:30fc\:30d1\:30bf\:30fc\:30f3\:ff08\
\:5186\:5f62\:958b\:53e3\:306e\:56de\:6298\:ff09 *)\nDensityPlot[\n Module[{\
\[Rho] = Sqrt[x^2 + y^2]},\n  If[\[Rho] < 0.01, 1, (2 BesselJ[1, \[Rho]] / \
\[Rho])^2]\n ],\n {x, -15, 15}, {y, -15, 15},\n PlotPoints -> 200,\n \
ColorFunction -> (GrayLevel[#^0.3] &),\n PlotLabel -> Style[\"\:30a8\:30a2\
\:30ea\:30fc\:30d1\:30bf\:30fc\:30f3\:ff08\:5186\:5f62\:958b\:53e3\:ff09\", \
14, Bold],\n FrameLabel -> {\"x\", \"y\"},\n ImageSize -> 400\n]\n```\n\n## \
