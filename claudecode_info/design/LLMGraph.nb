```mathematica\n(* ISplittable \:30d7\:30ed\:30c8\:30b3\:30eb\:306e\:5b9a\
\:7fa9 *)\n(* \:5404\:30aa\:30d6\:30b8\:30a7\:30af\:30c8\:578b\:304c\:5b9f\
\:88c5\:3059\:3079\:304d\:30a4\:30f3\:30bf\:30fc\:30d5\:30a7\:30fc\:30b9 *)\n\
iSplittableProtocol = <|\n  \"NotebookCells\" -> <|\n    \"Split\" -> \
Function[{cells, policy},\n      (* \:79d8\:533f\:30ec\:30d9\:30eb + \:6587\
\:8108\:4f9d\:5b58\:3067\:30b0\:30eb\:30fc\:30d7\:5316 *)\n      \
\"iSplitByPrivacyAndContext[cells, policy]\"\n    ],\n    \"Merge\" -> \
Function[{processedChunks},\n      (* \:5143\:306e\:30bb\:30eb\:9806\:5e8f\
\:3092\:4fdd\:6301\:3057\:3066\:518d\:5408\:6210 *)\n      \
\"iMergePreservingOrder[processedChunks]\"\n    ],\n    \"IsHomomorphic\" -> \
Function[{chunk},\n      (* \:6587\:8108\:4f9d\:5b58\:306a\:3057\:306a\:3089 \
True \[RightArrow] \:4e26\:5217\:5316\:53ef\:80fd *)\n      \
\"Not[chunk[\\\"ContextDependent\\\"]]\"\n    ]\n  |>,\n  \"TextChunks\" -> \
<|\n    \"Split\" -> \"iParagraphSplit | iSentenceSplit | \
iTokenWindowSplit\",\n    \"Merge\" -> \"iConcatenateWithSeparator\",\n    \
\"IsHomomorphic\" -> \"iNoAnaphora\"  (* \:7167\:5fdc\:304c\:306a\:3051\:308c\
\:3070\:4e26\:5217\:53ef *)\n  |>,\n  \"AudioSegments\" -> <|\n    \"Split\" \
-> \"iSilenceBasedSplit | iFixedDurationSplit\",\n    \"Merge\" -> \
\"iAudioConcatenate\",\n    \"IsHomomorphic\" -> \"True\"  (* \:97f3\:58f0\
\:30bb\:30b0\:30e1\:30f3\:30c8\:306f\:901a\:5e38\:72ec\:7acb *)\n  |>\n|>;\n\
```\n\n### 4.5 \:30b9\:30b1\:30b8\:30e5\:30fc\:30e9\:306e\:5f79\:5272\:5206\
\:96e2\n\n```mathematica\n(* L0 Scheduler \:3068 L1 PromptGraph \:306e\:5206\
