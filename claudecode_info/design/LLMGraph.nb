Cell[BoxData[
 RowBox[{
  RowBox[{
  "(*", " ", 
   "\:8a2d\:8a08\:30b3\:30f3\:30bb\:30d7\:30c8\:306e\:30b9\:30b1\:30c3\:30c1",
    " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"ClaudeGraph", ":", " ", 
    RowBox[{
    "LLMGraph", " ", 
     "\:30a4\:30f3\:30b9\:30d4\:30ec\:30fc\:30b7\:30e7\:30f3\:306e\:30ab\:30b9\
\:30bf\:30e0\:30b0\:30e9\:30d5"}]}], " ", "*)"}], "\n", 
  RowBox[{"clauseGraph", " ", "=", " ", 
   RowBox[{"ClaudeGraph", "[", 
    RowBox[{"<|", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<readSource\>\"", " ", "->", " ", 
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{"\"\<EvaluationFunction\>\"", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ReadString", "[", "#packageFile", "]"}], " ", "&"}], 
           ")"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<AccessLevel\>\"", " ", "->", " ", "\"\<Local\>\""}]}], 
        "\n", "  ", "|>"}]}], ",", "\n", "  ", 
      RowBox[{"\"\<generateUpdate\>\"", " ", "->", " ", 
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{"\"\<LLMProvider\>\"", " ", "->", 
          " ", "\"\<ClaudeCode\>\""}], ",", "  ", 
         RowBox[{"(*", " ", 
          RowBox[{"or", " ", "\"\<LMStudio\>\""}], " ", "*)"}], "\n", "    ", 
         RowBox[{"\"\<Prompt\>\"", " ", "->", 
          " ", "\"\<Update this code: `readSource`\\nInstruction: \
`instruction`\>\""}], ",", "\n", "    ", 
         RowBox[{"\"\<AccessLevel\>\"", " ", "->", " ", "\"\<API\>\""}], ",", 
         "\n", "    ", 
         RowBox[{"\"\<Fallback\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<LMStudio\>\"", ",", " ", "\"\<ClaudeCode\>\""}], 
           "}"}]}]}], "\n", "  ", "|>"}]}], ",", "\n", "  ", 
      RowBox[{"\"\<validateMerge\>\"", " ", "->", " ", 
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{"\"\<EvaluationFunction\>\"", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"iSafeMerge", "[", 
             RowBox[{"#readSource", ",", " ", "#generateUpdate"}], "]"}], " ",
             "&"}], ")"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<TestFunction\>\"", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"StringQ", "[", "#", "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"StringLength", "[", "#", "]"}], " ", ">", " ", 
              "100"}]}], " ", "&"}], ")"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<AccessLevel\>\"", " ", "->", " ", "\"\<Local\>\""}]}], 
        "\n", "  ", "|>"}]}], ",", "\n", "  ", 
      RowBox[{"\"\<writeResult\>\"", " ", "->", " ", 
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{"\"\<EvaluationFunction\>\"", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Export", "[", 
             RowBox[{
             "#dest", ",", " ", "#validateMerge", ",", " ", "\"\<Text\>\""}], 
             "]"}], " ", "&"}], ")"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<AccessLevel\>\"", " ", "->", 
          " ", "\"\<FileSystem\>\""}]}], "\n", "  ", "|>"}]}]}], "\n", "|>"}],
     "]"}]}]}]], "Input",ExpressionUUID->"bf3af2dd-bcda-2f41-9667-\
