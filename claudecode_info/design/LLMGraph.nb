   <|\"fn\" -> \"iExtractResult\",   \"t0\" -> 15.8, \"t1\" -> 16.1, \"status\
\" -> \"OK\"|>\n  }\n|>\n```\n\n## \:5916\:90e8\:30b3\:30f3\:30c6\:30f3\:30c4\
\:30b9\:30c8\:30a2\:306e\:8a2d\:8a08\n\n```mathematica\n(* \:30d7\:30ed\:30f3\
\:30d7\:30c8\:3068\:30ec\:30b9\:30dd\:30f3\:30b9\:3092 TaggingRules \:3067\
\:306f\:306a\:304f\:5916\:90e8\:30d5\:30a1\:30a4\:30eb\:306b\:4fdd\:5b58 *)\n\
(* \:4fdd\:5b58\:5148: \
$packageDirectory/claudecode_info/history/<notebookHash>/ *)\n\n\
iSaveNodeContent[nodeID_String, prompt_String, response_String] :=\n  \
Module[{dir, path},\n    dir = FileNameJoin[{$packageDirectory, \
\"claudecode_info\", \"history\",\n      iNotebookHash[InputNotebook[]]}];\n  \
  If[!DirectoryQ[dir], CreateDirectory[dir]];\n    path = FileNameJoin[{dir, \
nodeID <> \".mx\"}];\n    Export[path, Compress[<|\"prompt\" -> prompt, \
\"response\" -> response|>], \"String\"];\n    path\n  ]\n\n(* \:5fc5\:8981\
\:6642\:306b\:306e\:307f\:30ed\:30fc\:30c9 \[LongDash] \:9045\:5ef6\:8aad\
\:307f\:8fbc\:307f *)\niLoadNodeContent[contentRef_String] :=\n  \
If[FileExistsQ[contentRef],\n    Uncompress[Import[contentRef, \"String\"]],\n\
    Missing[\"ContentEvicted\"]\n  ]\n```\n\n\:3053\:308c\:306b\:3088\:308a \
`TaggingRules` \:306b\:4fdd\:5b58\:3055\:308c\:308b\:30b0\:30e9\:30d5\:672c\
\:4f53\:306f**\:30e1\:30bf\:30c7\:30fc\:30bf\:306e\:307f**\:3068\:306a\:308a\
\:3001\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:30d5\:30a1\:30a4\:30eb\:30b5\:30a4\
\:30ba\:3078\:306e\:5f71\:97ff\:304c\:6700\:5c0f\:5316\:3055\:308c\:308b\:3002\
\n\n## \:30b0\:30e9\:30d5\:672c\:4f53\:306e\:69cb\:9020\n\n```mathematica\n(* \
\:30ce\:30fc\:30c8\:30d6\:30c3\:30af LLMGraph \[LongDash] TaggingRules \:306b \
Compress \:3057\:3066\:4fdd\:5b58\:3055\:308c\:308b\:672c\:4f53 *)\n\
nbLLMGraphCompact = <|\n  \"version\" -> 1,\n  \"nbHash\" -> \"a3f2c1...\",\n \
 \"nodes\" -> <|\n    \"n-001\" -> compactNode1,\n    \"n-002\" -> \
compactNode2\n    (* ... \:5404\:30ce\:30fc\:30c9\:306f ~500 bytes *)\n  |>,\n\
  \"edges\" -> {\n    (* {from, to, type} \
\:306e\:30c8\:30ea\:30d7\:30ec\:30c3\:30c8\:306e\:307f *)\n    {\"n-001\", \
\"n-002\", \"Session\"},      (* ContinueEval \:30c1\:30a7\:30a4\:30f3 *)\n   \
 {\"n-002\", \"n-003\", \"DataFlow\"},     (* \:51fa\:529b\:5909\:6570\:306e\
\:53c2\:7167 *)\n    {\"n-003\", \"n-004\", \"SelectionEval\"} (* \
\:9078\:629eEval *)\n  },\n  \"clusters\" -> <|\n    \"c-001\" -> <|\"root\" \
-> \"n-001\", \"nodes\" -> {\"n-001\", \"n-002\"},\n                  \
\"compactState\" -> <|\"compactN\" -> 3, \"compactW\" -> 2000|>|>\n  |>,\n  \
\"gc\" -> <|\"lastEviction\" -> 3.983*^9, \"maxNodes\" -> 200, \"maxAgeDays\" \
-> 30|>\n|>\n```\n\n## \
\:5c65\:6b74\:30b5\:30a4\:30ba\:5236\:5fa1\:306e3\:6bb5\:968e\:6226\:7565\n\n\
### \:7b2c1\:6bb5\:968e: \:30b3\:30f3\:30c6\:30f3\:30c4\:5916\:90e8\:5316\
\:ff08\:5373\:52b9\:ff09\n\n\:30ce\:30fc\:30c9\:306e\:30d7\:30ed\:30f3\:30d7\
\:30c8/\:30ec\:30b9\:30dd\:30f3\:30b9\:672c\:6587\:3092 `TaggingRules` \:304b\
\:3089\:5916\:90e8 `.mx` \:30d5\:30a1\:30a4\:30eb\:3078\:79fb\:52d5\:3059\
\:308b\:3002\:3053\:308c\:3060\:3051\:3067 `TaggingRules` \:306e\:30b5\:30a4\
\:30ba\:306f **90% \:4ee5\:4e0a\:524a\:6e1b** \:3067\:304d\:308b\:3002\n\n### \
\:7b2c2\:6bb5\:968e: \:30ce\:30fc\:30c9\:306e \
GC\:ff08\:30ac\:30d9\:30fc\:30b8\:30b3\:30ec\:30af\:30b7\:30e7\:30f3\:ff09\n\n\
```mathematica\n(* \:53e4\:3044\:30ce\:30fc\:30c9\:306e\:30e1\:30bf\:30c7\
\:30fc\:30bf\:3092\:5727\:7e2e \[LongDash] \:8a73\:7d30\:3092\:6368\:3066\
\:3066\:8981\:7d04\:306b\:5909\:63db *)\niEvictOldNodes[nbGraph_Association, \
maxAgeDays_Integer: 30] :=\n  Module[{now, cutoff, oldIDs, keptNodes, \
evictedSummary},\n    now = AbsoluteTime[];\n    cutoff = now - maxAgeDays * \
86400;\n    oldIDs = Select[Keys[nbGraph[\"nodes\"]],\n      \
nbGraph[\"nodes\"][#][\"ts\"][\"end\"] < cutoff &];\n    (* \
\:53e4\:3044\:30ce\:30fc\:30c9\:306f\:8981\:7d04\:30ec\:30b3\:30fc\:30c9\:306b\
\:5727\:7e2e *)\n    evictedSummary = <|\n      \"evictedCount\" -> \
Length[oldIDs],\n      \"evictedRange\" -> \
MinMax[nbGraph[\"nodes\"][#][\"ts\"][\"start\"] & /@ oldIDs],\n      \"models\
\" -> DeleteDuplicates[nbGraph[\"nodes\"][#][\"model\"] & /@ oldIDs],\n      \
\"totalTokens\" -> Total[nbGraph[\"nodes\"][#][\"tokens\"][\"in\"] & /@ \
oldIDs]\n    |>;\n    keptNodes = KeyDrop[nbGraph[\"nodes\"], oldIDs];\n    \
Append[\n      ReplacePart[nbGraph, \"nodes\" -> keptNodes],\n      \
\"evictionLog\" -> Append[Lookup[nbGraph, \"evictionLog\", {}], \
evictedSummary]\n    ]\n  ]\n```\n\n### \:7b2c3\:6bb5\:968e: \:30af\:30e9\
\:30b9\:30bf\:30fc\:5358\:4f4d\:306e\:5727\:7e2e\n\n`ContinueEval` \:30c1\
\:30a7\:30a4\:30f3\:304c\:9577\:304f\:306a\:3063\:305f\:5834\:5408\:3001\:30af\
\:30e9\:30b9\:30bf\:30fc\:5185\:306e\:4e2d\:9593\:30ce\:30fc\:30c9\:30921\
\:3064\:306e\:8981\:7d04\:30ce\:30fc\:30c9\:306b\:5727\:7e2e\:3059\:308b\:3002\
\n\n```mathematica\n(* \:30af\:30e9\:30b9\:30bf\:30fc\:5727\:7e2e: \:4e2d\
\:9593\:30ce\:30fc\:30c9\:3092\:8981\:7d04\:30ce\:30fc\:30c9\:306b\:7f6e\:63db\
 *)\niCompactCluster[nbGraph_Association, clusterID_String, keepLast_Integer: \
2] :=\n  Module[{cluster, nodeIDs, toCompact, summary},\n    cluster = \
nbGraph[\"clusters\"][clusterID];\n    nodeIDs = cluster[\"nodes\"];\n    \
If[Length[nodeIDs] <= keepLast, Return[nbGraph]];\n    toCompact = \
nodeIDs[[;; -keepLast - 1]];\n    summary = <|\n      \"id\" -> clusterID <> \
\"-summary\",\n      \"type\" -> \"CompactedCluster\",\n      \"status\" -> \
\"Archived\",\n      \"model\" -> \"mixed\",\n      \"ts\" -> <|\n        \
\"start\" -> Min[nbGraph[\"nodes\"][#][\"ts\"][\"start\"] & /@ toCompact],\n  \
      \"end\"   -> Max[nbGraph[\"nodes\"][#][\"ts\"][\"end\"]   & /@ \
toCompact]\n      |>,\n      \"tokens\" -> <|\n        \"in\"  -> \
Total[nbGraph[\"nodes\"][#][\"tokens\"][\"in\"]  & /@ toCompact],\n        \
\"out\" -> Total[nbGraph[\"nodes\"][#][\"tokens\"][\"out\"] & /@ toCompact]\n \
     |>,\n      \"originalCount\" -> Length[toCompact],\n      \"cluster\" -> \
clusterID,\n      \"contentRef\" -> None,\n      \"execThread\" -> {}\n    \
|>;\n    ReplacePart[nbGraph, {\n      \"nodes\" -> \
Append[KeyDrop[nbGraph[\"nodes\"], toCompact], summary[\"id\"] -> summary],\n \
     {\"clusters\", clusterID, \"nodes\"} ->\n        \
Prepend[nodeIDs[[-keepLast ;;]], summary[\"id\"]]\n    }]\n  ]\n```\n\n## \
\:518d\:5b9f\:884c\:30fb\:5fa9\:5e30\:306e\:30ef\:30fc\:30af\:30d5\:30ed\:30fc\
\n\n### \:5931\:6557\:30ce\:30fc\:30c9\:304b\:3089\:306e\:5fa9\:5e30\n\n\
```mathematica\n(* \:5931\:6557\:30ce\:30fc\:30c9\:3092\:7279\:5b9a\:3057\
\:3001\:65b0\:30e2\:30c7\:30eb\:3067\:518d\:5b9f\:884c\:30b3\:30fc\:30c9\:3092\
\:751f\:6210 *)\niResumeFromFailure[nbGraph_Association, newModel_String: \
Automatic] :=\n  Module[{failedNodes, resumeOps},\n    failedNodes = \
Select[nbGraph[\"nodes\"],\n      #[\"status\"] === \"Failed\" || \
#[\"status\"] === \"FallbackUsed\" &];\n    If[Length[failedNodes] == 0,\n    \
  Return[Style[\"\\:5168\\:30ce\\:30fc\\:30c9\\:6b63\\:5e38\\:5b8c\\:4e86\", \
Darker[Green]]]];\n    resumeOps = KeyValueMap[\n      Function[{nid, nd},\n  \
      <|\"nodeID\" -> nid,\n          \"action\" -> If[nd[\"type\"] === \
\"ContinueEval\", \"ContinueEval\", \"Rerun\"],\n          \"model\" -> \
If[newModel === Automatic, nd[\"model\"], newModel],\n          \
\"contentRef\" -> nd[\"contentRef\"],\n          \"failPoint\" -> \
iDetectFailPoint[nd[\"execThread\"]]|>\n      ], failedNodes];\n    resumeOps\
\n  ]\n\n(* ExecutionThread \:304b\:3089\:5931\:6557\:70b9\:3092\:7279\:5b9a \
*)\niDetectFailPoint[execThread_List] :=\n  Module[{failed},\n    failed = \
Select[execThread, #[\"status\"] =!= \"OK\" &];\n    If[Length[failed] > 0, \
First[failed][\"fn\"], \"Unknown\"]\n  ]\n```\n\n### \:30e2\:30c7\:30eb\:66f4\
\:65b0\:5f8c\:306e\:4e00\:62ec\:518d\:5b9f\:884c\n\n```mathematica\n(* \:5168\
\:30ce\:30fc\:30c9\:307e\:305f\:306f\:30d5\:30a3\:30eb\:30bf\:6761\:4ef6\:306b\
\:5408\:81f4\:3059\:308b\:30ce\:30fc\:30c9\:3092\:65b0\:30e2\:30c7\:30eb\:3067\
\:518d\:8a08\:7b97 *)\niRecalcWithNewModel[nbGraph_Association, \
targetModel_String,\n    filterFn_: (True &)] :=\n  Module[{targets, plan},\n \
   targets = Select[nbGraph[\"nodes\"],\n      #[\"model\"] =!= targetModel \
&& #[\"status\"] =!= \"Archived\" && filterFn[#] &];\n    plan = KeyValueMap[\
\n      Function[{nid, nd},\n        <|\"nodeID\" -> nid,\n          \
\"originalModel\" -> nd[\"model\"],\n          \"targetModel\" -> \
targetModel,\n          \"estimatedTokens\" -> nd[\"tokens\"][\"in\"],\n      \
    \"priority\" -> If[nd[\"status\"] === \"Failed\", 1, 2],\n          \
\"contentAvailable\" -> (nd[\"contentRef\"] =!= None)|>\n      ], targets];\n \
   SortBy[plan, #[\"priority\"] &]\n  ]\n```\n\n## \:30b5\:30a4\:30ba\:898b\
\:7a4d\:3082\:308a\:6bd4\:8f03\n\n\:73fe\:884c\:65b9\:5f0f\:3068\:63d0\:6848\
\:65b9\:5f0f\:306e\:30b5\:30a4\:30ba\:6bd4\:8f03\:3092\:793a\:3059\:3002\n\n\
```mathematica\n(* 50\:30ce\:30fc\:30c9\:306e\:30bb\:30c3\:30b7\:30e7\:30f3\
\:3067\:306e\:30b5\:30a4\:30ba\:6bd4\:8f03\:30b7\:30df\:30e5\:30ec\:30fc\:30b7\
\:30e7\:30f3 *)\nnNodes = 50;\navgPromptSize = 8000;  (* bytes *)\n\
avgResponseSize = 15000; (* bytes *)\nmetadataPerNode = 500;  (* bytes *)\n\n\
currentSize = nNodes * (avgPromptSize + avgResponseSize + metadataPerNode);\n\
proposedGraphSize = nNodes * metadataPerNode;  (* TaggingRules \:5185 *)\n\
proposedExternalSize = nNodes * (avgPromptSize + avgResponseSize); (* \:5916\
\:90e8\:30d5\:30a1\:30a4\:30eb *)\n\nsizeSummary = Grid[{\n  {Style[\"\\:65b9\
\\:5f0f\", Bold], Style[\"TaggingRules\", Bold], Style[\"\\:5916\\:90e8\", \
Bold], Style[\"\\:5408\\:8a08\", Bold]},\n  {\"\\:73fe\\:884c\", \
Quantity[currentSize / 1024., \"Kilobytes\"] // Round, \"-\", \
Quantity[currentSize / 1024., \"Kilobytes\"] // Round},\n  \
{\"\\:63d0\\:6848\", Quantity[proposedGraphSize / 1024., \"Kilobytes\"] // \
Round, Quantity[proposedExternalSize / 1024., \"Kilobytes\"] // Round, \
Quantity[(proposedGraphSize + proposedExternalSize) / 1024., \"Kilobytes\"] \
// Round},\n  {\"\\:524a\\:6e1b\\:7387\", Quantity[Round[100 (1 - \
proposedGraphSize / currentSize)], \"Percent\"], \"-\", \"-\"}\n}, Frame -> \
All, Alignment -> Center,\n  Background -> {None, {LightBlue, None, None, \
LightGreen}}]\n```\n\n## ExecutionThread \:306e\:30a4\:30f3\:30b9\:30c8\:30eb\
\:30e1\:30f3\:30c6\:30fc\:30b7\:30e7\:30f3\:65b9\:91dd\n\n\:65e2\:5b58\:306e \
`claudecode.wl` \:5185\:306e\:4e3b\:8981\:95a2\:6570\:306b\:3001\:8efd\:91cf\
\:306a\:30c8\:30ec\:30fc\:30b9\:30d5\:30c3\:30af\:3092\:633f\:5165\:3059\:308b\
\:3002\n\n- **\:5bfe\:8c61\:95a2\:6570**: `iClaudeQueryRaw`, \
`iQueryWithFallback`, `iExtractResultFromStreamJson`, `iMergeAndValidate`\n- \
